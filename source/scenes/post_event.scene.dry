title: Post Event
new-page: true
on-arrival: {!

// RNG

function _mkrng(seed) {
    let s = seed >>> 0;
    return function() {
        s += 0x6d2b79f5;
        let t = Math.imul(s ^ (s >>> 15), 1 | s);
        t ^= t + Math.imul(t ^ (t >>> 7), 61 | t);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}

// Derive a per-tick RNG from the fixed seed + tick counter
// Same seed + same tick = identical results every time
const _r = _mkrng((Q.rng_seed + Q.tick * 0x9e3779b9) >>> 0);

Q.random_factor = function(f, variance = 0.65) {
    return f * (1 - variance / 2 + _r() * variance);
};


if (Q.inverted_ideos != 1) {

// ============================================================
// AUTO IDEOLOGY SCORER — derives 0 (far-left) to 20 (far-right)

const IDEO_KEYWORDS = [
    // 0 — revolutionary / Leninist left
    [/marxism-leninism/i,                 1],
    [/council communism/i,                0],

    // 2 — revolutionary but non-Leninist / left socialist
    [/revolutionary socialism/i,          2],
    [/left-wing socialism/i,              3],

    // NEW — Social Democracy family (must precede generic soc-dem/soc-rep below)
    [/social democracy \(revolutionary\)/i,      3],  // Left
    [/social democracy \(center marxist\)/i,     4],  // Center
    [/social democracy \(reformist\)/i,          6],  // Reformist
    [/laborism/i,                                7],  // Labor
    [/social republicanism \(neorevisionist\)/i, 8],  // Neorevisionist

    // 5 — mainstream social democracy
    [/social democracy/i,                 6],
    [/social republicanism/i,             7],

    // 7 — right social democracy / soft-left liberal
    [/right-wing social democracy/i,      8],
    [/catholic laborism/i,                10],

    // 10 — center / centrist liberal / cross-class Christian
    [/social liberalism/i,                9],
    [/christian socialism/i,              7],
    [/catholic tent/i,                    12],
    [/middle-class interest/i,            13],
    [/corporatism/i,                      15],

    // 13 — moderate conservative / regional Catholic conservative / Christian conservatives
    [/christian conservatism/i,           14],
    [/bavarian conservatism/i,            13],
    [/protestant social conservatism/i,   13],
    [/moderate conservatism/i,            14],
    [/liberal agrarianism/i,              12],

    // 15 — national liberal / agrarian-liberal right-center
    [/national liberalism/i,              14],
    [/hanoverian agrarianism/i,           15],
    [/hanseatic agrarian conservatism/i,  15],

    // 17 — hard agrarian conservative
    [/völkisch liberalism/i,              16],
    [/populist agrarian conservatism/i,   16],
    [/agrarian conservatism/i,            17],
    [/social corporatism/i,               16],

    // 18 — national conservative
    [/national conservatism/i,            18],

    // 20 — far-right nationalist / völkisch / Nazi
    [/national socialism/i,               20],
    [/völkisch nationalism/i,             20],
    [/national conservatism (Hugenbergite)/i,            18],
];

function ideoScore(ideologyString) {
    if (!ideologyString) return 10; // Fallback to absolute center (10)
    for (const [pattern, score] of IDEO_KEYWORDS) {
        if (pattern.test(ideologyString)) return score;
    }
    return 10; // Unrecognized ideology string -> treat as centrist/unknown
}

// Apply to every active party, reading straight from Q.[party]_ideology
for (const p of Q.parties) {
    const key = p + '_ideology';
    Q[p + '_ideo_score'] = ideoScore(Q[key]);
}

// Also cover parties tracked outside Q.parties but referenced in
// party_relations / coalition_blocks (splinters, KPO, LB, etc.)
const EXTRA_IDEO_PARTIES = [
    'kpo', 'sl', 'sapd', 'srpd', 'ddp', 'z', 'bvp', 'csrp', 'dvp', 'wp',
    'cnbl', 'csvd', 'dnvp', 'vrp', 'kvp', 'dhp', 'bb', 'dvfp',
    'aspd', 'vnr', 'hl', 'lb', 'rdp', 'cvp', 'sls', 'dtsp', 'dbp', 'dsbp', 'dnf', 'rlb', 'faud', 'kapd'
];
for (const p of EXTRA_IDEO_PARTIES) {
    const key = p + '_ideology';
    if (Q[key] !== undefined) {
        Q[p + '_ideo_score'] = ideoScore(Q[key]);
    }
}

}



// REMOVE DUPLICATES 

Q.parties = [...new Set(Q.parties)];


// CODE EXAMPLE FOR REMOVING Tolerator...
// Q.tolerating_parties = Q.tolerating_parties.filter(function(p) { return p !== 'DVP'; });
// Q.dvp_tolerating = 0;

// QOL. TRACK GOVERNMENT VOTES.

// ============================================
// GOVERNMENT VOTE/SEAT TRACKER
// ============================================
Q.government_total_votes = 0;

for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    if (Q[p + '_in_government'] === 1) {
        Q.government_total_votes += Q[p + '_r'] || 0;
    }
}

Q.government_total_votes = Math.round(Q.government_total_votes * 10) / 10;


// ============================================
// CONSTITUTIONAL SUPERMAJORITY CHECK (2/3)
// ============================================
Q.has_supermajority = (Q.government_effective_pct >= 66.7) ? 1 : 0;



// ============================================
// GOVERNMENT COLLAPSE CHECK
// ============================================

var gov_count = 0;
for (var i = 0; i < Q.parties.length; i++) {
    if (Q[Q.parties[i] + '_in_government'] === 1) gov_count++;
}

if (gov_count > 0) {
    var effective_votes = Q.government_total_votes;

    if (Q.tolerating_parties) {
        for (var i = 0; i < Q.tolerating_parties.length; i++) {
            var tp = Q.tolerating_parties[i].toLowerCase();
            if (Q[tp + '_in_government'] !== 1) {
                effective_votes += Q[tp + '_r'] || 0;
            }
        }
    }

    Q.government_effective_pct = Math.round(effective_votes * 10) / 10;

    if (effective_votes < 50) {
        Q.government_collapsed = 1;
        Q.next_election_year = Q.year;
        Q.next_election_month = Q.month + 2;
        if (Q.next_election_month > 12) {
            Q.next_election_month = 1;
            Q.next_election_year += 1;
        }
        for (var i = 0; i < Q.parties.length; i++) {
            Q[Q.parties[i] + '_in_government'] = 0;
        }
        Q.government_parties = [];
        Q.tolerating_parties = [];
        Q.spd_toleration = 0;
        Q.is_minority_government = 0;
    }
}


// QOL. REMOVES PHANTON PARTIES.

const inGov = Object.keys(Q)
  .filter(key => key.endsWith("_in_government") && Q[key] == 1)
  .map(key => key.replace("_in_government", ""))
  .filter(party => (Q[party + "_votes"] > 0) && (Q[party + "_r"] > 0))
  .map(party => party.toUpperCase());

Q.parties_in_government_display = inGov.length > 0
  ? inGov.join(", ")
  : "None";



// === PARTY RELATION GRAVITY ===
Q.relation_gravity = function(value) {
    var abs = Math.abs(value);
    if (abs <= 80) return value;
    var pull = (abs - 80) * 0.04;
    return value > 0 ? value - pull : value + pull;
};

for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    Q[p + '_relation'] = Q.relation_gravity(Q[p + '_relation'] || 0);
    if (!Q.math_broken) {
        Q[p + '_relation'] = Math.max(-100, Math.min(100, Q[p + '_relation']));
    } else {
        Q[p + '_relation'] = Q.impossible_add(Q[p + '_relation'], 0);
    }
}

// === CHECK FOR LOW-RELATION COALITION PARTNER ===
Q.coalition_low_relation = 0;

// Check full government parties (threshold: <= 30)
for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    if (p === "spd") continue;
    if (Q[p + '_in_government'] === 1 && Q[p + '_relation'] <= 30) {
        Q.coalition_low_relation = 1;
        break;
    }
}

// Check tolerating parties (threshold: <= 20), only if not already triggered
if (!Q.coalition_low_relation && Q.tolerating_parties) {
    for (var i = 0; i < Q.tolerating_parties.length; i++) {
        var tp = Q.tolerating_parties[i].toLowerCase();
        if (tp === "spd") continue;
        if (Q[tp + '_relation'] <= 20) {
            Q.coalition_low_relation = 1;
            break;
        }
    }
}


// === CHECK FOR LOW-RELATION COALITION PARTNER ===
Q.coalition_mid_relation = 0;
Q.mad_party = "";
Q.mad_party_key = "";
var lowest_relation = 999;

for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    if (p === "spd") continue;
    if (Q[p + '_in_government'] === 1 && Q[p + '_relation'] < 45 && Q[p + '_relation'] < lowest_relation) {
        Q.coalition_mid_relation = 1;
        Q.mad_party = p.toUpperCase();
        Q.mad_party_key = p;
        lowest_relation = Q[p + '_relation'];
    }
}






Q.coalition_tension = 0;

if (Q.government_parties) {
    for (var i = 0; i < Q.government_parties.length; i++) {
        var p = Q.government_parties[i].toLowerCase();
        if (p === 'spd') continue;
        var rel = Q[p + '_relation'] !== undefined ? Q[p + '_relation'] : 50;
        if (rel < 50) {
            Q.coalition_tension += (50 - rel) / 10;
        }
    }
}

Q.coalition_tension = Math.round(Q.coalition_tension * 10) / 10;


















// === VARIABLE RANGE CAPPING ===
// Clamps each listed Q.<var> to its defined [min, max] range after any
// mechanic that might push it out of bounds (e.g. relation dynamics,
// event effects, etc). Missing/undefined vars are skipped safely.

Q.capped_var_ranges = {
    // 0 to 10
    pro_consumer:              [0, 10],
    agricultural_finance:      [0, 10],
    land_reform:               [0, 10],
    socialization:             [0, 10],
    commonwealth_cooperation:  [0, 10],
    cooperatives:              [0, 10],
    economic_democracy:        [0, 20],
    workers_safety:            [0, 10],
    working_hours:             [0, 10],
    womens_rights:             [0, 10],

    // -10 to 10
    welfare:                   [-10, 10],
    judicial_reform:           [-10, 10],
    pacifism:                  [-10, 10],
    radicalization:            [-10, 10],
    democratization:           [-10, 10],

    // -1 to 2
    confronting_antisemitism:  [-1, 2],

    // 0 to 15
    workers_aid:               [0, 15],
    campaign_media:            [0, 15],
    commercialized_media:      [0, 15],
    cultural_organizations:    [0, 15],
    wtb_support:               [0, 15],
    local_rally:               [0, 15],
    peoples_party_support:     [0, 15]
};

Q.apply_var_caps = function() {
    for (var varName in Q.capped_var_ranges) {
        if (!Q.capped_var_ranges.hasOwnProperty(varName)) continue;
        if (Q[varName] === undefined) continue; // skip vars not in use

        var range = Q.capped_var_ranges[varName];
        var min = range[0];
        var max = range[1];

        if (Q[varName] < min) {
            Q[varName] = min;
        } else if (Q[varName] > max) {
            Q[varName] = max;
        }
    }
};

Q.apply_var_caps();









// === MINISTRY REASSIGNMENT (runs every tick) ===
var portfolios = ["foreign_minister", "interior_minister", "justice_minister", "labor_minister",
                   "economic_minister", "finance_minister", "agriculture_minister", "transport_minister"];

for (var i = 0; i < portfolios.length; i++) {
    var port = portfolios[i];
    var partyField = port + "_party";
    var currentParty = (Q[partyField] || "").toLowerCase();

    // If held party isn't in government anymore, reassign
    if (Q[currentParty + '_in_government'] !== 1) {
        // Find the largest remaining government party by seat share
        var bestParty = "";
        var bestVotes = -1;
        for (var j = 0; j < Q.parties.length; j++) {
            var p = Q.parties[j];
            if (Q[p + '_in_government'] === 1 && (Q[p + '_r'] || 0) > bestVotes) {
                bestVotes = Q[p + '_r'] || 0;
                bestParty = p;
            }
        }

        if (bestParty !== "") {
            Q[partyField] = bestParty.toUpperCase();
            Q[port] = (Q.ministry_roster[bestParty] && Q.ministry_roster[bestParty][port]) || 0;
        }
    }
}

// === MINISTER NAME / PARTY CONSISTENCY CHECK ===
// Ensures the displayed minister name always matches the party
// currently holding that portfolio. Catches any drift caused by
// party-field changes that happen outside the reassignment loop above
// (e.g. a death, resignation, or manual Q.<port>_party edit elsewhere).

if (!Q.minister_name_table) {
    Q.minister_name_table = {
        foreign_minister:     { KPD:'Pieck', SAPD:'Rosenfeld', SPD:'Breitscheid', SRPD:'Breitscheid', DDP:'Koch-Weser', Z:'Curtius', BVP:'Held', DVP:'Stresemann', WP:'Lambach', CNBL:'Hepp', DNVP:'Westarp' },
        interior_minister:    { KPD:'Ulbricht', SAPD:'Seydewitz', SPD:'Severing', SRPD:'Braun', DDP:'Koch-Weser', Z:'Wirth', BVP:'Schätzel', DVP:'Scholz', WP:'Petersen', CNBL:'Behrens', DNVP:'Hergt' },
        justice_minister:     { KPD:'Heckert', SAPD:'Ledebour', SPD:'Radbruch', SRPD:'Heilmann', DDP:'Koch-Weser', Z:'Bredt', BVP:'Gürtner', DVP:'Heinze', WP:'Drewitz', CNBL:'von Rohr', DNVP:'Schiele' },
        labor_minister:       { KPD:'Münzenberg', SAPD:'Seydewitz', SPD:'Wissell', SRPD:'Aufhäuser', DDP:'Dietrich', Z:'Stegerwald', BVP:'Stützel', DVP:'Brauns', WP:'Petersen', CNBL:'Lohse', DNVP:'Schiele' },
        economic_minister:    { KPD:'Remmele', SAPD:'Rosenfeld', SPD:'Hilferding', SRPD:'Schmidt', DDP:'Dietrich', Z:'Bredt', BVP:'Held', DVP:'Curtius', WP:'Lambach', CNBL:'Heim', DNVP:'Schiele' },
        finance_minister:     { KPD:'Neumann', SAPD:'Rosenfeld', SPD:'Hilferding', SRPD:'Hilferding', DDP:'Dietrich', Z:'Köhler', BVP:'Krausneck', DVP:'Moldenhauer', WP:'Drewitz', CNBL:'Hepp', DNVP:'Schiele' },
        agriculture_minister: { KPD:'Hoernle', SAPD:'Baade', SPD:'Baade', SRPD:'Baade', DDP:'Dietrich', Z:'Hermes', BVP:'Wutzlhofer', DVP:'Schiele', WP:'Bredt', CNBL:'Hamkens', DNVP:'Schiele' },
        transport_minister:   { KPD:'Hoernle', SAPD:'Baade', SPD:'Baade', SRPD:'Baade', DDP:'Dietrich', Z:'Guerard', BVP:'Wutzlhofer', DVP:'Schiele', WP:'Bredt', CNBL:'Hamkens', DNVP:'Schiele' }
    };
}

for (var i = 0; i < portfolios.length; i++) {
    var port = portfolios[i];
    var party = (Q[port + '_party'] || '').toUpperCase();

    var expectedName = (Q.minister_name_table[port] && Q.minister_name_table[port][party]) || 'Unbesetzt';

    // Special case: Stresemann's death reassigns the DVP foreign minister slot to Curtius
    if (port === 'foreign_minister' && party === 'DVP' && Q.stresemann_dead) {
        expectedName = 'Curtius';
    }

    if (Q[port] !== expectedName) {
        Q[port] = expectedName;
    }
}









// === LOBBYING ACTIVITY CHECK ===
Q.lobbying_active = 0;
Q.lobbyable_ministries = [];

for (var i = 0; i < portfolios.length; i++) {
    var port = portfolios[i];
    var mp = (Q[port + '_party'] || '').toLowerCase();
    var qualifies = mp && (Q[mp + '_relation'] || 0) >= 80;

    // flat boolean per portfolio, for use in plain view-if: syntax
    Q['lobby_' + port + '_available'] = qualifies ? 1 : 0;

    if (qualifies) {
        Q.lobbying_active = 1;
        Q.lobbyable_ministries.push({ portfolio: port, party: mp });
    }
}









// UPDATE PARTY RELATIONSHIPS EACH TIME.

function updatePartyRelations() {
    // 1. Direct mappings to variables that events already alter
    Q.party_relations.KPD.SPD   = Q.kpd_relation;
    Q.party_relations.KPD.SRPD  = Q.kpd_relation + 5;
    Q.party_relations.SPD.KPD   = Q.kpd_relation;
    Q.party_relations.SPD.DDP   = Q.ddp_relation;
    Q.party_relations.SPD.Z     = Q.z_relation;
    Q.party_relations.SPD.DVP   = Q.dvp_relation;
    Q.party_relations.SPD.CSRP  = Q.csrp_relation;
    Q.party_relations.SPD.DNVP  = Q.dnvp_relation;
    Q.party_relations.SPD.KVP   = Q.kvp_relation;
    Q.party_relations.SPD.DHP   = Q.dhp_relation;
    Q.party_relations.SPD.BB    = Q.bb_relation;
    Q.party_relations.SPD.DVFP  = Q.dvfp_relation;
    Q.party_relations.SPD.BVP  =  Q.bvp_relation;
    Q.party_relations.SRPD.KPD  = Q.kpd_relation - 10;
    Q.party_relations.SRPD.DDP  = Q.ddp_relation + 10;
    Q.party_relations.SRPD.Z    = Q.z_relation + 5;
    Q.party_relations.DDP.SPD   = Q.ddp_relation;
    Q.party_relations.DDP.SRPD  = Q.ddp_relation + 10;
    Q.party_relations.Z.SPD     = Q.z_relation;
    Q.party_relations.Z.SRPD    = Q.z_relation + 5;
    Q.party_relations.CSRP.SPD  = Q.csrp_relation;
    Q.party_relations.CSRP.SRPD = Q.csrp_relation + 5;
    Q.party_relations.DNVP.SPD  = Q.dnvp_relation;
    Q.party_relations.DNVP.SRPD = Q.dnvp_relation - 5;
    Q.party_relations.DVFP.SPD  = Q.dvfp_relation;
    Q.party_relations.VRP.SPD   = Q.vrp_relation;
    Q.party_relations.ASPD.KPD  = Q.kpd_relation - 10;
    Q.party_relations.ASPD.DDP  = Q.ddp_relation + 5;
    Q.party_relations.ASPD.Z    = Q.z_relation;
    Q.party_relations.ASPD.DVP  = Q.dvp_relation + 10;

    // 2. Re-evaluate Booleans for Coalition Blocks based on the live numbers
    Q.coalition_blocks = {
        DBP_KPD:   true,
        DBP_SAPD:  true,
        DBP_NSDAP: true,
        DBP_DVFP:  true,
        DBP_DTSP:  true,
        DBP_CNBL:  false,
        DBP_BB:    false,
        
        KPD_Z:     Q.party_relations.Z.SPD < 65 || Q.kpd_relation < 65,
        KPD_BVP:   true,
        KPD_DVP:   true,
        KPD_WP:    true,
        KPD_CNBL:  true,
        KPD_DNVP:  true,
        KPD_NSDAP: true,
        KPD_DVFP:  true,
        KPD_VRP:   true,
        KPD_DDP:   Q.kpd_relation < 65,
        KPD_SPD:   Q.communist_coalition < 3,

        SAPD_DVP:   true,
        SAPD_WP:    true,
        SAPD_CNBL:  true,
        SAPD_DNVP:  true,
        SAPD_NSDAP: true,
        SAPD_VRP:   true,

        SPD_NSDAP: true,
        SPD_DNVP:  Q.dnvp_relation < 60 || Q.dnvp_line === 3,
        SPD_KPD:   Q.communist_coalition < 3,
        SPD_VRP:   Q.vrp_relation < 35,

        SRPD_KPD:   Q.kpd_relation < 40,
        SRPD_NSDAP: true,
        SRPD_DNVP:  Q.dnvp_line === 3,
        SRPD_VRP:   Q.vrp_relation < 30,

        DDP_KPD:   true,
        DDP_NSDAP: true,
        DDP_DNVP:  Q.dnvp_line === 3,

        Z_KPD:    Q.kpd_relation < 65 || Q.z_relation < 45,
        Z_NSDAP:  Q.nazi_urgency >= 6,
        Z_DNVP:   Q.dnvp_line === 3 && Q.z_party_leader !== "Kaas",

        BVP_KPD:   true,
        BVP_SAPD:  true,
        BVP_NSDAP: Q.nazi_urgency >= 6,

        DVP_KPD:   true,
        DVP_SAPD:  true,
        DVP_NSDAP: Q.nazi_urgency >= 7 && Q.capital_strike_progress < 4,
        DVP_VRP:   Q.dvp_right_shift >= 2,

        WP_KPD:   true,
        WP_SAPD:  true,
        WP_NSDAP: Q.capital_strike_progress < 5,
        WP_VRP:   true,

        CNBL_KPD:  true,
        CNBL_SAPD: true,
        CNBL_SPD:  Q.party_relations.CNBL.SPD < 30,

        DNVP_KPD:  true,
        DNVP_SAPD: true,
        DNVP_SPD:  Q.dnvp_line === 3 || Q.dnvp_relation < 40,
        DNVP_DDP:  Q.dnvp_line === 3,
        DNVP_Z:    Q.dnvp_line === 3 && Q.z_party_leader !== "Kaas",
        DNVP_VRP:  Q.dnvp_line === 3,

        NSDAP_KPD:                  true,
        NSDAP_DBP:                  true,
        NSDAP_SPD:                  true,
        NSDAP_SAPD:                 true,
        NSDAP_SRPD:                 true,
        NSDAP_DDP:                  true,
        NSDAP_CSRP:                 true,
        NSDAP_VRP:                  true,
        NSDAP_BVP:                  Q.nazi_urgency >= 6,
        NSDAP_Z:                    Q.nazi_urgency >= 6,
        NSDAP_COALITIONS_GENERALLY: Q.nsdap_r < 35 || Q.year < 1932,

        VRP_KPD:   true,
        VRP_SAPD:  true,
        VRP_WP:    true,
        VRP_NSDAP: true,
        VRP_DNVP:  Q.dnvp_line === 3,
        VRP_DVP:   Q.dvp_right_shift >= 1,
        VRP_SPD:   Q.vrp_relation < 35,

        KVP_KPD:   true,
        KVP_SAPD:  true,
        KVP_NSDAP: true,
        KVP_DNVP:  Q.dnvp_line === 3,
        KVP_SPD:   false,

        DHP_KPD:   true,
        DHP_SAPD:  true,
        DHP_NSDAP: Q.nazi_urgency >= 5,

        BB_KPD:   true,
        BB_SAPD:  true,
        BB_NSDAP: Q.nazi_urgency >= 7,
        BB_WP:    false,
        BB_DVP:   true,

        LB_KPD:    false,
        LB_SPD:    Q.party_relations.LB.SPD < 30,
        LB_NSDAP:  true,
        LB_DNVP:   true,
        LB_DVP:    true,
        LB_WP:     true,
        LB_CNBL:   true,
        LB_DVFP:   true,
        LB_DTSP:   true,

        RDP_KPD:   true,
        RDP_NSDAP: true,
        RDP_DVFP:  true,
        RDP_DTSP:  true,
        RDP_DNVP:  Q.dnvp_line === 3,

        CVP_KPD:   true,
        CVP_SAPD:  true,
        CVP_NSDAP: true,
        CVP_DVFP:  true,
        CVP_DTSP:  true,
        CVP_SPD:   Q.z_in_government && Q.spd_in_government,

        SLS_KPD:   true,
        SLS_NSDAP: true,
        SLS_DVFP:  true,
        SLS_DTSP:  true,
        SLS_DNVP:  Q.dnvp_line === 3,

        DTSP_KPD:   true,
        DTSP_SAPD:  true,
        DTSP_SPD:   true,
        DTSP_SRPD:  true,
        DTSP_DDP:   true,
        DTSP_Z:     true,
        DTSP_BVP:   true,
        DTSP_CSRP:  true,
        DTSP_LB:    true,
        DTSP_RDP:   true,
        DTSP_SLS:   true,
        DTSP_CVP:   true,
        DTSP_DBP:   true,

        DVFP_DBP:   true,
    };
}

updatePartyRelations();



































Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// make sure no stat is below 0.

// 1. update dates
if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.ma = 1;
    console.log(Q.month);
    console.log(Q.time);
    
    // Advance by 1 week during a Ruhr labor strike, 2 weeks otherwise
    Q.weeks = (Q.weeks || 0) + (Q.ruhr_labor_strike == 1 ? 1 : 2);
    
    // Roll over to next month when 4+ weeks pass
    if (Q.weeks >= 4) {
        Q.weeks -= 4;
        Q.month += 1;
        
        if (Q.month >= 13) {
            Q.month = 1;
            Q.year += 1;
            if (Q.historical_mode) {
                Q.resources += 2;
            }
        }
    }
    
    // decrement timers
    for (timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }





// DNVP GAMEPLAY

if (Q.lambach_exile == 1) {
    Q.hugenberg_momentum += 3.6;
    Q.delegate_power_christsoc -= 1.4;   // DHV wing bleeds most
    Q.delegate_power_yocon -= 0.6;
    Q.delegate_power_b -= 1.0;
} else if (Q.lambach_reinstated == 1) {
    Q.hugenberg_momentum += 1.6;
    Q.delegate_power_a += 1.0;
    Q.delegate_power_christsoc += 0.4;
    Q.delegate_power_yocon += 0.2;
} else if (Q.lambach_exile == 0) {
    Q.delegate_power_christsoc += 5.6; // DHV vindicated
    Q.delegate_power_yocon += 2.0;
} else {
    Q.hugenberg_momentum += 2.0;
}

if (Q.cnbl_crisis == 1) {
    Q.hugenberg_momentum += 4.0;
} else {
    Q.delegate_power_b += 2.0;
    Q.delegate_power_yocon += 0.8;
    Q.delegate_power_christsoc += 0.5;
}

if (Q.vnr_momentum == 0) {
    Q.delegate_power_yocon += 0.5;    
    Q.delegate_power_christsoc += 1.4;
    Q.delegate_power_a += 0.5;
} else {
    Q.delegate_power_b += 2.0;
    Q.hugenberg_momentum += 3.0;
}

if (Q.geest_wildfire == 0) {
    Q.delegate_power_yocon += 1.3;
    Q.delegate_power_christsoc += 1.2;
    Q.delegate_power_a += 1.8;
    Q.delegate_power_b += 1.1;
    Q.hugenberg_momentum -= 1.2;
} else {
    Q.hugenberg_momentum += 5.0;
    Q.delegate_power_yocon += 1.5;    // split the old +10 to c
    Q.delegate_power_christsoc += 1.1;
    Q.delegate_power_a += 0.3;
    Q.delegate_power_b -= 1.0;
}

// 3b. Media Dominance Check
if (Q.commercialized_media >= 1 || Q.radio >= 1) {
    Q.hugenberg_momentum -= 2.0;
}

// Media beating

if (Q.hugenberg_media_attack >= 1 ) {
    Q.hugenberg_momentum -= 10.0;
}

// 3c. Land Reform Threat
if (Q.land_reform > 0) {
    Q.hugenberg_momentum += 4.0 * Q.land_reform;
}

// 3d. Government Participation Bonus
if (Q.dnvp_in_government) {
    Q.delegate_power_a += 4.0;
    Q.delegate_power_b += 2.0;
    Q.delegate_power_yocon += 2.2;
    Q.delegate_power_christsoc += 1.8;
}

if (Q.ideology == "reformist") {
    Q.delegate_power_a -= 0.3;
    Q.delegate_power_b -= 0.3;
    Q.delegate_power_yocon -= 0.1;
    Q.delegate_power_christsoc += 0.8;
    Q.hugenberg_momentum -= 0.1;
}
if (Q.ideology == "labor") {
    Q.delegate_power_christsoc -= 0.5;
    Q.delegate_power_a += 0.3;
    Q.delegate_power_b += 0.3;
    Q.delegate_power_yocon += 0.3;
    Q.hugenberg_momentum += 0.1;
}
if (Q.ideology == "left") {
    Q.hugenberg_momentum += 1;
    Q.delegate_power_a += 0.5;
    Q.delegate_power_b -= 1.2;
    Q.delegate_power_yocon += 0.5;
    Q.delegate_power_christsoc -= 0.5;
}

if (Q.welfare < 0) Q.delegate_power_christsoc += 2.5 * Math.abs(Q.welfare);

if (Q.unions_independent) Q.delegate_power_christsoc *= 1.06;

if (Q.lambach_stage >= 2) {
    Q.delegate_power_christsoc += 30;
}

// 4. Class Influence
Q.hugenberg_momentum += (Q.old_middle_dnvp_display * 0.27);
Q.hugenberg_momentum += (Q.rural_dnvp_display * 0.17);

Q.delegate_power_a += (Q.new_middle_dnvp_display * 0.32);
Q.delegate_power_a += (Q.old_middle_dnvp_display * 0.11);

Q.delegate_power_b += (Q.rural_dnvp_display * 0.20);
Q.delegate_power_b += (Q.old_middle_dnvp_display * 0.08);

// Young Conservatives: new middle class + small worker slice + some old middle
Q.delegate_power_yocon += (Q.workers_dnvp_display * 0.16) + (Q.new_middle_dnvp_display * 0.25) + (Q.old_middle_dnvp_display * 0.06);
// Christian Socials: worker-heavy + half of new middle
Q.delegate_power_christsoc += (Q.workers_dnvp_display * 0.6) + (Q.new_middle_dnvp_display * 0.33);

// 5. Ideological Reinforcements
Q.hugenberg_momentum += Q.nationalism * 4.0;
Q.delegate_power_b += Q.nationalism * 0.13 * Q.pro_republic * 0.1;
Q.delegate_power_a += Q.pro_republic * 0.034 + Q.nationalism * 0.056;
Q.delegate_power_yocon += Q.pro_republic * 0.25;
Q.delegate_power_christsoc += Q.socialism * 0.28 + Q.pro_republic * 0.12;

// 6. Failure Penalty
if (Q.dnvp_votes_display < 13) {
    Q.delegate_power_a -= 2.0;
    Q.delegate_power_b -= 2.0;
    Q.hugenberg_momentum += 3.0;
} else if (Q.dnvp_votes_display < 14) {
    Q.delegate_power_a -= 0.6;
    Q.delegate_power_b -= 1.0;
    Q.hugenberg_momentum += 1.0;
    Q.delegate_power_yocon += 0.6;
    Q.delegate_power_christsoc += 0.4;
} else if (Q.dnvp_votes_display < 16) {
    Q.delegate_power_a -= 0.2;
    Q.delegate_power_b -= 0.4;
    Q.hugenberg_momentum += 0.6;
    Q.delegate_power_yocon += 1.0;
    Q.delegate_power_christsoc += 0.6;
} else if (Q.dnvp_votes_display < 18) {
    Q.delegate_power_a += 1.2;
    Q.delegate_power_b -= 0.5;
    Q.hugenberg_momentum -= 1.0;
    Q.delegate_power_yocon += 2.0;
    Q.delegate_power_christsoc += 1.7;
} else {
    Q.delegate_power_a += 1.5;
    Q.delegate_power_b -= 0.6;
    Q.hugenberg_momentum -= 1.2;
    Q.delegate_power_yocon += 2.3;
    Q.delegate_power_christsoc += 2.0;
}

// 7. Global regulation: cap combined total of all 6 tracked vars at 1000
{
    const _dnvp_total_cap = 1000;
    const _dnvp_tracked = [
        'hugenberg_momentum',
        'delegate_power_a',
        'delegate_power_b',
        'delegate_power_yocon',
        'delegate_power_christsoc'
    ];

    const _dnvp_sum = _dnvp_tracked.reduce((sum, key) => sum + Q[key], 0);

    if (_dnvp_sum > _dnvp_total_cap) {
        const _dnvp_scale = _dnvp_total_cap / _dnvp_sum;
        _dnvp_tracked.forEach(key => {
            Q[key] *= _dnvp_scale;
        });
    }
}









// ==========================================
// DVP GAMEPLAY
// ==========================================

Q.dvp_left = Q.dvp_left || 240;
Q.dvp_right = Q.dvp_right || 260;

if (Q.spd_r >= 30) {
    Q.dvp_left -= 0.7;
    Q.dvp_right += 0.7;
} else if (Q.spd_r >= 27.5) {
    Q.dvp_left += 0.35;
    Q.dvp_right += 0.35;
} else if (Q.spd_r <= 27.5 && Q.spd_r > 25) {
    Q.dvp_left += 0.7;
    Q.dvp_right -= 0.7;
} else { 
    Q.dvp_left += 1.28;
    Q.dvp_right -= 1.28;
}

if (Q.foreign_minister_party == "DVP" || Q.kellogg_briand_signed_dvp == 1) {
    Q.dvp_right += 2.64;
    Q.dvp_left -= 0.7;
}

if (Q.congress_path != "capitulation") {
    Q.dvp_left += 0.7;
}
if (Q.congress_path == "capitulation") {
    Q.dvp_right += 2.8;
}
if (Q.congress_path == "social_nationalists" || Q.congress_path == "coalitionists") {
    Q.dvp_left += 1.8;
    if (Q.congress_path == "social_nationalists") {
        Q.dvp_left += 0.7;
    }
}

if (Q.upper_tax_rates > 0) {
    Q.dvp_right += 0.88 * Q.upper_tax_rates;
}
if (Q.welfare > 1) {
    Q.dvp_right += 0.6 * Q.welfare;
}
if (Q.working_hours > 0) {
    Q.dvp_right += 0.6 * Q.working_hours;
}
if (Q.ruhr_labor > 0) {
    Q.dvp_right += 1.28;
}
if (Q.works_councils > 0) {
    Q.dvp_right += 1.12 * Q.works_councils;
}
if (Q.socialization > 0) {
    Q.dvp_right += 2.4 * Q.socialization;
}
if (Q.cooperatives > 0) {
    Q.dvp_right += 1.28 * Q.cooperatives;
}

if (Q.major_curriculum == "vocational") {
    Q.dvp_left += 1.8;
}
if (Q.minor_curriculum == "vocational") {
    Q.dvp_left += 0.7;
}
if (Q.secularized == 1) {
    Q.dvp_left += 2.5;
}

Q.dvp_right += (Q.capital_strike_progress || 0) * 0.35;
Q.dvp_right += (Q.workers_safety || 0) * 0.35;
Q.dvp_left += (Q.judicial_reform || 0) * 1.28;
Q.dvp_left += (Q.reparations_negotiation || 0) * 2.0;

if (Q.enemies == "bourgeois parties" || Q.enemies == "DVP") {
    Q.dvp_right += 2.64;
}

Q.dvp_left += (Q.radio || 0) * 1.8;
Q.dvp_left += (Q.commercialized_media || 0) * 1.28;

if (Q.unions_independent) {
    Q.dvp_left += 4.0;
}

if (Q.ideology == "reformist") {
    Q.dvp_left += 1.8;
}
if (Q.ideology == "labor") {
    Q.dvp_left -= 1.28;
    Q.dvp_right += 1.28;
}
if (Q.ideology == "left") {
    Q.dvp_right += 2.24;
    Q.dvp_left -= 1.8;
}

Q.dvp_right += (Q.peoples_party_support || 0) * 0.35;
Q.dvp_left += (Q.peoples_party_support || 0) * 0.66;

Q.dvp_left += ((Q.dvp_relation || 0) / 8) * 0.35;
Q.dvp_right += ((100 - (Q.dvp_relation || 0)) * 0.5) * 0.28;

if (Q.dvp_relation < 40) {
    Q.dvp_right += 0.7;
}

Q.dvp_left += ((Q.pro_republic || 0) / 12) * 0.35;
Q.dvp_right += (Q.nationalism || 0) * 0.6;

// Q.dvp_left += (((Q.new_middle_dvp || 0) + (Q.workers_dvp || 0) + (Q.unemployedc_dvp || 0)) / 5) * 0.35;
// Q.dvp_right += ((Q.old_middle_dvp || 0) * 0.8 + (Q.rural_dvp || 0) * 0.6) * 0.32;

// 5. SPD/ZENTRUM DEMOGRAPHIC WEAKNESS OVERTURE
// Q.dvp_left += (32 - (Q.new_middle_spd || 0)) * 0.06;
// Q.dvp_left += (20 - (Q.new_middle_z || 0)) * 0.06;
// Q.dvp_left += (38 - (Q.workers_spd || 0)) * 0.06;
// Q.dvp_left += (15 - (Q.workers_z || 0)) * 0.06;

// 6. Global regulation / cap
{
    const _dvp_total_cap = 500;
    const _dvp_tracked = ['dvp_left', 'dvp_right'];
    const _dvp_sum = _dvp_tracked.reduce((sum, key) => sum + Q[key], 0);

    if (_dvp_sum > _dvp_total_cap) {
        const _dvp_scale = _dvp_total_cap / _dvp_sum;
        Q.dvp_left *= _dvp_scale;
        Q.dvp_right *= _dvp_scale;
    }
}


// ==========================================
// DDP GAMEPLAY
// ==========================================

Q.business_wing_ddp = Q.business_wing_ddp || 370;
Q.social_republican_ddp = Q.social_republican_ddp || 130;

if (Q.stolper_adopted == 1) {
    Q.business_wing_ddp += 2.7;
    Q.social_republican_ddp -= 1.8;
} else if (Q.stolper_adopted == -1) {
    Q.business_wing_ddp -= 2.0;
    Q.social_republican_ddp += 2.5;
}

if (Q.congress_path == "social_nationalists") {
    Q.social_republican_ddp += 0.3;
}

if (Q.ddp_in_government) {
    if (Q.spd_in_government) {
        Q.social_republican_ddp += 1.5;
        Q.business_wing_ddp -= 0.5;
    } else {
        Q.business_wing_ddp += 1.2;
        Q.social_republican_ddp -= 0.8;
    }
} else {
    Q.business_wing_ddp += 1.8;
    Q.social_republican_ddp -= 1.2;
}

Q.social_republican_ddp += ((Q.ddp_relation || 0) / 8) * 0.35;
Q.business_wing_ddp += ((100 - (Q.ddp_relation || 0)) * 0.5) * 0.35;

if (Q.welfare <= 0) {
    Q.social_republican_ddp += Math.abs(Q.welfare || 0) * 0.85;
}

if (Q.workers_aid <= 0) {
    Q.social_republican_ddp += Math.abs(Q.workers_aid || 0) * 0.50;
}

if (Q.ideology == "reformist") Q.social_republican_ddp += 1.8;
if (Q.ideology == "labor") {
    Q.social_republican_ddp -= 1.28;
    Q.business_wing_ddp += 1.28;
}
if (Q.ideology == "left") {
    Q.business_wing_ddp += 2.45; 
    Q.social_republican_ddp -= 1.8;
}

if (Q.womens_rights > 0) Q.social_republican_ddp += 0.11 + Q.womens_rights;
if (Q.kwg_research > 0) Q.social_republican_ddp += 0.51 + Q.kwg_research;
if (Q.family_law > 0) Q.social_republican_ddp += 0.15 + Q.family_law;
if (Q.womens_work > 0) Q.social_republican_ddp += 0.10 + Q.womens_work;

if (Q.upper_tax_rates > 0) Q.business_wing_ddp += 0.57 * Q.upper_tax_rates;
if (Q.middle_tax_rates > 0) Q.business_wing_ddp += 1.11 * Q.middle_tax_rates;
if (Q.lower_tax_rates > 0) Q.social_republican_ddp += 0.38 * Q.lower_tax_rates;
if (Q.works_councils > 0) Q.business_wing_ddp += 1.12 * Q.works_councils;
if (Q.socialization > 0) Q.business_wing_ddp += 1.11 * Q.socialization;
if (Q.cooperatives > 0) Q.business_wing_ddp += 0.49 * Q.cooperatives;

if (Q.spd_r >= 30) {
    Q.business_wing_ddp -= 0.7;
    Q.social_republican_ddp += 0.7;
} else if (Q.spd_r >= 27.5) {
    Q.business_wing_ddp += 0.35;
    Q.social_republican_ddp += 0.35;
} else if (Q.spd_r <= 27.5 && Q.spd_r > 25) {
    Q.business_wing_ddp += 0.7;
    Q.social_republican_ddp -= 0.7;
} else { 
    Q.business_wing_ddp += 1.28;
    Q.social_republican_ddp -= 1.28;
}

Q.ddp_new_mid = Q.new_middle_ddp || 0;
Q.ddp_old_mid = Q.old_middle_ddp || 0;
Q.ddp_rural   = Q.rural_ddp || 0;
Q.ddp_workers = Q.workers_ddp || 0;
Q.ddp_unemp   = Q.unemployedc_ddp || 0;

Q.business_wing_ddp += (Q.ddp_new_mid + Q.ddp_old_mid + Q.ddp_rural) * 0.11;
Q.social_republican_ddp += (Q.ddp_workers + Q.ddp_unemp) * 0.33;

// Global regulation: cap combined total at 500
{
    const _ddp_total_cap = 500; 
    const _ddp_tracked = ['business_wing_ddp', 'social_republican_ddp'];
    const _ddp_sum = _ddp_tracked.reduce((sum, key) => sum + Q[key], 0);

    if (_ddp_sum > _ddp_total_cap) {
        const _ddp_scale = _ddp_total_cap / _ddp_sum;
        _ddp_tracked.forEach(key => {
            Q[key] *= _ddp_scale;
        });
    }
}




// ==========================================
// ZENTRUM (CENTER PARTY) INTERNAL DYNAMICS
// ==========================================

Q.z_clerical_power = Q.z_clerical_power || 250;
Q.z_left_labor_power = Q.z_left_labor_power || 250;
Q.z_right_labor_power = Q.z_right_labor_power || 200;
Q.z_moderate_power = Q.z_moderate_power || 300;

// 1. THE CONCORDAT & VATICAN INFLUENCE
// Historically, Pacelli's push for Catholic Action and the Prussian Concordat 
// sidelined lay labor leaders and favored clerical control under Kaas.
if (Q.prussian_concordat >= 1) {
    // With the Prussian Concordat signed, Kaas is historically vindicated but 
    // focuses on Rome, leaving a vacuum that splits the labor wings.
    Q.z_clerical_power -= 3.5;
    Q.z_right_labor_power += 3.8; 
    Q.z_moderate_power += 2.0;
} else if (Q.prussian_concordat_progress == 0) {
    // Ongoing negotiations and Vatican pressure boost clerical authority.
    Q.z_clerical_power += 3.5;
    Q.z_right_labor_power -= 1.8; 
} else if (Q.prussian_concordat_progress >= 1) {
    Q.z_clerical_power += 2.5;
    Q.z_left_labor_power += 1.0;
    Q.z_right_labor_power -= 0.8; // Vatican opposes Stegerwald's interconfessional plans

    Q.z_clerical_power -= 0.5 * Q.prussian_concordat_progress;
    Q.z_right_labor_power += 0.7 * Q.prussian_concordat_progress;
    Q.z_left_labor_power += 0.1 * Q.prussian_concordat_progress;
    Q.z_moderate_power += 0.1 * Q.prussian_concordat_progress;
}


if (Q.catholic_action_influence >= 1) {
    Q.z_clerical_power += 4.5;
    Q.z_left_labor_power -= 1.5;  // KAB is pressured to accept clerical supervision
    Q.z_right_labor_power -= 3.0; // Christian Unions (DGB) hate clerical interference
}

if (Q.ideology == "reformist") {
    Q.z_left_labor_power += 2.5;
    Q.z_moderate_power += 0.5;
    Q.z_right_labor_power += 1.0;
} else if (Q.ideology == "labor") {
    Q.z_left_labor_power -= 1.5;
    Q.z_right_labor_power += 1.0;
    Q.z_moderate_power += 1.5;
    Q.z_clerical_power += 1.5;
} else if (Q.ideology == "left") {
    Q.z_left_labor_power -= 3.5;
    Q.z_right_labor_power += 4.0;
    Q.z_moderate_power += 0.5;
    Q.z_clerical_power += 3.5;
}

if (Q.enemies == "bourgeois parties") {
    Q.z_right_labor_power += 3.0;
    Q.z_left_labor_power -= 3.0;
    Q.z_clerical_power += 1.0;
    Q.z_moderate_power += 1.2;
}

// 2. COALITION STATUS & SPD RELATIONS
// Joos and Brauns rely on a stable, cooperative relationship with the SPD.
// If relations sour or the SPD acts aggressively, the bourgeois base swings to Kaas/Stegerwald.

if (Q.z_relation >= 70) {
    let multiplier = Q.z_relation / 10; // e.g., 7.5 multiplier at 75 relation
    
    Q.z_left_labor_power += 3.0 * multiplier;
    Q.z_moderate_power += 1.5 * multiplier;
    Q.z_right_labor_power -= 2.0 * multiplier;

} else if (Q.z_relation < 70 && Q.z_relation >= 60) {

    let multiplier = (70 - Q.z_relation) / 10; // e.g., 0.5 multiplier at 65 relation
    if (multiplier < 0.1) multiplier = 0.1;   // Safety floor so it always triggers at least a tiny bit
    
    Q.z_clerical_power += 1.5 * multiplier;
    Q.z_right_labor_power += 1.5 * multiplier;
    Q.z_left_labor_power -= 1.0 * multiplier;
    Q.z_moderate_power += 1.0 * multiplier;

} else {

    let multiplier = (80 - Q.z_relation) / 10; // e.g., 6.0 multiplier at 20 relation
    
    Q.z_clerical_power += 1.5 * multiplier;
    Q.z_right_labor_power += 2.9 * multiplier;
    Q.z_left_labor_power -= 1.2 * multiplier;
    Q.z_moderate_power -= 0.5 * multiplier;
}


if (Q.spd_in_government && Q.z_in_government) {
    Q.z_moderate_power += 2.5;
    Q.z_left_labor_power += 1.5;
} else if (Q.z_in_government && !Q.spd_in_government) {
    Q.z_clerical_power += 1.0;
    Q.z_right_labor_power += 3.0;
    Q.z_left_labor_power -= 0.6;
    Q.z_moderate_power += 0.1;
} else {
    Q.z_clerical_power += 1.5;
    Q.z_left_labor_power -= 1.0;
    Q.z_moderate_power -= 1.5;
    Q.z_right_labor_power += 3.5;
}

// 3. SOCIAL POLICY & LABOR CONFLICTS
// The fight over Welfare defines the labor split.
const welfare_val = Q.welfare || 0;
if (welfare_val > 0) {
    Q.z_left_labor_power += 1.5 * welfare_val;
    Q.z_moderate_power += 2.0 * welfare_val; // Validates Brauns' welfare-state legacy
} else if (welfare_val < 0) {
    // Austerity triggers union militancy, but also a defensive bourgeois backlash
    Q.z_right_labor_power += 3.5 * Math.abs(welfare_val);
    Q.z_clerical_power += 1.5 * Math.abs(welfare_val);
    Q.z_moderate_power -= 2.5 * Math.abs(welfare_val);
}

if (Q.unions_independent) {
    // ADBG unions strengthen the lay DGB wing
    Q.z_right_labor_power += 6.0;
    Q.z_left_labor_power += 2.5;
}

if (Q.lambach_exile == 0 && (Q.year >= 1928 && Q.month >= 7) && Q.year < 1930) {
    Q.z_left_labor_power += 1.0;
    Q.z_right_labor_power += 5.7;
    Q.z_moderate_power -= 1.5;
    Q.z_clerical_power -= 2.7;
}

if (Q.congress_path == "social_nationalists" && Q.year < 1930) {
    Q.z_left_labor_power += 2.5;
    Q.z_right_labor_power += 12;
    Q.z_moderate_power -= 1.5;
    Q.z_clerical_power -= 3.5;
}

// 4. THE CULTURE WAR (Secularization Threat)
// Nothing unites and radicalizes Zentrum like threats to religious schools.
// High secularization efforts by the SPD trigger a massive clerical backlash.
if (Q.secularized == 1 || Q.major_curriculum == "scientific") {
    Q.z_clerical_power += 5.5;    // Defensive Catholic mobilization
    Q.z_left_labor_power -= 4.0;  // Socialists' "allies" are blamed for cultural betrayal
    Q.z_moderate_power -= 2.0;
}

// 5. DEMOGRAPHICS & CLASS TENSIONS
// Center's internal delegate power is heavily swayed by voter class composition.
const workers_z = Q.workers_z_display || 0;
const rural_z = Q.rural_z_display || 0;
const old_middle_z = Q.old_middle_z_display || 0;
const new_middle_z = Q.new_middle_z_display || 0;

Q.z_left_labor_power += (workers_z * 0.50) + (new_middle_z * 0.18);
Q.z_right_labor_power += (workers_z * 0.48) + (new_middle_z * 0.05);

Q.z_clerical_power += (rural_z * 0.35) + (old_middle_z * 0.25);
Q.z_moderate_power += (new_middle_z * 0.40) + (old_middle_z * 0.15);

// Bourgeois Backlash: Historically, civil servants and academics feared Stegerwald 
// would turn Zentrum into a "workers' party." High middle-class representation suppresses him.
if (new_middle_z > 20 || old_middle_z > 25) {
    Q.z_right_labor_power -= 3.5;
    Q.z_clerical_power += 2.0;
} else {
    Q.z_right_labor_power += workers_z * 0.15;
    Q.z_left_labor_power += workers_z * 0.07;
}

// 6. GLOBAL REGULATION: Cap combined total of all 4 tracked variables at 1000
{
    const _z_total_cap = 1000;
    const _z_tracked = [
        'z_clerical_power',
        'z_left_labor_power',
        'z_right_labor_power',
        'z_moderate_power'
    ];

    const _z_sum = _z_tracked.reduce((sum, key) => sum + Q[key], 0);

    if (_z_sum > _z_total_cap) {
        const _z_scale = _z_total_cap / _z_sum;
        _z_tracked.forEach(key => {
            Q[key] *= _z_scale;
        });
    }
}

if (Q.z_party_leader == "Joseph Joos") {

    // Right labor always counts fully toward the anti-Joos bloc
    let vonc_score = Q.z_right_labor_power;

    const relation = Q.z_relation != null ? Q.z_relation : 50;
    const relation_deficit = Math.max(0, 70 - relation) / 70; // 0 to 1
    const clerical_weight = Math.pow(relation_deficit, 2);    // exponential curve

    vonc_score += Q.z_clerical_power * clerical_weight;

    const threshold_floor = 450;
    const threshold_ceiling = 600;
    const vonc_threshold = threshold_ceiling - (relation_deficit * (threshold_ceiling - threshold_floor));

    if (vonc_score >= vonc_threshold) {
        Q.z_vonc_triggered = 1;
    }
}






































if (Q.ruhr_labor_strike == 1) {

Q.socialism += 1 * Q.general_strike_progress;
Q.nationalism += 1 * Q.capital_strike_progress;

// --- workers vs employers ---
Q.ruhr_workers = Q.workers / 6.5;
Q.ruhr_worker_rfb = Q.ruhr_workers * 0.80;
Q.ruhr_worker_rb  = Q.ruhr_workers * 0.15;
Q.ruhr_worker_unaligned = Q.ruhr_workers * 0.05;
Q.ruhr_worker_force = Q.ruhr_workers * 0.70;

Q.ruhr_rfb_effective = Q.rfb_strength * Q.rfb_militancy * 0.25;

Q.ruhr_employer_base = Q.old_middle / 18;
Q.ruhr_employer_force = Q.ruhr_employer_base * 0.30;
Q.ruhr_sa_backing = Q.sa_strength * Q.sa_militancy;
Q.ruhr_sh_backing = Q.sh_strength * Q.sh_militancy;
Q.ruhr_employer_total = Q.ruhr_employer_force + Q.ruhr_sa_backing + Q.ruhr_sh_backing;

// --- reichswehr deployment ---
Q.reichswehr_strength_ruhr = 5;
Q.ruhr_reichswehr_effective = Q.reichswehr_strength_ruhr * 1000 * (Q.reichswehr_militancy / 100);
Q.ruhr_rw_loyal = Q.ruhr_reichswehr_effective * (Q.reichswehr_loyalty || 0.5);
Q.ruhr_rw_order = Q.ruhr_reichswehr_effective - Q.ruhr_rw_loyal;

// --- FAUD / KAPD ---
Q.ruhr_faud_effective = (Q.ruhr_faud_strength || 0) * (Q.ruhr_faud_militancy || 0);
Q.ruhr_kapd_effective = (Q.ruhr_kapd_strength || 0) * (Q.ruhr_kapd_militancy || 0);

// --- ideology bonus, shared by RB-split and independent-worker calcs ---
Q.ruhr_left_ideology_bonus = (Q.ideology == "left") ? 1.5 : 1.0;

// --- Reichsbanner split toward left camp, scaled by left_strength (1-99) + ideology bonus ---
Q.ruhr_rb_effective = Q.rb_strength * Q.rb_militancy;
Q.ruhr_rb_to_left_pct = Math.min(1, ((Q.left_strength || 1) / 99) * Q.ruhr_left_ideology_bonus * 0.5);
Q.ruhr_rb_to_left = Q.ruhr_rb_effective * Q.ruhr_rb_to_left_pct;
Q.ruhr_rb_remaining = Q.ruhr_rb_effective - Q.ruhr_rb_to_left;

// --- independent worker share: 1-5% of left_strength (1-99), capped 20%, ideology bonus ---
Q.ruhr_worker_independent_pct = Math.min(0.20, ((Q.left_strength || 1) / 99) * 0.08 * Q.ruhr_left_ideology_bonus);
Q.ruhr_worker_independent = Q.ruhr_workers * Q.ruhr_worker_independent_pct;

// --- left camp: KAPD + FAUD + RFB + RB(split-in) + independent workers ---
Q.ruhr_camp_left = Q.ruhr_kapd_effective
                  + Q.ruhr_faud_effective
                  + Q.ruhr_rfb_effective
                  + Q.ruhr_rb_to_left
                  + Q.ruhr_worker_independent;

// --- republic camp: national Reichswehr(loyalty-weighted) + remaining RB + negligible Jungdo ---
Q.ruhr_jungdo_effective = (Q.jungdo_strength || 0) * 0.01;
Q.ruhr_camp_republic = (Q.reichswehr_strength * (Q.reichswehr_loyalty || 0.5) * Q.reichswehr_militancy)
                      + Q.ruhr_rb_remaining
                      + Q.ruhr_jungdo_effective;

// --- right camp: disloyal Reichswehr(Ruhr-deployed) + SA + SH + employers ---
Q.ruhr_employer_share = Q.ruhr_employer_base * 0.30;
Q.ruhr_camp_right = Q.ruhr_rw_order
                   + Q.ruhr_sa_backing
                   + Q.ruhr_sh_backing
                   + Q.ruhr_employer_share;


if (Q.rfb_banned == 1) {
    Q.ruhr_faud_militancy += 0.001;
    Q.ruhr_kapd_militancy += 0.0005;
    Q.sa_strength += 5;
    if (Q.left_dissent < 50) Q.left_dissent += 2;
}

if (Q.sh_banned == 1) {
    Q.sa_strength += 30;
    Q.sa_militancy += 0.005;
}

if (Q.general_strike_progress > 0) {
    if (!Q.rfb_banned) {
        Q.rfb_strength += 3 * Q.general_strike_progress;
        Q.rfb_militancy += 0.0009 * (Q.general_strike_progress * 0.5)
    } else {
        Q.ruhr_faud_militancy += 0.00085 * (Q.general_strike_progress * 0.5);
        Q.ruhr_kapd_militancy += 0.0005 * (Q.general_strike_progress * 0.5);
    }
}

// --- RFB defection to KAPD/FAUD: redistribution, not free growth ---
Q.ruhr_rfb_defection_rate = 0.02
    + (Q.rfb_banned == 1 ? 0.015 : 0)
    + (Q.general_strike_progress > 0 ? 0.005 * Q.general_strike_progress : 0);

Q.ruhr_rfb_defection = Math.min(Q.rfb_strength * Q.ruhr_rfb_defection_rate, Q.rfb_strength);
Q.rfb_strength -= Q.ruhr_rfb_defection;

Q.ruhr_defection_kapd_share = (Q.ruhr_kapd_militancy || 0) /
    (((Q.ruhr_kapd_militancy || 0) + (Q.ruhr_faud_militancy || 0)) || 1);

Q.ruhr_kapd_strength += Q.ruhr_rfb_defection * Q.ruhr_defection_kapd_share;
Q.ruhr_faud_strength += Q.ruhr_rfb_defection * (1 - Q.ruhr_defection_kapd_share);

if (Q.left_split) {
    Q.rfb_strength += (Q.workers_spd * Q.left_dissent) * 0.01;
}

}





















// === DOMINANT PARTY BACKLASH + IDEOLOGICAL AFFINITY DRIFT ===
// Two opposite relation mechanics, run together each tick, both damped by
// SPEED so changes accrue gradually instead of landing all at once.

Q.relation_dynamics_speed = 0.25;

// --- dominant_party_backlash (inlined) ---
{
    var THRESHOLD = 30;
    var MAX_VOTE = 100;
    var MAX_SHIFT = 28;
    var SPEED = Q.relation_dynamics_speed;
    var MAX_DIST = 20;

    for (var i = 0; i < Q.parties.length; i++) {
        var dom = Q.parties[i];
        var domVotes = Q[dom + '_votes'] || 0;
        if (domVotes <= THRESHOLD) continue;

        var t = Math.min(1, (domVotes - THRESHOLD) / (MAX_VOTE - THRESHOLD));
        var severity = Math.pow(t, 1.5);

        var domIdeo = Q[dom + '_ideo_score'] !== undefined ? Q[dom + '_ideo_score'] : 10;

        if (dom !== 'spd') {
            var spdIdeo = Q['spd_ideo_score'] !== undefined ? Q['spd_ideo_score'] : 10;
            var spdIdeoDist = Math.abs(spdIdeo - domIdeo) / MAX_DIST;
            var spdDecay = Math.max(0, Math.min(1, severity * spdIdeoDist));

            var spdRelKey = dom + '_relation';
            if (Q[spdRelKey] !== undefined) {
                Q[spdRelKey] -= spdDecay * MAX_SHIFT * SPEED;
            }
        }

        for (var j = 0; j < Q.parties.length; j++) {
            var other = Q.parties[j];
            if (other === dom || other === 'spd') continue;

            var otherIdeo = Q[other + '_ideo_score'] !== undefined ? Q[other + '_ideo_score'] : 10;
            var ideoDist = Math.abs(otherIdeo - domIdeo) / MAX_DIST;
            var decay = Math.max(0, Math.min(1, severity * ideoDist));

            if (Q.party_relations[other.toUpperCase()] &&
                Q.party_relations[other.toUpperCase()][dom.toUpperCase()] !== undefined) {
                Q.party_relations[other.toUpperCase()][dom.toUpperCase()] -= decay * MAX_SHIFT * SPEED;
            }
        }
    }
}

// --- ideological_affinity_drift (inlined) ---
{
    var MAX_GAIN = 1;
    var CLOSE_RANGE = 7;
    var SPEED = Q.relation_dynamics_speed;

    var spdIdeo = Q['spd_ideo_score'] !== undefined ? Q['spd_ideo_score'] : 10;

    for (var i = 0; i < Q.parties.length; i++) {
        var p = Q.parties[i];
        if (p === 'spd') continue;

        var pIdeo = Q[p + '_ideo_score'] !== undefined ? Q[p + '_ideo_score'] : 10;
        var dist = Math.abs(spdIdeo - pIdeo);
        var closeness = Math.max(0, 1 - (dist / CLOSE_RANGE));
        var gain = closeness * closeness * closeness * MAX_GAIN;

        var relKey = p + '_relation';
        if (Q[relKey] !== undefined) {
            Q[relKey] += gain * SPEED;
        }
    }

    for (var i = 0; i < Q.parties.length; i++) {
        var a = Q.parties[i];
        if (a === 'spd') continue;
        var aIdeo = Q[a + '_ideo_score'] !== undefined ? Q[a + '_ideo_score'] : 10;

        for (var j = 0; j < Q.parties.length; j++) {
            var b = Q.parties[j];
            if (b === a || b === 'spd') continue;
            var bIdeo = Q[b + '_ideo_score'] !== undefined ? Q[b + '_ideo_score'] : 10;

            var dist2 = Math.abs(aIdeo - bIdeo);
            var closeness2 = Math.max(0, 1 - (dist2 / CLOSE_RANGE));
            var gain2 = closeness2 * closeness2 * closeness2 * MAX_GAIN;

            if (Q.party_relations[a.toUpperCase()] &&
                Q.party_relations[a.toUpperCase()][b.toUpperCase()] !== undefined) {
                Q.party_relations[a.toUpperCase()][b.toUpperCase()] += gain2 * SPEED;
            }
        }
    }
}










// ============================================================
// PASSIVE BUDGET
// ============================================================

Q.upper_tax_rates  = Q.upper_tax_rates || 0;
Q.middle_tax_rates = Q.middle_tax_rates || 0;
Q.lower_tax_rates  = Q.lower_tax_rates || 0;
Q.tariffs          = Q.tariffs || 0;

const TAX_YIELD_SCALE = 0.06;
const UPKEEP_SCALE    = 0.045;

// ============================================================
// PHASE / MACRO LINKAGE
// ============================================================

const PHASE_REVENUE_MULT = {
    growth:         1.10,
    overheating:    1.20,
    correction:     0.90,
    stagflation:    0.75,
    depression:     0.55,
    hyperinflation: 0.35  
};
let phase_revenue_mult = PHASE_REVENUE_MULT[Q.phase] || 1.0;


const PHASE_UPKEEP_MULT = {
    growth:         0.90,
    overheating:    1.05,
    correction:     1.10,
    stagflation:    1.30,
    depression:     1.45,
    hyperinflation: 1.75   
};
let phase_upkeep_mult = PHASE_UPKEEP_MULT[Q.phase] || 1.0;

// --- Unemployment drag ---
let unemp_excess       = Math.max(0, (Q.unemployed || 0) - 6);
let unemp_revenue_mult = Math.max(0.5, 1 - unemp_excess * 0.015);
let unemp_upkeep_mult  = 1 + unemp_excess * 0.02;

// --- Inflation effect ---
let infl = Q.inflation || 0;
let inflation_revenue_mult, inflation_upkeep_mult;
if (infl <= 4) {
    inflation_revenue_mult = 1 + Math.max(0, infl) * 0.02;
    inflation_upkeep_mult  = 1 + Math.max(0, infl) * 0.01;
} else {
    let over = infl - 4;
    inflation_revenue_mult = Math.max(0.25, 1.08 - over * 0.035);
    inflation_upkeep_mult  = 1.04 + over * 0.03;
}

// --- Growth effect (revenue only; upkeep is largely growth-insensitive) ---
let growth_revenue_mult = Math.max(0.6, 1 + (Q.economic_growth || 0) * 0.03);

// Combined macro multipliers, applied once to each side's total below
let macro_revenue_mult = phase_revenue_mult * unemp_revenue_mult * inflation_revenue_mult * growth_revenue_mult;
let macro_upkeep_mult  = phase_upkeep_mult  * unemp_upkeep_mult  * inflation_upkeep_mult;

// --- REVENUE SIDE ---
// NERF PASS: per-source multipliers also cut roughly in half from the
// originals (1.2 -> 0.5 lower-bracket, 0.8 -> 0.35 tariff) so the
// reduction isn't coming only from the shared base scale above.

// Upper-bracket revenue: diminishing returns + capital strike sabotage
let upper_yield = Q.upper_tax_rates * TAX_YIELD_SCALE;
if (Q.upper_tax_rates > 3) {
    upper_yield *= Math.max(0.4, 1 - (Q.upper_tax_rates - 3) * 0.12);
}
if (Q.capital_strike_progress > 0) {
    upper_yield *= Math.max(0.3, 1 - Q.capital_strike_progress * 0.08);
}

let middle_yield = Q.middle_tax_rates * TAX_YIELD_SCALE * 0.75;
if (Q.capital_strike_progress > 0) {
    middle_yield *= Math.max(0.3, 1 - Q.capital_strike_progress * 0.04);
}
if (Q.general_strike_progress > 0) {
    middle_yield *= Math.max(0.3, 1 - Q.general_strike_progress * 0.04);
}

// Lower-bracket revenue: broad base, reliable
let lower_yield = Q.lower_tax_rates * TAX_YIELD_SCALE * 0.5;

if (Q.general_strike_progress > 0) {
    lower_yield *= Math.max(0.3, 1 - Q.general_strike_progress * 0.08);
}

// Tariff revenue: shrinks with contraction and retaliation at high levels
let tariff_yield = Q.tariffs * TAX_YIELD_SCALE * 0.35;
if (Q.economic_growth < 0) {
    tariff_yield *= Math.max(0.5, 1 + Q.economic_growth * 0.05);
}
if (Q.tariffs > 3) {
    tariff_yield *= Math.max(0.5, 1 - (Q.tariffs - 3) * 0.1);
}

Q.fiscal_revenue = (upper_yield + middle_yield + lower_yield + tariff_yield) * macro_revenue_mult;


// --- UPKEEP SIDE ---
// Every enacted program from Agricultural Policy, Economic Democracy,
// Social Welfare, and Education & Science costs ongoing budget to
// maintain, scaled down since it fires every tick (vs. the one-time
// enactment cost).

let welfare_upkeep       = Math.max(0, Q.welfare || 0)          * UPKEEP_SCALE * 0.55;
let land_upkeep          = (Q.land_reform || 0)                  * UPKEEP_SCALE * 0.25;
let agri_fin_upkeep      = (Q.agricultural_finance || 0)         * UPKEEP_SCALE * 0.40;
let pro_consumer_upkeep  = (Q.pro_consumer || 0)                 * UPKEEP_SCALE * 0.35;
let state_buyer_upkeep   = (Q.state_buyer ? 1 : 0)                * UPKEEP_SCALE * 0.85;
let socialization_upkeep = (Q.socialization || 0)                 * UPKEEP_SCALE * 0.65;
let coop_upkeep          = (Q.cooperatives || 0)                  * UPKEEP_SCALE * 0.20;
let commonwealth_upkeep  = (Q.commonwealth_cooperation || 0)      * UPKEEP_SCALE * 0.30;
let econ_dem_upkeep      = (Q.economic_democracy || 0)            * UPKEEP_SCALE * 0.15;
let safety_upkeep        = (Q.workers_safety || 0)                * UPKEEP_SCALE * 0.10;
let police_upkeep        = (Q.prussian_police_strength || 0)             * UPKEEP_SCALE * 0.006;

let edu_science_upkeep    = (Q.education_science || 0)            * UPKEEP_SCALE * 0.10;
let school_boards_upkeep  = (Q.school_boards || 0)                * UPKEEP_SCALE * 0.05;
let public_hs_upkeep      = (Q.public_hs || 0)                    * UPKEEP_SCALE * 0.35;
let medical_research_upkeep = (Q.medical_research || 0)           * UPKEEP_SCALE * 0.40;
let applied_research_upkeep = (Q.applied_research || 0)           * UPKEEP_SCALE * 0.40;
let science_upkeep        = (Q.science || 0)                      * UPKEEP_SCALE * 0.10;
let kwg_research_upkeep   = (Q.kwg_research || 0)                 * UPKEEP_SCALE * 0.30;

Q.fiscal_upkeep = (welfare_upkeep + land_upkeep + agri_fin_upkeep + pro_consumer_upkeep
                + state_buyer_upkeep + socialization_upkeep + coop_upkeep
                + commonwealth_upkeep + econ_dem_upkeep + safety_upkeep
                + edu_science_upkeep + school_boards_upkeep + public_hs_upkeep
                + medical_research_upkeep + applied_research_upkeep + science_upkeep
                + kwg_research_upkeep + police_upkeep) * macro_upkeep_mult;

Q.budget += Q.fiscal_revenue - Q.fiscal_upkeep;
Q.budget = Math.round(Q.budget * 100) / 100;

// ============================================================

const DIRECT_MACRO_SCALE = 0.01; // global dial for this whole block

let growth_gap_effect = Math.max(-0.25, Math.min(0.25, (Q.economic_growth - 2.5) * 0.15));

let unemployment_drag_direct = -Math.max(0, Math.min(0.5, ((Q.unemployed || 0) - 6) * 0.03));

let inflation_drift = Q.inflation - 2.5;
let inflation_effect_direct = 0;
if (inflation_drift > 0) {
    inflation_effect_direct = -Math.min(0.5, inflation_drift * 0.02);
} else if (Q.inflation < -2) {
    inflation_effect_direct = -Math.min(0.3, Math.abs(Q.inflation + 2) * 0.015);
}

let direct_macro_delta = (growth_gap_effect + unemployment_drag_direct + inflation_effect_direct) * DIRECT_MACRO_SCALE * 100;
direct_macro_delta = Math.max(-1.0, Math.min(1.0, direct_macro_delta));

Q.budget += direct_macro_delta;
Q.budget = Math.round(Q.budget * 100) / 100;

// budget_audit must exist BEFORE anything writes into it
Q.budget_audit = Q.budget_audit || {};

Q.budget_audit.direct_growth_effect      = Math.round(growth_gap_effect * DIRECT_MACRO_SCALE * 100 * 100) / 100;
Q.budget_audit.direct_unemployment_drag  = Math.round(unemployment_drag_direct * DIRECT_MACRO_SCALE * 100 * 100) / 100;
Q.budget_audit.direct_inflation_effect   = Math.round(inflation_effect_direct * DIRECT_MACRO_SCALE * 100 * 100) / 100;
Q.budget_audit.direct_macro_delta        = Math.round(direct_macro_delta * 100) / 100;

Q.budget_audit.income_upper_tax   = Math.round(upper_yield  * macro_revenue_mult * 100) / 100;
Q.budget_audit.income_middle_tax  = Math.round(middle_yield * macro_revenue_mult * 100) / 100;
Q.budget_audit.income_lower_tax   = Math.round(lower_yield  * macro_revenue_mult * 100) / 100;
Q.budget_audit.income_tariffs     = Math.round(tariff_yield * macro_revenue_mult * 100) / 100;
Q.budget_audit.income_total       = Math.round(Q.fiscal_revenue * 100) / 100;

Q.budget_audit.expense_welfare       = Math.round(welfare_upkeep       * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_land_reform   = Math.round(land_upkeep          * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_agri_finance  = Math.round(agri_fin_upkeep      * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_pro_consumer  = Math.round(pro_consumer_upkeep  * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_state_buyer   = Math.round(state_buyer_upkeep   * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_socialization = Math.round(socialization_upkeep* macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_cooperatives  = Math.round(coop_upkeep          * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_commonwealth  = Math.round(commonwealth_upkeep * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_econ_dem      = Math.round(econ_dem_upkeep      * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_safety        = Math.round(safety_upkeep        * macro_upkeep_mult * 100) / 100;

Q.budget_audit.expense_police        = Math.round(police_upkeep * macro_upkeep_mult * 100) / 100;

Q.budget_audit.expense_education_science  = Math.round(edu_science_upkeep      * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_school_boards      = Math.round(school_boards_upkeep    * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_public_hs          = Math.round(public_hs_upkeep        * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_medical_research   = Math.round(medical_research_upkeep * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_applied_research   = Math.round(applied_research_upkeep * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_science            = Math.round(science_upkeep          * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_kwg_research       = Math.round(kwg_research_upkeep     * macro_upkeep_mult * 100) / 100;

Q.budget_audit.expense_total         = Math.round(Q.fiscal_upkeep * 100) / 100;

// --- NET / MULTIPLIER CONTEXT ---
// net_change now includes the direct macro nudge so it reflects the TRUE total budget movement this tick
Q.budget_audit.net_change      = Math.round((Q.fiscal_revenue - Q.fiscal_upkeep + direct_macro_delta) * 100) / 100;
Q.budget_audit.macro_rev_mult  = Math.round(macro_revenue_mult * 1000) / 1000;
Q.budget_audit.macro_upk_mult  = Math.round(macro_upkeep_mult  * 1000) / 1000;
Q.budget_audit.upper_tax_rate  = Q.upper_tax_rates || 0;
Q.budget_audit.middle_tax_rate = Q.middle_tax_rates || 0;
Q.budget_audit.lower_tax_rate  = Q.lower_tax_rates || 0;
Q.budget_audit.tariff_rate     = Q.tariffs || 0;
Q.budget_audit.phase           = Q.phase;

if (Q.budget_audit.net_change < 0) {
    Q.budget_audit.deficit_tick_streak = (Q.budget_audit.deficit_tick_streak || 0) + 1;
} else {
