// --- reformist_relation_pull ---

if (Q.ideology == "reformist") {
    var BASE_GAIN = 0.5;
    var SPEED = Q.relation_dynamics_speed;

    for (var i = 0; i < Q.parties.length; i++) {
        var p = Q.parties[i];
        if (p === 'spd') continue;

        var pIdeo = Q[p + '_ideo_score'] !== undefined ? Q[p + '_ideo_score'] : 10;
        if (pIdeo < 8 || pIdeo > 15) continue;

        var relKey = p + '_relation';
        if (Q[relKey] === undefined) continue;

        var distFrom50 = Math.abs(Q[relKey] - 50);
        var falloff = Math.max(0, Math.min(1, distFrom50 / 50));

        Q[relKey] += BASE_GAIN * falloff * SPEED;
    }
}




// DUES' impact on dissent
Q.dissent_cap = 59.9;

function applyDuesDissent(rate, threshold, gain, dissentKey) {
    var diff = rate - threshold;
    var delta = diff * gain;

    if (delta > 0) {
        
        if (Q[dissentKey] < Q.dissent_cap) {
            Q[dissentKey] = Math.min(Q.dissent_cap, Q[dissentKey] + delta);
        }
    } else if (delta < 0) {
        
        if (Q[dissentKey] > 0) {
            Q[dissentKey] = Math.max(0, Q[dissentKey] + delta);
        }
    }
}

applyDuesDissent(Q.dues_workers,     2, 0.3, 'labor_dissent');
applyDuesDissent(Q.dues_unemployedc, 1, 0.5, 'left_dissent');
applyDuesDissent(Q.dues_new_middle,  2, 0.3, 'reformist_dissent');
applyDuesDissent(Q.dues_old_middle,  2, 0.3, 'center_dissent');
applyDuesDissent(Q.dues_rural,       2, 0.3, 'neorevisionist_dissent');













