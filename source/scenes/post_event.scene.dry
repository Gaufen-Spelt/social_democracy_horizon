    Q.delegate_power_christsoc += 0.4;
    Q.delegate_power_yocon += 0.2;
} else if (Q.lambach_exile == 0 && Q.lambach_momentum == 1) {
    Q.delegate_power_christsoc += 5.9;   // DHV vindicated
    Q.delegate_power_yocon += 2.3;
} else {
    Q.hugenberg_momentum += 0.4;         // Reduced from 1.9
}

// 2. Track Destabilization Crises (1928+)
let dnvp_crises = 0;

// Crisis A: CNBL Crisis
if (Q.year >= 1928 && Q.month >= 3) {
    if (Q.cnbl_crisis == 1) {
        dnvp_crises++;
    } else {
        Q.delegate_power_nat_cons += 1.2;
        Q.delegate_power_agrarians += 0.5;
        Q.delegate_power_yocon += 0.8;
        Q.delegate_power_christsoc += 0.5;
    }
}

// Crisis B: Jungdo Split
if (Q.year >= 1928 && Q.month >= 3) {
    if (Q.jungdo_formed != 0) {
        dnvp_crises++;
        Q.delegate_power_nat_cons += 2.0;
    } else {
        Q.delegate_power_yocon += 0.5;    
        Q.delegate_power_christsoc += 1.4;
        Q.delegate_power_moderates += 0.5;
    }
}

// Crisis C: Geest Wildfire
if (Q.year >= 1928 && Q.month >= 1) {
    if (Q.geest_wildfire == 1) {
        dnvp_crises++;
        Q.delegate_power_yocon += 1.5;    
        Q.delegate_power_christsoc += 1.1;
        Q.delegate_power_moderates += 0.3;
        Q.delegate_power_nat_cons -= 0.6;
        Q.delegate_power_agrarians -= 0.4;
    } else {
        Q.delegate_power_yocon += 1.3;
        Q.delegate_power_christsoc += 1.2;
        Q.delegate_power_moderates += 1.8;
        Q.delegate_power_nat_cons += 0.6;
        Q.delegate_power_agrarians += 0.5;
        Q.hugenberg_momentum -= 1.2; // Moderates contain him if no wildfire
    }
}

// Apply Tiered Stacking: [0 Crises: 0.0, 1 Crisis: 1.2, 2 Crises: 5.5, 3 Crises: 12.0]
const crisis_momentum_tiers = [0.0, 1.2, 5.5, 12.0];
Q.hugenberg_momentum += crisis_momentum_tiers[dnvp_crises];

// 3b. Media Dominance Check
if (Q.commercialized_media >= 1 || Q.radio >= 1) {
    Q.hugenberg_momentum -= 2.0;
}

if (Q.hugenberg_media_attack >= 1) {
    Q.hugenberg_momentum -= 10.0;
}

// 3c. Land Reform Threat (Nerfed multiplier from 4.0 to 2.0)
if (Q.land_reform > 0) {
    Q.hugenberg_momentum += 2.0 * Q.land_reform;
    Q.delegate_power_agrarians += 3.0 * Q.land_reform; 
}

// 3d. Government Participation Bonus
if (Q.dnvp_in_government) {
    Q.delegate_power_moderates += 4.4;
    Q.delegate_power_nat_cons += 2.0;
    Q.delegate_power_yocon += 2.2;
    Q.delegate_power_christsoc += 1.8;
}

// Ideology Adjustments (Tuned Hugenberg gains down)
if (Q.ideology == "reformist") {
    Q.delegate_power_moderates -= 0.3;
    Q.delegate_power_nat_cons -= 0.3;
    Q.delegate_power_yocon -= 0.1;
    Q.delegate_power_christsoc += 0.8;
    Q.hugenberg_momentum -= 0.3;
}
if (Q.ideology == "labor") {
    Q.delegate_power_christsoc -= 0.5;
    Q.delegate_power_moderates += 0.3;
    Q.delegate_power_nat_cons += 0.3;
    Q.delegate_power_yocon += 0.3;
    Q.hugenberg_momentum += 0.0;
}
if (Q.ideology == "left") {
    Q.hugenberg_momentum += 0.4;       // Reduced from 1.0
    Q.delegate_power_moderates += 0.5;
    Q.delegate_power_nat_cons -= 1.2;
    Q.delegate_power_yocon += 0.5;
    Q.delegate_power_christsoc -= 0.5;
}

if (Q.welfare < 0) Q.delegate_power_christsoc += 2.5 * Math.abs(Q.welfare);

if (Q.unions_independent) Q.delegate_power_christsoc *= 1.06;

if (Q.lambach_stage >= 2) {
    Q.delegate_power_christsoc += 80;
    Q.hugenberg_momentum *= 0.1;
}

// Tariffs 
if (Q.tariffs < 0) {
    Q.delegate_power_agrarians -= 2.5 * Q.tariffs;
}

// 4. Class Influence (Nerfed Hugenberg's passive demographic scaling)
Q.hugenberg_momentum += ((Q.old_middle_dnvp_pct || 0) * 0.14); // Reduced from 0.27
Q.hugenberg_momentum += ((Q.rural_dnvp_pct || 0) * 0.08);      // Reduced from 0.17

Q.delegate_power_moderates += ((Q.new_middle_dnvp_pct || 0) * 0.32);
Q.delegate_power_moderates += ((Q.old_middle_dnvp_pct || 0) * 0.11);

Q.delegate_power_nat_cons += ((Q.rural_dnvp_pct || 0) * 0.05);
Q.delegate_power_nat_cons += ((Q.old_middle_dnvp_pct || 0) * 0.08);

Q.delegate_power_agrarians += ((Q.rural_dnvp_pct || 0) * 0.25);

Q.delegate_power_yocon += ((Q.workers_dnvp_pct || 0) * 0.16) + ((Q.new_middle_dnvp_pct || 0) * 0.25) + ((Q.old_middle_dnvp_pct || 0) * 0.06);
Q.delegate_power_christsoc += ((Q.workers_dnvp_pct || 0) * 0.6) + ((Q.new_middle_dnvp_pct || 0) * 0.33);

// 5. Ideological Reinforcements (Major nerf to passive nationalism scaling)
Q.hugenberg_momentum += Q.nationalism * 1.2; // Reduced from 4.0
Q.delegate_power_nat_cons += Q.nationalism * 0.13 * Q.pro_republic * 0.1;
Q.delegate_power_moderates += Q.pro_republic * 0.034 + Q.nationalism * 0.056;
Q.delegate_power_yocon += Q.pro_republic * 0.25;
Q.delegate_power_christsoc += Q.socialism * 0.28 + Q.pro_republic * 0.12;

// 6. Failure Penalty (Tuned down Hugenberg's default low-vote cushion)
let votes = Math.max(10, Math.min(20, Q.dnvp_pct || 12));

Q.delegate_power_moderates += Math.max(-2.0, Math.min(1.5, -2.0 + (votes - 12) * 0.58));
Q.delegate_power_nat_cons += Math.max(-2.0, Math.min(-0.4, -2.0 + (votes - 12) * 0.23));

// Hugenberg baseline low-vote gain nerfed from +3.0 max down to +0.8 max
Q.hugenberg_momentum += Math.max(-1.5, Math.min(0.8, 0.8 - (votes - 12) * 0.60));

Q.delegate_power_yocon += Math.max(0.0, Math.min(2.3, (votes - 12) * 0.38));
Q.delegate_power_christsoc += Math.max(0.0, Math.min(2.0, (votes - 12) * 0.33));

// 6b. Traditionalist umbrella aggregation
Q.delegate_power_traditionalists =
    Q.delegate_power_moderates + Q.delegate_power_nat_cons + Q.delegate_power_agrarians;

// 7. Global regulation: cap combined total of all tracked vars at 1000
{
    const _dnvp_total_cap = 1000;
    const _dnvp_tracked = [
        'hugenberg_momentum',
        'delegate_power_moderates',
        'delegate_power_nat_cons',
        'delegate_power_agrarians',
        'delegate_power_yocon',
        'delegate_power_christsoc'
    ];

    const _dnvp_sum = _dnvp_tracked.reduce((sum, key) => sum + Q[key], 0);

    if (_dnvp_sum > _dnvp_total_cap) {
        const _dnvp_scale = _dnvp_total_cap / _dnvp_sum;
        _dnvp_tracked.forEach(key => {
            Q[key] *= _dnvp_scale;
        });
        Q.delegate_power_traditionalists =
            Q.delegate_power_moderates + Q.delegate_power_nat_cons + Q.delegate_power_agrarians;
    }
}


// Moderates Leader (Coalitionists)
if ((Q.rural_dnvp_pct + Q.old_middle_dnvp_pct / 3) > 36 || Q.cnbl_crisis == 0) {
    Q.leader_moderates = "Friedrich Winckler";
    Q.leader_moderates_title = "Leader of the Prussian Landtag Delegation";
} else {
    Q.leader_moderates = "Oskar Hergt";
    Q.leader_moderates_title = "Former Party Chairman";
}

// National Conservatives Leader (Aristocrats)
if (Q.lambach_reinstated == 1 || Q.dnvp_pct > 18.4) {
    Q.leader_nat_cons = "Kuno von Westarp";
    Q.leader_nat_cons_title = "Incumbent Party Chairman";
} else {
    Q.leader_nat_cons = "Walter von Keudell";
    Q.leader_nat_cons_title = "Former Reich Interior Minister";
}

// Agrarians Leader (new sub-group of the traditionalist umbrella)
if ((Q.tariffs || 0) < 0) {
    Q.leader_agrarians = "Martin Schiele";
    Q.leader_agrarians_title = "Reichslandbund President";
} else {
    Q.leader_agrarians = "Gustav von Kalckreuth";
    Q.leader_agrarians_title = "Reichslandbund President";
}

// Popular Conservative Candidates (banner-bearers of each internal wing) —
// which one actually leads the bloc is decided further below, once the
// relative strength of each wing on the floor is known.
Q.leader_c_yocon = "Gottfried Treviranus";
Q.leader_c_yocon_title = "Young Conservative Faction Leader";

if (Q.lambach_exile == 0 || Q.lambach_momentum == 1) {
    Q.leader_c_christsoc = "Walther Lambach";
    Q.leader_c_christsoc_title = "Leader of the Christian Social - DHV wing";
} else {
    Q.leader_c_christsoc = "Emil Hartwig";
    Q.leader_c_christsoc_title = "Christian-Social Delegate";
}







// ==========================================
// NSDAP GAMEPLAY
// ==========================================

Q.hitlerist_power = Q.hitlerist_power || 800;
Q.strasserist_power = Q.strasserist_power || 50;
Q.rohmite_power = Q.rohmite_power || 150;

// 1. GEEST WILDFIRE & TIMING EVENTS
if (Q.geest_wildfire == 1) {    
    Q.hitlerist_power += 6.0;
} else if (Q.month >= 2 && Q.geest_wildfire <= 0) {
  
    Q.strasserist_power += 2.0;
}

// 2. HITLER FUNDING
if (Q.hitler_young_funded >= 1) {
    Q.hitlerist_power *= 1.10;
}

// 3. IDEOLOGY
if (Q.ideology == "reformist") {
    Q.strasserist_power += 1.5;
}

if (Q.welfare <= 0) {
    Q.strasserist_power += 1 * Q.welfare; 
}

if (Q.unions_independent) {
    Q.strasserist_power += 2.8;
}

if (Q.workers_spd_pct + Q.workers_kpd_pct < 60) {
    Q.strasserist_power += 2 + (Q.workers_nsdap_pct * 0.2);
}

if (Q.year >= 1928 && Q.month >= 10 && (Q.dnvp_party_leader == "Alfred Hugenberg" || Q.dnvp_ideology == "National Conservatism (Hugenbergite)")) {
    Q.hitlerist_power += 5.5 * (Q.dnvp_pct * 0.2);
} else {
    Q.strasserist_power += 3 * (Q.nsdap_pct * 0.25);
}

if (Q.year >= 1929 && Q.month >= 2 && (Q.dvp_party_leader == "Ernst Scholz" || Q.dvp_ideology == "National Liberalism (Scholzite)" || Q.dvp_ideology == "Authoritarian National Liberalism")) {
    Q.hitlerist_power += 3.5 * (Q.dvp_pct * 0.4);
} else {
    Q.strasserist_power += 2 * (Q.nsdap_pct * 0.2);
}

if (Q.workers_spd_pct < 40) {
    Q.strasserist_power += 2 + (Q.workers_spd_pct * 0.05);
}

Q.hitlerist_power += (Q.nationalism || 0) * 0.5;
Q.rohmite_power += (Q.nationalism || 0) * 0.5;

{
    const _ns_total = Q.hitlerist_power + Q.strasserist_power + Q.rohmite_power;
    const _strasser_share = _ns_total > 0 ? (Q.strasserist_power / _ns_total) : 0.05;
    Q.strasserist_power += (Q.socialism || 0) * _strasser_share;
}

// 5. DEMOGRAPHIC CLASS INFLUENCE
// Old middle class & rural: fully Hitlerist
Q.hitlerist_power += (Q.old_middle_nsdap_pct || 0);
Q.hitlerist_power += (Q.rural_nsdap_pct || 0);

// Unemployed: Röhm 40%, Hitler 40%, Strasser 20%
Q.rohmite_power += (Q.unemployedc_nsdap_pct || 0) * 0.40;
Q.hitlerist_power += (Q.unemployedc_nsdap_pct || 0) * 0.40;
Q.strasserist_power += (Q.unemployedc_nsdap_pct || 0) * 0.20;

// Workers: mostly Strasser 70%, Hitler 10%, Röhm 20%
Q.strasserist_power += (Q.workers_nsdap_pct || 0) * 0.70;
Q.hitlerist_power += (Q.workers_nsdap_pct || 0) * 0.10;
Q.rohmite_power += (Q.workers_nsdap_pct || 0) * 0.20;

// 6. GLOBAL REGULATION: cap combined total of all 3 tracked vars at 1000
{
    const _ns_total_cap = 1000;
    const _ns_tracked = [
        'hitlerist_power',
        'strasserist_power',
        'rohmite_power'
    ];

    const _ns_sum = _ns_tracked.reduce((sum, key) => sum + Q[key], 0);

    if (_ns_sum > _ns_total_cap) {
        const _ns_scale = _ns_total_cap / _ns_sum;
        _ns_tracked.forEach(key => {
            Q[key] *= _ns_scale;
        });
    }
}









// ==========================================
// DVP GAMEPLAY
// ==========================================

Q.dvp_left = Q.dvp_left || 240;
Q.dvp_right = Q.dvp_right || 260;

if (Q.spd_r >= 30) {
    Q.dvp_left -= 0.7;
    Q.dvp_right += 0.7;
} else if (Q.spd_r >= 27.5) {
    Q.dvp_left += 0.35;
    Q.dvp_right += 0.35;
} else if (Q.spd_r <= 27.5 && Q.spd_r > 25) {
    Q.dvp_left += 0.7;
    Q.dvp_right -= 0.7;
} else { 
    Q.dvp_left += 1.28;
    Q.dvp_right -= 1.28;
}

if (Q.foreign_minister_party == "DVP" || Q.kellogg_briand_signed_dvp == 1) {
    Q.dvp_right += 2.64;
    Q.dvp_left -= 0.7;
}

if (Q.congress_path != "capitulation") {
    Q.dvp_left += 0.7;
}
if (Q.congress_path == "capitulation") {
    Q.dvp_right += 2.8;
}
if (Q.congress_path == "social_nationalists" || Q.congress_path == "young_conservative"|| Q.congress_path == "coalitionists") {
    Q.dvp_left += 1.6;
    if (Q.congress_path == "christian_social") {
        Q.dvp_left += 0.9;
    }
}

if (Q.upper_tax_rates > 0) {
    Q.dvp_right += 0.88 * Q.upper_tax_rates;
}
if (Q.welfare > 1) {
    Q.dvp_right += 0.6 * Q.welfare;
}
if (Q.working_hours > 0) {
    Q.dvp_right += 0.6 * Q.working_hours;
}
if (Q.ruhr_labor > 0) {
    Q.dvp_right += 1.28;
}
if (Q.works_councils > 0) {
    Q.dvp_right += 1.12 * Q.works_councils;
}
if (Q.socialization > 0) {
    Q.dvp_right += 2.4 * Q.socialization;
}
if (Q.cooperatives > 0) {
    Q.dvp_right += 1.28 * Q.cooperatives;
}

if (Q.major_curriculum == "vocational") {
    Q.dvp_left += 1.8;
}
if (Q.minor_curriculum == "vocational") {
    Q.dvp_left += 0.7;
}
if (Q.secularized == 1) {
    Q.dvp_left += 2.5;
}

Q.dvp_right += (Q.capital_strike_progress || 0) * 0.35;
Q.dvp_right += (Q.workers_safety || 0) * 0.35;
Q.dvp_left += (Q.judicial_reform || 0) * 1.28;
Q.dvp_left += (Q.reparations_negotiation || 0) * 2.0;

if (Q.enemies == "bourgeois parties" || Q.enemies == "DVP") {
    Q.dvp_right += 2.64;
}

Q.dvp_left += (Q.radio || 0) * 1.8;
Q.dvp_left += (Q.commercialized_media || 0) * 1.28;

if (Q.unions_independent) {
    Q.dvp_left += 4.0;
}

if (Q.ideology == "reformist") {
    Q.dvp_left += 1.8;
}
if (Q.ideology == "labor") {
    Q.dvp_left -= 1.28;
    Q.dvp_right += 1.28;
}
if (Q.ideology == "left") {
    Q.dvp_right += 2.24;
    Q.dvp_left -= 1.8;
}

Q.dvp_right += (Q.peoples_party_support || 0) * 0.35;
Q.dvp_left += (Q.peoples_party_support || 0) * 0.66;

Q.dvp_left += ((Q.dvp_relation || 0) / 8) * 0.35;
Q.dvp_right += ((100 - (Q.dvp_relation || 0)) * 0.5) * 0.28;

if (Q.dvp_relation < 40) {
    Q.dvp_right += 0.7;
}

Q.dvp_left += ((Q.pro_republic || 0) / 12) * 0.36;
Q.dvp_right += (Q.nationalism || 0) * 0.30;

// 4. DEMOGRAPHIC CLASS INFLUENCE
Q.dvp_left += (((Q.new_middle_dvp_pct || 0) + (Q.workers_dvp_pct || 0) + (Q.unemployedc_dvp_pct || 0)) / 5) * 0.35;
Q.dvp_right += ((Q.old_middle_dvp_pct || 0) * 0.8 + (Q.rural_dvp_pct || 0) * 0.6) * 0.32;

// 5. SPD/ZENTRUM DEMOGRAPHIC WEAKNESS OVERTURE
Q.dvp_left += (32 - (Q.new_middle_spd_pct || 0)) * 0.06;
Q.dvp_left += (20 - (Q.new_middle_z_pct || 0)) * 0.06;
Q.dvp_left += (38 - (Q.workers_spd_pct || 0)) * 0.06;
Q.dvp_left += (15 - (Q.workers_z_pct || 0)) * 0.06;

// 6. Global regulation / cap
{
    const _dvp_total_cap = 500;
    const _dvp_tracked = ['dvp_left', 'dvp_right'];
    const _dvp_sum = _dvp_tracked.reduce((sum, key) => sum + Q[key], 0);

    if (_dvp_sum > _dvp_total_cap) {
        const _dvp_scale = _dvp_total_cap / _dvp_sum;
        Q.dvp_left *= _dvp_scale;
        Q.dvp_right *= _dvp_scale;
    }
}


// ==========================================
// DDP GAMEPLAY
// ==========================================

Q.business_wing_ddp = Q.business_wing_ddp || 370;
Q.social_republican_ddp = Q.social_republican_ddp || 130;

if (Q.stolper_adopted == 1) {
    Q.business_wing_ddp += 2.7;
    Q.social_republican_ddp -= 1.8;
} else if (Q.stolper_adopted == -1) {
    Q.business_wing_ddp -= 2.0;
    Q.social_republican_ddp += 2.5;
}

if (Q.congress_path == "christian_social" || Q.congress_path == "young_conservative") {
    Q.social_republican_ddp += 0.3;
}
if (Q.congress_path == "young_conservative") {
    Q.social_republican_ddp += 0.2;
}

if (Q.ddp_in_government) {
    if (Q.spd_in_government) {
        Q.social_republican_ddp += 1.5;
        Q.business_wing_ddp -= 0.5;
    } else {
        Q.business_wing_ddp += 1.2;
        Q.social_republican_ddp -= 0.8;
    }
} else {
    Q.business_wing_ddp += 1.8;
    Q.social_republican_ddp -= 1.2;
}

Q.social_republican_ddp += ((Q.ddp_relation || 0) / 8) * 0.35;
Q.business_wing_ddp += ((100 - (Q.ddp_relation || 0)) * 0.5) * 0.35;

if (Q.welfare <= 0) {
    Q.social_republican_ddp += Math.abs(Q.welfare || 0) * 0.85;
}

if (Q.workers_aid <= 0) {
    Q.social_republican_ddp += Math.abs(Q.workers_aid || 0) * 0.50;
}

if (Q.ideology == "reformist") Q.social_republican_ddp += 1.8;
if (Q.ideology == "labor") {
    Q.social_republican_ddp -= 1.28;
    Q.business_wing_ddp += 1.28;
}
if (Q.ideology == "left") {
    Q.business_wing_ddp += 2.45; 
    Q.social_republican_ddp -= 1.8;
}

if (Q.womens_rights > 0) Q.social_republican_ddp += 0.11 + Q.womens_rights;
if (Q.kwg_research > 0) Q.social_republican_ddp += 0.51 + Q.kwg_research;
if (Q.family_law > 0) Q.social_republican_ddp += 0.15 + Q.family_law;
if (Q.womens_work > 0) Q.social_republican_ddp += 0.10 + Q.womens_work;

if (Q.upper_tax_rates > 0) Q.business_wing_ddp += 0.57 * Q.upper_tax_rates;
if (Q.middle_tax_rates > 0) Q.business_wing_ddp += 1.11 * Q.middle_tax_rates;
if (Q.lower_tax_rates > 0) Q.social_republican_ddp += 0.38 * Q.lower_tax_rates;
if (Q.works_councils > 0) Q.business_wing_ddp += 1.12 * Q.works_councils;
if (Q.socialization > 0) Q.business_wing_ddp += 1.11 * Q.socialization;
if (Q.cooperatives > 0) Q.business_wing_ddp += 0.49 * Q.cooperatives;

if (Q.spd_r >= 30) {
    Q.business_wing_ddp -= 0.7;
    Q.social_republican_ddp += 0.7;
} else if (Q.spd_r >= 27.5) {
    Q.business_wing_ddp += 0.35;
    Q.social_republican_ddp += 0.35;
} else if (Q.spd_r <= 27.5 && Q.spd_r > 25) {
    Q.business_wing_ddp += 0.7;
    Q.social_republican_ddp -= 0.7;
} else { 
    Q.business_wing_ddp += 1.28;
    Q.social_republican_ddp -= 1.28;
}

Q.ddp_new_mid = Q.new_middle_ddp_pct || 0;
Q.ddp_old_mid = Q.old_middle_ddp_pct || 0;
Q.ddp_rural   = Q.rural_ddp_pct || 0;
Q.ddp_workers = Q.workers_ddp_pct || 0;
Q.ddp_unemp   = Q.unemployedc_ddp_pct || 0;

Q.business_wing_ddp += (Q.ddp_new_mid + Q.ddp_old_mid + Q.ddp_rural) * 0.11;
Q.social_republican_ddp += (Q.ddp_workers + Q.ddp_unemp) * 0.33;

// Global regulation: cap combined total at 500
{
    const _ddp_total_cap = 500; 
    const _ddp_tracked = ['business_wing_ddp', 'social_republican_ddp'];
    const _ddp_sum = _ddp_tracked.reduce((sum, key) => sum + Q[key], 0);

    if (_ddp_sum > _ddp_total_cap) {
        const _ddp_scale = _ddp_total_cap / _ddp_sum;
        _ddp_tracked.forEach(key => {
            Q[key] *= _ddp_scale;
        });
    }
}




// ==========================================
// ZENTRUM (CENTER PARTY) INTERNAL DYNAMICS
// ==========================================

Q.z_clerical_power = Q.z_clerical_power || 250;
Q.z_left_labor_power = Q.z_left_labor_power || 250;
Q.z_right_labor_power = Q.z_right_labor_power || 200;
Q.z_moderate_power = Q.z_moderate_power || 300;

// 1. THE CONCORDAT & VATICAN INFLUENCE
// Historically, Pacelli's push for Catholic Action and the Prussian Concordat 
// sidelined lay labor leaders and favored clerical control under Kaas.
if (Q.prussian_concordat >= 1) {
    // With the Prussian Concordat signed, Kaas is historically vindicated but 
    // focuses on Rome, leaving a vacuum that splits the labor wings.
    Q.z_clerical_power -= 3.5;
    Q.z_right_labor_power += 3.8; 
    Q.z_moderate_power += 2.0;
} else if (Q.prussian_concordat_progress == 0) {
    // Ongoing negotiations and Vatican pressure boost clerical authority.
    Q.z_clerical_power += 6.5;
    Q.z_right_labor_power -= 1.8; 
} else if (Q.prussian_concordat_progress >= 1) {
    Q.z_clerical_power += 4.5;
    Q.z_left_labor_power += 1.0;
    Q.z_right_labor_power -= 0.8; // Vatican opposes Stegerwald's interconfessional plans

    Q.z_clerical_power -= 0.5 * Q.prussian_concordat_progress;
    Q.z_right_labor_power += 0.7 * Q.prussian_concordat_progress;
    Q.z_left_labor_power += 0.1 * Q.prussian_concordat_progress;
    Q.z_moderate_power += 0.1 * Q.prussian_concordat_progress;
}


if (Q.catholic_action_influence >= 1) {
    Q.z_clerical_power += 4.5;
    Q.z_left_labor_power -= 1.5;  // KAB is pressured to accept clerical supervision
    Q.z_right_labor_power -= 3.0; // Christian Unions (DGB) hate clerical interference
}

if (Q.ideology == "reformist") {
    Q.z_left_labor_power += 2.5;
    Q.z_moderate_power += 0.5;
    Q.z_right_labor_power += 1.0;
} else if (Q.ideology == "labor") {
    Q.z_left_labor_power -= 1.5;
    Q.z_right_labor_power += 1.0;
    Q.z_moderate_power += 1.5;
    Q.z_clerical_power += 1.5;
} else if (Q.ideology == "left") {
    Q.z_left_labor_power -= 3.5;
    Q.z_right_labor_power += 4.0;
    Q.z_moderate_power += 0.5;
    Q.z_clerical_power += 3.5;
}

if (Q.enemies == "bourgeois parties") {
    Q.z_right_labor_power += 3.0;
    Q.z_left_labor_power -= 3.0;
    Q.z_clerical_power += 1.0;
    Q.z_moderate_power += 1.2;
}

// 2. COALITION STATUS & SPD RELATIONS
// Joos and Brauns rely on a stable, cooperative relationship with the SPD.
// If relations sour or the SPD acts aggressively, the bourgeois base swings to Kaas/Stegerwald.

if (Q.z_relation >= 70) {
    let multiplier = Q.z_relation / 10; // e.g., 7.5 multiplier at 75 relation
    
    Q.z_left_labor_power += 3.0 * multiplier;
    Q.z_moderate_power += 1.5 * multiplier;
    Q.z_right_labor_power -= 2.0 * multiplier;

} else if (Q.z_relation < 70 && Q.z_relation >= 60) {

    let multiplier = (70 - Q.z_relation) / 10; // e.g., 0.5 multiplier at 65 relation
    if (multiplier < 0.1) multiplier = 0.1;   // Safety floor so it always triggers at least a tiny bit
    
    Q.z_clerical_power += 1.5 * multiplier;
    Q.z_right_labor_power += 1.5 * multiplier;
    Q.z_left_labor_power -= 1.0 * multiplier;
    Q.z_moderate_power += 1.0 * multiplier;

} else {

    let multiplier = (80 - Q.z_relation) / 10; // e.g., 6.0 multiplier at 20 relation
    
    Q.z_clerical_power += 1.5 * multiplier;
    Q.z_right_labor_power += 2.9 * multiplier;
    Q.z_left_labor_power -= 1.2 * multiplier;
    Q.z_moderate_power -= 0.5 * multiplier;
}


if (Q.spd_in_government && Q.z_in_government) {
    Q.z_moderate_power += 2.5;
    Q.z_left_labor_power += 1.5;
} else if (Q.z_in_government && !Q.spd_in_government) {
    Q.z_clerical_power += 1.0;
    Q.z_right_labor_power += 3.0;
    Q.z_left_labor_power -= 0.6;
    Q.z_moderate_power += 0.1;
} else {
    Q.z_clerical_power += 1.5;
    Q.z_left_labor_power -= 1.0;
    Q.z_moderate_power -= 1.5;
    Q.z_right_labor_power += 3.5;
}

// 3. SOCIAL POLICY & LABOR CONFLICTS
// The fight over Welfare defines the labor split.
const welfare_val = Q.welfare || 0;
if (welfare_val > 0) {
    Q.z_left_labor_power += 1.5 * welfare_val;
    Q.z_moderate_power += 2.0 * welfare_val; // Validates Brauns' welfare-state legacy
} else if (welfare_val < 0) {
    // Austerity triggers union militancy, but also a defensive bourgeois backlash
    Q.z_right_labor_power += 3.5 * Math.abs(welfare_val);
    Q.z_clerical_power += 1.5 * Math.abs(welfare_val);
    Q.z_moderate_power -= 2.5 * Math.abs(welfare_val);
}

if (Q.unions_independent) {
    // ADBG unions strengthen the lay DGB wing
    Q.z_right_labor_power += 6.0;
    Q.z_left_labor_power += 2.5;
}

if (Q.lambach_exile == 0 && (Q.year >= 1928 && Q.month >= 7) && Q.year < 1930) {
    Q.z_left_labor_power += 1.0;
    Q.z_right_labor_power += 5.7;
    Q.z_moderate_power -= 1.5;
    Q.z_clerical_power -= 2.7;
}

if (Q.congress_path == "social_nationalists" && Q.year < 1930) {
    Q.z_left_labor_power += 2.5;
    Q.z_right_labor_power += 12;
    Q.z_moderate_power -= 1.5;
    Q.z_clerical_power -= 3.5;
}

// 4. THE CULTURE WAR (Secularization Threat)
// Nothing unites and radicalizes Zentrum like threats to religious schools.
// High secularization efforts by the SPD trigger a massive clerical backlash.
if (Q.secularized == 1 || Q.major_curriculum == "scientific") {
    Q.z_clerical_power += 5.5;    // Defensive Catholic mobilization
    Q.z_left_labor_power -= 4.0;  // Socialists' "allies" are blamed for cultural betrayal
    Q.z_moderate_power -= 2.0;
}

// 5. DEMOGRAPHICS & CLASS TENSIONS
// Center's internal delegate power is heavily swayed by voter class composition.
const workers_z = Q.workers_z_pct || 0;
const rural_z = Q.rural_z_pct || 0;
const old_middle_z = Q.old_middle_z_pct || 0;
const new_middle_z = Q.new_middle_z_pct || 0;

Q.z_left_labor_power += (workers_z * 0.50) + (new_middle_z * 0.18);
Q.z_right_labor_power += (workers_z * 0.48) + (new_middle_z * 0.05);

Q.z_clerical_power += (rural_z * 0.35) + (old_middle_z * 0.25);
Q.z_moderate_power += (new_middle_z * 0.40) + (old_middle_z * 0.15);

// Bourgeois Backlash: Historically, civil servants and academics feared Stegerwald 
// would turn Zentrum into a "workers' party." High middle-class representation suppresses him.
if (new_middle_z > 20 || old_middle_z > 25) {
    Q.z_right_labor_power -= 3.5;
    Q.z_clerical_power += 2.0;
} else {
    Q.z_right_labor_power += workers_z * 0.15;
    Q.z_left_labor_power += workers_z * 0.07;
}

// 6. GLOBAL REGULATION: Cap combined total of all 4 tracked variables at 1000
{
    const _z_total_cap = 1000;
    const _z_tracked = [
        'z_clerical_power',
        'z_left_labor_power',
        'z_right_labor_power',
        'z_moderate_power'
    ];

    const _z_sum = _z_tracked.reduce((sum, key) => sum + Q[key], 0);

    if (_z_sum > _z_total_cap) {
        const _z_scale = _z_total_cap / _z_sum;
        _z_tracked.forEach(key => {
            Q[key] *= _z_scale;
        });
    }
}


if (Q.z_party_leader == "Joseph Joos") {

    // Right labor always counts fully toward the anti-Joos bloc
    let vonc_score = Q.z_right_labor_power;

    const relation = Q.z_relation != null ? Q.z_relation : 50;
    const relation_deficit = Math.max(0, 70 - relation) / 70; // 0 to 1
    const clerical_weight = Math.pow(relation_deficit, 2);    // exponential curve

    vonc_score += Q.z_clerical_power * clerical_weight;

    const threshold_floor = 450;
    const threshold_ceiling = 600;
    const vonc_threshold = threshold_ceiling - (relation_deficit * (threshold_ceiling - threshold_floor));

    if (vonc_score >= vonc_threshold) {
        Q.z_vonc_triggered = 1;
    }
}















////// GAME EVENTS TRIGGER VALUES FLAVOR


// 1. DNVP Congress Trigger
if (Q.year == 1928 && Q.month >= 6 && Q.flavor_1_dnvp != 1) {
    if ((Q.dnvp_r < Q.old_dnvp_r - 2.5) || Q.cnbl_crisis == 1) {
        Q.flavor_1_dnvp = 1;
        Q.dnvp_party_0_congress_timer = 6;
        if (!Q.timers.includes('dnvp_party_0_congress')) {
            Q.timers.push('dnvp_party_0_congress');
        }
    } else {
        Q.flavor_1_dnvp = 1;
        Q.dnvp_party_0_congress_timer = 10;
        if (!Q.timers.includes('dnvp_party_0_congress')) {
            Q.timers.push('dnvp_party_0_congress');
        }
    }
}

// 2. Hugenberg Attack Trigger
if (Q.dnvp_party_leader == "Walther Lambach" && Q.flavor_2_dnvp != 1) {
    Q.dnvp_lambach_hugenberg_attack_timer = 6;
    if (!Q.timers.includes('dnvp_lambach_hugenberg_attack')) {
        Q.timers.push('dnvp_lambach_hugenberg_attack'); 
    }
    Q.flavor_2_dnvp = 1;
}

// 3. Traditionals Attack Trigger
if (Q.lambach_stage == 1 && Q.flavor_lambach_1_dnvp != 1) {
    Q.dnvp_lambach_traditionals_attack_timer = 8;
    if (!Q.timers.includes('dnvp_lambach_traditionals_attack')) {
        Q.timers.push('dnvp_lambach_traditionals_attack');
    }
    Q.flavor_lambach_1_dnvp = 1;
}

// 4. Lambach Article Trigger
if (((Q.year == 1928 && Q.month >= 6) || (Q.year == 1929 && Q.month <= 1)) && (Q.dnvp_pct < (Q.old_dnvp_r - 2.33) || Q.dnvp_pct < (Q.dnvp_r - 5) || Q.dnvp_pct < 16.3) && Q.lambach_flavor_trigger_1 != 1) {
    Q.lambach_article_timer = 2;
    if (!Q.timers.includes('lambach_article')) {
        Q.timers.push('lambach_article');
    }
    Q.lambach_flavor_trigger_1 = 1;
}

// Lambach momentum

// 5. Lambach Fallback / Christian Social Trigger
if (Q.lambach_flavor_2_trigger != 1 && (Q.lambach_flavor_trigger_1 != 1 || (Q.year == 1928 && Q.month >= 8 && (Q.delegate_power_christsoc + Q.delegate_power_yocon) > 600))) {
    Q.lambach_flavor_2_trigger = 1;
    Q.lambach_momentum_timer = 2;
    if (!Q.timers.includes('lambach_momentum')) {
        Q.timers.push('lambach_momentum');
    }
}



// Lambach Consolidation Stage 2 Trigger
if (Q.lambach_stage == 2 && Q.lambach_flavor_3_trigger != 1 && Q.lambach_consolidation_stage_2_timer == 0) {
    Q.lambach_consolidation_stage_2_timer = 4;
    if (!Q.timers.includes('lambach_consolidation_stage_2')) {
        Q.timers.push('lambach_consolidation_stage_2'); // Base name without _timer
    }
    Q.lambach_flavor_3_trigger = 1;
}


// Hugenberg VONC Trigger
if (Q.year >= 1929 && Q.year <= 1930 && Q.dnvp_party_leader == "Alfred Hugenberg" && 
    ((Q.young_opposition <= 15 && Q.hugenberg_final_votes < 45) || (Q.young_opposition < 10 && Q.hugenberg_final_votes < 50)) && 
    Q.hugenberg_momentum <= 300 && Q.hugenberg_weakness_trigger != 1) {
    
    Q.hugenberg_weakness_timer = 4;
    if (!Q.timers.includes('hugenberg_weakness')) {
        Q.timers.push('hugenberg_weakness');
    }
    Q.hugenberg_weakness_trigger = 1;
}

// Lambach vs Hugenberg
if (Q.dnvp_party_leader == "Alfred Hugenberg" && Q.lambach_stage == -1 && Q.lambach_stage_minus1_trigger != 1) {
    Q.lambach_stage_minus1_timer = 4;
    if (!Q.timers.includes('lambach_stage_minus1')) {
        Q.timers.push('lambach_stage_minus1');
    }
    Q.lambach_stage_minus1_trigger = 1;
}






















for (const party of Q.parties) {
    var timerKey = party + '_action';
    if (!Q.timers.includes(timerKey)) {
        Q.timers.push(timerKey);
    }
    if (Q[timerKey + '_timer'] === undefined) {
        Q[timerKey + '_timer'] = 0;
    }

    var flavorTimerKey = party + '_flavor_action';
    if (!Q.timers.includes(flavorTimerKey)) {
        Q.timers.push(flavorTimerKey);
    }
    if (Q[flavorTimerKey + '_timer'] === undefined) {
        Q[flavorTimerKey + '_timer'] = 0;
    }

    var govTimerKey = party + '_government_action';
    if (!Q.timers.includes(govTimerKey)) {
        Q.timers.push(govTimerKey);
    }
    if (Q[govTimerKey + '_timer'] === undefined) {
        Q[govTimerKey + '_timer'] = 0;
    }

    var govFlavorTimerKey = party + '_government_flavor_action';
    if (!Q.timers.includes(govFlavorTimerKey)) {
        Q.timers.push(govFlavorTimerKey);
    }
    if (Q[govFlavorTimerKey + '_timer'] === undefined) {
        Q[govFlavorTimerKey + '_timer'] = 0;
    }
}

function isParty(party, targetParties) {
    if (!party || !targetParties) return false;
    var targets = Array.isArray(targetParties) ? targetParties : [targetParties];
    return targets.some(t => t && party.toLowerCase() === t.toLowerCase());
}


// PARTY ACTIONS

function PickHighest(list, prop) {
    var bestKey = null;
    var bestVal = -Infinity;
    for (var key in list) {
        if (list[key].ignore) continue;
        if (list[key][prop] > bestVal) {
            bestVal = list[key][prop];
            bestKey = key;
        }
    }
    return bestKey;
}

function scaledWeight(baseWeight, currentValue, baseValue, maxMultiplier = 5) {
    var ratio = Math.min(baseValue / Math.max(currentValue, 1), maxMultiplier);
    return baseWeight * ratio;
}

function linearWeight(baseWeight, currentValue, baseValue, maxMultiplier = 5) {
    var ratio = Math.max(currentValue, 0) / baseValue;
    ratio = Math.min(ratio, maxMultiplier);
    return baseWeight * ratio;
}

function inIdeoRange(party, min, max) {
    var score = Q[party + '_ideo_score'];
    if (score === undefined) return false;
    return score >= min && score <= max;
}

// Human-readable party names for description text.
Q.PARTY_DISPLAY_NAMES = {
    dnvp: 'The DNVP',
    dvp: 'The DVP',
    kpo: 'The KPO',
    sl: 'The SL',
    sapd: 'The SAPD',
    srpd: 'The SRPD',
    ddp: Q.ddp_name,
    z: 'The Zentrum',
    bvp: 'The BVP',
    csrp: 'The CSRP',
    wp: 'The WP',
    cnbl: 'The CNBL',
    csvd: 'The CSVD',
    vrp: 'The VRP',
    kvp: 'The KVP',
    dhp: 'The DHP',
    bb: 'The BB',
    dvfp: 'The DVFP',
    aspd: 'The ASPD',
    vnr: 'The VNR',
    hl: 'The HL',
    lb: 'The LB',
    rdp: 'The RDP',
    cvp: 'The CVP',
    sls: 'The SLS',
    dtsp: 'The DTSP',
    dbp: 'The DBP',
    dsbp: 'The DSBP',
    dnf: 'The DNF',
    rlb: 'The RLB',
    faud: 'The FAUD',
    kapd: 'The KAPD',
    pp: 'The PP',
    gsrn: 'The GSRN',
    uspd: 'The USPD'
};

function partyLabel(party) {
    return Q.PARTY_DISPLAY_NAMES[party] || party.toUpperCase();
}

// Map internal class keys (as used in Q.classes / computeTarget's `c`
// argument) to the campaign_focus_<party> string vocabulary used by
// _campaignMult / _campaignSpeedBonus in the QOL/drift system
// (_CAMPAIGN_FOCUS_CLASS_MAP there maps the other direction). Only
// 'unemployedc' differs from its own class key ('unemployed' focus).
Q.CLASS_TO_CAMPAIGN_FOCUS = {
    workers:     'workers',
    unemployedc: 'unemployed',
    old_middle:  'old_middle',
    new_middle:  'new_middle',
    rural:       'rural',
};

// --- Global action definitions ---
Q.GLOBAL_PARTY_ACTIONS = {

    stahlhelm_recruitment: {
        ideoMin: 17, ideoMax: 20,
        weight: () => scaledWeight(1.30, Q.stahlhelm_strength, 1300),
        description: (party) => partyLabel(party) + ' has overseen Der Stahlhelm recruiting some of the disgruntled mittelstand and outclasses into their paramilitary, receiving some anonymous fundings alongside.',
        ignore: (party) => Q.sh_banned >= 1 || !isParty(party, 'dnvp'),
        timer: 10,
        apply: () => {
            Q.stahlhelm_strength += 50;
            Q.stahlhelm_militancy += 0.01;
        }
    },

    rfb_recruitment: {
        ideoMin: 1, ideoMax: 4,
        weight: () => scaledWeight(1.30, Q.rfb_strength, 1000),
        description: (party) => partyLabel(party) + ' has overseen the Roter Frontkämpferbund recruiting some of the disgruntled workers and unemployed into their paramilitary, receiving some anonymous fundings alongside.',
        ignore: (party) => Q.rfb_banned >= 1 || !isParty(party, 'kpd'),
        timer: 10,
        apply: () => {
            Q.rfb_strength += 50;
            Q.rfb_militancy += 0.01;
        }
    },

    nationalist_campaign: {
        ideoMin: 14, ideoMax: 20,
        weight: () => scaledWeight(0.75, Q.nationalism, 5),
        description: (party) => partyLabel(party) + ' has initiated a rally for nationalism and opposition against the republican order.',
        ignore: () => false,
        timer: 8,
        apply: () => {
            Q.nationalism += 3;
        }
    },

    prussian_counter_prussia: {
        ideoMin: 16, ideoMax: 20,
        weight: () => linearWeight(4.00, Q.prussian_republicanization, 30),
        description: (party) => partyLabel(party) + ' has replaced republican and socialist officials in Prussia with nationalist judges and civil servants, steering the state police away from democratic values.',
        ignore: (party) => Q[party + '_in_government_prussia'] <= 0,
        timer: 10,
        apply: () => {
            Q.prussian_republicanization -= 5;
            Q.prussian_police_loyalty -= 0.08;
            Q.prussian_police_strength += 30;
        }
    },

    prussian_rfb_ban: {
        ideoMin: 14, ideoMax: 20,
        weight: () => 20.00,
        description: (party) => partyLabel(party) + ' has prohibited the communist RFB paramilitary across Prussia, dealing a severe blow to left-wing militant organization in the state.',
        ignore: (party) => Q[party + '_in_government_prussia'] <= 0 || Q.rfb_banned >= 1,
        timer: 12,
        apply: () => {
            Q.rfb_banned = 1;
            Q.rfb_strength -= 50;
            Q.rfb_militancy *= 0.95;
        }
    },

    prussian_rb_ban: {
        ideoMin: 17, ideoMax: 20,
        weight: () => 20.00,
        description: (party) => partyLabel(party) + ' has issued a total ban on the Reichsbanner, citing the pro-republican paramilitary as too dangerous to permit its public activities.',
        ignore: (party) => (Q[party + '_in_government_prussia'] <= 0 || Q.rb_banned >= 1) && (Q.rb_strength * Q.rb_militancy < 500),
        timer: 12,
        apply: () => {
            Q.rb_banned = 1;
            Q.rb_strength -= 100;
            Q.rb_militancy *= 0.90;
        }
    },

    socialist_campaign: {
        ideoMin: 1, ideoMax: 6,
        weight: () => scaledWeight(0.75, Q.socialism, 5),
        description: (party) => partyLabel(party) + ' has initiated a rally for socialism and opposition against the republican order.',
        ignore: () => false,
        timer: 8,
        apply: () => {
            Q.socialism += 3;
        }
    },

    democratic_campaign: {
        ideoMin: 7, ideoMax: 14,
        weight: () => scaledWeight(0.75, Q.pro_republic, 5),
        description: (party) => partyLabel(party) + ' has initiated a rally for republic and opposition against the extremist forces.',
        ignore: () => false,
        timer: 8,
        apply: () => {
            Q.pro_republic += 2;
        }
    },

    campaigning: {
        ideoMin: 1, ideoMax: 20,
        weight: (party) => {
            var oldR = Q[party + '_old_r'];
            var pct  = Q[party + '_pct'];
            if (!oldR || oldR <= 0) return 0;
            var shortfall = Math.max(0, oldR - pct); // 0 if not underperforming
            return linearWeight(5.00, shortfall, oldR, 4);
        },
        description: (party) => {
            var focusClass = Q[party + '_campaign_target_class'];
            var focusLabel = {
                workers: 'the industrial working class',
                unemployedc: 'the unemployed',
                old_middle: 'shopkeepers and artisans',
                new_middle: 'white-collar workers and civil servants',
                rural: 'the countryside',
            }[focusClass] || 'the electorate';
            return partyLabel(party) + ' has launched a campaign push targeting ' + focusLabel + ', trailing its last Reichstag result.';
        },
        ignore: (party) => {
            var oldR = Q['old_' + party + '_r'];
            var pct  = Q[party + '_pct'];
            return !oldR || oldR <= 0 || pct >= oldR;
        },
        timer: 8,
        apply: (party) => {
            // --- Pick focus class: biggest shortfall vs computeTarget ---
            var bestClass = null;
            var bestGap   = -Infinity;
            for (const c of Q.classes) {
                var current = Q[c + '_' + party] || 0;
                var target  = computeTarget(party, c);
                var gap     = target - current; // positive = underperforming potential here
                if (gap > bestGap) {
                    bestGap   = gap;
                    bestClass = c;
                }
            }
            if (!bestClass) return;

            Q[party + '_campaign_target_class'] = bestClass; // for description/display
            Q['campaign_focus_' + party] = Q.CLASS_TO_CAMPAIGN_FOCUS[bestClass] || bestClass;

            // --- Intensity scaled by how far below old_r they are ---
            var oldR = Q['old_' + party + '_r'];
            var pct  = Q[party + '_pct'];
            var shortfallRatio = Math.min(1.0, Math.max(0, oldR - pct) / oldR); // 0..1
            // Floor of 0.4 so even a marginal shortfall still mounts a
            // meaningful campaign; scales up to 1.0 at total collapse.
            var newIntensity = 0.4 + shortfallRatio * 0.6;

            Q['campaign_intensity_' + party] = Math.max(
                Q['campaign_intensity_' + party] || 0,
                newIntensity
            );
        }
    },
};

// --- Run one party's action turn ---
function runPartyActions(party) {
    var timerKey = party + '_action_timer';
    var bannedKey = party + '_banned';
    var descKey = party + '_action_description';
    var flavorTimerKey = party + '_flavor_action_timer'; // per-party now

    if (Q[timerKey] > 0 || Q[bannedKey]) return;

    var pool = {};
    for (var key in Q.GLOBAL_PARTY_ACTIONS) {
        var action = Q.GLOBAL_PARTY_ACTIONS[key];
        if (!inIdeoRange(party, action.ideoMin, action.ideoMax)) continue;

        pool[key] = {
            weight: action.weight(party),
            ignore: action.ignore ? action.ignore(party) : false,
            timer: action.timer,
            description: action.description(party)
        };
    }

    var chosen = PickHighest(pool, 'weight');

    if (chosen === null) {
        Q[timerKey] = 6;
        Q[descKey] = partyLabel(party) + ' remains quiet for the time being, lacking viable options to act on.';
        return;
    }

    Q[timerKey] = pool[chosen].timer;
    Q[descKey] = pool[chosen].description;
    Q.GLOBAL_PARTY_ACTIONS[chosen].apply(party);

    // Queue this party's OWN flavor timer, keyed to it specifically
    var flavorTimerName = party + '_flavor_action';
    if (!Q.timers.includes(flavorTimerName)) {
        Q.timers.push(flavorTimerName);
    }
    Q[flavorTimerKey] = 3;
}

for (const party of Q.parties) {
    if (party === 'spd' || party === 'other') continue;
    runPartyActions(party);
}










// PARTY GOVERNMENT ACTIONS

// --- Ministry registry ---
// Each ministry maps to a Q key of the form "<ministry>_party", e.g.
// Q.finance_minister_party === 'dnvp' means the DNVP holds Finance.
Q.MINISTRIES = [
    'transport_minister',
    'agriculture_minister',
    'finance_minister',
    'economic_minister',
    'labor_minister',
    'justice_minister',
    'foreign_minister'
];

// Returns true if `party` currently holds `ministry` (e.g. 'finance_minister').
function holdsMinistry(party, ministry) {
    return Q[ministry + '_party'] && Q[ministry + '_party'].toLowerCase() === party.toLowerCase();
}

// Returns true if `party` holds ANY cabinet ministry.
function holdsAnyMinistry(party) {
    for (var i = 0; i < Q.MINISTRIES.length; i++) {
        if (holdsMinistry(party, Q.MINISTRIES[i])) return true;
    }
    return false;
}

// Returns true if `party` is the chancellor's party.
function isChancellorParty(party) {
    return Q.chancellor_party && Q.chancellor_party.toLowerCase() === party.toLowerCase();
}

// Convenience: is this party "in government" at the Reich level at all
// (chancellorship OR any ministry)? Mirrors the xparty_in_government_prussia
// pattern used for the Prussian actions.
function inReichGovernment(party) {
    return Q[party + '_in_government'] >= 1 || isChancellorParty(party) || holdsAnyMinistry(party);
}

// --- Global government action definitions ---

Q.GLOBAL_PARTY_GOVERNMENT_ACTIONS = {

    chancellery_agenda_push: {
        ideoMin: 1, ideoMax: 20,
        weight: () => 3.00,
        description: (party) => partyLabel(party) + ', holding the Chancellery, has pushed its legislative agenda through the cabinet.',
        ignore: (party) => !isChancellorParty(party),
        timer: 8,
        apply: () => {
            Q.government_stability += 1;
        }
    },

    finance_budget_maneuver: {
        ideoMin: 1, ideoMax: 20,
        weight: () => 2.50,
        description: (party) => partyLabel(party) + ', controlling the Finance Ministry, has maneuvered the budget to favor its base.',
        ignore: (party) => !holdsMinistry(party, 'finance_minister'),
        timer: 8,
        apply: () => {
            Q.government_stability += 0.5;
        }
    },

    economic_policy_shift: {
        ideoMin: 1, ideoMax: 20,
        weight: () => 2.50,
        description: (party) => partyLabel(party) + ', at the head of the Economics Ministry, has shifted regulatory policy in its favored direction.',
        ignore: (party) => !holdsMinistry(party, 'economic_minister'),
        timer: 8,
        apply: () => {
            Q.government_stability += 0.5;
        }
    },

    labor_dispute_mediation: {
        ideoMin: 1, ideoMax: 20,
        weight: () => 2.00,
        description: (party) => partyLabel(party) + ', running the Labor Ministry, has intervened in ongoing industrial disputes.',
        ignore: (party) => !holdsMinistry(party, 'labor_minister'),
        timer: 8,
        apply: () => {
            Q.government_stability += 0.5;
        }
    },

    justice_appointments: {
        ideoMin: 1, ideoMax: 20,
        weight: () => 2.00,
        description: (party) => partyLabel(party) + ', in charge of the Justice Ministry, has steered key judicial appointments.',
        ignore: (party) => !holdsMinistry(party, 'justice_minister'),
        timer: 10,
        apply: () => {
            Q.government_stability += 0.5;
        }
    },

    foreign_policy_initiative: {
        ideoMin: 1, ideoMax: 20,
        weight: () => 2.00,
        description: (party) => partyLabel(party) + ', holding the Foreign Ministry, has advanced a diplomatic initiative abroad.',
        ignore: (party) => !holdsMinistry(party, 'foreign_minister'),
        timer: 10,
        apply: () => {
            Q.government_stability += 0.5;
        }
    },

    agriculture_relief_measure: {
        ideoMin: 1, ideoMax: 20,
        weight: () => 1.75,
        description: (party) => partyLabel(party) + ', controlling the Agriculture Ministry, has enacted relief measures for farmers.',
        ignore: (party) => !holdsMinistry(party, 'agriculture_minister'),
        timer: 8,
        apply: () => {
            Q.government_stability += 0.5;
        }
    },

    transport_infrastructure_deal: {
        ideoMin: 1, ideoMax: 20,
        weight: () => 1.75,
        description: (party) => partyLabel(party) + ', overseeing the Transport Ministry, has brokered an infrastructure deal.',
        ignore: (party) => !holdsMinistry(party, 'transport_minister'),
        timer: 8,
        apply: () => {
            Q.government_stability += 0.5;
        }
    },

    cabinet_coordination: {
        ideoMin: 1, ideoMax: 20,
        weight: () => scaledWeight(1.00, Q.government_stability, 10),
        description: (party) => partyLabel(party) + ' has worked behind the scenes to keep the coalition cabinet aligned.',
        ignore: (party) => !inReichGovernment(party),
        timer: 6,
        apply: () => {
            Q.government_stability += 0.25;
        }
    },
};

// --- Run one party's government action turn ---
function runPartyGovernmentActions(party) {
    var timerKey = party + '_government_action_timer';
    var bannedKey = party + '_banned';
    var descKey = party + '_government_action_description';

    if (Q[timerKey] > 0 || Q[bannedKey]) return;

    // Main gate: party must actually be in government to act here at all.
    if (!inReichGovernment(party)) return;

    var pool = {};
    for (var key in Q.GLOBAL_PARTY_GOVERNMENT_ACTIONS) {
        var action = Q.GLOBAL_PARTY_GOVERNMENT_ACTIONS[key];
        if (!inIdeoRange(party, action.ideoMin, action.ideoMax)) continue;

        pool[key] = {
            weight: action.weight(party),
            ignore: action.ignore ? action.ignore(party) : false,
            timer: action.timer,
            description: action.description(party)
        };
    }

    var chosen = PickHighest(pool, 'weight');

    if (chosen === null) {
        Q[timerKey] = 6;
        Q[descKey] = partyLabel(party) + ' takes no notable government action for the time being.';
        return;
    }

    Q[timerKey] = pool[chosen].timer;
    Q[descKey] = pool[chosen].description;
    Q.GLOBAL_PARTY_GOVERNMENT_ACTIONS[chosen].apply(party);

    var govFlavorTimerName = party + '_government_flavor_action';
    if (!Q.timers.includes(govFlavorTimerName)) {
        Q.timers.push(govFlavorTimerName);
    }
    Q[party + '_government_flavor_action_timer'] = 3;
}

for (const party of Q.parties) {
    if (party === 'spd') continue;
    runPartyGovernmentActions(party);
}





















}


if (Q.ma >= 1) {
    Q.ma = 0;
    // append to historical party support records
    var party_support_results = {'date': new Date(Q.year, Q.month - 1)};
    for (var party of Q.parties) {
        party_support_results[party] = Q[party + '_normalized']*100;
    }
    Q.party_support_records.push(party_support_results);
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1),
                             'economic_growth': Q.economic_growth,
                             'inflation': Q.inflation,
                             'unemployment': Q.unemployed});

    // append to historical demographic-class party support records
    // one array per demographic class, mirroring party_support_records,
    // but reading class-specific normalized support (Q.<class>_<party>_normalized)
    // instead of the population-wide Q.<party>_normalized
    Q.demographic_support_records = Q.demographic_support_records || {
        workers: [], old_middle: [], new_middle: [], rural: [], unemployedc: []
    };

    var _demo_date = new Date(Q.year, Q.month - 1);
    for (var _dc of Q.classes) {
        var _demo_result = {'date': _demo_date};
        for (var party of Q.parties) {
            _demo_result[party] = (Q[_dc + '_' + party + '_normalized'] || 0) * 100;
        }
        if (!Q.demographic_support_records[_dc]) Q.demographic_support_records[_dc] = [];
        Q.demographic_support_records[_dc].push(_demo_result);
    }

        Q.leadership_records = Q.leadership_records || [];
Q.leadership_records.push({
    date: new Date(Q.year, Q.month - 1, Q.weeks === 0 ? 1 : 15),
    chancellor: Q.chancellor,
    chancellor_party: Q.chancellor_party,
    president: Q.president,
    president_party: Q.president_party
});
}































/// SMALL SETTINGS

if (!Q.math_broken) {
    // NORMAL: Sum of progressive party support
    Q.progressive_coalition = Q.spd_r + Q.kpd_r + Q.ddp_r + Q.srpd_r + Q.sapd_r + Q.csrp_r;
} else {
    // MATH BROKEN: Coalition math doesn't add up
    Q.progressive_coalition = Q.impossible_add(
        Q.impossible_add(Q.spd_r, Q.kpd_r),
        Q.impossible_add(Q.impossible_add(Q.ddp_r, Q.srpd_r), Q.impossible_add(Q.sapd_r, Q.csrp_r))
    );
    console.log("COALITION CHAOS: Progressive coalition = " + Q.progressive_coalition + "%");
}


// ÷====================== SMALL CHECKERS FOR CABINETS ===============÷=======

// Derive the *_cabinet flag directly from whoever Q.chancellor currently is,
// instead of checking against a fixed list. Whichever chancellor is set,
// that one flag goes to 1 and every other previously-set *_cabinet flag
// from earlier chancellors is cleared.

if (Q.chancellor) {
    const currentKey = Q.chancellor
        .toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "") // strip diacritics: ü -> u, etc.
        + "_cabinet";

    if (Q._last_cabinet_key && Q._last_cabinet_key !== currentKey) {
        Q[Q._last_cabinet_key] = 0;
    }

    Q[currentKey] = 1;
    Q._last_cabinet_key = currentKey;
}




if (Q.inverted_ideos != 1) {

// ============================================================
// AUTO IDEOLOGY SCORER — derives 0 (far-left) to 20 (far-right)

const IDEO_KEYWORDS = [
    // 0 — revolutionary / Leninist left
    [/marxism-leninism/i,                 1],
    [/council communism/i,                0],

    // 2 — revolutionary but non-Leninist / left socialist
    [/revolutionary socialism/i,          2],
    [/left-wing socialism/i,              3],

    // NEW — Social Democracy family (must precede generic soc-dem/soc-rep below)
    [/social democracy \(revolutionary\)/i,      3],  // Left
    [/social democracy \(center marxist\)/i,     4],  // Center
    [/social democracy \(reformist\)/i,          6],  // Reformist
    [/laborism/i,                                7],  // Labor
    [/social republicanism \(neorevisionist\)/i, 8],  // Neorevisionist
    [/right-wing social democracy/i,      12],

    // 5 — mainstream social democracy
    [/social democracy/i,                 6],
    [/social republicanism/i,             7],

    // 7 — right social democracy / soft-left liberal
    [/catholic laborism/i,                10],

    // 10 — center / centrist liberal / cross-class Christian
    [/social liberalism/i,                9],
    [/christian socialism/i,              7],
    [/catholic tent/i,                    12],
    [/middle-class interest/i,            13],
    [/corporatism/i,                      15],

    // 13 — moderate conservative / regional Catholic conservative / Christian conservatives
    [/christian conservatism/i,           14],
    [/bavarian conservatism/i,            13],
    [/protestant social conservatism/i,   13],
    [/moderate conservatism/i,            14],
    [/liberal agrarianism/i,              12],

    // 15 — national liberal / agrarian-liberal right-center
    [/national liberalism/i,              14],
    [/hanoverian agrarianism/i,           15],
    [/hanseatic agrarian conservatism/i,  15],

    // 17 — hard agrarian conservative
    [/völkisch liberalism/i,              16],
    [/populist agrarian conservatism/i,   16],
    [/agrarian conservatism/i,            17],
    [/social corporatism/i,               16],

    // 18 — national conservative
    [/national conservatism/i,            18],

    // 20 — far-right nationalist / völkisch / Nazi
    [/national socialism/i,               20],
    [/völkisch nationalism/i,             20],
    [/national conservatism (Hugenbergite)/i,            18],
];

function ideoScore(ideologyString) {
    if (!ideologyString) return 10; // Fallback to absolute center (10)
    for (const [pattern, score] of IDEO_KEYWORDS) {
        if (pattern.test(ideologyString)) return score;
    }
    return 10; // Unrecognized ideology string -> treat as centrist/unknown
}

// Player-set numeric nudge on top of the keyword-derived base score.
// Set by the Party Ideologies editor screen (root.ideo_adjust).
// Defaults to 0 (no change) so untouched parties behave exactly as before.
function ideoScoreWithOverride(pid, ideologyString) {
    var base = ideoScore(ideologyString);
    var override = Q[pid + '_ideo_override'];
    if (override === undefined || override === null || isNaN(override)) {
        override = 0;
    }
    var final = base + override;
    if (final < 0) { final = 0; }
    if (final > 20) { final = 20; }
    return final;
}

// Apply to every active party, reading straight from Q.[party]_ideology
for (const p of Q.parties) {
    const key = p + '_ideology';
    Q[p + '_ideo_score'] = ideoScoreWithOverride(p, Q[key]);
}

// Also cover parties tracked outside Q.parties but referenced in
// party_relations / coalition_blocks (splinters, KPO, LB, etc.)
const EXTRA_IDEO_PARTIES = [
    'kpo', 'sl', 'sapd', 'srpd', 'ddp', 'z', 'bvp', 'csrp', 'dvp', 'wp',
    'cnbl', 'csvd', 'dnvp', 'vrp', 'kvp', 'dhp', 'bb', 'dvfp',
    'aspd', 'vnr', 'hl', 'lb', 'rdp', 'cvp', 'sls', 'dtsp', 'dbp', 'dsbp', 'dnf', 'rlb', 'faud', 'kapd', 'gsrn', 'pp', 'uspd'
];
for (const p of EXTRA_IDEO_PARTIES) {
    const key = p + '_ideology';
    if (Q[key] !== undefined) {
        Q[p + '_ideo_score'] = ideoScoreWithOverride(p, Q[key]);
    }
}

}



// REMOVE DUPLICATES 

Q.parties = [...new Set(Q.parties)];



// CODE EXAMPLE FOR REMOVING Tolerator...
// Q.tolerating_parties = Q.tolerating_parties.filter(function(p) { return p !== 'DVP'; });
// Q.dvp_tolerating = 0;

// QOL. TRACK GOVERNMENT VOTES.

// ============================================
// GOVERNMENT VOTE/SEAT TRACKER
// ============================================
Q.government_total_votes = 0;

for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    if (Q[p + '_in_government'] === 1) {
        Q.government_total_votes += Q[p + '_r'] || 0;
    }
}

Q.government_total_votes = Math.round(Q.government_total_votes * 10) / 10;


// ============================================
// CONSTITUTIONAL SUPERMAJORITY CHECK (2/3)
// ============================================
Q.has_supermajority = (Q.government_effective_pct >= 66.7) ? 1 : 0;


// ============================================
// GOVERNMENT COLLAPSE CHECK
// ============================================

var gov_count = 0;
for (var i = 0; i < Q.parties.length; i++) {
    if (Q[Q.parties[i] + '_in_government'] === 1) gov_count++;
}

if (gov_count > 0) {
    var effective_votes = Q.government_total_votes;

    if (Q.tolerating_parties) {
        for (var i = 0; i < Q.tolerating_parties.length; i++) {
            var tp = Q.tolerating_parties[i].toLowerCase();
            if (Q[tp + '_in_government'] !== 1) {
                effective_votes += Q[tp + '_r'] || 0;
            }
        }
    }

    if (effective_votes < 50 && !(Q.in_emergency_government >= 1)) {
        Q.government_collapsed = 1;
        Q.next_election_year = Q.year;
        Q.next_election_month = Q.month + 2;
        if (Q.next_election_month > 12) {
            Q.next_election_month = 1;
            Q.next_election_year += 1;
        }
        for (var i = 0; i < Q.parties.length; i++) {
            Q[Q.parties[i] + '_in_government'] = 0;
        }
        Q.government_parties = [];
        Q.tolerating_parties = [];
        Q.spd_toleration = 0;
        Q.is_minority_government = 0;
    }
}







// QOL. REMOVES PHANTON PARTIES.

const inGov = Object.keys(Q)
  .filter(key => key.endsWith("_in_government") && Q[key] == 1)
  .map(key => key.replace("_in_government", ""))
  .filter(party => (Q[party + "_votes"] > 0) && (Q[party + "_r"] > 0))
  .map(party => party.toUpperCase());

Q.parties_in_government_display = inGov.length > 0
  ? inGov.join(", ")
  : "None";



// === PARTY RELATION GRAVITY ===
Q.relation_gravity = function(value) {
    var abs = Math.abs(value);
    if (abs <= 80) return value;
    var pull = (abs - 80) * 0.04;
    return value > 0 ? value - pull : value + pull;
};

for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    Q[p + '_relation'] = Q.relation_gravity(Q[p + '_relation'] || 0);
    if (!Q.math_broken) {
        Q[p + '_relation'] = Math.max(-100, Math.min(100, Q[p + '_relation']));
    } else {
        Q[p + '_relation'] = Q.impossible_add(Q[p + '_relation'], 0);
    }
}

// === CHECK FOR LOW-RELATION COALITION PARTNER ===
Q.coalition_low_relation = 0;

// Check full government parties (threshold: <= 30)
for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    if (p === "spd") continue;
    if (Q[p + '_in_government'] === 1 && Q[p + '_relation'] <= 30) {
        Q.coalition_low_relation = 1;
        break;
    }
}

// Check tolerating parties (threshold: <= 20), only if not already triggered
if (!Q.coalition_low_relation && Q.tolerating_parties) {
    for (var i = 0; i < Q.tolerating_parties.length; i++) {
        var tp = Q.tolerating_parties[i].toLowerCase();
        if (tp === "spd") continue;
        if (Q[tp + '_relation'] <= 20) {
            Q.coalition_low_relation = 1;
            break;
        }
    }
}


// === CHECK FOR LOW-RELATION COALITION PARTNER ===
Q.coalition_mid_relation = 0;
Q.mad_party = "";
Q.mad_party_key = "";
var lowest_relation = 999;

for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    if (p === "spd") continue;
    if (Q[p + '_in_government'] === 1 && Q[p + '_relation'] < 45 && Q[p + '_relation'] < lowest_relation) {
        Q.coalition_mid_relation = 1;
        Q.mad_party = p.toUpperCase();
        Q.mad_party_key = p;
        lowest_relation = Q[p + '_relation'];
    }
}






Q.coalition_tension = 0;

if (Q.government_parties) {
    for (var i = 0; i < Q.government_parties.length; i++) {
        var p = Q.government_parties[i].toLowerCase();
        if (p === 'spd') continue;
        var rel = Q[p + '_relation'] !== undefined ? Q[p + '_relation'] : 50;
        if (rel < 50) {
            Q.coalition_tension += (50 - rel) / 10;
        }
    }
}

Q.coalition_tension = Math.round(Q.coalition_tension * 10) / 10;

// === VARIABLE RANGE CAPPING ===

Q.capped_var_ranges = {
    // 0 to 10
    pro_consumer:              [0, 10],
    agricultural_finance:      [0, 10],
    land_reform:               [0, 10],
    socialization:             [0, 10],
    commonwealth_cooperation:  [0, 10],
    cooperatives:              [0, 10],
    economic_democracy:        [0, 20],
    workers_safety:            [0, 10],
    working_hours:             [0, 10],
    womens_rights:             [0, 10],

    // -10 to 10
    welfare:                   [-10, 10],
    judicial_reform:           [-10, 10],
    pacifism:                  [-10, 10],
    radicalization:            [-10, 10],
    democratization:           [-10, 10],

    // -1 to 2
    confronting_antisemitism:  [-1, 2],

    // 0 to 15
    workers_aid:               [0, 15],
    campaign_media:            [0, 15],
    commercialized_media:      [0, 15],
    cultural_organizations:    [0, 15],
    wtb_support:               [0, 15],
    local_rally:               [0, 15],
    peoples_party_support:     [0, 15]
};

Q.apply_var_caps = function() {
    for (var varName in Q.capped_var_ranges) {
        if (!Q.capped_var_ranges.hasOwnProperty(varName)) continue;
        if (Q[varName] === undefined) continue; // skip vars not in use

        var range = Q.capped_var_ranges[varName];
        var min = range[0];
        var max = range[1];

        if (Q[varName] < min) {
            Q[varName] = min;
        } else if (Q[varName] > max) {
            Q[varName] = max;
        }
    }
};

Q.apply_var_caps();








// === LOBBYING ACTIVITY CHECK ===
Q.lobbying_active = 0;
Q.lobbyable_ministries = [];

for (var i = 0; i < portfolios.length; i++) {
    var port = portfolios[i];
    var mp = (Q[port + '_party'] || '').toLowerCase();
    var qualifies = mp && (Q[mp + '_relation'] || 0) >= 80;

    // flat boolean per portfolio, for use in plain view-if: syntax
    Q['lobby_' + port + '_available'] = qualifies ? 1 : 0;

    if (qualifies) {
        Q.lobbying_active = 1;
        Q.lobbyable_ministries.push({ portfolio: port, party: mp });
    }
}







Q.inflation              = Math.max(-100, Math.min(1000, Q.inflation));
Q.unemployed             = Math.max(0,   Math.min(50,   Q.unemployed));
Q.economic_growth        = Math.max(-100, Math.min(20,   Q.economic_growth));
Q.inflation_expectations = Math.max(-35, Math.min(1000, Q.inflation_expectations));
Q.budget = Math.max(-50, Math.min(50, Q.budget));
Q.budget = Math.round(Q.budget * 100) / 100;

Q.capital_strike_progress = Math.max(0, Math.min(15, Q.capital_strike_progress || 0));
Q.coup_progress           = Math.max(0, Math.min(15, Q.coup_progress           || 0));
Q.general_strike_progress = Math.max(0, Math.min(15, Q.general_strike_progress || 0));

