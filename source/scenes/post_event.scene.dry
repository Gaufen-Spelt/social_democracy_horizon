// ECONOMIC SIMULATION — v7 (CORE REBUILD)
//
// Design principles, in order of priority:
//   1. Phases are NON-OVERLAPPING REGIONS of (inflation, growth, unemployment) space,
//      checked in fixed priority order. Two phases can never both claim to be "true"
//      for the same state — that ambiguity was the root cause of the v6 flapping and
//      hyperinflation/depression overlap.
//   2. Hysteresis is done with plain tick counters (integers), not decayed/smoothed
//      floats. "Qualified for N consecutive ticks" is auditable; an EMA score is not.
//   3. Inflation has a genuine two-sided feedback: whatever mechanism can make it
//      run away must be matched by a mechanism that can pull it back, scaled by the
//      SAME multiplier — no one-way valves.
//   4. Only inflation, unemployed, economic_growth are required. Everything else
//      (debt, velocity, FX) is a separate optional module that reads/writes these
//      three but does not change how the state machine works.
//
// ============================================================
// SECTION 0 — TIME CONSTANTS
// ============================================================

const DT_SCALE = 0.65;
const dt = 1 * DT_SCALE;

const POTENTIAL_GROWTH = 2.5;
const BASE_NAIRU = 6.0;
const BASE_INFLATION_TARGET = 2.5;


// ============================================================
// SECTION 1 — INITIALIZATION
// ============================================================

if (!Q.economyInitialized) {
    // Core three
    Q.inflation       = 2.5;
    Q.unemployed      = 6.0;
    Q.economic_growth = 2.5;

    // Structural / slow-moving
    Q.NAIRU                  = BASE_NAIRU;
    Q.inflation_expectations = BASE_INFLATION_TARGET;
    Q.expectations_anchored  = true;
    Q.anchor_break_streak    = 0;   // ticks spent with inflation far from target
    Q.anchor_repair_streak   = 0;   // ticks spent back near target

    // Transient pressures (policy impulses accumulate here, then decay)
    Q.demand_pressure = 0;
    Q.supply_pressure = 0;
    Q.price_pressure  = 0;

    // Phase machine
    Q.phase              = "growth";
    Q.phase_duration      = 0;
    Q.pending_phase       = null;
    Q.pending_phase_ticks = 0;
    Q.clear_zone_ticks    = 0;

    Q.economyInitialized = true;
}

Q.tick = (Q.tick || 0) + 1;
Q.phase_duration = (Q.phase_duration || 0) + 1;


// ============================================================
// SECTION 2 — POLICY IMPULSE INTAKE
// ============================================================
// External code sets Q.demand_impulse / Q.supply_impulse / Q.fiscal_impulse
// as one-shot values; we absorb them into the persistent pressure pools.

function policyScale() {
    // Impulses land harder when the economy is already in a bad state —
    // e.g. stimulus is less effective in a liquidity trap, rate hikes bite
    // harder when unemployment is already low. Capped so it can't explode.
    let scale = 1.0;
    if (Q.unemployed > 15) scale += Math.min(1.0, (Q.unemployed - 15) * 0.05);
    if (Q.inflation < -3)  scale += Math.min(0.6, Math.abs(Q.inflation + 3) * 0.08);
    return Math.min(2.5, scale);
}

if (Q.demand_impulse) {
    Q.demand_pressure += Q.demand_impulse * policyScale();
    Q.demand_impulse = 0;
}
if (Q.supply_impulse) {
    Q.supply_pressure += Q.supply_impulse * policyScale();
    Q.supply_impulse = 0;
}
if (Q.fiscal_impulse) {
    // fiscal_impulse > 0 = stimulus (expansionary), < 0 = austerity
    Q.demand_pressure += Q.fiscal_impulse * 0.5 * policyScale();
    Q.fiscal_impulse = 0;
}


// ============================================================
// SECTION 3 — PHASE STATE MACHINE (non-overlapping regions)
// ============================================================
//
// Each phase is defined by a "zone test" — a boolean function of the current
// (inflation, growth, unemployed). Zones are checked in priority order so that
// if a state happens to satisfy two zones' loose conditions, the higher-priority
// one wins deterministically, and the definitions themselves are written to
// avoid overlap wherever possible (hyperinflation and depression are gated on
// opposite sides of an inflation threshold, so they literally cannot both be true).
//
// Hysteresis: to CHANGE phase, the new zone must be satisfied for
// ENTER_TICKS consecutive ticks. To prevent instant reversal, a phase must
// also have lasted at least MIN_PHASE_TICKS before it's eligible to exit.

const ENTER_TICKS     = 3;   // consecutive ticks a new zone must hold before we switch
const MIN_PHASE_TICKS = 4;   // minimum ticks in a phase before it can change again

const ZONES = {
    // Order matters: checked top to bottom, first match wins.
    hyperinflation: (inf, grw, unem) => inf > 15,

    depression:     (inf, grw, unem) => inf <= 15 && grw < -3 && unem > 12,

    stagflation:    (inf, grw, unem) => inf <= 15 && inf > 5 && grw < 1 && unem > Q.NAIRU + 2,

    overheating:    (inf, grw, unem) => inf <= 15 && inf > 4.5 && grw > 3 && unem < Q.NAIRU,

    correction:     (inf, grw, unem) => inf <= 15 && grw < 0 && grw >= -3,

    growth:         (inf, grw, unem) => true, // default / fallback zone
};

const ZONE_ORDER = ["hyperinflation", "depression", "stagflation", "overheating", "correction", "growth"];

function currentZone() {
    for (const name of ZONE_ORDER) {
        if (ZONES[name](Q.inflation, Q.economic_growth, Q.unemployed)) return name;
    }
    return "growth";
}

{
    const zoneNow = currentZone();

    if (zoneNow === Q.phase) {
        // Still in the zone we're already labeled as; reset any pending switch.
        Q.pending_phase = null;
        Q.pending_phase_ticks = 0;
    } else {
        // We're in a different zone than our current label.
        if (Q.pending_phase === zoneNow) {
            Q.pending_phase_ticks += 1;
        } else {
            Q.pending_phase = zoneNow;
            Q.pending_phase_ticks = 1;
        }

        const eligibleToSwitch = Q.phase_duration >= MIN_PHASE_TICKS;
        const heldLongEnough   = Q.pending_phase_ticks >= ENTER_TICKS;

        // Hyperinflation is an emergency zone: allowed to override MIN_PHASE_TICKS,
        // because "wait 4 ticks before acknowledging hyperinflation" is not realistic.
        const isEmergencyOverride = zoneNow === "hyperinflation";

        if (heldLongEnough && (eligibleToSwitch || isEmergencyOverride)) {
            Q.phase = zoneNow;
            Q.phase_duration = 0;
            Q.pending_phase = null;
            Q.pending_phase_ticks = 0;
        }
    }
}


// ============================================================
// SECTION 4 — STRUCTURAL DRIFT (NAIRU, expectations anchor)
// ============================================================

// NAIRU hysteresis: prolonged depression raises structural unemployment slowly;
// recovery brings it back down slowly. This is deliberately slow-moving.
if (Q.phase === "depression" && Q.phase_duration > 8) {
    Q.NAIRU += (9.0 - Q.NAIRU) * 0.01 * dt;
} else {
    Q.NAIRU += (BASE_NAIRU - Q.NAIRU) * 0.008 * dt;
}
Q.NAIRU = Math.max(3, Math.min(12, Q.NAIRU));

// Anchoring: expectations "de-anchor" only after a sustained period of
// inflation far from target, and "re-anchor" only after a sustained period
// of inflation near target. Plain tick counters — no smoothed streaks.
const farFromTarget = Math.abs(Q.inflation - BASE_INFLATION_TARGET) > 4;
const nearTarget     = Math.abs(Q.inflation - BASE_INFLATION_TARGET) <= 2;

if (farFromTarget) {
    Q.anchor_break_streak += 1;
    Q.anchor_repair_streak = 0;
} else if (nearTarget) {
    Q.anchor_repair_streak += 1;
    Q.anchor_break_streak = 0;
} else {
    // in the middle zone, neither streak advances but neither resets to 0 instantly
    Q.anchor_break_streak = Math.max(0, Q.anchor_break_streak - 1);
    Q.anchor_repair_streak = Math.max(0, Q.anchor_repair_streak - 1);
}

if (Q.expectations_anchored && Q.anchor_break_streak > 5) {
    Q.expectations_anchored = false;
}
if (!Q.expectations_anchored && Q.anchor_repair_streak > 6) {
    Q.expectations_anchored = true;
}

// Expectations chase actual inflation, faster when unanchored.
const expectationSpeed = Q.expectations_anchored ? 0.06 : 0.16;
Q.inflation_expectations += expectationSpeed * (Q.inflation - Q.inflation_expectations) * dt;
if (Q.expectations_anchored) {
    // gentle pull back to the long-run target even if current inflation is off
    Q.inflation_expectations += 0.03 * (BASE_INFLATION_TARGET - Q.inflation_expectations) * dt;
}


// ============================================================
// SECTION 5 — DELTA COMPUTATION
// ============================================================

const outputGap = Q.economic_growth - POTENTIAL_GROWTH;
const uGap      = Q.unemployed - Q.NAIRU;

// ---- dINFLATION ----
// Two-sided by construction: runaway terms (Phillips curve slope, expectations
// unanchoring) are matched by a restoring term that scales with how unanchored
// things have gotten, so there is no regime where only the runaway side can act.

let dInflation = 0;

// Phillips-curve-ish core: tight labor market + strong output push inflation up
dInflation += 0.05 * -uGap;
dInflation += 0.03 * outputGap;
dInflation += Q.price_pressure * 0.10;

// Expectations pull: if actual inflation is below expectations, it gets pulled up;
// if above, pulled down. This term runs BOTH directions symmetrically.
dInflation += 0.08 * (Q.inflation_expectations - Q.inflation);

// Extra de-anchoring acceleration, but capped and always paired with restoring force below
if (!Q.expectations_anchored) {
    const runaway = Math.max(0, Q.inflation_expectations - Q.inflation) * 0.10;
    dInflation += runaway;
}

// RESTORING FORCE: grows with how far inflation has drifted from target,
// and — critically — grows faster than the runaway terms can as drift increases,
// so extreme inflation is always self-limiting rather than a one-way valve.
const drift = Q.inflation - BASE_INFLATION_TARGET;
const restoringForce = Math.sign(drift) * 0.02 * Math.pow(Math.abs(drift) / 10, 1.6);
dInflation -= restoringForce;

// Small noise
dInflation += (Math.random() - 0.5) * 0.03;

// Deflation has its own (weaker, asymmetric) dynamic — deflation is sticky but
// still capped, doesn't need the same restoring curve since it's bounded below.
dInflation = Math.max(-2.0, Math.min(6.0, dInflation));


// ---- dUNEMPLOYMENT ----
// Okun's law: growth below potential raises unemployment, above potential lowers it.
let dUnemployment = 0;
const okunsCoeff = outputGap < 0 ? 0.035 : 0.022;
dUnemployment -= okunsCoeff * outputGap / (1 + Math.abs(outputGap) * 0.2);

// Demand pressure (policy) directly affects jobs
dUnemployment -= Q.demand_pressure * 0.4;

// Mean reversion toward NAIRU when far off, prevents permanent runaway either direction
dUnemployment -= 0.03 * uGap / (1 + Math.abs(uGap) * 0.1);

dUnemployment += (Math.random() - 0.5) * 0.015;
dUnemployment = Math.max(-2.0, Math.min(2.0, dUnemployment));


// ---- dGROWTH ----
let dGrowth = 0;

// Mean reversion toward potential growth (economies don't grow or shrink forever
// at extreme rates without a force pushing back)
dGrowth += 0.05 * (POTENTIAL_GROWTH - Q.economic_growth) / (1 + Math.abs(outputGap) * 0.15);

// Demand and supply pressures move growth directly
dGrowth += Q.demand_pressure * 0.6;
dGrowth += Q.supply_pressure * 0.6;

// High inflation drags on growth (uncertainty, misallocation)
if (Q.inflation > 6) {
    dGrowth -= Math.min(0.02 * (Q.inflation - 6), 1.2);
}
// Deep deflation also drags on growth (debt-deflation spiral), asymmetric but bounded
if (Q.inflation < -2) {
    dGrowth -= Math.min(0.03 * Math.abs(Q.inflation + 2), 1.0);
}

// High unemployment above NAIRU drags on growth (lost capacity)
if (uGap > 0) {
    dGrowth -= Math.min(0.01 * uGap, 1.0);
}

dGrowth += (Math.random() - 0.5) * 0.02;
dGrowth = Math.max(-3.0, Math.min(3.0, dGrowth));


// ============================================================
// SECTION 6 — APPLY DELTAS
// ============================================================

Q.inflation       += dInflation * dt;
Q.unemployed      += dUnemployment * dt;
Q.economic_growth += dGrowth * dt;


// ============================================================
// SECTION 7 — DECAY TRANSIENT PRESSURES
// ============================================================

Q.demand_pressure *= Math.exp(-0.20 * dt);
Q.supply_pressure *= Math.exp(-0.20 * dt);
Q.price_pressure  *= Math.exp(-0.25 * dt);





Q.inflation              = Math.max(-15, Math.min(1000, Q.inflation));
Q.unemployed             = Math.max(0,   Math.min(50,   Q.unemployed));
Q.economic_growth        = Math.max(-20, Math.min(20,   Q.economic_growth));
Q.inflation_expectations = Math.max(-15, Math.min(1000, Q.inflation_expectations));
Q.budget = Math.max(-50, Math.min(50, Q.budget));
Q.budget = Math.round(Q.budget * 100) / 100;






// =========================== CABINET ECONOMICAL EFFECTS ====================




// ============================================================
// BRÜNING AUSTERITY / LAUTENBACH PLAN — mutually exclusive
// ============================================================

if (Q.bruning_cabinet === 1 && Q.lautenbach_plan_active !== 1 && Q.lautenbach_plan_rejected === 1) {

    // Budget improves modestly — spending cuts and tax enforcement
    Q.budget += 0.07;

    // Deflation pressure — wage cuts, price controls, tight money
    // (was Q.dInflation -= 0.03; that variable doesn't exist in v5)
    Q.price_pressure    -= 0.05;   // stronger signal to compensate

    // Demand collapses — less public spending, lower wages
    Q.demand_impulse    -= 0.07;
    Q.fiscal_stance     -= 0.06;

    // Unemployment creeps up — layoffs from public sector cuts
    // (was Q.dUnemployment += 0.07; routed through demand instead)
    Q.demand_impulse    -= 0.03;   // indirect unemployment channel

    // Capital pressure eases slightly — creditor confidence
    Q.capital_pressure  -= 0.03;

    // Trade pressure eases — deflation makes exports cheaper
    Q.trade_pressure    -= 0.03;

    // Austerity reduces monetization pressure — fiscal tightening
    // is the primary way to stop Weimar-style money printing
    Q.monetization_pressure = Math.max(0, (Q.monetization_pressure || 0) - 0.04);

} else if (Q.bruning_cabinet === 1 && Q.lautenbach_plan_active === 1 && !Q.return_to_normalcy) {

    // --------------------------------------------------------
    // LAUTENBACH PLAN — credit-financed public investment
    // Semi-WTB, pre-Keynesian demand stimulus
    // Overrides austerity but carries inflation/debt risk
    // --------------------------------------------------------

    // Budget takes a hit — deficit spending is the mechanism
    Q.budget            -= 0.16;

    // Demand recovers — public works and credit expansion
    Q.demand_impulse    += 0.10;
    Q.fiscal_stance     += 0.04;

    // Supply side benefits — infrastructure investment
    Q.supply_impulse    += 0.05;

    // Unemployment falls — job creation programs
    // Routed through demand (demandUCoeff handles unemployment in v5)
    Q.demand_impulse    += 0.03;

    // Growth nudge routed through demand + supply forces
    // (was Q.dGrowth += 0.05; that variable doesn't exist in v5)
    Q.supply_impulse    += 0.02;

    // Inflation creeps back — more money chasing goods
    Q.price_pressure    += 0.04;

    // Capital pressure rises — creditors nervous about deficit
    Q.capital_pressure  += 0.04;

    // Trade pressure ticks up — imports rise with demand
    Q.trade_pressure    += 0.03;

    // Modest monetization risk — deficit financed but not pure printing
    Q.monetization_pressure = Math.min(2.0, (Q.monetization_pressure || 0) + 0.02);
}


if (Q.wagemann_plan_active === 1 && Q.year >= 1932 && Q.year < 1933) {
    Q.lautenbach_plan_active   = 0;
    Q.lautenbach_plan_rejected = 0;

    // --------------------------------------------------------
    // WAGEMANN PLAN — monetary expansion / reflation
    // This IS the Weimar money-printing mechanic.
    // Feeds monetization_pressure directly in v5.
    // --------------------------------------------------------

    // Core: directly inject monetization pressure
    // Wagemann's plan was essentially deficit monetization —
    // the exact mechanism the v5 engine models with this variable.
    Q.monetization_pressure = Math.min(2.0, (Q.monetization_pressure || 0) + 0.12);

    // Price and demand effects of monetary expansion
    Q.price_pressure            += 0.08;
    Q.demand_impulse            += 0.10;
    Q.credit_expansion           = Math.min(0.8, (Q.credit_expansion || 0) + 0.06);

    // If expectations already unanchored, spiral risk kicks in
    // Wagemann's plan was terrifying to anyone who remembered 1923
    if (!Q.expectations_anchored) {
        Q.monetization_pressure  = Math.min(2.0, Q.monetization_pressure + 0.10);
        Q.price_pressure        += 0.06;
        // Drive high_inflation_streak rather than directly editing expectations
        // — this respects the anchoring state machine in v5
        Q.high_inflation_streak  = (Q.high_inflation_streak || 0) + 1.5;
    }

    // Growth benefits modestly — reflation puts money into circulation
    // Routed through demand force (was Q.dGrowth += 0.06)
    Q.supply_impulse            += 0.03;

    // Budget neutral-to-positive — monetary not fiscal
    Q.budget                    += 0.05;

    // Capital flight risk — foreign creditors panic at money-printing
    Q.capital_pressure          += 0.08;
    Q.trade_pressure            += 0.05;

    // If inflation already above 4, compounding risk
    // The 1923 memory makes markets overreact
    if (Q.inflation > 4) {
        Q.capital_pressure      += 0.06;
        Q.monetization_pressure  = Math.min(2.0, Q.monetization_pressure + 0.05);
    }
}


// ============================================================
// WTB TIMER EFFECTS
// ============================================================

if ((Q.wtb_timer || 0) > 0) {

    const diminish = Q.wtb_implemented >= 4 ? 0.70 : 1.0;

    Q.demand_impulse   = (Q.demand_impulse  || 0) + 0.04 * diminish;
    Q.fiscal_stance    = (Q.fiscal_stance   || 0) - 0.03 * diminish;
    Q.price_pressure   = (Q.price_pressure  || 0) + 0.02 * diminish;
    Q.supply_impulse   = (Q.supply_impulse  || 0) + 0.02 * diminish;
    Q.capital_pressure = Math.max(0, (Q.capital_pressure || 0) - 0.01 * diminish);
}



















































// ============================================
// PRESIDENTIAL PATIENCE
// ============================================




if (Q.presidential_powers == 0 && !Q.government_dismissed) {

    var pp_gov_count = 0;
    for (var i = 0; i < Q.parties.length; i++) {
        if (Q[Q.parties[i] + '_in_government'] === 1) pp_gov_count++;
    }

    if (pp_gov_count > 0 && !Q.emergency_rule) {

        // --- target patience level based on current economic conditions ---
        var pp_unemp_stress = Math.max(0, (Q.unemployed || 0) - 8);         // 0 at baseline
        var pp_infl_stress  = Math.abs((Q.inflation || 0) - 2);              // 0 at stable 2%
        var pp_growth_bonus = Math.max(0, (Q.economic_growth || 0) - 1);     // rewards real growth
        var pp_growth_stress = Math.max(0, -(Q.economic_growth || 0));      // punishes contraction

        var pp_target = 50;
        pp_target -= pp_unemp_stress   * 3.0;
        pp_target -= pp_infl_stress    * 2.0;
        pp_target -= pp_growth_stress  * 4.0;
        pp_target += pp_growth_bonus   * 2.0;
        pp_target = Math.max(0, Math.min(100, pp_target));

        // --- drift current patience toward target, slowly ---
        var pp_decay_rate = 0.12; // base monthly drift speed
        if (Q.presidential_cabinet === 1) {
            pp_decay_rate *= 0.7; // 30% slowdown: this is his own cabinet
        }

        Q.presidential_patience = (Q.presidential_patience === undefined) ? 50 : Q.presidential_patience;

        // --- compute drift, with a minimum step so it doesn't stall near the target ---
        var pp_delta = (pp_target - Q.presidential_patience) * pp_decay_rate;
        var pp_min_step = 1.0; // minimum monthly movement once heading toward target
        if (Math.abs(pp_delta) < pp_min_step && Q.presidential_patience !== pp_target) {
            pp_delta = pp_min_step * Math.sign(pp_target - Q.presidential_patience);
        }
        Q.presidential_patience += pp_delta;

        Q.presidential_patience = Math.max(0, Math.min(100, Q.presidential_patience));
        Q.presidential_patience = Math.round(Q.presidential_patience * 100) / 100;

        // --- dismissal trigger (edge-triggered: fires once, on crossing to 0) ---
        if (Q.presidential_patience <= 0) {
            Q.government_dismissed = 1;
            Q.government_dismissed_reason = "presidential_patience";

        }
    }
}








































    
// ============================================================
// OPINION DYNAMICS — v3 (IDEOLOGY-SCORE REBUILD)
// Tick = 2 weeks (semi-month)
//
// This version replaces the old discrete party-bucket system
// (socialist_party_count / centrist_party_count / nationalist_party_count,
// built from long if-chains of named parties) with a continuous
// 0–20 ideology score per party (Q.[party]_ideo_score, produced by the
// AUTO IDEOLOGY SCORER — must run BEFORE this file each tick).
//
// BANDS (score 0-20, 10 = dead center):
//   radical-left    0-4
//   moderate-left   5-9
//   centrist        10
//   moderate-right  11-14
//   radical-right   15-20
//
// INFLUENCE: each government party's influence = |score - 10| / 10
//   (0 at dead center, 1.0 at the extremes). Band influence is the
//   sum of its members' influence, capped at 1.0. This replaces the
//   old bloc_influence() count-based formula entirely.
//
// FEED MODEL (this is the actual behavioral change from v2):
//   - MODERATE bands (moderate-left, moderate-right) push socialism/
//     nationalism respectively at ALL times, scaled only by their
//     influence — NOT gated by econ_negative, NOT counted as
//     "radicalization." This is the crisis-independent floor: it's
//     what keeps nationalism/socialism from bottoming out near 0.1%
//     during good times, because a moderate-right DNVP-line government
//     (say) keeps some nationalist sentiment alive purely by existing,
//     regardless of the economy.
//   - RADICAL bands (radical-left, radical-right) push socialism/
//     nationalism ONLY when econ_negative > 0 — i.e. crisis-gated,
//     same spirit as the old ember/radicalization mechanic, but now a
//     live term (no persistent stock) scaled by influence * econ_negative.
//
// FLAGS: downstream mechanics (honeymoon, TSE, cross-pressure, betrayal)
// still want simple booleans. We provide BOTH general flags
// (socialist_in_power / nationalist_in_power / centrist_in_power) that
// treat radical+moderate as one side, AND finer subtyped flags
// (radical_left_in_power / moderate_left_in_power / radical_right_in_power /
// moderate_right_in_power) so mechanics that care about the radical/
// moderate distinction (e.g. TSE blame deflection, betrayal thresholds)
// can use the sharper flag where it matters.
// ============================================================

// ============================================================
// HELPERS
// ============================================================

function scale(value, low, high) {
    return Math.max(0, Math.min(1, (value - low) / (high - low)));
}

function lerp(a, b, t) {
    return a + (b - a) * Math.max(0, Math.min(1, t));
}

// Soft sigmoid approach to ceilings/floors — replaces hard clamp logic.
// Returns a multiplier that tapers toward zero as value approaches wall.
function wall_damp(value, wall, width, pushing_toward_wall) {
    if (!pushing_toward_wall) return 1.0;
    var dist = Math.abs(value - wall);
    return Math.max(0, Math.min(1, dist / width));
}

// ============================================================
// VELOCITY TRACKING
// Last-tick deltas stored on Q to compute momentum.
// ============================================================

if (Q.nat_vel  === undefined) Q.nat_vel  = 0;
if (Q.soc_vel  === undefined) Q.soc_vel  = 0;
if (Q.pr_vel   === undefined) Q.pr_vel   = 0;

// Momentum factor: a signal moving fast in one direction amplifies
// further movement in that direction (bandwagon), but only up to a cap.
// Negative momentum (reversals) face friction.
function momentum_mult(velocity, direction) {
    // direction: +1 or -1 for which way we're currently pushing
    var alignment = velocity * direction; // positive = bandwagon, negative = reversal
    if (alignment > 0) {
        // Bandwagon: up to 1.35x amplification, saturating around vel=3
        return 1.0 + Math.min(0.35, alignment * 0.12);
    } else {
        // Reversal friction: harder to turn a fast-moving trend
        return Math.max(0.55, 1.0 + alignment * 0.08);
    }
}

// ============================================================
// TSE FLAG
// ============================================================

var tse = Q.transformed_socialist_economy ? 1 : 0;

// ============================================================
// TICK SCALING
// ============================================================

var TICK = 0.38; // master scalar

// ============================================================
// CONTINUOUS ECONOMY SIGNAL
// Returns a value in [-1, +1]: +1 = prosperity, -1 = crisis, 0 = mixed.
// ============================================================

var unemp_score     = 1 - scale(Q.unemployed,       3, 22);
var inflation_score = 1 - scale(Math.abs(Q.inflation), 2, 14);
var growth_score    = scale(Q.economic_growth,      -4, 6);

var econ_composite = (unemp_score * 0.40) + (growth_score * 0.35) + (inflation_score * 0.25);
var econ_signal = (econ_composite - 0.5) * 2.0;

if (tse) {
    econ_signal -= scale(Q.unemployed, 4, 10) * 0.25;
}

econ_signal = Math.max(-1, Math.min(1, econ_signal));

var econ_positive = Math.max(0,  econ_signal);
var econ_negative = Math.max(0, -econ_signal);
var econ_mixed    = 1 - Math.abs(econ_signal);

// ============================================================
// PHASE MULTIPLIERS
// ============================================================

var phase_unemp_mult       = 1.0;
var phase_inflation_mult   = 1.0;
var phase_growth_mult      = 1.0;
var phase_centrist_penalty = 0.0;

switch (Q.phase) {
    case "growth":
        phase_unemp_mult     = 0.7;
        phase_inflation_mult = 0.8;
        phase_growth_mult    = 1.4;
        break;
    case "overheating":
        phase_unemp_mult     = 0.8;
        phase_inflation_mult = 1.3;
        phase_growth_mult    = 1.2;
        break;
    case "hyperinflation":
        phase_unemp_mult       = 0.9;
        phase_inflation_mult   = 2.2;
        phase_growth_mult      = 1.0;
        phase_centrist_penalty = 0.8;
        break;
    case "correction":
        phase_unemp_mult     = 1.2;
        phase_inflation_mult = 1.0;
        phase_growth_mult    = 1.3;
        break;
    case "depression":
        phase_unemp_mult       = 2.0;
        phase_inflation_mult   = 0.7;
        phase_growth_mult      = 1.6;
        phase_centrist_penalty = 1.0;
        break;
    case "stagflation":
        phase_unemp_mult       = 1.4;
        phase_inflation_mult   = 1.4;
        phase_growth_mult      = 1.2;
        phase_centrist_penalty = 1.4;
        break;
}

var unemp_neg    = scale(Q.unemployed,           8, 25) * phase_unemp_mult;
var unemp_pos    = (1 - scale(Q.unemployed,      3, 10)) * (2.0 - phase_unemp_mult);
var infl_neg     = scale(Math.abs(Q.inflation),  5, 15) * phase_inflation_mult;
var infl_pos     = (1 - scale(Math.abs(Q.inflation), 3, 8)) * (2.0 - phase_inflation_mult);
var growth_pos   = scale(Q.economic_growth,      1,  6) * phase_growth_mult;
var growth_neg   = scale(-Q.economic_growth,     1, 10) * phase_growth_mult;

if (tse) {
    unemp_neg *= 1.4;
    unemp_pos *= 1.3;
}

unemp_pos  = Math.max(0, Math.min(1, unemp_pos));
infl_pos   = Math.max(0, Math.min(1, infl_pos));

// ============================================================
// IDEOLOGY BANDS AND INFLUENCE
// Requires Q.[party]_ideo_score to already be set (AUTO IDEOLOGY
// SCORER block runs earlier in the tick, before this file).
// Requires Q.parties (array of active party keys) and government
// status flags Q.[party]_in_government, as before.
// ============================================================

const IDEO_BANDS = {
    radical_left:   (s) => s <= 4,
    moderate_left:  (s) => s >= 5  && s <= 9,
    centrist:       (s) => s === 10,
    moderate_right: (s) => s >= 11 && s <= 14,
    radical_right:  (s) => s >= 15,
};

function bandOf(score) {
    if (score === undefined || score === null) return "centrist"; // unscored -> treat as neutral
    if (IDEO_BANDS.radical_left(score))   return "radical_left";
    if (IDEO_BANDS.moderate_left(score))  return "moderate_left";
    if (IDEO_BANDS.centrist(score))       return "centrist";
    if (IDEO_BANDS.moderate_right(score)) return "moderate_right";
    return "radical_right";
}

// party_influence = |score - 10| / 10, clamped to [0,1]
function partyInfluence(score) {
    if (score === undefined || score === null) return 0;
    return Math.max(0, Math.min(1, Math.abs(score - 10) / 10));
}

var band_influence = {
    radical_left:   0,
    moderate_left:  0,
    centrist:       0,
    moderate_right: 0,
    radical_right:  0,
};
var band_party_count = {
    radical_left:   0,
    moderate_left:  0,
    centrist:       0,
    moderate_right: 0,
    radical_right:  0,
};

// Union of Q.parties plus any extra scored parties not in that array
// (splinters, etc. — anything carrying a [party]_ideo_score).
var _ideo_party_set = {};
if (Q.parties) {
    for (const p of Q.parties) _ideo_party_set[p] = true;
}
for (const key in Q) {
    if (key.endsWith('_ideo_score')) {
        _ideo_party_set[key.slice(0, -'_ideo_score'.length)] = true;
    }
}

for (const p in _ideo_party_set) {
    if (!Q[p + '_in_government']) continue; // only governing parties count toward influence
    const score = Q[p + '_ideo_score'];
    const band  = bandOf(score);
    const infl  = partyInfluence(score);
    band_influence[band] += infl;
    band_party_count[band] += 1;
}

// Cap each band's summed influence at 1.0, same ceiling as the old bloc_influence.
for (const b in band_influence) {
    band_influence[b] = Math.min(1.0, band_influence[b]);
}

// ---- General flags (either radical or moderate on that side counts) ----
var socialist_in_power   = (band_party_count.radical_left  > 0) || (band_party_count.moderate_left  > 0);
var nationalist_in_power = (band_party_count.radical_right > 0) || (band_party_count.moderate_right > 0);
var centrist_in_power    = band_party_count.centrist > 0;

// ---- Subtyped flags (radical vs moderate distinction preserved) ----
var radical_left_in_power   = band_party_count.radical_left   > 0;
var moderate_left_in_power  = band_party_count.moderate_left  > 0;
var radical_right_in_power  = band_party_count.radical_right  > 0;
var moderate_right_in_power = band_party_count.moderate_right > 0;

// ---- General influence (replaces socialist_influence / nationalist_influence / centrist_influence) ----
// Combined influence of a side = larger of its two sub-band influences, not the sum,
// to avoid double-counting when a coalition has both a radical and moderate partner
// on the same side (mirrors how the old bloc_influence capped at 1.0 per side).
var socialist_influence   = Math.min(1.0, Math.max(band_influence.radical_left,  band_influence.moderate_left));
var nationalist_influence = Math.min(1.0, Math.max(band_influence.radical_right, band_influence.moderate_right));
var centrist_influence    = band_influence.centrist;

// Junior-partner amplification, same spirit as v2: if a side's entire government
// presence is a single lone party in a coalition of >=3 total parties, its exposure
// to blame is boosted 15%. Recomputed against total governing party count.
var total_govt_parties = 0;
for (const b in band_party_count) total_govt_parties += band_party_count[b];
var coalition_size_factor = total_govt_parties > 0 ? total_govt_parties : 1;

function juniorBoost(count, influence) {
    if (count === 1 && coalition_size_factor >= 3) return Math.min(1.0, influence * 1.15);
    return influence;
}
socialist_influence   = juniorBoost(band_party_count.radical_left + band_party_count.moderate_left, socialist_influence);
nationalist_influence = juniorBoost(band_party_count.radical_right + band_party_count.moderate_right, nationalist_influence);

// ============================================================
// HONEYMOON / FATIGUE
// ============================================================

if (Q.govt_tenure_ticks === undefined) Q.govt_tenure_ticks = 0;

var honeymoon_factor = 1.0 - (0.40 * Math.max(0, 1 - Q.govt_tenure_ticks / 12));
var fatigue_factor   = 1.0 - (0.25 * scale(Q.govt_tenure_ticks, 52, 104));

// ============================================================
// PRO_REPUBLIC
// Sluggish in both directions — institutions change slowly.
// ============================================================

var pr_push = 0;
var pr_pull = 0;

pr_push += (unemp_pos * 1.2 + infl_pos * 0.7 + growth_pos * 1.0) * econ_positive * fatigue_factor;
pr_pull += (unemp_neg * 2.2 + infl_neg * 1.0 + growth_neg * 1.8) * econ_negative * honeymoon_factor;

if (econ_negative > 0.3) {
    if (!Q.spd_in_government && !Q.z_in_government) {
        pr_pull += 0.6 * econ_negative;
    }
    if (centrist_in_power && !socialist_in_power && !nationalist_in_power) {
        pr_pull += phase_centrist_penalty * centrist_influence * econ_negative;
    }
}

if (tse) {
    if (econ_positive > 0.3) {
        pr_push *= (1.0 + 0.4 * socialist_influence);
    } else if (econ_negative > 0.3) {
        pr_pull *= (1.0 + 0.7 * socialist_influence);
    } else {
        pr_pull += 0.25 * socialist_influence;
    }
}

var raw_pr_delta = (pr_push - pr_pull);

var pr_inertia = raw_pr_delta > 0 ? 0.60 : 1.0;
raw_pr_delta *= pr_inertia;

var pr_mom = momentum_mult(Q.pr_vel, raw_pr_delta > 0 ? 1 : -1);
raw_pr_delta *= pr_mom;

raw_pr_delta *= wall_damp(Q.pro_republic, raw_pr_delta > 0 ? 90 : 10, 18, true);

var pr_delta = raw_pr_delta * TICK;
Q.pr_vel = lerp(Q.pr_vel, raw_pr_delta, 0.3);

// ============================================================
// NATIONALISM
//
// Two feed channels, per the new model:
//   1. MODERATE-RIGHT baseline: constant push scaled by moderate_right
//      influence, active regardless of economy. This is the floor that
//      keeps nationalism alive in good times.
//   2. RADICAL-RIGHT crisis term: push scaled by radical_right influence,
//      but only active when econ_negative > 0 (crisis-gated).
// ============================================================

var nat_push = 0;
var nat_pull = 0;

// --- Channel 1: moderate-right baseline (crisis-independent floor) ---
var NAT_MODERATE_BASELINE = 0.6; // magnitude constant for the floor push
nat_push += NAT_MODERATE_BASELINE * band_influence.moderate_right;

// --- Channel 2: radical-right crisis term (gated on econ_negative) ---
if (econ_negative > 0) {
    var NAT_RADICAL_CRISIS = 2.4; // magnitude constant for the crisis spike
    nat_push += NAT_RADICAL_CRISIS * band_influence.radical_right * econ_negative *
        (unemp_neg * 0.4 + infl_neg * 0.3 + growth_neg * 0.3);
}

if (econ_negative > 0.25) {
    if (nationalist_in_power) {
        nat_pull += 1.3 * nationalist_influence * econ_negative * honeymoon_factor;
    }
    if (socialist_in_power || centrist_in_power) {
        var other_influence = Math.max(socialist_influence, centrist_influence);
        nat_push += 1.0 * other_influence * econ_negative;
    }
}

// Prosperity: nationalism loses its core message (this still actively pulls it down)
nat_pull += (unemp_pos * 1.0 + infl_pos * 0.7) * econ_positive;

if (econ_positive > 0.25) {
    if (nationalist_in_power) {
        nat_push += 1.0 * nationalist_influence * econ_positive * fatigue_factor;
    }
    if (socialist_in_power) {
        nat_pull += 0.8 * socialist_influence * econ_positive;
    }
}

// TSE opposition effect — only makes sense when nationalism isn't already governing
if (tse) {
    if (econ_negative > 0.25 && !nationalist_in_power) {
        nat_push *= (1.0 + 0.6 * (1 - socialist_influence) * econ_negative);
    }
    if (econ_positive > 0.25 && !nationalist_in_power) {
        nat_pull *= (1.0 + 0.35 * socialist_influence);
    }
}

var raw_nat_delta = (nat_push - nat_pull);

var nat_inertia = raw_nat_delta > 0 ? 1.25 : 0.65;
raw_nat_delta *= nat_inertia;

var nat_mom = momentum_mult(Q.nat_vel, raw_nat_delta > 0 ? 1 : -1);
raw_nat_delta *= nat_mom;

raw_nat_delta *= wall_damp(Q.nationalism, raw_nat_delta > 0 ? 90 : 10, 18, true);

var nat_delta = raw_nat_delta * TICK;
Q.nat_vel = lerp(Q.nat_vel, raw_nat_delta, 0.35);

// ============================================================
// SOCIALISM
// Mirrors nationalism's two-channel model:
//   1. MODERATE-LEFT baseline (crisis-independent floor)
//   2. RADICAL-LEFT crisis term (crisis-gated)
// ============================================================

var soc_push = 0;
var soc_pull = 0;

// --- Channel 1: moderate-left baseline (crisis-independent floor) ---
var SOC_MODERATE_BASELINE = 0.6;
soc_push += SOC_MODERATE_BASELINE * band_influence.moderate_left;

// --- Channel 2: radical-left crisis term (gated on econ_negative) ---
if (econ_negative > 0) {
    var SOC_RADICAL_CRISIS = 2.4;
    soc_push += SOC_RADICAL_CRISIS * band_influence.radical_left * econ_negative *
        (unemp_neg * 0.4 + infl_neg * 0.27 + growth_neg * 0.27);
}

if (econ_negative > 0.25) {
    if (socialist_in_power) {
        var soc_blame_mult = tse ? 0.55 : 1.0;
        soc_blame_mult *= honeymoon_factor;
        soc_pull += 1.3 * socialist_influence * econ_negative * soc_blame_mult;
    }
    if (nationalist_in_power && !Q.in_grand_coalition) {
        soc_push += 1.0 * nationalist_influence * econ_negative;
    }
}

soc_pull += (unemp_pos * 1.0 + infl_pos * 0.7) * econ_positive;

if (econ_positive > 0.25) {
    if (socialist_in_power) {
        soc_push += 1.0 * socialist_influence * econ_positive * fatigue_factor;
    }
    if (nationalist_in_power && !socialist_in_power) {
        soc_pull += 0.7 * nationalist_influence * econ_positive;
    }
}

if (tse && socialist_in_power) {
    soc_push += 0.25 * socialist_influence;
    if (econ_positive > 0.3) {
        soc_push *= (1.0 + 0.5 * socialist_influence);
    }
}

var raw_soc_delta = (soc_push - soc_pull);

var soc_inertia = raw_soc_delta > 0 ? 0.95 : 0.75;
raw_soc_delta *= soc_inertia;

var soc_mom = momentum_mult(Q.soc_vel, raw_soc_delta > 0 ? 1 : -1);
raw_soc_delta *= soc_mom;

raw_soc_delta *= wall_damp(Q.socialism, raw_soc_delta > 0 ? 90 : 10, 18, true);

var soc_delta = raw_soc_delta * TICK;
Q.soc_vel = lerp(Q.soc_vel, raw_soc_delta, 0.25);

// ============================================================
// COMPETENCE COUNTERS
// ============================================================

if (Q.socialist_govt_success_counter  === undefined) Q.socialist_govt_success_counter  = 0;
if (Q.nationalist_govt_success_counter === undefined) Q.nationalist_govt_success_counter = 0;

if (socialist_in_power) {
    var soc_counter_drift = econ_signal * socialist_influence * 0.3;
    Q.socialist_govt_success_counter = Math.max(0, Math.min(8,
        Q.socialist_govt_success_counter + soc_counter_drift));

    if (Q.socialist_govt_success_counter > 4) {
        soc_delta += 0.08 * socialist_influence *
            scale(Q.socialist_govt_success_counter, 4, 8) * TICK;
    }
}

if (nationalist_in_power) {
    var nat_counter_drift = econ_signal * nationalist_influence * 0.3;
    Q.nationalist_govt_success_counter = Math.max(0, Math.min(8,
        Q.nationalist_govt_success_counter + nat_counter_drift));

    if (Q.nationalist_govt_success_counter > 4) {
        nat_delta += 0.08 * nationalist_influence *
            scale(Q.nationalist_govt_success_counter, 4, 8) * TICK;
    }
}

// ============================================================
// CROSS-PRESSURE
// ============================================================

var cross_mult = tse ? 1.4 : 1.0;

if (Q.nationalism > 35 || Q.socialism > 35) {

    if (nat_delta > 0) {
        pr_delta  -= nat_delta * 0.20 * cross_mult;
        soc_delta -= nat_delta * 0.12;
    }
    if (soc_delta > 0) {
        pr_delta  -= soc_delta * 0.20 * cross_mult;
        nat_delta -= soc_delta * 0.08;
    }

    if (nat_delta > 0 && soc_delta > 0) {
        var smaller = Math.min(nat_delta, soc_delta);
        nat_delta -= smaller * 0.10;
        soc_delta -= smaller * 0.10;
    }
}

// ============================================================
// BROKEN PROMISES
// Uses the subtyped flags: betrayal from a radical-left government reads
// differently than one from a moderate-left government, so we key the
// stronger effects off the radical flag specifically where it matters,
// falling back to the general flag for the parts that don't care.
// ============================================================

if (econ_negative > 0.35) {
    if (socialist_in_power) {
        var unemp_threshold  = tse ? 12 : 20;
        var betrayal_signal  = scale(Q.unemployed, unemp_threshold, unemp_threshold + 8);

        if (betrayal_signal > 0) {
            // Radical-left betrayal cuts deeper than moderate-left betrayal —
            // the promise of structural transformation was bigger to begin with.
            var betrayal_mag = tse ? 0.55 : (radical_left_in_power ? 0.30 : 0.20);
            var rep_bleed    = tse ? 0.18 : (radical_left_in_power ? 0.09 : 0.05);
            soc_delta -= betrayal_mag * socialist_influence * betrayal_signal * TICK;
            pr_delta  -= rep_bleed   * socialist_influence * betrayal_signal * TICK;
        }
    }

    if (nationalist_in_power && (Q.inflation > 15 || Q.economic_growth < -5)) {
        var nat_betrayal_mag = radical_right_in_power ? 0.30 : 0.20;
        nat_delta -= nat_betrayal_mag * nationalist_influence * TICK;
        pr_delta  -= 0.09 * nationalist_influence * TICK;
    }

    if (!socialist_in_power && !nationalist_in_power && centrist_in_power) {
        soc_delta += 0.18 * centrist_influence * TICK;
        nat_delta += 0.18 * centrist_influence * TICK;
        pr_delta  -= 0.18 * centrist_influence * TICK;
    }
}

// ============================================================
// TSE PHASE INTERACTIONS
// ============================================================

if (tse) {
    if (Q.phase === "depression") {
        soc_delta += 0.28 * socialist_influence * TICK;
        nat_delta += 0.16 * TICK;
        pr_delta  -= 0.22 * TICK;
    }

    if (Q.phase === "hyperinflation") {
        soc_delta -= 0.45 * socialist_influence * TICK;
        nat_delta += 0.35 * TICK;
        pr_delta  -= 0.35 * TICK;
    }

    if (Q.phase === "stagflation") {
        soc_delta -= 0.18 * socialist_influence * TICK;
        nat_delta += 0.22 * TICK;
        pr_delta  -= 0.28 * TICK;
    }

    if (Q.phase === "growth") {
        soc_delta += 0.22 * socialist_influence * TICK;
        nat_delta -= 0.16 * socialist_influence * TICK;
        pr_delta  += 0.11 * socialist_influence * TICK;
    }
}

// ============================================================
// HISTORICAL PRECEDENT
// ============================================================

if (Q.spd_crisis_victories && Q.spd_crisis_victories > 0
        && econ_positive > 0.3 && socialist_in_power) {
    soc_delta += 0.06 * Q.spd_crisis_victories * socialist_influence * TICK;
}

if (Q.nationalist_crisis_failures && Q.nationalist_crisis_failures > 0
        && nationalist_in_power) {
    nat_delta -= 0.04 * Q.nationalist_crisis_failures * nationalist_influence * TICK;
}

// ============================================================
// APPLY DELTAS
// ============================================================

Q.pro_republic += pr_delta;
Q.nationalism  += nat_delta;
Q.socialism    += soc_delta;

// ============================================================
// CLAMP & ROUND
// ============================================================

if (!Q.math_broken) {
    Q.pro_republic = Math.round(Math.max(0, Math.min(100, Q.pro_republic)) * 10) / 10;
    Q.nationalism  = Math.round(Math.max(0, Math.min(100, Q.nationalism))  * 10) / 10;
    Q.socialism    = Math.round(Math.max(0, Math.min(100, Q.socialism))    * 10) / 10;
} else {
    Q.pro_republic = Q.impossible_percentage(Q.pro_republic);
    Q.nationalism  = Q.impossible_percentage(Q.nationalism);
    Q.socialism    = Q.impossible_percentage(Q.socialism);
    console.log("OPINION CHAOS: PR=" + Q.pro_republic + " Nat=" + Q.nationalism + " Soc=" + Q.socialism + " Total=" + (Q.pro_republic + Q.nationalism + Q.socialism));
}

// ============================================================
// DEBUG / DISPLAY EXPORTS
// Exposes band composition so you can sanity-check the new system
// against Q.[party]_ideo_score values in your test scenarios.
// ============================================================

Q.ideo_band_influence   = band_influence;
Q.ideo_band_party_count = band_party_count;
Q.ideo_flags = {
    socialist_in_power, nationalist_in_power, centrist_in_power,
    radical_left_in_power, moderate_left_in_power,
    radical_right_in_power, moderate_right_in_power,
};














// ============================================================
// QOL GRIEVANCE SYSTEM
// ============================================================

// ============================================================
// SECTION 2A — TARGET COMPUTATION PER DIMENSION PER CLASS
// Each target is 0–100. 50 = neutral (1928 baseline).
// Above 50 = satisfied, below 50 = aggrieved.
// ============================================================

// ---- SHARED SIGNALS ----
// Pre-compute signals used across multiple classes to avoid repetition.

// Economic signals
const _qol_unemp_stress  = Math.max(0, Q.unemployed - 8);       // 0 at baseline
const _qol_infl_stress   = Math.abs(Q.inflation - 2);            // 0 at stable 2%
const _qol_defl_stress   = Math.max(0, -Q.inflation);            // deflation hits debtors
const _qol_growth_bonus  = Math.max(0, Q.economic_growth - 1);   // positive growth signal
const _qol_growth_stress = Math.max(0, -Q.economic_growth);      // contraction signal

// Security signals
const _qol_sa_threat  = (Q.sa_strength  * Q.sa_militancy)  / 500;
const _qol_rfb_threat = (Q.rfb_strength * Q.rfb_militancy) / 400;
const _qol_sh_threat  = (Q.sh_strength  * Q.sh_militancy)  / 600;
const _qol_rb_shield  = Math.min(1.5, (Q.rb_strength * Q.rb_militancy) / 3000);
const _qol_pol_loyal  = ((Q.prussian_police_loyalty || 0.5) + (Q.interior_police_loyalty || 0.45)) / 2;

// Political signals
const _qol_spd_in_govt  = Q.spd_in_government  ? 1 : 0;
const _qol_left_in_govt = (Q.spd_in_government || Q.kpd_in_government || Q.sapd_in_government) ? 1 : 0;
const _qol_right_in_govt= (Q.dnvp_in_government || Q.nsdap_in_government) ? 1 : 0;
const _qol_con_reform   = Q.constitutional_reform || 0;
const _qol_pres_rel     = (Q.presidential_patience  || 50) / 100;

// Cultural signals
const _qol_edu          = Q.education_science || 0;
const _qol_sci          = Q.science           || 0;
const _qol_womens       = Q.womens_rights      || 0;
const _qol_secular      = Q.secularized        || 0;
const _qol_curriculum_d = (Q.major_curriculum === 'democratic'  || Q.minor_curriculum === 'democratic')  ? 1 : 0;
const _qol_curriculum_t = (Q.major_curriculum === 'traditional' || Q.minor_curriculum === 'traditional') ? 1 : 0;
const _qol_concordat    = (Q.prussian_concordate || Q.reichskonkordat) ? 1 : 0;
const _qol_youth_orgs   = Q.youth_organizations || 0;


// ============================================================
// WORKERS
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    _t += (Q.welfare          || 0) * 7;
    _t += (Q.working_hours    || 0) * 5;
    _t += (Q.workers_safety   || 0) * 4;
    _t += (Q.works_councils   || 0) * 4;
    _t += (Q.works_program    || 0) * 6;
    _t += (Q.wtb_implemented  || 0) * 5;
    _t += (Q.cooperatives     || 0) * 3;
    _t += _qol_growth_bonus        * 1.5;
    _t -= _qol_unemp_stress        * 2.5;
    _t -= _qol_growth_stress       * 2.0;
    _t -= (Q.dues_workers     || 0) * 4;     // dues are a burden on workers
    _t -= _qol_infl_stress         * 0.8;   // workers hurt by inflation but less than middle
    if (Q.unions_independent === 1) _t -= 10; // alienated from SPD
    _t = Math.max(0, Math.min(100, _t));
    Q.workers_grievance_economic += ((_t - Q.workers_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    _t = 50;
    _t -= _qol_sa_threat  * 18;   // SA is the primary threat to workers
    _t -= _qol_rfb_threat * 6;    // RFB crossfire also hurts workers
    _t += _qol_rb_shield  * 12;   // Reichsbanner protects
    _t += _qol_pol_loyal  * 10;   // loyal police helps
    _t -= (Q.blutmai ? 8 : 0);    // Blutmai permanently scars worker trust in state
    _t -= (Q.rb_banned  ? 12 : 0);
    _t -= (Q.rfb_banned ? 3  : 0); // RFB ban removes crossfire but also solidarity org
    _t = Math.max(0, Math.min(100, _t));
    Q.workers_grievance_security += ((_t - Q.workers_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    _t += _qol_spd_in_govt      * 15;
    _t += (Q.labor_rights    || 0) * 8;
    _t += (Q.works_councils  || 0) * 5;
    _t += (Q.economic_democracy || 0) * 6;
    _t += _qol_con_reform       * 4;
    _t -= _qol_right_in_govt    * 12;
    _t -= (Q.presidential_cabinet ? 8 : 0);
    _t -= (Q.emergency_rule   ? 10 : 0);
    _t -= (Q.rfb_banned && !Q.kpd_banned ? 6 : 0); // banning their orgs feels political
    _t = Math.max(0, Math.min(100, _t));
    Q.workers_grievance_political += ((_t - Q.workers_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    _t = 50;
    _t += _qol_edu              * 4;
    _t += _qol_womens           * 3;
    _t += (Q.commonwealth_cooperation || 0) * 5;
    _t += _qol_curriculum_d     * 5;
    _t -= _qol_curriculum_t     * 4;
    _t += _qol_youth_orgs       * 3;
    _t = Math.max(0, Math.min(100, _t));
    Q.workers_grievance_cultural += ((_t - Q.workers_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// UNEMPLOYED
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    _t += (Q.welfare        || 0) * 8;
    _t += (Q.works_program  || 0) * 10;   // works programs are their direct lifeline
    _t += (Q.wtb_implemented|| 0) * 8;
    _t += (Q.state_buyer    || 0) * 5;
    _t -= _qol_unemp_stress       * 3.5;  // they feel this most acutely
    _t -= _qol_growth_stress      * 2.5;
    _t -= _qol_defl_stress        * 1.5;  // deflation = no jobs being created
    _t -= (Q.dues_unemployedc > 0 ? (Q.dues_unemployedc * 6) : -8); // waived dues = relief
    _t = Math.max(0, Math.min(100, _t));
    Q.unemployedc_grievance_economic += ((_t - Q.unemployedc_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    _t = 50;
    _t -= _qol_sa_threat  * 20;   // SA recruits and terrorizes the unemployed simultaneously
    _t -= _qol_rfb_threat * 8;
    _t += _qol_rb_shield  * 10;
    _t += _qol_pol_loyal  * 8;
    _t -= (Q.blutmai ? 10 : 0);
    _t -= (Q.rb_banned  ? 14 : 0);
    _t = Math.max(0, Math.min(100, _t));
    Q.unemployedc_grievance_security += ((_t - Q.unemployedc_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    _t += _qol_left_in_govt     * 12;
    _t += (Q.labor_rights    || 0) * 5;
    _t += _qol_con_reform       * 3;
    _t -= _qol_right_in_govt    * 15;   // right govt = austerity = their destruction
    _t -= (Q.presidential_cabinet ? 12 : 0);
    _t -= (Q.emergency_rule   ? 12 : 0);
    _t -= (Q.austerity_cuts   ? 15 : 0); // emergency cuts devastate them
    _t = Math.max(0, Math.min(100, _t));
    Q.unemployedc_grievance_political += ((_t - Q.unemployedc_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    _t = 50;
    _t += _qol_edu              * 3;
    _t += _qol_youth_orgs       * 4;   // youth orgs matter more — they skew young
    _t += _qol_curriculum_d     * 4;
    _t -= _qol_curriculum_t     * 3;
    _t = Math.max(0, Math.min(100, _t));
    Q.unemployedc_grievance_cultural += ((_t - Q.unemployedc_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// OLD MIDDLE (Mittelstand — artisans, small shopkeepers, rentiers)
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    // Old middle was destroyed by 1923 — inflation is their deepest fear
    _t -= _qol_infl_stress        * 4.0;   // strongest inflation sensitivity of any class
    _t -= _qol_defl_stress        * 2.0;   // deflation kills their businesses too
    _t -= _qol_unemp_stress       * 1.5;   // less direct than workers
    _t += _qol_growth_bonus       * 2.0;
    _t -= _qol_growth_stress      * 2.5;
    _t += (Q.pro_consumer      || 0) * 5;  // pro-consumer policy helps shopkeepers
    _t -= (Q.dues_old_middle   || 0) * 5;
    _t += (Q.nationalization_progress > 0 ? -8 : 0); // nationalization threatens them
    _t = Math.max(0, Math.min(100, _t));
    Q.old_middle_grievance_economic += ((_t - Q.old_middle_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    _t = 50;
    _t -= _qol_sa_threat  * 8;    // SA is disruptive to their businesses
    _t -= _qol_rfb_threat * 10;   // RFB street fighting scares shopkeepers more
    _t += _qol_pol_loyal  * 12;
    _t -= (Q.general_strike_progress > 3 ? 10 : 0); // general strike = closed shops
    _t -= (Q.rb_banned  ? 5  : 0);
    _t -= (Q.emergency_rule ? -5 : 0); // emergency rule = order, they may prefer it
    _t = Math.max(0, Math.min(100, _t));
    Q.old_middle_grievance_security += ((_t - Q.old_middle_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    _t -= _qol_spd_in_govt      * 8;    // SPD = socialism = threat to property
    _t -= _qol_left_in_govt     * 10;
    _t += _qol_right_in_govt    * 6;
    _t += _qol_con_reform       * 3;
    _t += (Q.judicial_reform   || 0) * 5; // rule of law protects their contracts
    _t -= (Q.presidential_cabinet ? 3 : 0); // ambiguous — order but uncertainty
    _t -= (Q.emergency_rule   ? -4 : 0);   // they often prefer strong order
    _t = Math.max(0, Math.min(100, _t));
    Q.old_middle_grievance_political += ((_t - Q.old_middle_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    // Old middle is the most culturally conservative class
    _t = 50;
    _t += _qol_concordat        * 8;    // church-state relations matter deeply
    _t += _qol_curriculum_t     * 8;    // traditional curriculum = their values
    _t -= _qol_curriculum_d     * 6;
    _t -= _qol_secular          * 5;
    _t -= _qol_womens           * 3;    // women's rights challenge their worldview
    _t += (Q.judicial_reform   || 0) * 3;
    _t = Math.max(0, Math.min(100, _t));
    Q.old_middle_grievance_cultural += ((_t - Q.old_middle_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// NEW MIDDLE (White-collar workers, civil servants, professionals)
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    _t += _qol_growth_bonus       * 3.0;   // growth = promotions, security
    _t -= _qol_growth_stress      * 3.0;
    _t -= _qol_infl_stress        * 2.5;   // salaries don't keep up with inflation
    _t -= _qol_defl_stress        * 1.5;
    _t -= _qol_unemp_stress       * 1.5;
    _t += (Q.education_science || 0) * 5;  // education = their career prospects
    _t += (Q.science           || 0) * 4;
    _t -= (Q.dues_new_middle   || 0) * 4;
    _t += (Q.wtb_implemented   || 0) * 3;  // WTB stabilizes the economy they depend on
    _t = Math.max(0, Math.min(100, _t));
    Q.new_middle_grievance_economic += ((_t - Q.new_middle_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    _t = 50;
    _t -= _qol_sa_threat  * 10;
    _t -= _qol_rfb_threat * 10;   // equally threatened by both extremes
    _t += _qol_pol_loyal  * 14;   // care most about state order
    _t -= (Q.general_strike_progress > 3 ? 8 : 0);
    _t += (Q.emergency_rule ? 5 : 0); // new middle often prefers order over freedom
    _t -= (Q.rb_banned  ? 6  : 0);
    _t = Math.max(0, Math.min(100, _t));
    Q.new_middle_grievance_security += ((_t - Q.new_middle_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    // New middle wants competent, stable government more than ideology
    _t += _qol_con_reform       * 6;
    _t += (Q.bureaucratic_reform || 0) * 8;  // direct interest in civil service reform
    _t += (Q.judicial_reform    || 0) * 5;
    _t -= (Q.presidential_cabinet ? 4 : 0);
    _t -= _qol_left_in_govt     * 6;    // SPD threatens their civil service positions
    _t -= _qol_right_in_govt    * 4;    // DNVP purges them too
    _t += _qol_pres_rel         * 5;    // presidential legitimacy matters
    _t = Math.max(0, Math.min(100, _t));
    Q.new_middle_grievance_political += ((_t - Q.new_middle_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    // New middle is split — educated but often nationalist
    _t = 50;
    _t += _qol_edu              * 6;
    _t += _qol_sci              * 5;
    _t += _qol_womens           * 4;   // more open to women's rights than old middle
    _t += _qol_curriculum_d     * 4;
    _t -= _qol_curriculum_t     * 3;
    _t += _qol_youth_orgs       * 3;
    _t = Math.max(0, Math.min(100, _t));
    Q.new_middle_grievance_cultural += ((_t - Q.new_middle_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// RURAL
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    _t += (Q.agricultural_policy  || 0) * 8;
    _t += (Q.agricultural_finance || 0) * 7;
    _t += (Q.land_reform          || 0) * 6;   // land reform helps poor farmers
    _t += (Q.state_buyer          || 0) * 6;   // state grain purchases = price floor
    _t -= _qol_defl_stress              * 3.5; // deflation crushes farm prices hardest
    _t -= _qol_infl_stress              * 1.5; // input cost inflation hurts
    _t -= _qol_unemp_stress             * 1.0;
    _t += _qol_growth_bonus             * 1.5;
    _t -= (Q.tariffs < 0 ? Math.abs(Q.tariffs) * 5 : 0); // low tariffs = foreign competition
    _t -= (Q.dues_rural           || 0) * 4;
    _t = Math.max(0, Math.min(100, _t));
    Q.rural_grievance_economic += ((_t - Q.rural_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    // Rural areas experience less direct street violence but fear disorder
    _t = 50;
    _t -= _qol_sa_threat  * 6;
    _t -= _qol_rfb_threat * 6;
    _t += _qol_pol_loyal  * 8;
    _t -= (Q.emergency_rule ? -6 : 0); // rural often welcomes strong order
    _t -= (Q.general_strike_progress > 5 ? 8 : 0); // strikes cut off supply chains
    _t = Math.max(0, Math.min(100, _t));
    Q.rural_grievance_security += ((_t - Q.rural_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    _t += (Q.agricultural_policy  || 0) * 6;  // direct representation of rural interests
    _t += (Q.land_reform          || 0) * 5;
    _t -= _qol_spd_in_govt              * 5;   // SPD is an urban party
    _t -= _qol_left_in_govt             * 8;
    _t += _qol_right_in_govt            * 4;   // DNVP claims to represent agrarian interests
    _t += (Q.cnbl_in_government ? 8 : 0);      // explicit rural party in govt
    _t += (Q.bb_in_government   ? 6 : 0);
    _t -= (Q.presidential_cabinet ? 2 : 0);
    _t = Math.max(0, Math.min(100, _t));
    Q.rural_grievance_political += ((_t - Q.rural_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    // Rural is the most church-dependent and tradition-bound class
    _t = 50;
    _t += _qol_concordat        * 6;
    _t += _qol_curriculum_t     * 10;
    _t -= _qol_curriculum_d     * 8;
    _t -= _qol_secular          * 8;
    _t -= _qol_womens           * 4;
    _t += (Q.catholics > 35 ? 4 : 0);
    _t += _qol_youth_orgs       * 2;
    _t = Math.max(0, Math.min(100, _t));
    Q.rural_grievance_cultural += ((_t - Q.rural_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// SECTION 2B — COMPOSITE QOL CALCULATION
// Weighted sum of 4 dimensions per class → Q.[class]_qol (0–150)
// ============================================================

const _CLASSES_QOL_TICK    = ['workers', 'unemployedc', 'old_middle', 'new_middle', 'rural'];
const _DIMENSIONS_QOL_TICK = ['economic', 'security', 'political', 'cultural'];

for (const _c of _CLASSES_QOL_TICK) {
    const _w  = Q.grievance_weights[_c];
    let _composite = 0;

    for (const _d of _DIMENSIONS_QOL_TICK) {
        // grievance dimension is 0-100, 50=neutral
        // remap to -50/+50 relative to neutral, then weight
        _composite += (_w[_d] * Q[_c + '_grievance_' + _d]);
    }
    // _composite is now 0-100 (50 = perfectly neutral across all dimensions)
    // Remap to 0-150 scale where 100 = 1928 baseline
    // Formula: 100 + (_composite - 50) * 1.0
    // So 50 composite → QOL 100, 100 composite → QOL 150, 0 composite → QOL 50

    Q[_c + '_qol_last'] = Q[_c + '_qol'];
    Q[_c + '_qol']      = Math.max(50, Math.min(150,
        100 + (_composite - 50)
    ));
    Q[_c + '_qol_vel']  = Q[_c + '_qol'] - Q[_c + '_qol_last'];
}

// Convenience aliases for display
Q.workers_qol_display    = Q.workers_qol.toFixed(1);
Q.unemployed_qol_display = Q.unemployedc_qol.toFixed(1);
Q.old_middle_qol_display = Q.old_middle_qol.toFixed(1);
Q.new_middle_qol_display = Q.new_middle_qol.toFixed(1);
Q.rural_qol_display      = Q.rural_qol.toFixed(1);

// Overall population QOL (class-size weighted)
Q.population_qol = (
    (Q.workers    / 100) * Q.workers_qol    +
    (Q.unemployedc/ 100) * Q.unemployedc_qol+
    (Q.old_middle / 100) * Q.old_middle_qol +
    (Q.new_middle / 100) * Q.new_middle_qol +
    (Q.rural      / 100) * Q.rural_qol
);
Q.population_qol = Math.round(Q.population_qol * 10) / 10;


// ============================================================
// SECTION 3D — MATH BROKEN COMPATIBILITY
// If Q.math_broken is active, QOL becomes chaotic.
// ============================================================

if (Q.math_broken) {
    for (const _c of ['workers', 'unemployedc', 'old_middle', 'new_middle', 'rural']) {
        Q[_c + '_qol'] = Q.impossible_percentage(Q[_c + '_qol']);
        for (const _d of ['economic', 'security', 'political', 'cultural']) {
            Q[_c + '_grievance_' + _d] = Q.impossible_add(Q[_c + '_grievance_' + _d], 0);
        }
    }
    Q.population_qol = Q.impossible_percentage(Q.population_qol);
    console.log('QOL CHAOS: population_qol=' + Q.population_qol);
}


// ============================================================
// SECTION 3C — QOL DISPLAY STRING
// ============================================================

{
    const _QOL_CLASSES = [
        ['workers',    'Workers'],
        ['unemployedc','Unemployed'],
        ['old_middle', 'Old Middle'],
        ['new_middle', 'New Middle'],
        ['rural',      'Rural'],
    ];
    const _QOL_DIMS = ['economic', 'security', 'political', 'cultural'];

    function _qol_bar(val) {
        // val is 0-100 grievance dimension. 50=neutral.
        // Returns a simple text indicator.
        if (val >= 75) return '+++';
        if (val >= 60) return '++ ';
        if (val >= 50) return '+  ';
        if (val >= 40) return '-  ';
        if (val >= 25) return '-- ';
        return                     '---';
    }

    let _report = '';
    for (const [_ck, _label] of _QOL_CLASSES) {
        const _qol = Q[_ck + '_qol'] || 100;
        const _vel = Q[_ck + '_qol_vel'] || 0;
        const _trend = _vel > 0.3 ? '↑' : _vel < -0.3 ? '↓' : '→';
        _report += `**${_label}** QOL: ${_qol.toFixed(0)} ${_trend}\n`;
        for (const _d of _QOL_DIMS) {
            const _dval = Q[_ck + '_grievance_' + _d] || 50;
            _report += `  ${_d}: ${_qol_bar(_dval)} (${_dval.toFixed(0)})\n`;
        }
        _report += '\n';
    }
    _report += `**Population QOL:** ${(Q.population_qol || 100).toFixed(1)}\n`;
    Q.qol_report = _report;
}


// ============================================================
// IDENTITY POPULATION DRIFT
// These are overlapping shares, not a normalized pool.
// ============================================================

// --- SECULARS ---
// Grows slowly with education and science policy
// Shrinks if traditional curriculum dominates
Q.secular_growth = 0;
if (Q.education_science >= 2)   Q.secular_growth += 0.08;
if (Q.education_science >= 4)   Q.secular_growth += 0.06;
if (Q.secularized >= 1)         Q.secular_growth += 0.10;
if (Q.major_curriculum === 'traditional') Q.secular_growth -= 0.10;
if (Q.minor_curriculum === 'traditional') Q.secular_growth -= 0.05;
// Baseline slow drift upward — modernization is a tide
Q.secular_growth += 0.02;
Q.seculars = Math.max(3, Math.min(40, Q.seculars + Q.secular_growth));

// --- CATHOLICS ---
// Mostly stable — shifts only from major events
// Slow natural decline as seculars grow, mostly from Protestant pool
Q.catholics = Math.max(20, Math.min(40, Q.catholics - Q.secular_growth * 0.3));

// --- PROTESTANTS ---
// Derived residual — takes the bulk of secular drift loss
Q.protestants = Math.max(30, Math.min(75, 100 - Q.catholics - Q.seculars));

// --- YOUTH ---
// 18-30 cohort radicalization level, not raw population share
// Rises with economic crisis, street violence, unemployment
// Falls with stability, successful youth policy
Q.youth_crisis_pressure = 0;
Q.youth_crisis_pressure += Math.max(0, Q.unemployed - 8) * 0.15;
Q.youth_crisis_pressure += Math.max(0, -Q.economic_growth) * 0.10;
Q.youth_crisis_pressure += ((Q.sa_strength * Q.sa_militancy) + 
                            (Q.rfb_strength * Q.rfb_militancy)) / 8000;
// Normalization pressure — always pulls back toward baseline over time
Q.youth_normalization = (Q.youth - 18) * 0.05;
// Policy counters
Q.youth_policy_effect = 0;
if (Q.youth_organizations >= 1) Q.youth_policy_effect -= 0.15 * Q.youth_organizations;
if (Q.education_science >= 2)   Q.youth_policy_effect -= 0.08;
if (Q.womens_rights >= 2)       Q.youth_policy_effect -= 0.04;

Q.youth = Math.max(10, Math.min(55, 
    Q.youth + Q.youth_crisis_pressure - Q.youth_normalization + Q.youth_policy_effect
));


// ============================================================
// IDENTITY MODIFIERS
// Applied to ideology_caps.base as multipliers.
// Each variable is a population share 0-100.
// Normalized to 0-1 for multiplication.
// ============================================================

var cath_share  = Q.catholics  / 100;
var prot_share  = Q.protestants / 100;
var sec_share   = Q.seculars   / 100;
var youth_share = Q.youth      / 100;


// === PARTY DRIFT OVERHAUL: IDENTITY MODIFIERS ===
// Wrapped in a function so it can be re-invoked with isolated
// share inputs later (for the per-identity display breakdown),
// without duplicating any of the formulas by hand.
function buildIdentityModifier(cs, ps, ss, ys) {
    return {
        spd:   1 + (ss * 0.20) + (ys * 0.08) - (cs * 0.10 * (Q.prussian_concordat >= 1 ? 1.04 : 1)),
        srpd:  1 + (ss * 0.15) + (ys * 0.06) - (cs * 0.08),
        kpd:   1 + (ss * 0.30) + (ys * 0.15) - (cs * 0.15),
        sapd:  1 + (ss * 0.20) + (ys * 0.10) - (cs * 0.10),
        nsdap: 1 + (ps * 0.34) + (ys * 0.45) - (cs * 0.40) - (ss * 0.10),
        dnvp:  1 + (ps * 0.45) - (ys * 0.15) - (cs * 0.10),
        dvfp:  1 + (ps * 0.25) - (ys * 0.25) - (cs * 0.10),
        dvp:   1 + (ss * 0.15) + (ps * 0.10) - (ys * 0.12),
        ddp:   1 + (ss * 0.25) + (ps * 0.05) - (ys * 0.20),
        z:     (Q.z_ideology === "Christian Conservatism")
                   ? 1
                       + (cs * 1.45 * (Q.prussian_concordat >= 1 ? 1.15 : 1) * (Q.z_transition_cvp === 1 ? (1/3) : 0.5))
                       + (ps * 0.35 * (Q.z_transition_cvp === 1 ? 1.55 : 1))
                       + (ss * (0.15 + (Q.z_transition_cvp === 2 ? 0.20 : 0)))
                       + (ys * (0.10 + (Q.z_transition_cvp === 2 ? 0.15 : 0)))
                       - (ys * 0.10)
               : (Q.z_ideology === "Catholic Laborism")
                   ? 1
                       + (cs * 1.45 * (Q.prussian_concordat >= 1 ? 1.15 : 1) * 1.10)
                       - (ss * 0.20)
                       - (ys * 0.05)
               : 1 + (cs * 1.45 * (Q.prussian_concordat >= 1 ? 1.15 : 1)) - (ss * 0.20) - (ys * 0.10),
        bvp:   1 + (cs * 1.25) - (ss * 0.25) - (ys * 0.08),
        cnbl:  1 + (ps * 0.15) - (ys * 0.10),
        wp:    1 + (ss * 0.10) - (ys * 0.18),
        csvd:  1 + (ps * 0.20) - (ys * 0.12) - (cs * 0.08),
        csrp:  1 + (ss * 0.15) - (cs * 0.10),
        vrp:   1 + (ss * 0.10) - (ys * 0.25),
        bb:    1 + (ps * 0.12) - (ys * 0.08),
        dhp:   1 + (ps * 0.15) - (ys * 0.10),
        kvp:   1 + (ps * 0.12) - (ys * 0.15),
        dtsp:  1 + (ps * 0.28) + (ys * 0.20) - (cs * 0.35) - (ss * 0.08),
        sls:   1 + (ss * 0.08) - (cs * 0.05),
        rdp:   1 + (ss * 0.30) + (ps * 0.05) - (cs * 0.20) - (ys * 0.18),
        cvp:   1 + (cs * 0.55) - (ss * 0.28) - (ys * 0.12),
        lb:    1 + (ss * 0.25) + (ys * 0.18) - (cs * 0.18),
        dnf:   1 + (ps * 0.60) + (ys * 0.15),
        other: 1 + (ys * 0.10),
    };
}

Q.identity_modifier = buildIdentityModifier(cath_share, prot_share, sec_share, youth_share);

// === EVENT-DRIVEN IDENTITY MODIFIERS ===
// NOTE: one-off event modifiers (e.g. Prussian Concordat -> z/spd) now live
// inline as ternary terms directly on the affected lines in
// buildIdentityModifier above, matching the Q.peoples_party inline pattern
// used throughout computeTarget's class_mods. This stub is kept only so
// the existing `* (eim.party || 1.0)` reads scattered through computeTarget
// keep working (they resolve to a harmless 1.0 no-op) without having to
// touch every call site.
Q.event_identity_modifier = {};
for (const party of Q.parties) {
    Q.event_identity_modifier[party] = 1.0;
}

// === CLASS×IDENTITY CROSS-TAB SUPPORT ===
// Per-identity affinity table, isolated at full strength (share=1.0) for
// each identity in turn. This becomes the identity_mods[party][idn] lookup
// used by the class×identity cell drift loop below. Built from
// buildIdentityModifier so it can never drift out of sync with the
// existing per-party identity coefficients — one source of truth.
Q.identity_mods = {};
{
    const _iso = {
        catholics:   buildIdentityModifier(1, 0, 0, 0),
        protestants: buildIdentityModifier(0, 1, 0, 0),
        seculars:    buildIdentityModifier(0, 0, 1, 0),
        youth:       buildIdentityModifier(0, 0, 0, 1),
    };
    for (var _party of Q.parties) {
        Q.identity_mods[_party] = {
            catholics:   (_iso.catholics[_party]   !== undefined) ? _iso.catholics[_party]   : 1.0,
            protestants: (_iso.protestants[_party] !== undefined) ? _iso.protestants[_party] : 1.0,
            seculars:    (_iso.seculars[_party]    !== undefined) ? _iso.seculars[_party]    : 1.0,
            youth:       (_iso.youth[_party]       !== undefined) ? _iso.youth[_party]       : 1.0,
        };
    }
}


// === PARTY DRIFT OVERHAUL ===
// Architecture: thermostat model
// Each tick: target = f(conditions), support moves toward target at speed s
// No caps, no soft cap function, no delta accumulation
// Target IS the ceiling/floor — self-correcting by design

// ─────────────────────────────────────────
// SHARED FACTORS (unchanged from original)
// ─────────────────────────────────────────

Q.unemployment_threshold = 7.5;
Q.inflation_threshold    = 3.0;

Q.unemployment_excess = Math.max(0, Q.unemployed - Q.unemployment_threshold);

if (Q.inflation >= 0) {
    Q.inflation_excess = Math.max(0, Q.inflation - Q.inflation_threshold);
} else {
    Q.inflation_excess = Math.abs(Q.inflation) * 1.5;
}

Q.unrest_factor = Q.random_factor(
    0.3 +
    Math.pow(Q.unemployment_excess / 8,  2.2) +
    Math.pow(Q.inflation_excess   / 6,  1.8),
    0.35
);
Q.unrest_factor = Math.min(Q.unrest_factor, 12.0);

if (Q.inflation >= 0) {
    Q.inflation_component = Q.inflation / 5;
} else {
    Q.inflation_component = Math.abs(Q.inflation) / 3;
}

Q.pro_republic_factor = Q.random_factor(
    Math.min(Math.max(Q.pro_republic / 33, 0.5), 1.5), 0.15
);
Q.nationalism_factor = Q.random_factor(
    Math.min(Math.max(Q.nationalism / 33, 0.5), 1.5), 0.20
);
Q.socialism_factor = Q.random_factor(
    Math.min(Math.max(Q.socialism / 33, 0.5), 1.5), 0.20
);
Q.street_pressure_factor = Q.random_factor(
    Math.min(Math.max(
        (Q.sa_strength * Q.sa_militancy + Q.rfb_strength * Q.rfb_militancy + Q.sh_strength * Q.sh_militancy) / 3500,
        0.7), 1.8),
    0.25
);

Q.sa_influence  = Q.nsdap_banned ? 0 : Q.random_factor((Q.sa_strength/100  + Q.sa_militancy)  * 0.25, 0.3);
Q.sh_influence  = (Q.dnvp_banned || Q.sh_banned) ? 0 : Q.random_factor((Q.sh_strength/100  + Q.sh_militancy)  * 0.2,  0.25);
Q.rfb_influence = Q.kpd_banned  ? 0 : Q.random_factor((Q.rfb_strength/100 + Q.rfb_militancy) * 0.2,  0.25);
Q.rb_influence  = Q.random_factor((Q.rb_strength/100 + Q.rb_militancy) * 0.15, 0.25);

// Class amplifiers — survive unchanged
Q.class_influences = {
    workers:     1.3 + Q.rfb_influence,
    old_middle:  1.0 + Q.sh_influence,
    new_middle:  1.0 + Q.sh_influence,
    rural:       1.0 + Q.sh_influence,
    unemployedc: 1.3 + Q.sa_influence,
};

// Campaign intensity decay
if (Q.campaign_intensity > 0) Q.campaign_intensity -= 0.08;
Q.campaign_intensity = Math.max(0, Q.campaign_intensity);
const ci = Q.campaign_intensity;


// ─────────────────────────────────────────
// BANNED REDISTRIBUTION MAP (unchanged)
// ─────────────────────────────────────────

const BANNED_REDISTRIBUTION = {
    nsdap: [
        ['dnvp',  0.50, () => !Q.dnvp_banned],
        ['dvp',   0.25, () => Q.dvp_right_shift && !Q.dvp_banned],
        ['other', 0.25, () => true]
    ],
    dnvp: [
        ['nsdap', 0.60, () => !Q.nsdap_banned && Q.dnvp_line === 3],
        ['nsdap', 0.30, () => !Q.nsdap_banned && Q.dnvp_line !== 3],
        ['dvp',   0.20, () => !Q.dvp_banned],
        ['other', 0.20, () => true]
    ],
    dvp: [
        ['dnvp',  0.35, () => !Q.dnvp_banned],
        ['nsdap', 0.25, () => !Q.nsdap_banned && Q.dvp_right_shift],
        ['wp',    0.20, () => !Q.wp_banned && !Q.dvp_right_shift],
        ['other', 0.20, () => true]
    ],
    wp: [
        ['spd',   0.30, () => !Q.spd_banned],
        ['ddp',   0.25, () => !Q.ddp_banned],
        ['srpd',  0.20, () => !Q.srpd_banned],
        ['other', 0.25, () => true]
    ],
    cnbl: [
        ['z',     0.35, () => !Q.z_banned],
        ['bvp',   0.20, () => !Q.bvp_banned],
        ['dnvp',  0.20, () => !Q.dnvp_banned],
        ['other', 0.25, () => true]
    ],
    kpd: [
        ['sapd',  0.40, () => Q.sapd_formed && !Q.sapd_banned],
        ['spd',   0.35, () => !Q.spd_banned && (Q.ideology === 'left' || Q.ideology === 'neorev')],
        ['spd',   0.20, () => !Q.spd_banned && Q.ideology !== 'left' && Q.ideology !== 'neorev'],
        ['other', 0.25, () => true]
    ],
    sapd: [
        ['kpd',   0.40, () => !Q.kpd_banned],
        ['spd',   0.30, () => !Q.spd_banned],
        ['srpd',  0.15, () => !Q.srpd_banned],
        ['other', 0.15, () => true]
    ],
    csvd: [
        ['dnvp',  0.30, () => !Q.dnvp_banned],
        ['nsdap', 0.25, () => !Q.nsdap_banned],
        ['other', 0.45, () => true]
    ],
    srpd: [
        ['spd',   0.45, () => !Q.spd_banned],
        ['sapd',  0.25, () => Q.sapd_formed && !Q.sapd_banned],
        ['kpd',   0.15, () => !Q.kpd_banned],
        ['other', 0.15, () => true]
    ],
    spd: [
        ['srpd',  0.35, () => !Q.srpd_banned],
        ['sapd',  0.25, () => Q.sapd_formed && !Q.sapd_banned],
        ['ddp',   0.20, () => !Q.ddp_banned],
        ['other', 0.20, () => true]
    ],
    ddp: [
        ['spd',   0.30, () => !Q.spd_banned],
        ['wp',    0.25, () => !Q.wp_banned],
        ['z',     0.20, () => !Q.z_banned],
        ['other', 0.25, () => true]
    ],
    z: [
        ['bvp',   0.40, () => !Q.bvp_banned],
        ['cnbl',  0.25, () => !Q.cnbl_banned],
        ['ddp',   0.15, () => !Q.ddp_banned],
        ['other', 0.20, () => true]
    ],
    bvp: [
        ['z',     0.45, () => !Q.z_banned],
        ['cnbl',  0.25, () => !Q.cnbl_banned],
        ['other', 0.30, () => true]
    ],
    other: [
        ['dnvp',  0.20, () => !Q.dnvp_banned],
        ['spd',   0.20, () => !Q.spd_banned],
        ['z',     0.20, () => !Q.z_banned],
        ['other', 0.40, () => true]
    ],
    kvp: [
        ['dnvp',  0.45, () => !Q.dnvp_banned],
        ['csvd',  0.30, () => !Q.csvd_banned],
        ['other', 0.25, () => true]
    ],
    dhp: [
        ['cnbl',  0.40, () => !Q.cnbl_banned],
        ['dnvp',  0.30, () => !Q.dnvp_banned],
        ['other', 0.30, () => true]
    ],
    bb: [
        ['cnbl',  0.35, () => !Q.cnbl_banned],
        ['bvp',   0.30, () => !Q.bvp_banned],
        ['nsdap', 0.20, () => !Q.nsdap_banned],
        ['other', 0.15, () => true]
    ]
};

// Crisis party definitions — mirrors Q.crisis_parties_by_class

const _CRISIS_PARTIES = {
    workers:     ['kpd', 'sapd', 'nsdap'],
    unemployedc: ['kpd', 'sapd', 'nsdap'],
    old_middle:  ['nsdap', 'dvfp', 'dnvp'],
    new_middle:  ['nsdap', 'dvfp', 'dnvp'],
    rural:       ['nsdap', 'cnbl', 'dnvp'],
};


// ─────────────────────────────────────────
// SECTION 3A — QOL HELPER
// ─────────────────────────────────────────

// _applyQOL — applies the asymmetric QOL multiplier to a computed base.
//
// For crisis parties: bad QOL amplifies appeal (2.0 - qol_ratio)
//   qol=50  (ratio 0.50) → ×1.50  strong amplification
//   qol=100 (ratio 1.00) → ×1.00  neutral
//   qol=150 (ratio 1.50) → ×0.50  suppressed even at baseline
//
// For moderate parties: good QOL gives gentle boost (0.85 + ratio*0.15)
//   qol=50  (ratio 0.50) → ×0.925  mild suppression
//   qol=100 (ratio 1.00) → ×1.000  neutral
//   qol=150 (ratio 1.50) → ×1.075  mild bonus
//
// The asymmetry is intentional:
//   crisis party penalty from high QOL (×0.50) >> moderate party bonus from high QOL (×1.075)
//   This means QOL erosion is always more dangerous than QOL improvement is helpful.

function _applyQOL(base, party, c) {
    const _qol    = Q[c + '_qol'] || 100;
    const _ratio  = _qol / 100;                     // 0.5 to 1.5
    const _crisis = (_CRISIS_PARTIES[c] || []).includes(party);

    if (_crisis) {
        // Amplify crisis party appeal when QOL is bad
        return base * (2.0 - _ratio);
    } else {
        // Gently modulate moderate party appeal with QOL
        return base * (0.85 + _ratio * 0.15);
    }
}


// ─────────────────────────────────────────
// TARGET COMPUTATION
// Returns: the support level conditions currently warrant for this party/class
// This replaces ideology_caps.base × class_multiplier
// ─────────────────────────────────────────

// ─────────────────────────────────────────
// SANDBOX ADJUSTMENT HELPERS
// Q.<party>_adjustment                -> multiplies party base (all classes)
// Q.<class>_<party>_adjustment        -> multiplies that class's mod for the party
// Both default to 1.0 (no-op) if unset. Safe against NaN/undefined/non-numeric.
// ─────────────────────────────────────────

function _partyAdj(party) {
    const v = Q[`${party}_adjustment`];
    return (typeof v === 'number' && !isNaN(v)) ? v : 1.0;
}

function _classAdj(party, c) {
    const v = Q[`${c}_${party}_adjustment`];
    return (typeof v === 'number' && !isNaN(v)) ? v : 1.0;
}

function computeTarget(party, c) {
    const nat  = Q.nationalism_factor;
    const rep  = Q.pro_republic_factor;
    const soc  = Q.socialism_factor;
    const unr  = Q.unrest_factor;
    const im   = Q.identity_modifier;
    const eim  = Q.event_identity_modifier;

    let base = 0;

    switch (party) {

        case 'nsdap': {
            if (Q.nsdap_banned) return 0;
            
            // Misery Index: Unemployment + Deflation + Growth Collapse
            let misery = (Q.unemployment_excess * 2.0) + (Q.inflation_excess * 1.5);
            if (Q.economic_growth < 0) misery += Math.abs(Q.economic_growth) * 3.0;

            let soft = 40, hard = 120; 
            let raw = (nat * 8.559) + (misery * 1.1);
            
            let final_raw = raw <= soft ? raw
                : soft + (hard - soft) * (1 - Math.exp(-(raw - soft) / 45));

            // CRITICAL: Check if Q.identity_modifier.nsdap is killing your growth.
            // We force a floor of 1.0 during a high-misery crisis.
            let identity = im.nsdap;
            if (misery > 15) identity = Math.max(identity, 1.0);

            base = final_raw * identity;
            base *= _partyAdj('nsdap');

            // Young NSDAP boost: only applies pre-1930
            const young_nsdap = (Q.hitler_young_funded == 1 && Q.year < 1930);
            const urban_flavor = (Q.urban_plan_flavor_1 == 1);
            const rural_flavor = (Q.geest_wildfire == 1);

            const young_boost = {
                workers:     young_nsdap ? (urban_flavor ? 1.20 : 1.05) : 1.0,
                old_middle:  young_nsdap ? 1.15 : 1.0,
                new_middle:  young_nsdap ? 1.10 : 1.0,
                rural:       young_nsdap ? (urban_flavor ? 1.05 : 1.20) : 1.0,
                unemployedc: young_nsdap ? 1.10 : 1.0,
            };

            // Small standalone worker boost, independent of young_nsdap
            const worker_urban_boost = urban_flavor ? 1.05 : 1.0;

            const class_mods = {
                workers:     0.90 * (Q.peoples_party === 1 ? 1.1 : 1) * young_boost.workers * worker_urban_boost * (rural_flavor ? 1 : 1.3),
                old_middle:  2.10 * (1 + (Q.nationalism/100) * 0.5) * young_boost.old_middle,
                new_middle:  1.80 * (1 + (Q.nationalism/100) * 0.4) * young_boost.new_middle,
                rural:       2.20 * (1 + (Q.nationalism/100) * 0.6) * young_boost.rural * (rural_flavor ? 1.4 : 1), // Rural core
                unemployedc: 2.10 * (1 + Math.min(Q.unemployed/10, 1.0)) * young_boost.unemployedc,
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('nsdap', c), party, c);
        }

        case 'dvfp': {
            if (Q.dvfp_banned || !Q.dvfp_formed) return 0;
            let nat_floor   = nat * 25;
            let u           = Math.max(0, unr - 0.6);
            let crisis_ramp = 90 / (1 + Math.exp(-1.4 * (u - 1.8)));
            let buff = Q.april_challenge === 1 ? 1.28 : 0.85;
            base = (nat_floor + crisis_ramp) * buff * im.dvfp;
            base *= _partyAdj('dvfp');

            const class_mods = {
                workers:     0.20 * (Q.peoples_party === 1 ? 1.02 : 1),
                old_middle:  1.74 * (1 + Math.min(Q.nationalism/100,1)*0.25) * (Q.peoples_party === 1 ? 0.95 : 1),
                new_middle:  0.77 * (Q.peoples_party === 1 ? 0.95 : 1),
                rural:       1.79 * (1 + Math.min(Q.nationalism/100,1)*0.22) * (Q.peoples_party === 1 ? 0.95 : 1),
                unemployedc: 0.77 * (Q.peoples_party === 1 ? 1.03 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dvfp', c), party, c);
        }

        case 'dnvp': {
           if (Q.dnvp_banned) return 0;

           const isNatCon      = Q.dnvp_ideology === "National Conservatism";
           const isSocCorp     = Q.dnvp_ideology === "Social Corporatism";

           const nsdapAbsent = Q.nsdap_banned || !Q.parties.includes('nsdap');

           let chaos_m = 1.0;
           if (unr > 0.7) {
               const excess  = unr - 0.7; // 0 to 0.3 range
               const severity = nsdapAbsent ? 2.5 * 0.4 : 2.5; // weaken chaos impact when NSDAP absent
               chaos_m = Math.max(0.1, 1 - excess * severity);
           }

           base = ((nat * 85) + (isSocCorp ? rep * 30 : 20)) * im.dnvp * chaos_m;

           const isLambach    = Q.dnvp_party_leader === "Walther Lambach";
           const lambachEarly = Q.year < 1929;
           const dnvpgovernment = Q.dnvp_in_government == 1;

           // Government bonus: starts at +20% (1.20), decays by 33% (relative) per crisis trigger
           let govBonus_m = 1.0;
           if (dnvpgovernment) {
               const crisisTriggers = [Q.cnbl_crisis, Q.vnr_momentum, Q.geest_wildfire]
                   .filter(Boolean).length;
               // Each trigger cuts the *bonus portion* (the 0.20 above baseline) by 33%
               const bonusPortion = 0.20 * Math.pow(0.67, crisisTriggers);
               govBonus_m = 1.0 + bonusPortion;
           }
           base *= govBonus_m;
           base *= _partyAdj('dnvp');

           let workers_m     = 0.69
               * (Q.peoples_party                      === 1 ? 1.10 : 1)
               * (Q.lambach_reinstated && lambachEarly        ? 1.20 : 1)
               * (Q.lambach_momentum   && lambachEarly        ? 1.70 : 1)
               * (isLambach                                   ? 1.35 : 1.00)
               * (isSocCorp                                   ? 1.40 : 1.00)
               * (isNatCon                                    ? 0.85 : 1.00);
           let old_middle_m  = 1.55 * (1 + Math.min(Q.nationalism/100,1)*0.28)
               * (Q.peoples_party                      === 1 ? 0.95 : 1)
               * (isLambach                                   ? 0.87 : 1.00)
               * (isNatCon                                    ? 1.25 : 1.00)
               * (isSocCorp                                   ? 0.86 : 1.00);
           let new_middle_m  = 0.99 * (1 + Math.min(Q.nationalism/100,1)*0.18)
               * (Q.peoples_party                      === 1 ? 0.95 : 1)
               * (Q.lambach_reinstated && lambachEarly        ? 1.35 : 1)
               * (Q.lambach_momentum   && lambachEarly        ? 2.65 : 1)
               * (isLambach                                   ? 1.50 : 1.00)
               * (isSocCorp                                   ? 1.35 : 1.00)
               * (isNatCon                                    ? 0.90 : 1.00);
           let rural_m       = 1.72 * (1 + Math.min(Q.nationalism/100,1)*0.30)
               * (Q.peoples_party                      === 1 ? 0.95 : 1)
               * (Q.parties.includes('dbp')                  ? 0.9111 : 1)
               * (Q.parties.includes('cnbl')                  ? 0.7953 : 1)
               * (isLambach                                   ? 0.87 : 1.00)
               * (isNatCon                                    ? 1.20 : 1.00)
               * (isSocCorp                                   ? 0.80 : 1.00);
           let unemployedc_m = 0.33
               * (Q.peoples_party                      === 1 ? 1.05 : 1)
               * (isSocCorp                                   ? 1.30 : 1.00)
               * (isNatCon                                    ? 0.80 : 1.00);

           const class_mods = { workers: workers_m, old_middle: old_middle_m, new_middle: new_middle_m, rural: rural_m, unemployedc: unemployedc_m };
           if (Q.dem_challenge === 1) base *= 0.80;
           return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dnvp', c), party, c);
       }

        case 'dnf': {
            if (Q.dnf_banned) return 0;
    
            let chaos_penalty = unr > 0.65 ? (unr * 25) : 0;
            base = ((nat * 90) - chaos_penalty) * (im.dnf || im.dnvp);
            base *= _partyAdj('dnf');

            const isHarzburg   = Q.harzburg_front_seen === true;
            const mediaBlitz   = Q.hugenberg_media_blitz === true;

            let workers_m     = 0.16
                * (mediaBlitz                                  ? 1.20 : 1)
                * (isHarzburg                                  ? 0.70 : 1);

            let old_middle_m  = 1.78 * (1 + Math.min(Q.nationalism/100,1)*0.40)
                * (Q.peoples_party                      === 1 ? 0.90 : 1)
                * (mediaBlitz                                  ? 1.15 : 1);

            let new_middle_m  = 0.50 * (1 + Math.min(Q.nationalism/100,1)*0.22)
                * (mediaBlitz                                  ? 1.35 : 1)
                * (isHarzburg                                  ? 1.10 : 1);

            let rural_m       = 2.15 * (1 + Math.min(Q.nationalism/100,1)*0.45)
                * (Q.peoples_party                      === 1 ? 0.90 : 1)
                * (Q.parties.includes('dbp')                  ? 0.85 : 1)
                * (Q.parties.includes('cnbl')                 ? 0.68 : 1)
                * (isHarzburg                                  ? 0.80 : 1);

            let unemployedc_m = 0.30
                * (Q.unemployment > 0.28                      ? 1.15 : 1);

            const class_mods = { workers: workers_m, old_middle: old_middle_m, new_middle: new_middle_m, rural: rural_m, unemployedc: unemployedc_m };
            
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dnf', c), party, c);
        }


        case 'dsbp': {
            if (Q.dsbp_banned) return 0;

            // ── Presence penalties ──────────────────────────────────────
            const ddp_present  = Q.parties.includes('ddp') && !Q.ddp_banned;
            const dvp_present  = Q.parties.includes('dvp') && !Q.dvp_banned;
            const vnr_present  = Q.parties.includes('vnr') && !Q.vnr_banned;

            let presence_pen = 1.0;
            if (ddp_present && dvp_present) presence_pen = 0.18;   // both parents: severe nerf
            else if (ddp_present)           presence_pen = 0.30;   // DDP alone: heavy nerf
            else if (dvp_present)           presence_pen = 0.30;   // DVP alone: heavy nerf
            if (vnr_present)                presence_pen *= 0.85;  // VNR siphons liberal-national voters

            // ── Base: 1.9× the combined DDP+DVP base rates ──────────────
            // DDP base driver: rep * 53; DVP base driver: factor * 49 * scale
            let ddp_factor   = Q.dvp_right_shift ? nat * 0.95 : rep * 1.0;
            let infl_pen     = Math.pow(Math.abs(Q.inflation - 1.5) / 12, 1.2);
            let unemp_pen    = Math.pow(Math.max(0, Q.unemployed - 5) / 25, 1.1);
            let econ_conf    = Math.max(0.35, 1 - (infl_pen * 0.7) - (unemp_pen * 0.7));
            let dvp_scale    = Q.dvp_right_shift ? 2.2 : 1.8;
            let dvp_base_raw = ddp_factor * 49 * dvp_scale * econ_conf;

            let sec_bonus  = (100 - Q.catholics) / 100 * 0.10;
            let nat_pen_d  = (Q.nationalism / 100) * 0.15;
            let edu_bonus  = (Q.education_science || 0) * 0.03
                           + (Q.secularized       || 0) * 0.05
                           + (Q.science           || 0) * 0.10
                           + (Q.womens_rights     || 0) * 0.05;
            let ddp_base_raw = rep * 53 * (1.1 + sec_bonus - nat_pen_d + edu_bonus);

            // Rep factor boosted 30% vs raw DDP — merger skews liberal-republican
            let rep_boost = 1.30;
            base = (ddp_base_raw * rep_boost + dvp_base_raw) * 1.9 * presence_pen * (im.dsbp || 1);
            base *= _partyAdj('dsbp');

            // ── Class multipliers: 80% of combined parents, old_middle & rural halved ──
            // Parent DDP class mods (new_middle 1.40, workers 0.60, old_middle 0.85, rural 0.50, unemployedc 0.55)
            // Parent DVP class mods (workers 0.45, old_middle 1.35, new_middle 1.40, rural 0.65, unemployedc 0.30)
            const combined = {
                workers:     (0.60 + 0.45)  / 2,   // 0.525
                old_middle:  (0.85 + 1.35)  / 2,   // 1.10
                new_middle:  (1.40 + 1.40)  / 2,   // 1.40
                rural:       (0.50 + 0.65)  / 2,   // 0.575
                unemployedc: (0.55 + 0.30)  / 2,   // 0.425
            };

            const class_mods = {
                workers:     combined.workers     * 0.80,
                old_middle:  combined.old_middle  * 0.80 * 0.50,  // 50% extra penalty
                new_middle:  combined.new_middle  * 0.80,
                rural:       combined.rural       * 0.80 * 0.50,  // 50% extra penalty
                unemployedc: combined.unemployedc * 0.80,
            };

            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dsbp', c), party, c);
        }

        case 'wp': {
            if (Q.wp_banned) return 0;
            let middle_norm  = (Q.old_middle + Q.new_middle) / 99;
            let crisis       = 1 + (Q.inflation * 0.23) - (Q.unemployed * 0.15);
            base = rep * 19 * nat * 17 * middle_norm * Math.max(0.3, crisis) * im.wp;
            base *= _partyAdj('wp');

            let old_middle_m = 1.50 * (1 + Math.max(0, Q.inflation * 0.008)) * (Q.peoples_party === 1 ? 0.96 : 1);
            let new_middle_m = 1.30 * (Q.peoples_party === 1 ? 0.96 : 1);
            const class_mods = { workers: 0.50, old_middle: old_middle_m, new_middle: new_middle_m, rural: 0.70, unemployedc: 0.50 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('wp', c), party, c);
        }

        case 'cnbl': {
            if (Q.cnbl_banned) return 0;
            base = (rep * 11 + nat * 19) * (1 + Q.rural * 0.009) * im.cnbl;
            base *= _partyAdj('cnbl');
            let rural_m = 1.80 * (1 + Math.min(Q.rural / 100, 0.4));
            const class_mods = { workers: 0.25, old_middle: 0.60, new_middle: 0.40, rural: rural_m, unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('cnbl', c), party, c);
        }

        case 'kpd': {
            if (Q.kpd_banned) return 0;
            let buff = Q.april_challenge === 1 ? 1.30 : 1;
            base = soc * 34 * 1.9 * (1 + unr * 0.13) * buff * im.kpd;
            base *= _partyAdj('kpd');

            let workers_m     = 1.45 * (Q.peoples_party === 1 ? 1.08 : 1);
            let old_middle_m  = 0.05 * (Q.peoples_party === 1 ? 0.92 : 1);
            let new_middle_m  = 0.10 * (Q.peoples_party === 1 ? 0.92 : 1);
            let rural_m       = 0.15 * (Q.peoples_party === 1 ? 0.92 : 1);
            let unemployedc_m = 1.35 * (Q.peoples_party === 1 ? 1.08 : 1);
            const class_mods  = { workers: workers_m, old_middle: old_middle_m, new_middle: new_middle_m, rural: rural_m, unemployedc: unemployedc_m };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('kpd', c), party, c);
        }

        case 'sapd': {
            if (Q.sapd_banned || !Q.sapd_formed) return 0;
            let buff = Q.april_challenge === 1 ? 1.15 : 0.90;
            base = soc * 19 * 2.0 * (1 + unr * 0.12) * buff * im.sapd;
            base *= _partyAdj('sapd');

            const class_mods = {
                workers:     1.30 * (Q.peoples_party === 1 ? 1.07 : 1),
                old_middle:  0.25 * (Q.peoples_party === 1 ? 0.93 : 1),
                new_middle:  0.40 * (Q.peoples_party === 1 ? 0.93 : 1),
                rural:       0.20 * (Q.peoples_party === 1 ? 0.93 : 1),
                unemployedc: 1.20 * (Q.peoples_party === 1 ? 1.07 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('sapd', c), party, c);
        }

        case 'srpd': {
            if (Q.srpd_banned || !Q.srpd_formed) return 0;
            let rb = Q.rb_strength * 0.0004;
            base = (soc * 10 * 1.95 + rep * 25 * 1.76 + rb) * im.srpd;
            base *= _partyAdj('srpd');

            const class_mods = {
                workers:     1.15 * (Q.peoples_party === 1 ? 1.06 : 1),
                old_middle:  0.85 * (Q.peoples_party === 1 ? 0.94 : 1),
                new_middle:  0.97 * (Q.peoples_party === 1 ? 0.94 : 1),
                rural:       0.56 * (Q.peoples_party === 1 ? 0.94 : 1),
                unemployedc: 0.89 * (Q.peoples_party === 1 ? 1.06 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('srpd', c), party, c);
        }

        case 'spd': {
    if (Q.spd_banned) return 0;
    let s = soc, r = rep;
    if (Q.peoples_party === 1)      { s *= 0.80; r *= 1.20; }
    if (Q.ideology === 'left')       { s *= 1.15; r *= 0.90; }
    else if (Q.ideology === 'reformist') { r *= 1.10; s *= 0.90; }
    else if (Q.ideology === 'neorev')    { s *= 1.05; r *= 1.05; }

    if (Q.social_fascism_adopted == 1) {r *= 1.47; s *= 0.60}

    let campaign_boost = 1.1;
    if (Q.campaign_focus === 'workers'    && ci > 0) campaign_boost += ci * 0.30
        + (Q.wtb_adopted === 1 ? 0.05 : 0)
        + (Q.nationalization_progress >= 1 ? 0.04 : 0)
        + (Q.welfare <= 0 ? -0.04 : 0)
        + (Q.workers_aid > 0 ? Q.workers_aid * 0.01 : 0)
        + (Q.pro_consumer > 0 ? 0.02 : 0)
        + (Q.trans_rights > 0 ? 0.01 : 0)
        + (Q.iron_front_progress > 2 ? 0.015 : 0)
        - (Q.peoples_party === 1 ? (Q.socialism / 200) : 0)
        - (Q.lower_tax_rates > 0 ? Q.lower_tax_rates * 0.03 : 0);

    if (Q.campaign_focus === 'new_middle' && ci > 0) campaign_boost += ci * 0.30
        + (Q.peoples_party === 1 ? 0.04 : 0)
        - (Q.socialism <= 49 && Q.peoples_party === 0 ? 0.06 : 0)
        - (Q.upper_tax_rates > 0 ? Q.upper_tax_rates * 0.03 : 0);

    if (Q.campaign_focus === 'old_middle' && ci > 0) campaign_boost += ci * 0.30
        + (Q.peoples_party === 1 ? 0.04 : 0)
        - (Q.nationalism >= 51 && Q.peoples_party === 0 ? 0.06 : 0)
        - (Q.upper_tax_rates > 0 ? Q.upper_tax_rates * 0.03 : 0)
        - (Q.nationalism / 480);

    if (Q.campaign_focus === 'rural'      && ci > 0) campaign_boost += ci * 0.30
        + (Q.rural_policy >= 2 ? 0.04 : 0)
        + (Q.state_buyer === 1 ? 0.03 : 0)
        - (Q.peoples_party === 0 ? 0.05 : 0);

    if (Q.campaign_focus === 'unemployed' && ci > 0) campaign_boost += ci * 0.30
        + (Q.wtb_adopted === 1 ? 0.06 : 0)
        + (Q.welfare >= 2 ? 0.04 : 0)
        + (Q.iron_front_progress > 4 ? 0.02 : 0)
        - (Q.welfare < 0 ? 0.05 : 0);

    if (Q.campaign_focus === 'women'      && ci > 0) campaign_boost += ci * 0.30
        + (Q.womens_rights >= 3 ? Q.womens_rights * 0.01 : 0)
        + (Q.abortion_rights > 0 ? 0.02 : 0)
        + (Q.womens_work > 0 ? Q.womens_work / 300 : 0)
        + (Q.family_law > 0 ? Q.family_law / 400 : 0);

    if (Q.campaign_focus === 'middle'     && ci > 0) campaign_boost += ci * 0.30
        - (Q.nationalism >= (Q.pro_republic / 2) && Q.peoples_party === 0 ? 0.05 : 0)
        - ((Q.socialism * 1.5) <= Q.nationalism && Q.peoples_party === 0 ? 0.04 : 0)
        - (Q.upper_tax_rates > 0 ? Q.upper_tax_rates * 0.027 : 0);

    base = (r * 99 + s * 58) * im.spd * (eim.spd || 1.0) * campaign_boost;
    base *= _partyAdj('spd');

    let m;
    if (c === 'workers') {
        m = 1.15;
        if (Q.peoples_party === 1)  m *= 0.82;
        if (Q.ideology === 'left')      m *= 1.12;
        if (Q.ideology === 'reformist') m *= 0.92;
        if (Q.campaign_focus === 'workers'    && ci > 0) m += ci * 0.25;
        if (Q.campaign_focus === 'unemployed' && ci > 0) m += ci * 0.07;
        
        let workersDuesDiff = Q.dues_workers - 1;
        m *= workersDuesDiff > 0 ? (1 - workersDuesDiff * 0.086) : (1 - workersDuesDiff * 0.05);
        if (Q.wtb_timer > 0)             m += (Q.workers / 100) * 0.75;
        if (Q.unions_independent === 1)  m *= 0.50;
        if (Q.pro_consumer > 0)          m += Q.pro_consumer     * 0.23;
        if (Q.state_buyer > 0)           m += Q.state_buyer     * 0.25;
        if (Q.welfare > 0)               m += Q.welfare         * 0.11;
        if (Q.working_hours > 0)         m += Q.working_hours   * 0.08;
        if (Q.workers_safety > 0)        m += Q.workers_safety  * 0.05;
        if (Q.commonwealth_cooperation > 0) m += Q.commonwealth_cooperation * 0.55;
        if (Q.works_councils > 0)        m += Q.works_councils  * 0.05;
        if (Q.economic_democracy > 0)    m += Q.economic_democracy * 0.02;
        if (Q.cooperatives > 0)          m += Q.cooperatives    * 0.10;
        if (Q.lower_tax_rates > 0)       m -= Q.lower_tax_rates * 0.25;
    } else if (c === 'old_middle') {
        m = 0.65;
        if (Q.peoples_party === 1)   m *= 1.15;
        if (Q.ideology === 'left')       m *= 0.88;
        if (Q.ideology === 'reformist')  m *= 1.10;
        if (Q.ideology === 'neorev')     m *= 1.05;
        if (Q.campaign_focus === 'old_middle' && ci > 0) m += ci * 0.09;
        if (Q.campaign_focus === 'middle'     && ci > 0) m += ci * 0.07;
        if (Q.campaign_focus === 'women'      && ci > 0) m += ci * 0.04;
        if (Q.campaign_focus === 'catholics'  && ci > 0) m += ci * 0.07 * (Q.catholics / 35);
        
        let oldMiddleDuesDiff = Q.dues_old_middle - 1;
        m *= oldMiddleDuesDiff > 0 ? (1 - oldMiddleDuesDiff * 0.12) : (1 - oldMiddleDuesDiff * 0.07);
        if (Q.land_reform > 0)      m -= Q.land_reform     * 0.15;
    } else if (c === 'new_middle') {
        m = 0.80;
        if (Q.peoples_party === 1)   m *= 1.15;
        if (Q.ideology === 'left')       m *= 0.88;
        if (Q.ideology === 'reformist')  m *= 1.10;
        if (Q.ideology === 'neorev')     m *= 1.05;
        if (Q.campaign_focus === 'new_middle' && ci > 0) m += ci * 0.10;
        if (Q.campaign_focus === 'women'      && ci > 0) m += ci * 0.06;
        if (Q.campaign_focus === 'middle'     && ci > 0) m += ci * 0.07;
        if (Q.campaign_focus === 'catholics'  && ci > 0) m += ci * 0.04 * (Q.catholics / 35);
        
        let newMiddleDuesDiff = Q.dues_new_middle - 2;
        m *= newMiddleDuesDiff > 0 ? (1 - newMiddleDuesDiff * 0.094) : (1 - newMiddleDuesDiff * 0.055);
        if (Q.wtb_timer > 0)        m += (Q.new_middle / 100) * 0.27;
        if (Q.reformists_resign === 1) m *= 0.50;
    } else if (c === 'rural') {
        m = 0.76;
        if (Q.peoples_party === 1)   m *= 1.12;
        if (Q.campaign_focus === 'rural'     && ci > 0) m += ci * 0.11;
        if (Q.campaign_focus === 'catholics' && ci > 0) m += ci * 0.07 * (Q.catholics / 35);
        
        let ruralDuesDiff = Q.dues_rural - 1;
        m *= ruralDuesDiff > 0 ? (1 - ruralDuesDiff * 0.11) : (1 - ruralDuesDiff * 0.065);
        if (Q.land_reform > 0)      m += Q.land_reform          * 0.32;
        if (Q.agricultural_finance > 0) m += Q.agricultural_finance * 0.22;
        if (Q.pro_consumer > 0)     m += Q.pro_consumer          * 0.03;
        if (Q.state_buyer > 0)      m += Q.state_buyer          * 0.45;
    } else if (c === 'unemployedc') {
        m = 1.05;
        if (Q.peoples_party === 1)   m *= 0.88;
        if (Q.ideology === 'left')   m *= 1.10;
        if (Q.campaign_focus === 'unemployed' && ci > 0) m += ci * 0.12;
        if (Q.campaign_focus === 'workers'    && ci > 0) m += ci * 0.04;
        
        let unemployedDuesDiff = Q.dues_unemployedc - 0.5;
        m *= unemployedDuesDiff > 0 ? (1 - unemployedDuesDiff * 0.086) : (1 - unemployedDuesDiff * 0.05);
        if (Q.wtb_timer > 0)         m += (Q.unemployedc / 100) * 1.03;
        if (Q.left_split === 1)      m *= 0.50;
        if (Q.pro_consumer > 0)      m += Q.pro_consumer         * 0.13;
        if (Q.state_buyer > 0)       m += Q.state_buyer         * 0.15;
        if (Q.welfare > 0)           m += Q.welfare             * 0.06;
    } else {
        m = 1.0;
    }

    if (Q.dem_challenge === 1) base *= 0.80;
    if (Q.ls_challenge === 1) base *= 1.40;
    if (Q.new_partei_challenge) {
        const START_YEAR = 1928;
        const END_YEAR = 1935;
        const totalWeeks = (END_YEAR - START_YEAR) * 26;
        const elapsedWeeks = (Q.year - START_YEAR) * 26 + Q.month * 2 + (Q.weeks / 2);
        const debuffPercent = Math.max(0, 99 * (1 - elapsedWeeks / totalWeeks));
        base *= (1 - debuffPercent / 100);
    }

    const finalM = m * _classAdj('spd', c);
    return _applyQOL(base * finalM * 0.93, party, c);
}

        case 'ddp': {
           if (Q.ddp_banned) return 0;
           let infl_pen    = Math.pow(Math.abs(Q.inflation - 1.5) / 12, 1.2);
           let unemp_pen   = Math.pow(Math.max(0, Q.unemployed - 5) / 25, 1.1);
           let econ_conf   = Math.max(0.50, 1 - (infl_pen * 0.33) - (unemp_pen * 0.33));
           let edu_bonus = (Q.education_science || 0) * 0.03
                         + (Q.secularized       || 0) * 0.05
                         + (Q.science           || 0) * 0.10
                         + (Q.womens_rights     || 0) * 0.05;
           if (!Q.ddp_name || Q.ddp_name === 'DDP') {
               let sec_bonus = (100 - Q.catholics) / 100 * 0.10;
               let nat_pen   = (Q.nationalism / 100) * 0.15;
               base = (rep * 47 * (1.1 + sec_bonus - nat_pen + edu_bonus)) * econ_conf * im.ddp;
               base *= _partyAdj('ddp');

               const class_mods = {
                   workers:     (0.25) * (Q.peoples_party === 1 ? 0.93 : 1),
                   old_middle:  (0.85) * (Q.peoples_party === 1 ? 1.08 : 1),
                   new_middle:  (1.40 * ((Q.education_science >= 2 || Q.womens_rights >= 3) ? 1.05 : 1)) * (Q.peoples_party === 1 ? 1.08 : 1),
                   rural:       (0.20) * (Q.peoples_party === 1 ? 1.05 : 1),
                   unemployedc: (0.05) * (Q.peoples_party === 1 ? 0.93 : 1),
               };
               return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('ddp', c), party, c);
           } else if (Q.ddp_name === 'LMP') {
               let wp_strength = (Q.wp_votes || 0) * 0.004;
               let mittelstand_bonus = (Q.old_middle_ddp || 0) * 0.002;
               let edu_pen = (Q.education_science || 0) * 0.02
                           + (Q.secularized       || 0) * 0.03
                           + (Q.womens_rights     || 0) * 0.03;
               base = (rep * 0.30 + wp_strength + mittelstand_bonus - edu_pen) * 52 * econ_conf * im.ddp;
               base *= _partyAdj('ddp');

               const class_mods = {
                   workers:     0.20 * (Q.peoples_party === 1 ? 0.93 : 1),
                   old_middle:  1.35 * (Q.peoples_party === 1 ? 1.08 : 1),
                   new_middle:  0.85 * (Q.peoples_party === 1 ? 1.08 : 1),
                   rural:       0.10 * (Q.peoples_party === 1 ? 1.05 : 1),
                   unemployedc: 0.15 * (Q.peoples_party === 1 ? 0.93 : 1),
               };
               return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('ddp', c), party, c);
           } else {
               // DStP
               let jungdo  = (Q.jungdo_strength || 0) * 0.0003;
               let edu_pen = (Q.education_science || 0) * 0.01
                           + (Q.secularized       || 0) * 0.05
                           + (Q.science           || 0) * 0.10
                           + (Q.womens_rights     || 0) * 0.05;
               base = (rep * 0.30 + nat * 0.29 + jungdo - edu_pen) * 59 * econ_conf * im.ddp;
               base *= _partyAdj('ddp');

               const class_mods = {
                   workers:     0.50 * (Q.peoples_party === 1 ? 0.93 : 1),
                   old_middle:  1.05 * (Q.peoples_party === 1 ? 1.08 : 1),
                   new_middle:  1.10 * (Q.peoples_party === 1 ? 1.08 : 1),
                   rural:       0.5 * (Q.peoples_party === 1 ? 1.05 : 1),
                   unemployedc: 0.10 * (Q.peoples_party === 1 ? 0.93 : 1),
               };
               return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('ddp', c), party, c);
           }
       }

        case 'dvp': {
            if (Q.dvp_banned) return 0;
            let factor      = Q.dvp_right_shift ? nat * 0.95 : rep * 1.0;
            let infl_pen    = Math.pow(Math.abs(Q.inflation - 1.5) / 12, 1.2);
            let unemp_pen   = Math.pow(Math.max(0, Q.unemployed - 5) / 25, 1.1);
            let econ_conf   = Math.max(0.35, 1 - (infl_pen * 0.50) - (unemp_pen * 0.50));
            let scale       = Q.dvp_right_shift ? 2.2 : 1.8;
            base = factor * 40 * scale * econ_conf * (im.dvp || 1);
            base *= _partyAdj('dvp');

            const class_mods = {
                workers:     0.15 * (Q.peoples_party === 1 ? 0.92 : 1),
                old_middle:  1.50 * (Q.dvp_right_shift ? (1 + Math.min(Q.nationalism/100,1)*0.22) : 1) * (Q.peoples_party === 1 ? 0.96 : 1),
                new_middle:  1.35 * (Q.dvp_right_shift ? (1 + Math.min(Q.nationalism/100,1)*0.18) : 1) * (Q.peoples_party === 1 ? 0.96 : 1),
                rural:       0.30 * (Q.peoples_party === 1 ? 0.96 : 1),
                unemployedc: 0.05 * (Q.peoples_party === 1 ? 0.92 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dvp', c), party, c);
        }

        case 'z': {
            if (Q.z_banned) return 0;
            let cath_bonus  = Q.catholics / 8;
            let leader_mod  = Q.z_party_leader === 'Kaas' ? 0.94 : Q.z_party_leader === 'Joos' ? 1.06 : 1.0;
            let gov_mod     = Q.z_in_government ? 1.12 : 0.93;
            base = (rep * 70 + cath_bonus * 4) * leader_mod * gov_mod * im.z * (eim.z || 1.0);

            let floor = cath_bonus * 7.5 * gov_mod;
            base = Math.max(base, floor);
            base *= _partyAdj('z');

            const isChristCon = Q.z_ideology === "Christian Conservatism";
            const isCathLabor = Q.z_ideology === "Catholic Laborism";

            const ccClassMult = isChristCon
                ? {
                    rural:      0.65,
                    old_middle: 0.65 * (Q.z_transition_cvp === 1 ? 1.20 : 1),
                    workers:    1.35 * (Q.z_transition_cvp === 2 ? 1.15 : 1),
                    new_middle: 1.25,
                  }
                : isCathLabor
                ? {
                    workers:     1.55,
                    unemployedc: 1.60,
                    old_middle:  0.75,
                    new_middle:  0.90,
                    rural:       0.85,
                  }
                : {};

            const class_mods = {
                workers:     0.65 * (Q.z_party_leader == 'Adam Stegerwald' ? 1.08 : 1) * (Q.peoples_party === 1 ? 1.09 : 1) * (ccClassMult.workers || 1),
                old_middle:  1.10 * (Q.peoples_party === 1 ? 0.91 : 1) * (ccClassMult.old_middle || 1),
                new_middle:  0.90 * (Q.peoples_party === 1 ? 0.87 : 1) * (ccClassMult.new_middle || 1),
                rural:       0.90 * (Q.peoples_party === 1 ? 0.87 : 1) * (ccClassMult.rural || 1),
                unemployedc: 0.20 * (Q.peoples_party === 1 ? 1.10 : 1) * (ccClassMult.unemployedc || 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('z', c), party, c);
        }

        case 'bvp': {
            if (Q.bvp_banned) return 0;
            let cath = Q.catholics * 0.10;
            let rur  = Q.rural    * 0.03;
            base = Math.min(45, rep * 15 * (nat * 22) * im.bvp + cath + rur);
            base *= _partyAdj('bvp');

            let rural_m = 1.20 * (1 + Math.min(Q.rural / 125, 0.25)) * (Q.peoples_party === 1 ? 0.96 : 1);
            const class_mods = {
                workers:     0.41 * (Q.peoples_party === 1 ? 0.94 : 1),
                old_middle:  1.55 * (Q.peoples_party === 1 ? 0.96 : 1),
                new_middle:  0.86 * (Q.peoples_party === 1 ? 0.96 : 1),
                rural:       rural_m,
                unemployedc: 0.10 * (Q.peoples_party === 1 ? 0.94 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('bvp', c), party, c);
        }

        case 'csvd': {
            if (Q.csvd_banned) return 0;
            let dnvp_split_bonus = 0;
            if (Q.dnvp_party_leader == "Alfred Hugenberg" || Q.lambach_defection >= 1)                              dnvp_split_bonus = 0.5 + (Q.dnvp_r * 0.03);


            let anti_nazi_appeal = 0;
            if (Q.nsdap_r >= 15 && Q.nsdap_r < 30)             anti_nazi_appeal = 0.3 + (Q.church_resist_nazis ? 0.15 : 0);
            else if (Q.nsdap_r >= 30)                           anti_nazi_appeal = -0.2;

            let coalition_stability = 0;

            let crisis_factor = Q.unemployed >= 20 ? 0.6 : Q.unemployed >= 12 ? 0.8 : Q.unemployed >= 8 ? 0.85 : 1.0;

            base = (rep * 15 + (nat * 15) + dnvp_split_bonus + anti_nazi_appeal + coalition_stability) * crisis_factor * im.csvd;
            base *= _partyAdj('csvd');

            const class_mods = {
                workers:     0.95 * (Q.peoples_party === 1 ? 1.10 : 1) * (Q.lambach_defection >= 1 ? 2.50 : 1),
                old_middle:  0.25 * (1 + Math.min(Q.nationalism/100,1)*0.22) * (Q.peoples_party === 1 ? 0.96 : 1),
                new_middle:  1.80 * (1 + Math.min(Q.nationalism/100,1)*0.18) * (Q.peoples_party === 1 ? 0.96 : 1) * (Q.lambach_defection >= 1 ? 2.50 : 1),
                rural:       0.10 * (1 + Math.min(Q.nationalism/100,1)*0.25) * (Q.peoples_party === 1 ? 0.96 : 1),
                unemployedc: 0.65 * (Q.peoples_party === 1 ? 0.93 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('csvd', c), party, c);
        }

        case 'csrp': {
            if (Q.csrp_banned) return 0;
            let april = Q.april_challenge && Q.year >= 1933 ? 27 : 1;
            base = rep * 16 * im.csrp * april;
            base *= _partyAdj('csrp');
            const class_mods = { workers: 0.20, old_middle: 0.05, new_middle: 0.15, rural: 0.10, unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('csrp', c), party, c);
        }

        case 'vrp': {
            if (Q.vrp_banned) return 0;
            base = (rep * 12.5 + Math.max(0, Q.inflation) * 0.08) * im.vrp;
            base *= _partyAdj('vrp');
            const class_mods = { workers: 0.04, old_middle: 0.12, new_middle: 0.08, rural: 0.01, unemployedc: 0.67 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('vrp', c), party, c);
        }

        case 'other': {
            if (Q.other_banned) return 0;
            base = (nat + rep) * 7 * im.other;
            base *= _partyAdj('other');
            const class_mods = { 
        workers: 0.30, 
        old_middle: 0.85, 
        new_middle: 0.80, 
        rural: 1.15 * (Q.landvolk_fury > 0 ? Q.landvolk_fury / 1.05 : 1) * (Q.parties.includes('cnbl') ? 1.5953 : 1), 
        unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('other', c), party, c);
        }

        case 'kvp': {
            if (Q.kvp_banned) return 0;
            let split_bonus = Q.dnvp_party_leader == "Alfred Hugenberg" || Q.lambach_stage >= 2 ? 2.5 : 0.8;
            base = (rep * 18 + nat * 14) * split_bonus * im.kvp;
            base *= _partyAdj('kvp');
            const class_mods = { workers: 0.10, old_middle: 1.65, new_middle: 1.25, rural: 1.25, unemployedc: 0.10 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('kvp', c), party, c);
        }

        case 'dhp': {
            if (Q.dhp_banned) return 0;
            base = Math.min(3.5, (rep * 30 + nat * 10) * 0.8 * im.dhp);
            base *= _partyAdj('dhp');
            const class_mods = { workers: 0.20, old_middle: 1.35, new_middle: 0.60, rural: 1.70, unemployedc: 0.25 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dhp', c), party, c);
        }

        case 'bb': {
            if (Q.bb_banned) return 0;
            let rural_weight    = Q.rural / 60;
            let deflation_bonus = Q.inflation < 0 ? (1 + Math.abs(Q.inflation) * 0.08) : 1.0;
            base = (rep * 10 + nat * 12) * rural_weight * deflation_bonus * im.bb;
            base *= _partyAdj('bb');
            const class_mods = { workers: 0.10, old_middle: 0.40, new_middle: 0.20, rural: 2.10, unemployedc: 0.35 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('bb', c), party, c);
        }

        case 'aspd': {
            if (Q.aspd_banned) return 0;
            base = (rep * 3 + nat * 10 + soc * 1) * im.bb;
            base *= _partyAdj('aspd');
            const class_mods = { workers: 0.65, old_middle: 0.05, new_middle: 0.22, rural: 0.01, unemployedc: 0.35 };
            let result = base * (class_mods[c] || 1.0) * _classAdj('aspd', c);
            if (Q.reformists_resign >= 1) result *= 2.50;
            if (Q.unions_independent >= 1) result *= 2.50;
            if (Q.neorev_split >= 1) result *= 3.50;
            if (Q.ideology == "left") result *= 1.50;
            return _applyQOL(result, party, c);
        }

        case 'hl': {
            if (Q.hl_banned) return 0;
            base = (rep * 3 + nat * 5 + soc * 10) * im.bb;
            base *= _partyAdj('hl');
            const class_mods = { workers: 0.50, old_middle: 0.50, new_middle: 0.20, rural: 0.55, unemployedc: 0.25 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('hl', c), party, c);
        }

        case 'sl': {
            if (Q.sl_banned) return 0;
            let sl_buff = Q.april_challenge === 1 ? 4.50 : 1;
            base = (rep * 3 + nat * 5 + soc * 10) * sl_buff * im.bb;
            base *= _partyAdj('sl');
            const class_mods = { workers: 0.50, old_middle: 0.50, new_middle: 0.20, rural: 0.55, unemployedc: 0.25 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('sl', c), party, c);
        }

        case 'kpo': {
            if (Q.kpo_banned) return 0;
            base = (rep * 3 + nat * 5 + soc * 20) * im.bb;
            base *= _partyAdj('kpo');
            const class_mods = { workers: 0.50, old_middle: 0.50, new_middle: 0.20, rural: 0.55, unemployedc: 0.25 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('kpo', c), party, c);
        }

        case 'vnr': {
            if (Q.vnr_banned) return 0;
            base = (rep * 10 + nat * 8 + soc * 1) * im.bb;
            base *= _partyAdj('vnr');
            const class_mods = { 
            workers: 0.10, 
            old_middle: 0.35 * (Q.vnr_momentum >= 1 ? 3.11 : 1), 
            new_middle: 0.30 * (Q.vnr_momentum >= 1 ? 3.11 : 1), 
            rural: 0.20, 
            unemployedc: 0.10 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('vnr', c), party, c);
        }

        case 'dtsp': {
            if (Q.dtsp_banned) return 0;
            base = nat * 8 * (1 + unr * 0.10) * im.dtsp;
            base *= _partyAdj('dtsp');
            const class_mods = { workers: 0.15, old_middle: 0.90, new_middle: 0.70, rural: 0.80, unemployedc: 0.20 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dtsp', c), party, c);
        }

        case 'sls': {
            if (Q.sls_banned) return 0;
            base = rep * 4 * im.sls;
            base *= _partyAdj('sls');
            const class_mods = { workers: 0.30, old_middle: 0.40, new_middle: 0.25, rural: 0.60, unemployedc: 0.20 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('sls', c), party, c);
        }

        case 'rdp': {
            if (Q.rdp_banned) return 0;
            let nat_pen = (Q.nationalism / 100) * 0.20;
            base = rep * 6 * (1.0 - nat_pen) * im.rdp;
            base *= _partyAdj('rdp');
            const class_mods = { workers: 0.25, old_middle: 0.30, new_middle: 0.85, rural: 0.15, unemployedc: 0.20 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('rdp', c), party, c);
        }

        case 'cvp': {
            if (Q.cvp_banned) return 0;
            let cath_bonus = Q.catholics / 18;
            base = (rep * 5 + cath_bonus) * im.cvp;
            base *= _partyAdj('cvp');
            const class_mods = { workers: 0.40, old_middle: 0.80, new_middle: 0.50, rural: 0.70, unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('cvp', c), party, c);
        }

        case 'lb': {
            if (Q.lb_banned) return 0;
            base = soc * 7 * (1 + unr * 0.08) * im.lb;
            base *= _partyAdj('lb');
            const class_mods = { workers: 0.55, old_middle: 0.10, new_middle: 0.20, rural: 0.10, unemployedc: 0.45 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('lb', c), party, c);
        }

       case 'dbp': {
    if (Q.dbp_banned) return 0;

    let rural_weight    = Q.rural / 70;  // slightly less rural-dependent than BB (Q.rural/60)
    let deflation_bonus = Q.inflation < 0 ? (1 + Math.abs(Q.inflation) * 0.06) : 1.0;
    let lib_bonus       = (rep * 0.45) + ((100 - Q.nationalism) / 100) * 0.15;

    base = (rep * 29 + nat * 8) * rural_weight * deflation_bonus * lib_bonus * (im.dbp || 1);
    base *= _partyAdj('dbp');

    const class_mods = {
        workers:     0.15,   // minimal worker base
        old_middle:  0.75,   // small traders, rural artisans — present but not the core
        new_middle:  0.40,   // modest white-collar presence
        rural:       2.20,   // rural core, slightly softer than BB's 2.10 since more liberal
        unemployedc: 0.25,
    };
    return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dbp', c), party, c);
}

    case 'faud': {
        if (Q.faud_banned) return 0;
        base = soc * 2 * (1 + unr * 0.25) * im.kpd;
        base *= _partyAdj('faud');

        const class_mods = {
            workers:     0.35 * (Q.unions_independent === 1 ? 1.5 : 1),
            old_middle:  0.01,
            new_middle:  0.02,
            rural:       0.02,
            unemployedc: 0.30,
        };
        return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('faud', c), party, c);
    }

    case 'kapd': {
        if (Q.kapd_banned) return 0;
        let buff = Q.april_challenge === 1 ? 1.10 : 0.85;
        base = soc * 8 * 1.4 * (1 + unr * 0.18) * buff * im.kpd;
        base *= _partyAdj('kapd');

        const class_mods = {
            workers:     1.60 * (Q.peoples_party === 1 ? 1.05 : 1) * (Q.left_split === 1 ? 1.3 : 1),
            old_middle:  0.02,
            new_middle:  0.05,
            rural:       0.03,
            unemployedc: 1.35 * (Q.peoples_party === 1 ? 1.05 : 1),
        };
        return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('kapd', c), party, c);
    }

    case 'rlb': {
    if (Q.rlb_banned) return 0;
    let agrarian_crisis = Q.agri_price_collapse ? 1.5 : 1.0;
    base = (nat * 35 + rep * 20) * (Q.rural / 60) * agrarian_crisis * im.dnvp;
    base *= _partyAdj('rlb');

    const class_mods = {
        workers:     0.08,
        old_middle:  0.55,
        new_middle:  0.15,
        rural:       2.40 * (1 + Math.min(Q.nationalism/100,1)*0.35)
                     * (Q.parties.includes('dbp') ? 0.95 : 1)
                     * (Q.parties.includes('cnbl') ? 0.85 : 1),
        unemployedc: 0.15,
        };
    return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('rlb', c), party, c);
    }

        default: {
            if (Q.other_banned) return 0;
            base = (nat + rep) * 6 * im.other;
            base *= _partyAdj('other');
            const class_mods = { workers: 0.30, old_middle: 1.00, new_middle: 1.00, rural: 1.00, unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('other', c), party, c);
        }
    }
}



// ─────────────────────────────────────────
// SPEED COMPUTATION
// Returns: fraction of (target - current) closed per tick
// Crisis parties fast, stable parties slow
// ─────────────────────────────────────────

function computeSpeed(party, c) {
    const unr = Q.unrest_factor;

    // Base speed per party archetype
    const base_speeds = {
        // Crisis-reactive — fast
        kapd:   0.25,
        nsdap:  0.18,
        dnf:    0.175,
        kpd:    0.17,
        sapd:   0.14,
        dvfp:   0.13,

        // Moderate reactive
        spd:    0.11,
        dnvp:   0.12,
        srpd:   0.10,
        csvd:   0.09,
        dvp:    0.09,
        ddp:    0.09,
        dsbp:   0.10,

        // Stable/structural
        z:      0.06,
        bvp:    0.06,
        cnbl:   0.07,
        wp:     0.07,
        kvp:    0.08,
        rlb:    0.075,

        // Very stable / niche
        dbp:    0.08,
        bb:     0.05,
        dhp:    0.05,
        sls:    0.04,
        csrp:   0.05,
        vrp:    0.06,
        dtsp:   0.10,
        rdp:    0.06,
        cvp:    0.06,
        lb:     0.07,
        aspd:   0.06,
        hl:     0.06,
        sl:     0.08,
        kpo:    0.08,
        vnr:    0.07,
        srpd:   0.09,
        other:  0.08,
        faud:   0.02,
        default: 0.07,
    };

    let speed = base_speeds[party] || base_speeds.default;

    // Crisis bonus: reactive parties get faster when conditions are extreme
    const crisis_parties = ['nsdap', 'kpd', 'sapd', 'dvfp', 'dnf', 'dnvp', 'srpd'];
    if (crisis_parties.includes(party)) {
        speed *= (1 + Math.min(unr * 0.12, 0.50));  // up to +50% faster in deep crisis
    }

    // Stable parties slow down further under crisis (confusion, fragmentation)
    const stable_parties = ['z', 'bvp', 'cnbl', 'wp', 'bb', 'dbp'];
    if (stable_parties.includes(party) && unr > 1.5) {
        speed *= Math.max(0.60, 1 - (unr - 1.5) * 0.08);
    }

    // SPD: campaign gives speed boost toward focused class
    if (party === 'spd' && Q.campaign_focus && ci > 0) {
        const focus_map = {
            workers:    'workers',
            unemployed: 'unemployedc',
            new_middle: 'new_middle',
            old_middle: 'old_middle',
            rural:      'rural',
        };
        if (focus_map[Q.campaign_focus] === c) {
            speed += ci * 0.04;
        }
        // women / middle spread a little across all
        if (Q.campaign_focus === 'women' || Q.campaign_focus === 'middle') {
            speed += ci * 0.02;
        }
    }

    // Enemies modifier: suppressed parties move slower toward targeted classes
    const target_map = {
    'NSDAP': ['nsdap'],
    'KPD':   ['kpd'],
    'DNVP':  ['dnvp'],
    'DVP':   ['dvp'],
    'Z':     ['z'],
    'BVP':   ['bvp'],
    'WP':    ['wp'],
    'DDP':   ['ddp'],
    'SAPD':  ['sapd'],
    'CSVD':  ['csvd'],
    'CNBL':  ['cnbl'],
};

const enemy_vars = [Q.enemy_1, Q.enemy_2, Q.enemy_3].filter(Boolean);

if (enemy_vars.length > 0) {
    const worker_classes = ['workers', 'unemployedc'];

    // Collect all targeted parties, weighted by priority tier
    // Primary: full penalty | Secondary: reduced | Tertiary: minor
    const tier_multipliers = [0.78, 0.87, 0.93];

    let slowest_multiplier = 1.0;
    let spd_boost = 1.0;

    enemy_vars.forEach((enemy, tier) => {
        const targets = target_map[enemy] || [];
        if (targets.includes(party) && worker_classes.includes(c)) {
            // Take the strongest applicable penalty if a party appears somehow in multiple tiers
            slowest_multiplier = Math.min(slowest_multiplier, tier_multipliers[tier]);
        }
        if (party === 'spd' && targets.length > 0 && worker_classes.includes(c)) {
            // SPD boost also diminishes by tier: +8%, +5%, +3%
            spd_boost *= (tier === 0 ? 1.08 : tier === 1 ? 1.05 : 1.03);
        }
    });

    speed *= slowest_multiplier;
    if (party === 'spd') speed *= spd_boost;
}

return Math.min(speed, 0.40);

}

// ─────────────────────────────────────────
// MAIN DRIFT LOOP
// ─────────────────────────────────────────

for (Q.c of Q.classes) {
    for (Q.party of Q.parties) {
        Q.base = Q[Q.c + '_' + Q.party] || 0;

        // === BANNED PARTY HANDLING ===
        const banned_flag = Q.party + '_banned';
        if (Q[banned_flag] && BANNED_REDISTRIBUTION[Q.party]) {
            if (Q.base > 0) {
                const routes = BANNED_REDISTRIBUTION[Q.party];
                for (let i = 0; i < routes.length; i++) {
                    const [target, share, condition] = routes[i];
                    if (condition()) {
                        Q[Q.c + '_' + target] += Q.base * share;
                    }
                }
            }
            Q[Q.c + '_' + Q.party] = 0;
            continue;
        }

        // === THERMOSTAT MOVE ===
        const target = computeTarget(Q.party, Q.c);
        const speed  = computeSpeed(Q.party, Q.c);

        // Noise on the move itself, not the target
        // Slightly asymmetric: gains are noisier than losses (political momentum)
        const moving_up   = target > Q.base;
        const noise       = moving_up
            ? (0.80 + _r() * 0.45)   // 0.80–1.25 when gaining
            : (0.88 + _r() * 0.28);  // 0.88–1.16 when losing (stickier)

        Q[Q.c + '_' + Q.party] = Math.max(0,
            Q.base + (target - Q.base) * speed * noise
        );
    }
}


// ─────────────────────────────────────────
// NORMALIZATION
// ─────────────────────────────────────────

if (!Q.math_broken) {
    for (var c of Q.classes) {
        var class_votes = 0;
        for (var party of Q.parties) {
            class_votes += Q[c + '_' + party];
        }
        for (var party of Q.parties) {
            Q[c + '_' + party + '_normalized'] = class_votes > 0 ? Q[c + '_' + party] / class_votes : 0;
            Q[c + '_' + party + '_pct']        = Number((Q[c + '_' + party + '_normalized'] * 100).toFixed(1));
            Q[c + '_' + party + '_display']    = (Q[c + '_' + party + '_normalized'] * 100).toFixed(1);
        }
    }
} else {
    for (var c of Q.classes) {
        var class_votes = Q.impossible_add(0, 0);
        for (var party of Q.parties) {
            class_votes = Q.impossible_add(class_votes, Q[c + '_' + party]);
        }
        for (var party of Q.parties) {
            Q[c + '_' + party + '_normalized'] = Q.impossible_multiply(Q[c + '_' + party], 1 / class_votes);
            var _classPctStr = Q.impossible_percentage(Q[c + '_' + party + '_normalized'] * 100).toFixed(1);
            Q[c + '_' + party + '_pct']        = Number(_classPctStr);
            Q[c + '_' + party + '_display']    = _classPctStr;
        }
    }
}


// ============================================================
// CLASS×IDENTITY CROSS-TAB
// Identities form ON TOP OF classes: workers_catholics_spd, etc.
// Each (class, identity) pair gets its own raw vote pool per party,
// driven by the same computeTarget()/computeSpeed() thermostat as
// the class-only loop above, but with each party's target additionally
// crossed by Q.identity_mods[party][idn] (the identity's own affinity,
// isolated from buildIdentityModifier — see where Q.identity_mods is
// built, above the drift functions).
// ============================================================

Q.identities = Q.identities || ['catholics', 'protestants', 'seculars', 'youth'];

// --- Class lean coefficients ---
// The naive Q[c] * Q[idn] formula is scale-invariant in Q[c] (it cancels
// out of the ratio), so every class ended up with an identical identity
// composition — rural, workers, and new_middle all showing the exact same
// 20.7 / 63.4 / 3.9 / 12.0 split. That's not a real cross-tab, just the
// population-wide split copy-pasted per class.
//
// This table gives each class its own lean, multiplied against the
// population-wide Q[idn] share before normalizing. A lean of 1.0 means
// "matches the population average"; >1 skews the identity toward that
// class, <1 skews it away. Q[idn]'s own drift (secularization, youth
// radicalization, etc.) still moves every class's composition over time —
// this only sets the *relative* skew between classes, consistent with
// the setting (rural more religious/Protestant, workers/new_middle more
// secular and younger, old_middle the most religiously conventional).
Q.class_identity_lean = Q.class_identity_lean || {
    workers:     { catholics: 0.90, protestants: 0.95, seculars: 1.45, youth: 1.20 },
    old_middle:  { catholics: 1.05, protestants: 1.10, seculars: 0.55, youth: 0.75 },
    new_middle:  { catholics: 0.95, protestants: 1.00, seculars: 1.30, youth: 1.05 },
    rural:       { catholics: 1.10, protestants: 1.20, seculars: 0.25, youth: 0.85 },
    unemployedc: { catholics: 0.95, protestants: 0.95, seculars: 1.15, youth: 1.55 },
};

// --- Cell population shares: Q[idn] weighted by that class's lean,
//     renormalized so the 4 identity shares within each class sum to 100%.
Q.class_identity_share = Q.class_identity_share || {};

for (var c of Q.classes) {
    var _lean = Q.class_identity_lean[c] || {};
    var _raw = {};
    var _raw_total = 0;
    for (var idn of Q.identities) {
        var v = (Q[idn] || 0) * (_lean[idn] !== undefined ? _lean[idn] : 1.0);
        _raw[idn] = v;
        _raw_total += v;
    }
    Q.class_identity_share[c] = {};
    for (var idn of Q.identities) {
        Q.class_identity_share[c][idn] = _raw_total > 0 ? (_raw[idn] / _raw_total) * 100 : (100 / Q.identities.length);
    }
}

// --- Cell drift loop: same thermostat as the class-only loop, one level deeper.
if (!Q.math_broken) {
    for (var c of Q.classes) {
        for (var idn of Q.identities) {
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                var cbase = Q[ckey] || 0;

                // Banned party handling mirrors the class-only loop: zero out,
                // no redistribution logic duplicated here (class-level loop
                // already handles redistribution for the class as a whole).
                var banned_flag = party + '_banned';
                if (Q[banned_flag]) {
                    Q[ckey] = 0;
                    continue;
                }

                var class_target    = computeTarget(party, c);
                // Identities no longer influence party vote targets: the cell
                // target is derived purely from the class calculation above
                // (computeTarget(party, c)), same as every other cell in
                // class c. Q.identity_mods is intentionally not consulted
                // here anymore — identity still shapes population composition
                // via Q.class_identity_share (built above), it just no longer
                // biases which party a class member votes for.
                var identity_affinity = (Q.identity_mods[party] && Q.identity_mods[party][idn] !== undefined)
                ? Q.identity_mods[party][idn] : 1.0;
                var cell_target = Math.max(0, class_target * identity_affinity);
                var cell_speed       = computeSpeed(party, c);

                var moving_up = cell_target > cbase;
                var noise = moving_up
                    ? (0.80 + _r() * 0.45)
                    : (0.88 + _r() * 0.28);

                Q[ckey] = Math.max(0, cbase + (cell_target - cbase) * cell_speed * noise);
            }
        }
    }
} else {
    for (var c of Q.classes) {
        for (var idn of Q.identities) {
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                var cbase = Q.impossible_add(Q[ckey] || 0, 0);
                var class_target = computeTarget(party, c);
                // Same change as the normal-mode branch: identity no longer
                // biases the target, cell derives purely from the class calc.
                var cell_target = class_target;
                Q[ckey] = Q.impossible_add(cbase, Q.impossible_subtract(cell_target, cbase));
            }
        }
    }
}

// --- Cell normalization: within each (class, identity) pair, parties sum to 100%.
if (!Q.math_broken) {
    for (var c of Q.classes) {
        for (var idn of Q.identities) {
            var cell_votes = 0;
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                Q[ckey] = Math.max(0, Q[ckey] || 0);
                cell_votes += Q[ckey];
            }
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                Q[ckey + '_normalized'] = cell_votes > 0 ? Q[ckey] / cell_votes : 0;
                Q[ckey + '_pct']        = Number((Q[ckey + '_normalized'] * 100).toFixed(1));
                Q[ckey + '_display']    = (Q[ckey + '_normalized'] * 100).toFixed(1);
            }
        }
    }
} else {
    for (var c of Q.classes) {
        for (var idn of Q.identities) {
            var cell_votes = Q.impossible_add(0, 0);
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                cell_votes = Q.impossible_add(cell_votes, Q[ckey] || 0);
            }
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                Q[ckey + '_normalized'] = Q.impossible_multiply(Q[ckey] || 0, 1 / cell_votes);
                var _cellPctStr = Q.impossible_percentage(Q[ckey + '_normalized'] * 100).toFixed(1);
                Q[ckey + '_pct']        = Number(_cellPctStr);
                Q[ckey + '_display']    = _cellPctStr;
            }
        }
    }
}
































// ============================================================
// BILL SYSTEM — POST EVENT TICK (v3)
//
// Single flat bill pool ordered socialist → völkisch.
// Parties select from it based on ideology window + affinity.
// Bills are not owned by any party; any eligible party can
// push any bill that falls within their ideological range.
// ============================================================


// ============================================================
// SECTION A: GLOBAL BILL POOL
//
// base_ideo : 1 (communist) → 10 (völkisch)
// affinity  : thematic tags for party affinity scoring
// cooldown  : turns before bill can re-enter queue (25–60)
// push_weight: base probability weight before modifiers
// ============================================================

var BILLS = [

    // ── FAR LEFT (ideo 1) ────────────────────────────────────
    { id: 'socialisation',      name: 'Socialisation of Heavy Industry',
      type: 'economic', base_ideo: 1, affinity: ['labor','socialist'],
      timer: 35, push_weight: 0.18, ministry: 'economic',    cooldown: 40,
      on_pass: function() { Q.socialization=(Q.socialization||0)+1; } },

    { id: 'works_councils',     name: 'Revolutionary Works Councils Act',
      type: 'labor',    base_ideo: 1, affinity: ['labor','socialist'],
      timer: 30, push_weight: 0.14, ministry: 'labor',       cooldown: 40,
      on_pass: function() { Q.works_councils=(Q.works_councils||0)+2; } },

    { id: 'workers_relief',     name: 'Emergency Workers Relief Fund',
      type: 'welfare',  base_ideo: 1, affinity: ['welfare','labor'],
      timer: 28, push_weight: 0.15, ministry: 'labor',       cooldown: 35,
      on_pass: function() { Q.workers_aid=(Q.workers_aid||0)+1; Q.welfare=(Q.welfare||0)+1; } },

    // ── DEMOCRATIC LEFT (ideo 2–3) ───────────────────────────
    { id: 'land_reform',        name: 'Agricultural Land Reform',
      type: 'economic', base_ideo: 2, affinity: ['agrarian','socialist'],
      timer: 35, push_weight: 0.12, ministry: 'agriculture', cooldown: 40,
      on_pass: function() { Q.land_reform=(Q.land_reform||0)+1; } },

    { id: 'cooperatives',       name: 'Worker Cooperative Promotion Act',
      type: 'labor',    base_ideo: 2, affinity: ['labor','socialist'],
      timer: 30, push_weight: 0.12, ministry: 'economic',    cooldown: 40,
      on_pass: function() { Q.cooperatives=(Q.cooperatives||0)+1; } },

    { id: 'unemployment_ins',   name: 'Unemployment Insurance Extension',
      type: 'welfare',  base_ideo: 3, affinity: ['welfare','labor'],
      timer: 30, push_weight: 0.20, ministry: 'labor',       cooldown: 35,
      on_pass: function() { Q.workers_aid=(Q.workers_aid||0)+1; Q.welfare=(Q.welfare||0)+1; } },

    { id: 'public_works',       name: 'WTB Public Works Programme',
      type: 'economic', base_ideo: 3, affinity: ['labor','reform'],
      timer: 45, push_weight: 0.16, ministry: 'economic',    cooldown: 50,
      on_pass: function() { Q.state_buyer=(Q.state_buyer||0)+1; } },

    { id: 'womens_workplace',   name: 'Women in the Workplace Act',
      type: 'social',   base_ideo: 3, affinity: ['civil','reform'],
      timer: 35, push_weight: 0.12, ministry: 'labor',       cooldown: 40,
      on_pass: function() { Q.womens_rights=(Q.womens_rights||0)+1; Q.womens_work=(Q.womens_work||0)+1; } },

    // ── LIBERAL CENTRE (ideo 4–5) ────────────────────────────
    { id: 'secular_schools',    name: 'Secular School Reform',
      type: 'social',   base_ideo: 5, affinity: ['civil','secular'],
      timer: 40, push_weight: 0.12, ministry: 'interior',    cooldown: 40,
      on_pass: function() { Q.secularized=(Q.secularized||0)+1; Q.school_boards=(Q.school_boards||0)+1; } },

    { id: 'consumer_protect',   name: 'Consumer Protection Reform',
      type: 'economic', base_ideo: 5, affinity: ['reform','bourgeois'],
      timer: 30, push_weight: 0.10, ministry: 'economic',    cooldown: 35,
      on_pass: function() { Q.pro_consumer=(Q.pro_consumer||0)+1; } },

    { id: 'para_175_reform',    name: 'Reform of Paragraph 175',
      type: 'civil',    base_ideo: 5, affinity: ['civil','secular'],
      timer: 45, push_weight: 0.08, ministry: 'justice',     cooldown: 60,
      on_pass: function() { Q.homosexual_rights=(Q.homosexual_rights||0)+1; Q.reformed_183=1; } },

    // ── CHRISTIAN CENTRE (ideo 5–6) ──────────────────────────
    { id: 'church_concordat',   name: 'Church-State Concordat',
      type: 'social',   base_ideo: 5, affinity: ['catholic','conservative'],
      timer: 50, push_weight: 0.16, ministry: 'chancellor',  cooldown: 60,
      on_pass: function() { Q.prussian_concordate=1; } },

    { id: 'confessional_schools',name: 'Confessional Schools Protection',
      type: 'social',   base_ideo: 5, affinity: ['catholic','conservative'],
