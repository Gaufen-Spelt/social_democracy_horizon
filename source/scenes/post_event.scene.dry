// CALCULATIONS ARE HERE:


// 1. Calculate the dynamic threshold based on budget
Q.dismantle_required_strength = Q.budget >= -1 ? 50 : 50 * Math.pow(0.6, -1 - Q.budget);

Q.strength_groups = {
    current_reform_strength: [
        ['reformist_strength', 1],
        ['labor_strength', 1/3],
        ['neorevisionist_strength', 1]
    ],
    true_reform_strength: [
        ['reformist_strength', 1],
        ['labor_strength', 1],
        ['neorevisionist_strength', 1]
    ],
    false_reform_strength: [
        ['reformist_strength', 2],
        ['neorevisionist_strength', 1]
    ],
    republican_strength: [
        ['reformist_strength', 1],
        ['neorevisionist_strength', 2],
        ['labor_strength', 1/4]
    ],
    umbrella_reform_strength: [
        ['reformist_strength', 1],
        ['labor_strength', 1],
        ['center_strength', 1],
        ['neorevisionist_strength', 1]
    ],
    left_bloc_strength: [
        ['left_strength', 1],
        ['center_strength', 0.5]
    ],
    // add new combos here, one line each
};

Q.recalc_strengths = function() {
    for (var key in Q.strength_groups) {
        var total = 0;
        var terms = Q.strength_groups[key];
        for (var i = 0; i < terms.length; i++) {
            var varName = terms[i][0];
            var weight = terms[i][1];
            total += (Q[varName] || 0) * weight;
        }
        Q[key] = total;
    }
};

Q.recalc_strengths();





// ============================================================
// REICHSEXEKUTION TRIGGER CHECK (stub)
// ============================================================

// President's ideology score, using same override pipeline as parties
var _presidentParty = (Q.president_party || '').toLowerCase();
Q.president_ideo_score = Q[_presidentParty + '_ideo_score'] !== undefined
    ? Q[_presidentParty + '_ideo_score']
    : 10; // unaffiliated/unknown president -> centrist fallback
Q.president_ideo_bucket =
    Q.president_ideo_score <= 3  ? 'far-left'  :
    Q.president_ideo_score <= 8  ? 'left'      :
    Q.president_ideo_score <= 11 ? 'center'    :
    Q.president_ideo_score <= 16 ? 'right'     : 'far-right';

// Chancellor's score (chancellor_party assumed to hold a party key, e.g. 'spd')
var _chancellorParty = (Q.chancellor_party || '').toLowerCase();
Q.chancellor_ideo_score = Q[_chancellorParty + '_ideo_score'] !== undefined
    ? Q[_chancellorParty + '_ideo_score']
    : Q.president_ideo_score; // no valid chancellor -> no gap contribution

// Seat-weighted average ideology of the government (in_government == 1 only)
var _govWeightedSum = 0;
var _govSeatTotal = 0;
for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    if (Q[p + '_in_government'] === 1) {
        var seats = Q[p + '_r'] || 0;
        _govWeightedSum += (Q[p + '_ideo_score'] || 10) * seats;
        _govSeatTotal += seats;
    }
}
Q.government_ideo_score_weighted = _govSeatTotal > 0
    ? _govWeightedSum / _govSeatTotal
    : Q.president_ideo_score; // no government -> no gap contribution

// Gap checks, either direction, threshold 7
var _chancellorGap = Math.abs(Q.president_ideo_score - Q.chancellor_ideo_score);
var _governmentGap = Math.abs(Q.president_ideo_score - Q.government_ideo_score_weighted);

Q.reichsexekution_chancellor_trip = _chancellorGap >= 7 ? 1 : 0;
Q.reichsexekution_government_trip = _governmentGap >= 7 ? 1 : 0;

Q.reichsexekution_triggered = 0;
Q.reichsexekution_cause = '';

if (Q.presidential_powers != 1) {
    if (Q.reichsexekution_chancellor_trip && Q.reichsexekution_government_trip) {
        Q.reichsexekution_triggered = 1;
        Q.reichsexekution_cause = 'both';
    } else if (Q.reichsexekution_chancellor_trip) {
        Q.reichsexekution_triggered = 1;
        Q.reichsexekution_cause = 'chancellor';
    } else if (Q.reichsexekution_government_trip) {
        Q.reichsexekution_triggered = 1;
        Q.reichsexekution_cause = 'government_average';
    }
}
































