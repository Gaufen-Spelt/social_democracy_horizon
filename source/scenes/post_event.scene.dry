title: Post Event
new-page: true
on-arrival: {!

// NOTES: IDEOLOGIES: 1 - 6 ARE FAR LEFT
// 7 - 9 ARE CENTER LEFT
// 10 - 12 ARE CENTER
// 13 - 15 ARE CENTER RIGHT
// 16 - 20 ARE FAR RIGHT

// RNG

function _mkrng(seed) {
    let s = seed >>> 0;
    return function() {
        s += 0x6d2b79f5;
        let t = Math.imul(s ^ (s >>> 15), 1 | s);
        t ^= t + Math.imul(t ^ (t >>> 7), 61 | t);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}

// Derive a per-tick RNG from the fixed seed + tick counter
// Same seed + same tick = identical results every time
const _r = _mkrng((Q.rng_seed + Q.tick * 0x9e3779b9) >>> 0);

Q.random_factor = function(f, variance = 0.65) {
    return f * (1 - variance / 2 + _r() * variance);
};


// UPDATE PARTY RELATIONSHIPS EACH TIME.

function updatePartyRelations() {
    // 1. Direct mappings to variables that events already alter
    Q.party_relations.KPD.SPD   = Q.kpd_relation;
    Q.party_relations.KPD.SRPD  = Q.kpd_relation + 5;
    Q.party_relations.SPD.KPD   = Q.kpd_relation;
    Q.party_relations.SPD.DDP   = Q.ddp_relation;
    Q.party_relations.SPD.Z     = Q.z_relation;
    Q.party_relations.SPD.DVP   = Q.dvp_relation;
    Q.party_relations.SPD.CSRP  = Q.csrp_relation;
    Q.party_relations.SPD.DNVP  = Q.dnvp_relation;
    Q.party_relations.SPD.KVP   = Q.kvp_relation;
    Q.party_relations.SPD.DHP   = Q.dhp_relation;
    Q.party_relations.SPD.BB    = Q.bb_relation;
    Q.party_relations.SPD.DVFP  = Q.dvfp_relation;
    Q.party_relations.SPD.BVP   = Q.bvp_relation;
    Q.party_relations.SRPD.KPD  = Q.kpd_relation - 10;
    Q.party_relations.SRPD.DDP  = Q.ddp_relation + 10;
    Q.party_relations.SRPD.Z    = Q.z_relation + 5;
    Q.party_relations.DDP.SPD   = Q.ddp_relation;
    Q.party_relations.DDP.SRPD  = Q.ddp_relation + 10;
    Q.party_relations.Z.SPD     = Q.z_relation;
    Q.party_relations.Z.SRPD    = Q.z_relation + 5;
    Q.party_relations.CSRP.SPD  = Q.csrp_relation;
    Q.party_relations.CSRP.SRPD = Q.csrp_relation + 5;
    Q.party_relations.DNVP.SPD  = Q.dnvp_relation;
    Q.party_relations.DNVP.SRPD = Q.dnvp_relation - 5;
    Q.party_relations.DVFP.SPD  = Q.dvfp_relation;
    Q.party_relations.VRP.SPD   = Q.vrp_relation;
    Q.party_relations.ASPD.KPD  = Q.kpd_relation - 10;
    Q.party_relations.ASPD.DDP  = Q.ddp_relation + 5;
    Q.party_relations.ASPD.Z    = Q.z_relation;
    Q.party_relations.ASPD.DVP  = Q.dvp_relation + 10;

    // --- newly added: remaining tracked-relation parties, mirrored both ways ---
    Q.party_relations.SAPD.SPD  = 50 + (Q.left_strength >= 50 ? 15 : 0);
    Q.party_relations.SPD.SAPD  = 50 + (Q.left_strength >= 50 ? 15 : 0);

    Q.party_relations.BVP.SPD   = Q.bvp_relation;
    Q.party_relations.BVP.SRPD  = Q.bvp_relation + 5;

    Q.party_relations.DVP.SPD   = Q.dvp_relation;
    Q.party_relations.DVP.SRPD  = Q.dvp_relation - 5;
    Q.party_relations.DVP.DDP   = 65 - (Q.dvp_right_shift ?? 0) * 10;
    Q.party_relations.DVP.Z     = 60 + (Q.z_party_leader === "Kaas" ? 10 : 0);
    Q.party_relations.DVP.DNVP  = 50 + (Q.dvp_right_shift ?? 0) * 15;
    Q.party_relations.DVP.NSDAP = 20 + (Q.capital_strike_progress * 6) + (Q.dvp_right_shift ?? 0) * 12;

    Q.party_relations.WP.SPD    = Q.wp_relation;
    Q.party_relations.WP.SRPD   = Q.wp_relation - 5;
    Q.party_relations.WP.NSDAP  = 30 + (Q.capital_strike_progress * 3);

    Q.party_relations.CNBL.SPD  = Q.cnbl_relation;
    Q.party_relations.CNBL.SRPD = Q.cnbl_relation + 5;
    Q.party_relations.CNBL.NSDAP = 30 + (Q.capital_strike_progress * 4) + (Q.year >= 1930 ? 10 : 0);

    Q.party_relations.CSVD.SPD  = Q.csvd_relation;
    Q.party_relations.CSVD.SRPD = Q.csvd_relation + 5;
    Q.party_relations.CSVD.DNVP = Q.dnvp_line === 3 ? 5 : 55;

    Q.party_relations.KVP.DNVP  = Q.dnvp_line === 3 ? 5 : 60;

    Q.party_relations.DHP.DNVP  = Q.dnvp_line === 3 ? 15 : 55;

    Q.party_relations.BB.SPD    = Q.bb_relation;

    Q.party_relations.DBP.SPD   = Q.dbp_relation;
    Q.party_relations.DBP.SRPD  = Q.dbp_relation + 5;

    Q.party_relations.DSBP.SPD  = Q.dsbp_relation;
    Q.party_relations.DSBP.SRPD = Q.dsbp_relation + 3;

    Q.party_relations.DNVP.Z    = (Q.dnvp_line === 3 ? 20 : 50) + (Q.z_party_leader === "Kaas" ? 15 : -10);
    Q.party_relations.Z.DNVP    = (Q.dnvp_line === 3 ? 20 : 50) + (Q.z_party_leader === "Kaas" ? 15 : -10);
    Q.party_relations.Z.NSDAP   = Q.nazi_urgency >= 7 ? 0 : Math.max(0, 25 - Q.nazi_urgency * 5);
    Q.party_relations.NSDAP.Z   = Q.nazi_urgency >= 7 ? 0 : Math.max(0, 20 - Q.nazi_urgency * 4);
    Q.party_relations.NSDAP.BVP = Math.max(0, 15 - Q.nazi_urgency * 3);
    Q.party_relations.BVP.NSDAP = Math.max(0, 15 - Q.nazi_urgency * 3);
    Q.party_relations.NSDAP.VRP = 25 + (Q.capital_strike_progress * 3);
    Q.party_relations.NSDAP.DVP = 25 + (Q.capital_strike_progress * 5) + (Q.dvp_right_shift ?? 0) * 10;
    Q.party_relations.NSDAP.WP  = 30 + (Q.capital_strike_progress * 3);
}

updatePartyRelations();




// ── ENSURE EVERY Q.parties MEMBER HAS A FULL RELATIONS ROW/COLUMN ──
function ensurePartyRelationsComplete() {
    if (!Array.isArray(Q.parties) || !Q.party_relations) return;

    var allParties = Q.parties
        .filter(function(p){ return p !== 'other'; })
        .map(function(p){ return p.toUpperCase(); });

    // SPD is the player party and always implicitly present.
    if (allParties.indexOf('SPD') === -1) allParties.push('SPD');

    for (var i = 0; i < allParties.length; i++) {
        var p1 = allParties[i];

        // Ensure the row exists.
        if (!Q.party_relations[p1] || typeof Q.party_relations[p1] !== 'object') {
            Q.party_relations[p1] = {};
        }

        // Ensure every OTHER party has an entry in this row, and that this
        // party has an entry in every OTHER row (both directions).
        for (var j = 0; j < allParties.length; j++) {
            var p2 = allParties[j];
            if (p1 === p2) continue;

            if (Q.party_relations[p1][p2] === undefined || Q.party_relations[p1][p2] === null) {
                Q.party_relations[p1][p2] = 0;
            }
            if (!Q.party_relations[p2] || typeof Q.party_relations[p2] !== 'object') {
                Q.party_relations[p2] = {};
            }
            if (Q.party_relations[p2][p1] === undefined || Q.party_relations[p2][p1] === null) {
                Q.party_relations[p2][p1] = 0;
            }
        }
    }
}

ensurePartyRelationsComplete();





























Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// make sure no stat is below 0.

// 1. update dates
if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.ma = 1;
    Q.subevents = 1;
    console.log(Q.month);
    console.log(Q.time);
    
    // Advance by 1 week during a Ruhr labor strike, 2 weeks otherwise
    Q.weeks = (Q.weeks || 0) + (Q.ruhr_labor_strike == 1 ? 1 : 2);
    
    // Roll over to next month when 4+ weeks pass
    if (Q.weeks >= 4) {
        Q.weeks -= 4;
        Q.month += 1;
        
        if (Q.month >= 13) {
            Q.month = 1;
            Q.year += 1;
            if (Q.landvolk_fury) {
                Q.landvolk_fury -= 1;
            }
            if (Q.historical_mode) {
                Q.resources += 2;
            }
        }
    }
    
    // decrement timers
    for (timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }












































if (Q.ruhr_labor_strike == 1) {

Q.socialism += 1 * Q.general_strike_progress;
Q.nationalism += 1 * Q.capital_strike_progress;

// --- workers vs employers ---
Q.ruhr_workers = Q.workers / 6.5;
Q.ruhr_worker_rfb = Q.ruhr_workers * 0.80;
Q.ruhr_worker_rb  = Q.ruhr_workers * 0.15;
Q.ruhr_worker_unaligned = Q.ruhr_workers * 0.05;
Q.ruhr_worker_force = Q.ruhr_workers * 0.70;

Q.ruhr_rfb_effective = Q.rfb_strength * Q.rfb_militancy * 0.25;

Q.ruhr_employer_base = Q.old_middle / 18;
Q.ruhr_employer_force = Q.ruhr_employer_base * 0.30;
Q.ruhr_sa_backing = Q.sa_strength * Q.sa_militancy;
Q.ruhr_sh_backing = Q.sh_strength * Q.sh_militancy;
Q.ruhr_employer_total = Q.ruhr_employer_force + Q.ruhr_sa_backing + Q.ruhr_sh_backing;

// --- reichswehr deployment ---
Q.reichswehr_strength_ruhr = 5;
Q.ruhr_reichswehr_effective = Q.reichswehr_strength_ruhr * 1000 * (Q.reichswehr_militancy / 100);
Q.ruhr_rw_loyal = Q.ruhr_reichswehr_effective * (Q.reichswehr_loyalty || 0.5);
Q.ruhr_rw_order = Q.ruhr_reichswehr_effective - Q.ruhr_rw_loyal;

// --- FAUD / KAPD ---
Q.ruhr_faud_effective = (Q.ruhr_faud_strength || 0) * (Q.ruhr_faud_militancy || 0);
Q.ruhr_kapd_effective = (Q.ruhr_kapd_strength || 0) * (Q.ruhr_kapd_militancy || 0);

// --- ideology bonus, shared by RB-split and independent-worker calcs ---
Q.ruhr_left_ideology_bonus = (Q.ideology == "left") ? 1.5 : 1.0;

// --- Reichsbanner split toward left camp, scaled by left_strength (1-99) + ideology bonus ---
Q.ruhr_rb_effective = Q.rb_strength * Q.rb_militancy;
Q.ruhr_rb_to_left_pct = Math.min(1, ((Q.left_strength || 1) / 99) * Q.ruhr_left_ideology_bonus * 0.5);
Q.ruhr_rb_to_left = Q.ruhr_rb_effective * Q.ruhr_rb_to_left_pct;
Q.ruhr_rb_remaining = Q.ruhr_rb_effective - Q.ruhr_rb_to_left;

// --- independent worker share: 1-5% of left_strength (1-99), capped 20%, ideology bonus ---
Q.ruhr_worker_independent_pct = Math.min(0.20, ((Q.left_strength || 1) / 99) * 0.08 * Q.ruhr_left_ideology_bonus);
Q.ruhr_worker_independent = Q.ruhr_workers * Q.ruhr_worker_independent_pct;

// --- left camp: KAPD + FAUD + RFB + RB(split-in) + independent workers ---
Q.ruhr_camp_left = Q.ruhr_kapd_effective
                  + Q.ruhr_faud_effective
                  + Q.ruhr_rfb_effective
                  + Q.ruhr_rb_to_left
                  + Q.ruhr_worker_independent;

// --- republic camp: national Reichswehr(loyalty-weighted) + remaining RB + negligible Jungdo ---
Q.ruhr_jungdo_effective = (Q.jungdo_strength || 0) * 0.01;
Q.ruhr_camp_republic = (Q.reichswehr_strength * (Q.reichswehr_loyalty || 0.5) * Q.reichswehr_militancy)
                      + Q.ruhr_rb_remaining
                      + Q.ruhr_jungdo_effective;

// --- right camp: disloyal Reichswehr(Ruhr-deployed) + SA + SH + employers ---
Q.ruhr_employer_share = Q.ruhr_employer_base * 0.30;
Q.ruhr_camp_right = Q.ruhr_rw_order
                   + Q.ruhr_sa_backing
                   + Q.ruhr_sh_backing
                   + Q.ruhr_employer_share;


if (Q.rfb_banned == 1) {
    Q.ruhr_faud_militancy += 0.001;
    Q.ruhr_kapd_militancy += 0.0005;
    Q.sa_strength += 5;
    if (Q.left_dissent < 50) Q.left_dissent += 2;
}

if (Q.sh_banned == 1) {
    Q.sa_strength += 30;
    Q.sa_militancy += 0.005;
}

if (Q.general_strike_progress > 0) {
    if (!Q.rfb_banned) {
        Q.rfb_strength += 3 * Q.general_strike_progress;
        Q.rfb_militancy += 0.0009 * (Q.general_strike_progress * 0.5)
    } else {
        Q.ruhr_faud_militancy += 0.00085 * (Q.general_strike_progress * 0.5);
        Q.ruhr_kapd_militancy += 0.0005 * (Q.general_strike_progress * 0.5);
    }
}

// --- RFB defection to KAPD/FAUD: redistribution, not free growth ---
Q.ruhr_rfb_defection_rate = 0.02
    + (Q.rfb_banned == 1 ? 0.015 : 0)
    + (Q.general_strike_progress > 0 ? 0.005 * Q.general_strike_progress : 0);

Q.ruhr_rfb_defection = Math.min(Q.rfb_strength * Q.ruhr_rfb_defection_rate, Q.rfb_strength);
Q.rfb_strength -= Q.ruhr_rfb_defection;

Q.ruhr_defection_kapd_share = (Q.ruhr_kapd_militancy || 0) /
    (((Q.ruhr_kapd_militancy || 0) + (Q.ruhr_faud_militancy || 0)) || 1);

Q.ruhr_kapd_strength += Q.ruhr_rfb_defection * Q.ruhr_defection_kapd_share;
Q.ruhr_faud_strength += Q.ruhr_rfb_defection * (1 - Q.ruhr_defection_kapd_share);

if (Q.left_split) {
    Q.rfb_strength += (Q.workers_spd * Q.left_dissent) * 0.01;
}

}





















// === DOMINANT PARTY BACKLASH + IDEOLOGICAL AFFINITY DRIFT ===
// Two opposite relation mechanics, run together each tick, both damped by
// SPEED so changes accrue gradually instead of landing all at once.

Q.relation_dynamics_speed = 0.25;

// --- dominant_party_backlash (inlined) ---
{
    var THRESHOLD = 30;
    var MAX_VOTE = 100;
    var MAX_SHIFT = 28;
    var SPEED = Q.relation_dynamics_speed;
    var MAX_DIST = 20;

    for (var i = 0; i < Q.parties.length; i++) {
        var dom = Q.parties[i];
        var domVotes = Q[dom + '_votes'] || 0;
        if (domVotes <= THRESHOLD) continue;

        var t = Math.min(1, (domVotes - THRESHOLD) / (MAX_VOTE - THRESHOLD));
        var severity = Math.pow(t, 1.5);

        var domIdeo = Q[dom + '_ideo_score'] !== undefined ? Q[dom + '_ideo_score'] : 10;

        if (dom !== 'spd') {
            var spdIdeo = Q['spd_ideo_score'] !== undefined ? Q['spd_ideo_score'] : 10;
            var spdIdeoDist = Math.abs(spdIdeo - domIdeo) / MAX_DIST;
            var spdDecay = Math.max(0, Math.min(1, severity * spdIdeoDist));

            var spdRelKey = dom + '_relation';
            if (Q[spdRelKey] !== undefined) {
                Q[spdRelKey] -= spdDecay * MAX_SHIFT * SPEED;
            }
        }

        for (var j = 0; j < Q.parties.length; j++) {
            var other = Q.parties[j];
            if (other === dom || other === 'spd') continue;

            var otherIdeo = Q[other + '_ideo_score'] !== undefined ? Q[other + '_ideo_score'] : 10;
            var ideoDist = Math.abs(otherIdeo - domIdeo) / MAX_DIST;
            var decay = Math.max(0, Math.min(1, severity * ideoDist));

            if (Q.party_relations[other.toUpperCase()] &&
                Q.party_relations[other.toUpperCase()][dom.toUpperCase()] !== undefined) {
                Q.party_relations[other.toUpperCase()][dom.toUpperCase()] -= decay * MAX_SHIFT * SPEED;
            }
        }
    }
}

// --- ideological_affinity_drift (inlined) ---
{
    var MAX_GAIN = 1;
    var CLOSE_RANGE = 7;
    var SPEED = Q.relation_dynamics_speed;

    var spdIdeo = Q['spd_ideo_score'] !== undefined ? Q['spd_ideo_score'] : 10;

    for (var i = 0; i < Q.parties.length; i++) {
        var p = Q.parties[i];
        if (p === 'spd') continue;

        var pIdeo = Q[p + '_ideo_score'] !== undefined ? Q[p + '_ideo_score'] : 10;
        var dist = Math.abs(spdIdeo - pIdeo);
        var closeness = Math.max(0, 1 - (dist / CLOSE_RANGE));
        var gain = closeness * closeness * closeness * MAX_GAIN;

        var relKey = p + '_relation';
        if (Q[relKey] !== undefined) {
            Q[relKey] += gain * SPEED;
        }
    }

    for (var i = 0; i < Q.parties.length; i++) {
        var a = Q.parties[i];
        if (a === 'spd') continue;
        var aIdeo = Q[a + '_ideo_score'] !== undefined ? Q[a + '_ideo_score'] : 10;

        for (var j = 0; j < Q.parties.length; j++) {
            var b = Q.parties[j];
            if (b === a || b === 'spd') continue;
            var bIdeo = Q[b + '_ideo_score'] !== undefined ? Q[b + '_ideo_score'] : 10;

            var dist2 = Math.abs(aIdeo - bIdeo);
            var closeness2 = Math.max(0, 1 - (dist2 / CLOSE_RANGE));
            var gain2 = closeness2 * closeness2 * closeness2 * MAX_GAIN;

            if (Q.party_relations[a.toUpperCase()] &&
                Q.party_relations[a.toUpperCase()][b.toUpperCase()] !== undefined) {
                Q.party_relations[a.toUpperCase()][b.toUpperCase()] += gain2 * SPEED;
            }
        }
    }
}










// ============================================================
// PASSIVE BUDGET
// ============================================================

Q.upper_tax_rates  = Q.upper_tax_rates || 0;
Q.middle_tax_rates = Q.middle_tax_rates || 0;
Q.lower_tax_rates  = Q.lower_tax_rates || 0;
Q.tariffs          = Q.tariffs || 0;

const TAX_YIELD_SCALE = 0.06;
const UPKEEP_SCALE    = 0.045;

// ============================================================
// PHASE / MACRO LINKAGE
// ============================================================

const PHASE_REVENUE_MULT = {
    growth:         1.10,
    overheating:    1.20,
    correction:     0.90,
    stagflation:    0.75,
    depression:     0.55,
    hyperinflation: 0.35  
};
let phase_revenue_mult = PHASE_REVENUE_MULT[Q.phase] || 1.0;


const PHASE_UPKEEP_MULT = {
    growth:         0.90,
    overheating:    1.05,
    correction:     1.10,
    stagflation:    1.30,
    depression:     1.45,
    hyperinflation: 1.75   
};
let phase_upkeep_mult = PHASE_UPKEEP_MULT[Q.phase] || 1.0;

// --- Unemployment drag ---
let unemp_excess       = Math.max(0, (Q.unemployed || 0) - 6);
let unemp_revenue_mult = Math.max(0.5, 1 - unemp_excess * 0.015);
let unemp_upkeep_mult  = 1 + unemp_excess * 0.02;

// --- Inflation effect ---
let infl = Q.inflation || 0;
let inflation_revenue_mult, inflation_upkeep_mult;
if (infl <= 4) {
    inflation_revenue_mult = 1 + Math.max(0, infl) * 0.02;
    inflation_upkeep_mult  = 1 + Math.max(0, infl) * 0.01;
} else {
    let over = infl - 4;
    inflation_revenue_mult = Math.max(0.25, 1.08 - over * 0.035);
    inflation_upkeep_mult  = 1.04 + over * 0.03;
}

// --- Growth effect (revenue only; upkeep is largely growth-insensitive) ---
let growth_revenue_mult = Math.max(0.6, 1 + (Q.economic_growth || 0) * 0.03);

// Combined macro multipliers, applied once to each side's total below
let macro_revenue_mult = phase_revenue_mult * unemp_revenue_mult * inflation_revenue_mult * growth_revenue_mult;
let macro_upkeep_mult  = phase_upkeep_mult  * unemp_upkeep_mult  * inflation_upkeep_mult;

// --- REVENUE SIDE ---
// NERF PASS: per-source multipliers also cut roughly in half from the
// originals (1.2 -> 0.5 lower-bracket, 0.8 -> 0.35 tariff) so the
// reduction isn't coming only from the shared base scale above.

// Upper-bracket revenue: diminishing returns + capital strike sabotage
let upper_yield = Q.upper_tax_rates * TAX_YIELD_SCALE;
if (Q.upper_tax_rates > 3) {
    upper_yield *= Math.max(0.4, 1 - (Q.upper_tax_rates - 3) * 0.12);
}
if (Q.capital_strike_progress > 0) {
    upper_yield *= Math.max(0.3, 1 - Q.capital_strike_progress * 0.08);
}

let middle_yield = Q.middle_tax_rates * TAX_YIELD_SCALE * 0.75;
if (Q.capital_strike_progress > 0) {
    middle_yield *= Math.max(0.3, 1 - Q.capital_strike_progress * 0.04);
}
if (Q.general_strike_progress > 0) {
    middle_yield *= Math.max(0.3, 1 - Q.general_strike_progress * 0.04);
}

// Lower-bracket revenue: broad base, reliable
let lower_yield = Q.lower_tax_rates * TAX_YIELD_SCALE * 0.5;

if (Q.general_strike_progress > 0) {
    lower_yield *= Math.max(0.3, 1 - Q.general_strike_progress * 0.08);
}

// Tariff revenue: shrinks with contraction and retaliation at high levels
let tariff_yield = Q.tariffs * TAX_YIELD_SCALE * 0.35;
if (Q.economic_growth < 0) {
    tariff_yield *= Math.max(0.5, 1 + Q.economic_growth * 0.05);
}
if (Q.tariffs > 3) {
    tariff_yield *= Math.max(0.5, 1 - (Q.tariffs - 3) * 0.1);
}

Q.fiscal_revenue = (upper_yield + middle_yield + lower_yield + tariff_yield) * macro_revenue_mult;


// --- UPKEEP SIDE ---
// Every enacted program from Agricultural Policy, Economic Democracy,
// Social Welfare, and Education & Science costs ongoing budget to
// maintain, scaled down since it fires every tick (vs. the one-time
// enactment cost).

let welfare_upkeep       = Math.max(0, Q.welfare || 0)          * UPKEEP_SCALE * 0.55;
let land_upkeep          = (Q.land_reform || 0)                  * UPKEEP_SCALE * 0.25;
let agri_fin_upkeep      = (Q.agricultural_finance || 0)         * UPKEEP_SCALE * 0.40;
let pro_consumer_upkeep  = (Q.pro_consumer || 0)                 * UPKEEP_SCALE * 0.35;
let state_buyer_upkeep   = (Q.state_buyer ? 1 : 0)                * UPKEEP_SCALE * 0.85;
let socialization_upkeep = (Q.socialization || 0)                 * UPKEEP_SCALE * 0.65;
let coop_upkeep          = (Q.cooperatives || 0)                  * UPKEEP_SCALE * 0.20;
let commonwealth_upkeep  = (Q.commonwealth_cooperation || 0)      * UPKEEP_SCALE * 0.30;
let econ_dem_upkeep      = (Q.economic_democracy || 0)            * UPKEEP_SCALE * 0.15;
let safety_upkeep        = (Q.workers_safety || 0)                * UPKEEP_SCALE * 0.10;
let police_upkeep        = (Q.prussian_police_strength || 0)             * UPKEEP_SCALE * 0.006;

let edu_science_upkeep    = (Q.education_science || 0)            * UPKEEP_SCALE * 0.10;
let school_boards_upkeep  = (Q.school_boards || 0)                * UPKEEP_SCALE * 0.05;
let public_hs_upkeep      = (Q.public_hs || 0)                    * UPKEEP_SCALE * 0.35;
let medical_research_upkeep = (Q.medical_research || 0)           * UPKEEP_SCALE * 0.40;
let applied_research_upkeep = (Q.applied_research || 0)           * UPKEEP_SCALE * 0.40;
let science_upkeep        = (Q.science || 0)                      * UPKEEP_SCALE * 0.10;
let kwg_research_upkeep   = (Q.kwg_research || 0)                 * UPKEEP_SCALE * 0.30;

Q.fiscal_upkeep = (welfare_upkeep + land_upkeep + agri_fin_upkeep + pro_consumer_upkeep
                + state_buyer_upkeep + socialization_upkeep + coop_upkeep
                + commonwealth_upkeep + econ_dem_upkeep + safety_upkeep
                + edu_science_upkeep + school_boards_upkeep + public_hs_upkeep
                + medical_research_upkeep + applied_research_upkeep + science_upkeep
                + kwg_research_upkeep + police_upkeep) * macro_upkeep_mult;

Q.budget += Q.fiscal_revenue - Q.fiscal_upkeep;
Q.budget = Math.round(Q.budget * 100) / 100;

// ============================================================

const DIRECT_MACRO_SCALE = 0.01; // global dial for this whole block

let growth_gap_effect = Math.max(-0.25, Math.min(0.25, (Q.economic_growth - 2.5) * 0.15));

let unemployment_drag_direct = -Math.max(0, Math.min(0.5, ((Q.unemployed || 0) - 6) * 0.03));

let inflation_drift = Q.inflation - 2.5;
let inflation_effect_direct = 0;
if (inflation_drift > 0) {
    inflation_effect_direct = -Math.min(0.5, inflation_drift * 0.02);
} else if (Q.inflation < -2) {
    inflation_effect_direct = -Math.min(0.3, Math.abs(Q.inflation + 2) * 0.015);
}

let direct_macro_delta = (growth_gap_effect + unemployment_drag_direct + inflation_effect_direct) * DIRECT_MACRO_SCALE * 100;
direct_macro_delta = Math.max(-1.0, Math.min(1.0, direct_macro_delta));

Q.budget += direct_macro_delta;
Q.budget = Math.round(Q.budget * 100) / 100;

// budget_audit must exist BEFORE anything writes into it
Q.budget_audit = Q.budget_audit || {};

Q.budget_audit.direct_growth_effect      = Math.round(growth_gap_effect * DIRECT_MACRO_SCALE * 100 * 100) / 100;
Q.budget_audit.direct_unemployment_drag  = Math.round(unemployment_drag_direct * DIRECT_MACRO_SCALE * 100 * 100) / 100;
Q.budget_audit.direct_inflation_effect   = Math.round(inflation_effect_direct * DIRECT_MACRO_SCALE * 100 * 100) / 100;
Q.budget_audit.direct_macro_delta        = Math.round(direct_macro_delta * 100) / 100;

Q.budget_audit.income_upper_tax   = Math.round(upper_yield  * macro_revenue_mult * 100) / 100;
Q.budget_audit.income_middle_tax  = Math.round(middle_yield * macro_revenue_mult * 100) / 100;
Q.budget_audit.income_lower_tax   = Math.round(lower_yield  * macro_revenue_mult * 100) / 100;
Q.budget_audit.income_tariffs     = Math.round(tariff_yield * macro_revenue_mult * 100) / 100;
Q.budget_audit.income_total       = Math.round(Q.fiscal_revenue * 100) / 100;

Q.budget_audit.expense_welfare       = Math.round(welfare_upkeep       * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_land_reform   = Math.round(land_upkeep          * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_agri_finance  = Math.round(agri_fin_upkeep      * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_pro_consumer  = Math.round(pro_consumer_upkeep  * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_state_buyer   = Math.round(state_buyer_upkeep   * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_socialization = Math.round(socialization_upkeep* macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_cooperatives  = Math.round(coop_upkeep          * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_commonwealth  = Math.round(commonwealth_upkeep * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_econ_dem      = Math.round(econ_dem_upkeep      * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_safety        = Math.round(safety_upkeep        * macro_upkeep_mult * 100) / 100;

Q.budget_audit.expense_police        = Math.round(police_upkeep * macro_upkeep_mult * 100) / 100;

Q.budget_audit.expense_education_science  = Math.round(edu_science_upkeep      * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_school_boards      = Math.round(school_boards_upkeep    * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_public_hs          = Math.round(public_hs_upkeep        * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_medical_research   = Math.round(medical_research_upkeep * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_applied_research   = Math.round(applied_research_upkeep * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_science            = Math.round(science_upkeep          * macro_upkeep_mult * 100) / 100;
Q.budget_audit.expense_kwg_research       = Math.round(kwg_research_upkeep     * macro_upkeep_mult * 100) / 100;

Q.budget_audit.expense_total         = Math.round(Q.fiscal_upkeep * 100) / 100;

// --- NET / MULTIPLIER CONTEXT ---
// net_change now includes the direct macro nudge so it reflects the TRUE total budget movement this tick
Q.budget_audit.net_change      = Math.round((Q.fiscal_revenue - Q.fiscal_upkeep + direct_macro_delta) * 100) / 100;
Q.budget_audit.macro_rev_mult  = Math.round(macro_revenue_mult * 1000) / 1000;
Q.budget_audit.macro_upk_mult  = Math.round(macro_upkeep_mult  * 1000) / 1000;
Q.budget_audit.upper_tax_rate  = Q.upper_tax_rates || 0;
Q.budget_audit.middle_tax_rate = Q.middle_tax_rates || 0;
Q.budget_audit.lower_tax_rate  = Q.lower_tax_rates || 0;
Q.budget_audit.tariff_rate     = Q.tariffs || 0;
Q.budget_audit.phase           = Q.phase;

if (Q.budget_audit.net_change < 0) {
    Q.budget_audit.deficit_tick_streak = (Q.budget_audit.deficit_tick_streak || 0) + 1;
} else {
    Q.budget_audit.deficit_tick_streak = 0;
}

if (Q.budget < 0) {
    Q.budget_audit.budget_negative_streak = (Q.budget_audit.budget_negative_streak || 0) + 1;
} else {
    Q.budget_audit.budget_negative_streak = 0;
}

if (Q.budget < -25) {
    Q.budget_audit.status = "crisis";       
} else if (Q.budget < 0) {
    Q.budget_audit.status = "deficit";      
} else if (Q.budget_audit.net_change < 0) {
    Q.budget_audit.status = "declining";    
} else {
    Q.budget_audit.status = "stable";
}


Q.budget_audit_text =
    "Budget: " + Q.budget.toFixed(2) + " (" + Q.budget_audit.status + ")\n" +
    "Income: " + Q.budget_audit.income_total +
        " [upper tax " + Q.budget_audit.income_upper_tax +
        ", middle tax " + Q.budget_audit.income_middle_tax +
        ", lower tax " + Q.budget_audit.income_lower_tax +
        ", tariffs " + Q.budget_audit.income_tariffs + "]\n" +
    "Expenses: " + Q.budget_audit.expense_total +
        " [welfare " + Q.budget_audit.expense_welfare +
        ", land " + Q.budget_audit.expense_land_reform +
        ", agri finance " + Q.budget_audit.expense_agri_finance +
        ", pro-consumer " + Q.budget_audit.expense_pro_consumer +
        ", state buyer " + Q.budget_audit.expense_state_buyer +
        ", socialization " + Q.budget_audit.expense_socialization +
        ", cooperatives " + Q.budget_audit.expense_cooperatives +
        ", commonwealth " + Q.budget_audit.expense_commonwealth +
        ", econ democracy " + Q.budget_audit.expense_econ_dem +
        ", safety " + Q.budget_audit.expense_safety +
        ", education & science " + Q.budget_audit.expense_education_science +
        ", school boards " + Q.budget_audit.expense_school_boards +
        ", public high schools " + Q.budget_audit.expense_public_hs +
        ", medical research " + Q.budget_audit.expense_medical_research +
        ", applied research " + Q.budget_audit.expense_applied_research +
        ", science " + Q.budget_audit.expense_science +
        ", KWG research " + Q.budget_audit.expense_kwg_research + "]\n" +
    "Direct macro nudge: " + Q.budget_audit.direct_macro_delta +
        " [growth " + Q.budget_audit.direct_growth_effect +
        ", unemployment " + Q.budget_audit.direct_unemployment_drag +
        ", inflation " + Q.budget_audit.direct_inflation_effect + "]\n" +
    "Net this tick: " + Q.budget_audit.net_change +
        " (upper tax rate: " + Q.budget_audit.upper_tax_rate +
        ", middle tax rate: " + Q.budget_audit.middle_tax_rate + ")\n" +
    "Deficit streak: " + Q.budget_audit.deficit_tick_streak + " ticks, " +
    "budget-negative streak: " + Q.budget_audit.budget_negative_streak + " ticks";







































































// QOL

// INSTA ADOPT

if (Q.nationalization_support >= 5) {
    Q.nationalization_adopted = 1;
}

if (Q.moderate_plan_support >= 4) {
    Q.moderate_plan_adopted = 1;
}

if (Q.austerity_support >= 2) {
    Q.centrist_adopted = 1;
}

if (Q.wtb_support >= Q.wtb_threshold) {
    Q.wtb_adopted = 1;
}




// MODIFIERS OF PARTY ADVISORS AND OTHER STUFF



if (Q.peoples_party == 1) {
    if (Q.left_dissent < 45) Q.left_dissent += 1;
    if (Q.center_dissent < 40) Q.center_dissent += 1;
    if (Q.reformist_strength < 30) Q.reformist_strength += 1;
    if (Q.neorevisionist_strength < 20) Q.neorevisionist_strength += 1;
}

const strengthMap = {
    left: "left_strength",
    centrist: "center_strength",
    labor: "labor_strength",
    reformist: "reformist_strength",
    neorev: "neorevisionist_strength"
};
const key = strengthMap[Q.ideology];
if (key && Q[key] < 30) { Q[key] += 1; }


// --- reformist_relation_pull ---

if (Q.ideology == "reformist") {
    var BASE_GAIN = 0.5;
    var SPEED = Q.relation_dynamics_speed;

    for (var i = 0; i < Q.parties.length; i++) {
        var p = Q.parties[i];
        if (p === 'spd') continue;

        var pIdeo = Q[p + '_ideo_score'] !== undefined ? Q[p + '_ideo_score'] : 10;
        if (pIdeo < 8 || pIdeo > 15) continue;

        var relKey = p + '_relation';
        if (Q[relKey] === undefined) continue;

        var distFrom50 = Math.abs(Q[relKey] - 50);
        var falloff = Math.max(0, Math.min(1, distFrom50 / 50));

        Q[relKey] += BASE_GAIN * falloff * SPEED;
    }
}


// DUES' impact on dissent
Q.dissent_cap = 59.9;

function applyDuesDissent(rate, threshold, gain, dissentKey) {
    var diff = rate - threshold;
    var delta = diff * gain;

    if (delta > 0) {
        
        if (Q[dissentKey] < Q.dissent_cap) {
            Q[dissentKey] = Math.min(Q.dissent_cap, Q[dissentKey] + delta);
        }
    } else if (delta < 0) {
        
        if (Q[dissentKey] > 0) {
            Q[dissentKey] = Math.max(0, Q[dissentKey] + delta);
        }
    }
}

applyDuesDissent(Q.dues_workers,     2, 0.3, 'labor_dissent');
applyDuesDissent(Q.dues_unemployedc, 1, 0.5, 'left_dissent');
applyDuesDissent(Q.dues_new_middle,  2, 0.3, 'reformist_dissent');
applyDuesDissent(Q.dues_old_middle,  2, 0.3, 'center_dissent');
applyDuesDissent(Q.dues_rural,       2, 0.3, 'neorevisionist_dissent');






// schachtmatt SCHACHT SIEGE

if (Q.reichsbank_siege >= 1) {
    if (Q.dvp_in_government >= 1) {
    Q.dvp_relation -= 1;
}
    if (Q.presidential_patience >= 50) {
        Q.presidential_patience -= 2;
    } else if (Q.presidential_patience >= 30) {
        Q.presidential_patience -= 1;
    } else if (Q.presidential_patience >= 10) {
        Q.presidential_patience -= 0.5;
    }
Q.economic_growth -= 0.1;
Q.workers -= 0.1;
Q.unemployed += 0.1;
Q.budget -= 0.05;
Q.capital_strike_progress += 0.2;
}


if (Q.year >= 1932 && Q.communist_revolution_timer > 10 && Q.april_challenge == 1) {
    Q.communist_revolution_timer -= 1;
    Q.rfb_strength += 20;
}



























    
// ECONOMIC SIMULATION — v9
// Changes from v8 (over-correction fix):
//  - v8's LINEAR mean reversion was too strong near equilibrium: any shock
//    snapped back to potential growth / NAIRU within ~1 year and then sat
//    glued there with no drift, which reads as "recovers instantly, then
//    stagnates forever" — technically not stagnation, just an inert model.
//  - Replaced with a SOFT reversion curve: weak pull near equilibrium (lets
//    shocks and noise persist / accumulate instead of snapping back), strong
//    pull far from equilibrium (still guarantees extreme states resolve in
//    a few years, not a decade, unlike v7).
//  - Added a demand-destruction feedback loop (uGap-driven demand_pressure
//    drain) so a deep shock can sustain itself for 1-3 years before fading,
//    instead of being purely a single-tick event with no persistence.
//  - Slightly higher noise variance so the economy doesn't freeze at a
//    fixed point once it settles near potential/NAIRU.
//
// v8 changes retained from v7:
//  - DT_SCALE 0.65 -> 1.0
//  - widened delta caps
//  - depression NAIRU creep capped in duration
//  - loosened phase hysteresis (ENTER_TICKS, MIN_PHASE_TICKS)


// ============================================================
// SECTION 0 — TIME CONSTANTS
// ============================================================

const DT_SCALE = 1.0; // was 0.65
const dt = 1 * DT_SCALE;

const POTENTIAL_GROWTH = 2.5;
const BASE_NAIRU = 6.0;
const BASE_INFLATION_TARGET = 2.5;


// ============================================================
// SECTION 1 — INITIALIZATION
// ============================================================

if (!Q.economyInitialized) {
    // Core three
    Q.inflation       = 2.5;
    Q.unemployed      = 6.0;
    Q.economic_growth = 2.5;

    // Structural / slow-moving
    Q.NAIRU                  = BASE_NAIRU;
    Q.inflation_expectations = BASE_INFLATION_TARGET;
    Q.expectations_anchored  = true;
    Q.anchor_break_streak    = 0;   // ticks spent with inflation far from target
    Q.anchor_repair_streak   = 0;   // ticks spent back near target

    // Transient pressures (policy impulses accumulate here, then decay)
    Q.demand_pressure = 0;
    Q.supply_pressure = 0;
    Q.price_pressure  = 0;

    // Phase machine
    Q.phase              = "growth";
    Q.phase_duration      = 0;
    Q.pending_phase       = null;
    Q.pending_phase_ticks = 0;
    Q.clear_zone_ticks    = 0;

    Q.economyInitialized = true;
}

Q.tick = (Q.tick || 0) + 1;
Q.phase_duration = (Q.phase_duration || 0) + 1;


// ============================================================
// SECTION 2 — POLICY IMPULSE INTAKE
// ============================================================
// External code sets Q.demand_impulse / Q.supply_impulse / Q.fiscal_impulse
// as one-shot values; we absorb them into the persistent pressure pools.

function policyScale() {
    // Impulses land harder when the economy is already in a bad state —
    // e.g. stimulus is less effective in a liquidity trap, rate hikes bite
    // harder when unemployment is already low. Capped so it can't explode.
    let scale = 1.0;
    if (Q.unemployed > 15) scale += Math.min(1.0, (Q.unemployed - 15) * 0.05);
    if (Q.inflation < -3)  scale += Math.min(0.6, Math.abs(Q.inflation + 3) * 0.08);
    return Math.min(2.5, scale);
}

if (Q.demand_impulse) {
    Q.demand_pressure += Q.demand_impulse * policyScale();
    Q.demand_impulse = 0;
}
if (Q.supply_impulse) {
    Q.supply_pressure += Q.supply_impulse * policyScale();
    Q.supply_impulse = 0;
}
if (Q.fiscal_impulse) {
    // fiscal_impulse > 0 = stimulus (expansionary), < 0 = austerity
    Q.demand_pressure += Q.fiscal_impulse * 0.5 * policyScale();
    Q.fiscal_impulse = 0;
}


// ============================================================
// SECTION 3 — PHASE STATE MACHINE (non-overlapping regions)
// ============================================================
//
// Each phase is defined by a "zone test" — a boolean function of the current
// (inflation, growth, unemployed). Zones are checked in priority order so that
// if a state happens to satisfy two zones' loose conditions, the higher-priority
// one wins deterministically, and the definitions themselves are written to
// avoid overlap wherever possible (hyperinflation and depression are gated on
// opposite sides of an inflation threshold, so they literally cannot both be true).
//
// Hysteresis: to CHANGE phase, the new zone must be satisfied for
// ENTER_TICKS consecutive ticks. To prevent instant reversal, a phase must
// also have lasted at least MIN_PHASE_TICKS before it's eligible to exit.
//
// v8: both loosened slightly — 7-tick minimum floor to exit a phase was
// stacking with already-slow reversion dynamics to make depression in
// particular last far too long in real time.

const ENTER_TICKS     = 2;   // was 3
const MIN_PHASE_TICKS = 3;   // was 4

const ZONES = {
    // Order matters: checked top to bottom, first match wins.
    hyperinflation: (inf, grw, unem) => inf > 15,

    depression:     (inf, grw, unem) => inf <= 15 && grw < -3 && unem > 12,

    stagflation:    (inf, grw, unem) => inf <= 15 && inf > 5 && grw < 1 && unem > Q.NAIRU + 2,

    overheating:    (inf, grw, unem) => inf <= 15 && inf > 4.5 && grw > 3 && unem < Q.NAIRU,

    correction:     (inf, grw, unem) => inf <= 15 && grw < 0 && grw >= -3,

    growth:         (inf, grw, unem) => true, // default / fallback zone
};

const ZONE_ORDER = ["hyperinflation", "depression", "stagflation", "overheating", "correction", "growth"];

function currentZone() {
    for (const name of ZONE_ORDER) {
        if (ZONES[name](Q.inflation, Q.economic_growth, Q.unemployed)) return name;
    }
    return "growth";
}

{
    const zoneNow = currentZone();

    if (zoneNow === Q.phase) {
        // Still in the zone we're already labeled as; reset any pending switch.
        Q.pending_phase = null;
        Q.pending_phase_ticks = 0;
    } else {
        // We're in a different zone than our current label.
        if (Q.pending_phase === zoneNow) {
            Q.pending_phase_ticks += 1;
        } else {
            Q.pending_phase = zoneNow;
            Q.pending_phase_ticks = 1;
        }

        const eligibleToSwitch = Q.phase_duration >= MIN_PHASE_TICKS;
        const heldLongEnough   = Q.pending_phase_ticks >= ENTER_TICKS;

        // Hyperinflation is an emergency zone: allowed to override MIN_PHASE_TICKS,
        // because "wait N ticks before acknowledging hyperinflation" is not realistic.
        const isEmergencyOverride = zoneNow === "hyperinflation";

        if (heldLongEnough && (eligibleToSwitch || isEmergencyOverride)) {
            Q.phase = zoneNow;
            Q.phase_duration = 0;
            Q.pending_phase = null;
            Q.pending_phase_ticks = 0;
        }
    }
}


// ============================================================
// SECTION 4 — STRUCTURAL DRIFT (NAIRU, expectations anchor)
// ============================================================

// NAIRU hysteresis: prolonged depression raises structural unemployment slowly;
// recovery brings it back down slowly. This is deliberately slow-moving.
//
// v8: creep now also STOPS after phase_duration > 20 — previously depression
// raised its own exit bar (higher NAIRU -> harder to satisfy uGap-based
// recovery terms) for as long as the phase lasted, which fights its own
// resolution the longer a depression runs.
if (Q.phase === "depression" && Q.phase_duration > 8 && Q.phase_duration < 20) {
    Q.NAIRU += (9.0 - Q.NAIRU) * 0.006 * dt;
} else {
    Q.NAIRU += (BASE_NAIRU - Q.NAIRU) * 0.008 * dt;
}
Q.NAIRU = Math.max(3, Math.min(12, Q.NAIRU));

// Anchoring: expectations "de-anchor" only after a sustained period of
// inflation far from target, and "re-anchor" only after a sustained period
// of inflation near target. Plain tick counters — no smoothed streaks.
const farFromTarget = Math.abs(Q.inflation - BASE_INFLATION_TARGET) > 4;
const nearTarget     = Math.abs(Q.inflation - BASE_INFLATION_TARGET) <= 2;

if (farFromTarget) {
    Q.anchor_break_streak += 1;
    Q.anchor_repair_streak = 0;
} else if (nearTarget) {
    Q.anchor_repair_streak += 1;
    Q.anchor_break_streak = 0;
} else {
    // in the middle zone, neither streak advances but neither resets to 0 instantly
    Q.anchor_break_streak = Math.max(0, Q.anchor_break_streak - 1);
    Q.anchor_repair_streak = Math.max(0, Q.anchor_repair_streak - 1);
}

if (Q.expectations_anchored && Q.anchor_break_streak > 5) {
    Q.expectations_anchored = false;
}
if (!Q.expectations_anchored && Q.anchor_repair_streak > 6) {
    Q.expectations_anchored = true;
}

// Expectations chase actual inflation, faster when unanchored.
const expectationSpeed = Q.expectations_anchored ? 0.06 : 0.16;
Q.inflation_expectations += expectationSpeed * (Q.inflation - Q.inflation_expectations) * dt;
if (Q.expectations_anchored) {
    // gentle pull back to the long-run target even if current inflation is off
    Q.inflation_expectations += 0.03 * (BASE_INFLATION_TARGET - Q.inflation_expectations) * dt;
} else {
    // v9: even while UNANCHORED, apply a small pull toward target. Previously
    // this branch did nothing, so once expectations de-anchored they had zero
    // force pulling them back toward BASE_INFLATION_TARGET — they could only
    // chase whatever actual inflation was doing. During a deep deflationary
    // shock this created a closed loop: inflation drags expectations down,
    // expectations (via the dInflation expectations term) offer no upward
    // pull back, so both sides settle together far from target with nothing
    // left to break the lock except the hard clamp. This pull is deliberately
    // much weaker than the anchored case (0.008 vs 0.03) so de-anchoring still
    // means something — expectations are still unmoored and will still chase
    // extreme inflation readily — but it's no longer a perfect trap.
    Q.inflation_expectations += 0.008 * (BASE_INFLATION_TARGET - Q.inflation_expectations) * dt;
}


// ============================================================
// SECTION 5 — DELTA COMPUTATION
// ============================================================

const outputGap = Q.economic_growth - POTENTIAL_GROWTH;
const uGap      = Q.unemployed - Q.NAIRU;

// ---- dINFLATION ----
// Two-sided by construction: runaway terms (Phillips curve slope, expectations
// unanchoring) are matched by a restoring term that scales with how unanchored
// things have gotten, so there is no regime where only the runaway side can act.
// (Left as-is in v8 — inflation dynamics weren't the reported problem, and
// the restoring force here is already correctly non-dampened, i.e. it grows
// FASTER than linear with drift via the ^1.4 exponent, unlike the growth/
// unemployment terms below which had it backwards.)

let dInflation = 0;

const tightnessMult = Q.unemployed < 3 ? (1 + (3 - Q.unemployed) * 0.25) : 1;
dInflation += 0.05 * -uGap * tightnessMult;

dInflation += 0.03 * outputGap;
dInflation += Q.price_pressure * 0.08;

dInflation += 0.08 * (Q.inflation_expectations - Q.inflation);

if (!Q.expectations_anchored) {
    const runaway = Math.max(0, Q.inflation_expectations - Q.inflation) * 0.10;
    dInflation += runaway;
}

const drift = Q.inflation - BASE_INFLATION_TARGET;
// v9: restoring-force coefficient raised 0.03 -> 0.08. At extreme drift with
// elevated unemployment, the old coefficient left this term roughly HALF the
// size of the Phillips-curve term (0.05 * -uGap), so inflation could get
// pushed to the -15 clamp and just sit there — the model's own dynamics
// never actually pulled it back, only the hard floor stopped the fall. This
// keeps the same curve shape (still gentle for ordinary drift) but ensures
// it dominates the runaway terms once drift is large, so deep deflation/
// inflation genuinely resolves instead of parking at the clamp.
const restoringForce = Math.sign(drift) * 0.08 * Math.pow(Math.abs(drift) / 8, 1.4);
dInflation -= restoringForce;

dInflation += (Math.random() - 0.5) * 0.03;

dInflation = Math.max(-2.0, Math.min(6.0, dInflation));


// ---- SOFT REVERSION HELPER ----
// Weak pull when the gap is small (lets noise/shocks persist near equilibrium
// instead of snapping back every tick), strong pull once the gap exceeds
// SOFT_KNEE (so extreme states — real depressions, real overheating — still
// resolve in a few years rather than getting stuck the way v7 did).
//
// v9 tuning note: the original 0.3x near-equilibrium multiplier was too weak
// to overcome persistent external drags (deflation drag on growth, Phillips
// term on inflation) once the economy settled a few points off target —
// those drags don't decay, so a soft-reversion pull that's *also* weak at
// moderate gaps left growth/unemployment/inflation parked 3-4 points off
// target indefinitely instead of continuing to close the gap. Raised to 0.45x
// so it still allows shocks to persist and breathe, but reliably wins against
// steady-state drags at moderate distances instead of only at extremes.
const SOFT_KNEE = 3.0;
function softReversion(gap, baseRate, kneeRate) {
    const extra = Math.max(0, Math.abs(gap) - SOFT_KNEE) * kneeRate;
    return -Math.sign(gap) * (baseRate * Math.abs(gap) * 0.45 + extra);
}

// ---- dUNEMPLOYMENT ----
// Okun's law: growth below potential raises unemployment, above potential lowers it.
let dUnemployment = 0;
const okunsCoeff = outputGap < 0 ? 0.035 : 0.022;
dUnemployment -= okunsCoeff * outputGap / (1 + Math.abs(outputGap) * 0.2);

// Demand pressure (policy) directly affects jobs
dUnemployment -= Q.demand_pressure * 0.4;

// v9: mean reversion toward NAIRU now uses the soft curve — gentle near NAIRU
// so unemployment doesn't get glued to it, strong once uGap is large so
// depression-level unemployment still comes back down within a few years.
dUnemployment += softReversion(uGap, 0.08, 0.03);

// v9: demand-destruction feedback — sustained high unemployment above NAIRU
// suppresses demand, which in turn drags growth. This is what lets a shock
// stay depressed for 1-3 years instead of being a single-tick event that
// fades immediately once the initial hit passes.
//
// IMPORTANT: this must be an EQUILIBRIUM target, not an unconditional drain.
// Draining every tick while uGap > 4 (regardless of current demand_pressure)
// compounds faster than Section 7's exponential decay can remove it, producing
// an unbounded downward spiral instead of a temporary drag. Instead we pull
// demand_pressure toward a floor proportional to uGap, so it stops draining
// once it reaches that floor.
if (uGap > 4) {
    // Floor is capped at -2.0 regardless of how large uGap gets — this is a
    // one-time "demand destruction" drag representing lost confidence/spending,
    // not a force that scales without limit alongside the crisis it's reacting
    // to. An unbounded floor here creates a feedback loop that overpowers the
    // restoring force at any parameterization and spirals to the hard caps.
    const ddFloor = Math.max(-2.0, -0.15 * (uGap - 4));
    if (Q.demand_pressure > ddFloor) {
        Q.demand_pressure += (ddFloor - Q.demand_pressure) * 0.15 * dt;
    }
}

dUnemployment += (Math.random() - 0.5) * 0.03; // was 0.015 — more noise so it doesn't freeze at a fixed point
dUnemployment = Math.max(-3.5, Math.min(3.5, dUnemployment));


// ---- dGROWTH ----
let dGrowth = 0;

// v9: mean reversion toward potential growth now uses the soft curve —
// see SOFT REVERSION HELPER above for rationale.
dGrowth += softReversion(outputGap, 0.14, 0.05);

// Demand and supply pressures move growth directly
dGrowth += Q.demand_pressure * 0.6;
dGrowth += Q.supply_pressure * 0.6;

// High inflation drags on growth (uncertainty, misallocation)
if (Q.inflation > 6) {
    dGrowth -= Math.min(0.02 * (Q.inflation - 6), 1.2);
}
// Deep deflation also drags on growth (debt-deflation spiral), asymmetric but bounded
if (Q.inflation < -2) {
    dGrowth -= Math.min(0.03 * Math.abs(Q.inflation + 2), 1.0);
}

// High unemployment above NAIRU drags on growth (lost capacity)
if (uGap > 0) {
    dGrowth -= Math.min(0.01 * uGap, 1.0);
}

dGrowth += (Math.random() - 0.5) * 0.04; // was 0.02 — more noise so it doesn't freeze at a fixed point
dGrowth = Math.max(-4.5, Math.min(4.5, dGrowth));


// ============================================================
// SECTION 6 — APPLY DELTAS
// ============================================================

Q.inflation       += dInflation * dt;
Q.unemployed      += dUnemployment * dt;
Q.economic_growth += dGrowth * dt;


// ============================================================
// SECTION 7 — DECAY TRANSIENT PRESSURES
// ============================================================

Q.demand_pressure *= Math.exp(-0.20 * dt);
Q.supply_pressure *= Math.exp(-0.20 * dt);
Q.price_pressure  *= Math.exp(-0.25 * dt);


// =========================== CABINET ECONOMICAL EFFECTS ====================


// ============================================================
// BRÜNING AUSTERITY / LAUTENBACH PLAN — mutually exclusive
// ============================================================

if (Q.bruning_cabinet === 1 && Q.lautenbach_plan_active !== 1 && Q.lautenbach_plan_rejected === 1) {

    // Budget improves modestly — spending cuts and tax enforcement
    Q.budget += 0.07;

    // Deflation pressure — wage cuts, price controls, tight money
    Q.price_pressure    -= 0.05;   // stronger signal to compensate

    // Demand collapses — less public spending, lower wages
    Q.demand_impulse    -= 0.07;
    Q.fiscal_stance     -= 0.06;

    // Unemployment creeps up — layoffs from public sector cuts
    Q.demand_impulse    -= 0.03;   // indirect unemployment channel

    // Capital pressure eases slightly — creditor confidence
    Q.capital_pressure  -= 0.03;

    // Trade pressure eases — deflation makes exports cheaper
    Q.trade_pressure    -= 0.03;

    // Austerity reduces monetization pressure — fiscal tightening
    // is the primary way to stop Weimar-style money printing
    Q.monetization_pressure = Math.max(0, (Q.monetization_pressure || 0) - 0.04);

} else if (Q.bruning_cabinet === 1 && Q.lautenbach_plan_active === 1 && !Q.return_to_normalcy) {

    // --------------------------------------------------------
    // LAUTENBACH PLAN — credit-financed public investment
    // Semi-WTB, pre-Keynesian demand stimulus
    // Overrides austerity but carries inflation/debt risk
    // --------------------------------------------------------

    // Budget takes a hit — deficit spending is the mechanism
    Q.budget            -= 0.16;

    // Demand recovers — public works and credit expansion
    Q.demand_impulse    += 0.10;
    Q.fiscal_stance     += 0.04;

    // Supply side benefits — infrastructure investment
    Q.supply_impulse    += 0.05;

    // Unemployment falls — job creation programs
    Q.demand_impulse    += 0.03;

    // Growth nudge routed through demand + supply forces
    Q.supply_impulse    += 0.02;

    // Inflation creeps back — more money chasing goods
    Q.price_pressure    += 0.04;

    // Capital pressure rises — creditors nervous about deficit
    Q.capital_pressure  += 0.04;

    // Trade pressure ticks up — imports rise with demand
    Q.trade_pressure    += 0.03;

    // Modest monetization risk — deficit financed but not pure printing
    Q.monetization_pressure = Math.min(2.0, (Q.monetization_pressure || 0) + 0.02);
}


if (Q.wagemann_plan_active === 1 && Q.year >= 1932 && Q.year < 1933) {
    Q.lautenbach_plan_active   = 0;
    Q.lautenbach_plan_rejected = 0;

    // --------------------------------------------------------
    // WAGEMANN PLAN — monetary expansion / reflation
    // This IS the Weimar money-printing mechanic.
    // Feeds monetization_pressure directly in v5.
    // --------------------------------------------------------

    // Core: directly inject monetization pressure
    Q.monetization_pressure = Math.min(2.0, (Q.monetization_pressure || 0) + 0.12);

    // Price and demand effects of monetary expansion
    Q.price_pressure            += 0.08;
    Q.demand_impulse            += 0.10;
    Q.credit_expansion           = Math.min(0.8, (Q.credit_expansion || 0) + 0.06);

    // If expectations already unanchored, spiral risk kicks in
    if (!Q.expectations_anchored) {
        Q.monetization_pressure  = Math.min(2.0, Q.monetization_pressure + 0.10);
        Q.price_pressure        += 0.06;
        Q.high_inflation_streak  = (Q.high_inflation_streak || 0) + 1.5;
    }

    // Growth benefits modestly — reflation puts money into circulation
    Q.supply_impulse            += 0.03;

    // Budget neutral-to-positive — monetary not fiscal
    Q.budget                    += 0.05;

    // Capital flight risk — foreign creditors panic at money-printing
    Q.capital_pressure          += 0.08;
    Q.trade_pressure            += 0.05;

    // If inflation already above 4, compounding risk
    if (Q.inflation > 4) {
        Q.capital_pressure      += 0.06;
        Q.monetization_pressure  = Math.min(2.0, Q.monetization_pressure + 0.05);
    }
}


// ============================================================
// WTB TIMER EFFECTS
// ============================================================

if ((Q.wtb_timer || 0) > 0) {

    const diminish = Q.wtb_implemented >= 4 ? 0.70 : 1.0;

    Q.demand_impulse   = (Q.demand_impulse  || 0) + 0.04 * diminish;
    Q.fiscal_stance    = (Q.fiscal_stance   || 0) - 0.03 * diminish;
    Q.price_pressure   = (Q.price_pressure  || 0) + 0.02 * diminish;
    Q.supply_impulse   = (Q.supply_impulse  || 0) + 0.02 * diminish;
    Q.capital_pressure = Math.max(0, (Q.capital_pressure || 0) - 0.01 * diminish);

    // NEW — direct budget boost from WTB activity
    Q.budget += 0.35 * diminish;
}






























// ============================================
// PRESIDENTIAL PATIENCE
// ============================================

if (Q.presidential_powers == 0 && !Q.government_dismissed) {

    var pp_gov_count = 0;
    for (var i = 0; i < Q.parties.length; i++) {
        if (Q[Q.parties[i] + '_in_government'] === 1) pp_gov_count++;
    }

    if (pp_gov_count > 0 && !Q.emergency_rule) {

        // --- target patience level based on current economic conditions ---
        var pp_unemp_stress = Math.max(0, (Q.unemployed || 0) - 8);         // 0 at baseline
        var pp_infl_stress  = Math.abs((Q.inflation || 0) - 2);              // 0 at stable 2%
        var pp_growth_bonus = Math.max(0, (Q.economic_growth || 0) - 1);     // rewards real growth
        var pp_growth_stress = Math.max(0, -(Q.economic_growth || 0));      // punishes contraction

        var pp_target = 50;
        pp_target -= pp_unemp_stress   * 3.0;
        pp_target -= pp_infl_stress    * 2.0;
        pp_target -= pp_growth_stress  * 4.0;
        pp_target += pp_growth_bonus   * 2.0;
        pp_target = Math.max(0, Math.min(100, pp_target));

        // --- base drift rate, accelerated by how severe current stress is ---
        var pp_decay_rate = 0.12; // base monthly drift speed
        if (Q.presidential_cabinet === 1) {
            pp_decay_rate *= 0.7; // 30% slowdown: this is his own cabinet
        }

        // crisis multiplier: bad months hit harder, not just settle to a lower target
        var pp_crisis_multiplier = 1 + (pp_unemp_stress + pp_infl_stress + pp_growth_stress) * 0.02;
        pp_decay_rate *= pp_crisis_multiplier;

        Q.presidential_patience = (Q.presidential_patience === undefined) ? 50 : Q.presidential_patience;

        // --- compute drift, with a proportional minimum step so it doesn't stall near the target ---
        var pp_delta = (pp_target - Q.presidential_patience) * pp_decay_rate;
        var pp_gap = Math.abs(pp_target - Q.presidential_patience);
        var pp_min_step = Math.max(0.5, pp_gap * 0.05); // scales with distance, never below 0.5
        if (Math.abs(pp_delta) < pp_min_step && Q.presidential_patience !== pp_target) {
            pp_delta = pp_min_step * Math.sign(pp_target - Q.presidential_patience);
        }
        Q.presidential_patience += pp_delta;

        Q.presidential_patience = Math.max(0, Math.min(100, Q.presidential_patience));
        Q.presidential_patience = Math.round(Q.presidential_patience * 100) / 100;

        // --- dismissal trigger (edge-triggered: fires once, on crossing to 0) ---
        if (Q.presidential_patience <= 0) {
            Q.government_dismissed = 1;
            Q.government_dismissed_reason = "presidential_patience";
        }
    }
}


















    
// ============================================================
// OPINION DYNAMICS — v2
// Tick = 2 weeks (semi-month)
//
// Key changes from v1:
//   - Velocity/momentum tracking (trajectory matters, not just position)
//   - Continuous economy signal instead of binary good/bad gates
//   - Differentiated inertia: nationalism spikes fast/bleeds slow,
//     socialism is sticky, republic legitimacy is sluggish both ways
//   - Faction-weighted influence (junior partners absorb more blame)
//   - Honeymoon/fatigue: grace period on entry, erosion over time
//   - TSE effects multiply into signals rather than stacking additively
//   - All base magnitudes scaled down for fortnightly ticks
// ============================================================

// ============================================================
// HELPERS
// ============================================================

function scale(value, low, high) {
    return Math.max(0, Math.min(1, (value - low) / (high - low)));
}

function lerp(a, b, t) {
    return a + (b - a) * Math.max(0, Math.min(1, t));
}

// Soft sigmoid approach to ceilings/floors — replaces hard clamp logic.
// Returns a multiplier that tapers toward zero as value approaches wall.
function wall_damp(value, wall, width, pushing_toward_wall) {
    if (!pushing_toward_wall) return 1.0;
    var dist = Math.abs(value - wall);
    return Math.max(0, Math.min(1, dist / width));
}

// ============================================================
// VELOCITY TRACKING
// Last-tick deltas stored on Q to compute momentum.
// ============================================================

if (Q.nat_vel  === undefined) Q.nat_vel  = 0;
if (Q.soc_vel  === undefined) Q.soc_vel  = 0;
if (Q.pr_vel   === undefined) Q.pr_vel   = 0;

// Momentum factor: a signal moving fast in one direction amplifies
// further movement in that direction (bandwagon), but only up to a cap.
// Negative momentum (reversals) face friction.
function momentum_mult(velocity, direction) {
    // direction: +1 or -1 for which way we're currently pushing
    var alignment = velocity * direction; // positive = bandwagon, negative = reversal
    if (alignment > 0) {
        // Bandwagon: up to 1.35x amplification, saturating around vel=3
        return 1.0 + Math.min(0.35, alignment * 0.12);
    } else {
        // Reversal friction: harder to turn a fast-moving trend
        return Math.max(0.55, 1.0 + alignment * 0.08);
    }
}

// ============================================================
// TSE FLAG
// ============================================================

var tse = Q.transformed_socialist_economy ? 1 : 0;

// ============================================================
// TICK SCALING
// Base tick = 2 weeks. All deltas are approximately 1/26 of
// annual-scale effects. We don't divide everything by 26 literally —
// instead we reduce the master scaling constants and let the
// continuous signals carry the weight.
// ============================================================

var TICK = 0.38; // master scalar (replaces the flat 0.65 everywhere)

// ============================================================
// CONTINUOUS ECONOMY SIGNAL
// Replaces binary economy_good / economy_bad.
// Returns a value in [-1, +1]:
//   +1 = unambiguous prosperity
//   -1 = severe crisis
//    0 = neutral / mixed
// This feeds into push/pull as a continuous weight rather than a gate.
// ============================================================

var unemp_score     = 1 - scale(Q.unemployed,       3, 22);   // 1=good, 0=bad
var inflation_score = 1 - scale(Math.abs(Q.inflation), 2, 14); // 1=stable, 0=bad
var growth_score    = scale(Q.economic_growth,      -4, 6);   // 1=growing, 0=shrinking

// Weighted composite: unemployment dominates, then growth, then inflation
var econ_composite = (unemp_score * 0.40) + (growth_score * 0.35) + (inflation_score * 0.25);
// Remap from [0,1] to [-1,+1]
var econ_signal = (econ_composite - 0.5) * 2.0;

// TSE raises the bar — transformation promised structural full employment.
// Shift the signal downward slightly if TSE active (harder to reach "good")
if (tse) {
    econ_signal -= scale(Q.unemployed, 4, 10) * 0.25;
}

// Clamp to [-1, +1]
econ_signal = Math.max(-1, Math.min(1, econ_signal));

// Convenience aliases for partial-signal zones
var econ_positive = Math.max(0,  econ_signal);  // 0 when bad, >0 when good
var econ_negative = Math.max(0, -econ_signal);  // 0 when good, >0 when bad
var econ_mixed    = 1 - Math.abs(econ_signal);  // peaks at 0, 1 when perfectly mixed

// Persisted onto Q so the PARTY BEHAVIOR SYSTEM (computeTarget, later in
// this tick) can read the economy signal without recomputing it. This is
// a SEPARATE channel from the bloc-level nat/soc/pr push-pull above — the
// per-party government/opposition reward-punish system below does not
// compound with the bloc-influence system; it reads the same raw
// econ_signal independently.
Q.econ_signal   = econ_signal;
Q.econ_positive = econ_positive;
Q.econ_negative = econ_negative;
Q.econ_mixed    = econ_mixed;

// ============================================================
// PHASE MULTIPLIERS
// Now applied as multipliers on specific components of econ_negative/positive,
// rather than flat scalars on pre-computed stress values.
// ============================================================

var phase_unemp_mult       = 1.0;
var phase_inflation_mult   = 1.0;
var phase_growth_mult      = 1.0;
var phase_centrist_penalty = 0.0;

switch (Q.phase) {
    case "growth":
        phase_unemp_mult     = 0.7;
        phase_inflation_mult = 0.8;
        phase_growth_mult    = 1.4;
        break;
    case "overheating":
        phase_unemp_mult     = 0.8;
        phase_inflation_mult = 1.3;
        phase_growth_mult    = 1.2;
        break;
    case "hyperinflation":
        phase_unemp_mult       = 0.9;
        phase_inflation_mult   = 2.2;
        phase_growth_mult      = 1.0;
        phase_centrist_penalty = 0.8;
        break;
    case "correction":
        phase_unemp_mult     = 1.2;
        phase_inflation_mult = 1.0;
        phase_growth_mult    = 1.3;
        break;
    case "depression":
        phase_unemp_mult       = 2.0;
        phase_inflation_mult   = 0.7;
        phase_growth_mult      = 1.6;
        phase_centrist_penalty = 1.0;
        break;
    case "stagflation":
        phase_unemp_mult       = 1.4;
        phase_inflation_mult   = 1.4;
        phase_growth_mult      = 1.2;
        phase_centrist_penalty = 1.4;
        break;
}

// Phase-weighted economy signal for unemployment, inflation, and growth
// components separately — lets phases tilt which dimension of distress bites
var unemp_neg    = scale(Q.unemployed,           8, 25) * phase_unemp_mult;
var unemp_pos    = (1 - scale(Q.unemployed,      3, 10)) * (2.0 - phase_unemp_mult);
var infl_neg     = scale(Math.abs(Q.inflation),  5, 15) * phase_inflation_mult;
var infl_pos     = (1 - scale(Math.abs(Q.inflation), 3, 8)) * (2.0 - phase_inflation_mult);
var growth_pos   = scale(Q.economic_growth,      1,  6) * phase_growth_mult;
var growth_neg   = scale(-Q.economic_growth,     1, 10) * phase_growth_mult;

// TSE amplifies unemployment signals bidirectionally
if (tse) {
    unemp_neg *= 1.4;
    unemp_pos *= 1.3;
}

unemp_pos  = Math.max(0, Math.min(1, unemp_pos));
infl_pos   = Math.max(0, Math.min(1, infl_pos));

// ============================================================
// PARTY BLOC COUNTS AND INFLUENCE
// Junior coalition partners now weighted differently —
// the smallest partner absorbs disproportionate blame.
// ============================================================

var socialist_party_count   = 0;
var centrist_party_count    = 0;
var nationalist_party_count = 0;

if (Q.ideology === "left" && Q.spd_in_government && Q.social_fascism_adopted != 1) socialist_party_count++;
if (Q.kpd_in_government)  socialist_party_count++;
if (Q.sapd_in_government) socialist_party_count++;
if (Q.sl_in_government)   socialist_party_count++;
if (Q.kpo_in_government)  socialist_party_count++;
if (Q.lb_in_government) socialist_party_count++;

if (Q.spd_in_government && Q.ideology !== "left") centrist_party_count++;
if (Q.z_in_government)    centrist_party_count++;
if (Q.ddp_in_government)  centrist_party_count++;
if (Q.dvp_in_government && (Q.dvp_right_shift || 0) < 1) centrist_party_count++;
if (Q.srpd_in_government) centrist_party_count++;
if (Q.wp_in_government)   centrist_party_count++;
if (Q.bvp_in_government)  centrist_party_count++;
if (Q.dnvp_in_government && Q.dnvp_line === 1) centrist_party_count++;
if (Q.aspd_in_government) centrist_party_count++;
if (Q.vnr_in_government)  centrist_party_count++;
if (Q.hl_in_government)   centrist_party_count++;
if (Q.sls_in_government)   centrist_party_count++;
if (Q.cvp_in_government)   centrist_party_count++;
if (Q.rdp_in_government)   centrist_party_count++;
if (Q.dbp_in_government)   centrist_party_count++;
if (Q.dsbp_in_government)   centrist_party_count++;

if (Q.vnr_in_government)  nationalist_party_count++;
if (Q.dtsp_in_government)  nationalist_party_count++;
if (Q.dnvp_in_government && Q.dnvp_line !== 1) nationalist_party_count++;
if (Q.cnbl_in_government) nationalist_party_count++;
if (Q.nsdap_in_government) nationalist_party_count++;
if (Q.dvfp_in_government) nationalist_party_count++;
if (Q.dvp_in_government && (Q.dvp_right_shift || 0) >= 1) nationalist_party_count++;

// Influence: junior partners (single-party-count blocs in large coalitions)
// take amplified blame. The smaller you are relative to the coalition,
// the more exposed you are to voter punishment.
var total_govt_parties = socialist_party_count + centrist_party_count + nationalist_party_count;
var coalition_size_factor = total_govt_parties > 0 ? total_govt_parties : 1;

function bloc_influence(count) {
    if (count === 0) return 0;
    var base = Math.min(count * 0.35, 1.0);
    // Junior penalty: lone bloc in a large coalition gets +15% blame exposure
    if (count === 1 && coalition_size_factor >= 3) base *= 1.15;
    return Math.min(base, 1.0);
}

var socialist_influence   = bloc_influence(socialist_party_count);
var centrist_influence    = bloc_influence(centrist_party_count);
var nationalist_influence = bloc_influence(nationalist_party_count);

var socialist_in_power    = socialist_party_count > 0;
var centrist_in_power     = centrist_party_count > 0;
var nationalist_in_power  = nationalist_party_count > 0;

// ============================================================
// HONEYMOON / FATIGUE
// New governments get a grace period where blame is muted.
// Long-serving governments face credibility fatigue.
// Stored as Q.govt_tenure_ticks — caller must increment this
// each tick a government persists (or reset on change).
// ============================================================

if (Q.govt_tenure_ticks === undefined) Q.govt_tenure_ticks = 0;

// Honeymoon: first ~12 ticks (6 months), blame absorption is 40% lower
var honeymoon_factor = 1.0 - (0.40 * Math.max(0, 1 - Q.govt_tenure_ticks / 12));
// Fatigue: after ~52 ticks (2 years), credit absorption starts dropping too
var fatigue_factor   = 1.0 - (0.25 * scale(Q.govt_tenure_ticks, 52, 104));

// ============================================================
// PRO_REPUBLIC
// Sluggish in both directions — institutions change slowly.
// ============================================================

var pr_push = 0;
var pr_pull = 0;

// Positive economy feeds republic legitimacy — but slowly,
// institutions earn trust over time more than via single events
pr_push += (unemp_pos * 1.2 + infl_pos * 0.7 + growth_pos * 1.0) * econ_positive * fatigue_factor;

// Negative economy bleeds republic — faster than recovery
pr_pull += (unemp_neg * 2.2 + infl_neg * 1.0 + growth_neg * 1.8) * econ_negative * honeymoon_factor;

// Blame attribution — only when economy is clearly bad
if (econ_negative > 0.3) {
    if (!Q.spd_in_government && !Q.z_in_government) {
        pr_pull += 0.6 * econ_negative;
    }
    if (centrist_in_power && !socialist_in_power && !nationalist_in_power) {
        pr_pull += phase_centrist_penalty * centrist_influence * econ_negative;
    }
}

// TSE: multiplied into existing push/pull rather than additive
if (tse) {
    if (econ_positive > 0.3) {
        // Transformation + prosperity: "the republic can deliver"
        pr_push *= (1.0 + 0.4 * socialist_influence);
    } else if (econ_negative > 0.3) {
        // Transformation + crisis: constitutional anxiety
        pr_pull *= (1.0 + 0.7 * socialist_influence);
    } else {
        // Mixed: structural anxiety
        pr_pull += 0.25 * socialist_influence;
    }
}

var raw_pr_delta = (pr_push - pr_pull);

// Republic legitimacy: asymmetric inertia.
// Recovers at ~60% the speed it falls — institutions bleed faster than they heal.
var pr_inertia = raw_pr_delta > 0 ? 0.60 : 1.0;
raw_pr_delta *= pr_inertia;

// Momentum
var pr_mom = momentum_mult(Q.pr_vel, raw_pr_delta > 0 ? 1 : -1);
raw_pr_delta *= pr_mom;

// Wall damping
raw_pr_delta *= wall_damp(Q.pro_republic, raw_pr_delta > 0 ? 90 : 10, 18, true);

var pr_delta = raw_pr_delta * TICK;
Q.pr_vel = lerp(Q.pr_vel, raw_pr_delta, 0.3); // velocity updates toward raw signal

// ============================================================
// NATIONALISM
// Fast to spike, slow to bleed.
// Explanatory simplicity (scapegoating, betrayal) makes it
// the fastest absorber of economic anxiety.
// ============================================================

var nat_push = 0;
var nat_pull = 0;

// Crisis: nationalism absorbs anxiety fastest of the three
nat_push += (unemp_neg * 2.8 + infl_neg * 1.0 + growth_neg * 2.0) * econ_negative;

if (econ_negative > 0.25) {
    if (nationalist_in_power) {
        // In power during bad times: takes blame, but less than left would
        nat_pull += 1.3 * nationalist_influence * econ_negative * honeymoon_factor;
    }
    if (socialist_in_power || centrist_in_power) {
        var other_influence = Math.max(socialist_influence, centrist_influence);
        nat_push += 1.0 * other_influence * econ_negative;
    }
}

// Prosperity: nationalism loses its core message
nat_pull += (unemp_pos * 1.0 + infl_pos * 0.7) * econ_positive;

if (econ_positive > 0.25) {
    if (nationalist_in_power) {
        // In power during good times: gets some credit but also scrutiny
        nat_push += 1.0 * nationalist_influence * econ_positive * fatigue_factor;
    }
    if (socialist_in_power) {
        nat_pull += 0.8 * socialist_influence * econ_positive;
    }
}

// TSE opposition effect: multiplied into the push/pull
if (tse) {
    if (econ_negative > 0.25 && !nationalist_in_power) {
        // "We told you so" — amplified by how badly transformation is failing
        nat_push *= (1.0 + 0.6 * (1 - socialist_influence) * econ_negative);
    }
    if (econ_positive > 0.25 && !nationalist_in_power) {
        // Successful transformation: ideological defeat for nationalism
        nat_pull *= (1.0 + 0.35 * socialist_influence);
    }
}

var raw_nat_delta = (nat_push - nat_pull);

// Nationalism: FAST spike, SLOW bleed.
// Rising: 1.25x speed. Falling: 0.65x speed.
var nat_inertia = raw_nat_delta > 0 ? 1.25 : 0.65;
raw_nat_delta *= nat_inertia;

var nat_mom = momentum_mult(Q.nat_vel, raw_nat_delta > 0 ? 1 : -1);
raw_nat_delta *= nat_mom;

raw_nat_delta *= wall_damp(Q.nationalism, raw_nat_delta > 0 ? 90 : 10, 18, true);

var nat_delta = raw_nat_delta * TICK;
Q.nat_vel = lerp(Q.nat_vel, raw_nat_delta, 0.35);

// ============================================================
// SOCIALISM
// Slower to move than nationalism, stickier once established.
// Class consciousness builds gradually; it also dissolves gradually.
// ============================================================

var soc_push = 0;
var soc_pull = 0;

// Crisis: socialism gains, but more slowly than nationalism
soc_push += (unemp_neg * 2.8 + infl_neg * 0.8 + growth_neg * 1.6) * econ_negative;

if (econ_negative > 0.25) {
    if (socialist_in_power) {
        var soc_blame_mult = tse ? 0.55 : 1.0; // TSE enables blame deflection
        soc_blame_mult *= honeymoon_factor;
        soc_pull += 1.3 * socialist_influence * econ_negative * soc_blame_mult;
    }
    if (nationalist_in_power && !Q.in_grand_coalition) {
        soc_push += 1.0 * nationalist_influence * econ_negative;
    }
}

// Prosperity: socialism loses urgency narrative
soc_pull += (unemp_pos * 1.0 + infl_pos * 0.7) * econ_positive;

if (econ_positive > 0.25) {
    if (socialist_in_power) {
        soc_push += 1.0 * socialist_influence * econ_positive * fatigue_factor;
    }
    if (nationalist_in_power && !socialist_in_power) {
        soc_pull += 0.7 * nationalist_influence * econ_positive;
    }
}

// TSE structural legitimacy — multiplied into existing signals
if (tse && socialist_in_power) {
    // The transformation itself generates ongoing ideological momentum
    soc_push += 0.25 * socialist_influence;

    if (econ_positive > 0.3) {
        // Vindication narrative amplifies what's already happening
        soc_push *= (1.0 + 0.5 * socialist_influence);
    }
}

var raw_soc_delta = (soc_push - soc_pull);

// Socialism: moderate speed both ways, stickier than nationalism.
// Rising: 0.95x. Falling: 0.75x (class loyalty persists under pressure).
var soc_inertia = raw_soc_delta > 0 ? 0.95 : 0.75;
raw_soc_delta *= soc_inertia;

var soc_mom = momentum_mult(Q.soc_vel, raw_soc_delta > 0 ? 1 : -1);
raw_soc_delta *= soc_mom;

raw_soc_delta *= wall_damp(Q.socialism, raw_soc_delta > 0 ? 90 : 10, 18, true);

var soc_delta = raw_soc_delta * TICK;
Q.soc_vel = lerp(Q.soc_vel, raw_soc_delta, 0.25); // slowest velocity update = stickiest

// ============================================================
// COMPETENCE COUNTERS
// Now continuous rather than threshold-gated.
// ============================================================

if (Q.socialist_govt_success_counter  === undefined) Q.socialist_govt_success_counter  = 0;
if (Q.nationalist_govt_success_counter === undefined) Q.nationalist_govt_success_counter = 0;

if (socialist_in_power) {
    // Counter drifts toward econ_signal — good times build it, bad times erode it
    var soc_counter_drift = econ_signal * socialist_influence * 0.3;
    Q.socialist_govt_success_counter = Math.max(0, Math.min(8,
        Q.socialist_govt_success_counter + soc_counter_drift));

    // Sustained competence compounds socialism score (slowly)
    if (Q.socialist_govt_success_counter > 4) {
        soc_delta += 0.08 * socialist_influence *
            scale(Q.socialist_govt_success_counter, 4, 8) * TICK;
    }
}

if (nationalist_in_power) {
    var nat_counter_drift = econ_signal * nationalist_influence * 0.3;
    Q.nationalist_govt_success_counter = Math.max(0, Math.min(8,
        Q.nationalist_govt_success_counter + nat_counter_drift));

    if (Q.nationalist_govt_success_counter > 4) {
        nat_delta += 0.08 * nationalist_influence *
            scale(Q.nationalist_govt_success_counter, 4, 8) * TICK;
    }
}

// ============================================================
// CROSS-PRESSURE
// Extremes rising bleeds the republic.
// Polarization is bidirectional but asymmetric:
// nationalism rising suppresses socialism more than vice versa
// (fear displaces class solidarity faster than it's rebuilt).
// ============================================================

var cross_mult = tse ? 1.4 : 1.0;

if (Q.nationalism > 35 || Q.socialism > 35) {

    if (nat_delta > 0) {
        pr_delta  -= nat_delta * 0.20 * cross_mult;
        soc_delta -= nat_delta * 0.12; // fear displaces solidarity
    }
    if (soc_delta > 0) {
        pr_delta  -= soc_delta * 0.20 * cross_mult;
        nat_delta -= soc_delta * 0.08; // weaker displacement in this direction
    }

    // If both rising simultaneously: they partially cancel each other
    // rather than both compounding freely
    if (nat_delta > 0 && soc_delta > 0) {
        var smaller = Math.min(nat_delta, soc_delta);
        nat_delta -= smaller * 0.10;
        soc_delta -= smaller * 0.10;
    }
}

// ============================================================
// BROKEN PROMISES
// TSE raises the unemployment betrayal threshold.
// Now uses continuous signal rather than hard threshold.
// ============================================================

if (econ_negative > 0.35) {
    if (socialist_in_power) {
        var unemp_threshold  = tse ? 12 : 20;
        var betrayal_signal  = scale(Q.unemployed, unemp_threshold, unemp_threshold + 8);

        if (betrayal_signal > 0) {
            var betrayal_mag = tse ? 0.55 : 0.30;
            var rep_bleed    = tse ? 0.18 : 0.09;
            soc_delta -= betrayal_mag * socialist_influence * betrayal_signal * TICK;
            pr_delta  -= rep_bleed   * socialist_influence * betrayal_signal * TICK;
        }
    }

    if (nationalist_in_power && (Q.inflation > 15 || Q.economic_growth < -5)) {
        nat_delta -= 0.30 * nationalist_influence * TICK;
        pr_delta  -= 0.09 * nationalist_influence * TICK;
    }

    if (!socialist_in_power && !nationalist_in_power && centrist_in_power) {
        soc_delta += 0.18 * centrist_influence * TICK;
        nat_delta += 0.18 * centrist_influence * TICK;
        pr_delta  -= 0.18 * centrist_influence * TICK;
    }
}

// ============================================================
// TSE PHASE INTERACTIONS
// Now multiplicative into the running deltas rather than flat additive.
// Smaller base values reflect the fortnightly tick — these are
// slow ideological tides, not overnight conversions.
// ============================================================

if (tse) {
    if (Q.phase === "depression") {
        soc_delta += 0.28 * socialist_influence * TICK;
        nat_delta += 0.16 * TICK;
        pr_delta  -= 0.22 * TICK;
    }

    if (Q.phase === "hyperinflation") {
        soc_delta -= 0.45 * socialist_influence * TICK;
        nat_delta += 0.35 * TICK;
        pr_delta  -= 0.35 * TICK;
    }

    if (Q.phase === "stagflation") {
        soc_delta -= 0.18 * socialist_influence * TICK;
        nat_delta += 0.22 * TICK;
        pr_delta  -= 0.28 * TICK;
    }

    if (Q.phase === "growth") {
        soc_delta += 0.22 * socialist_influence * TICK;
        nat_delta -= 0.16 * socialist_influence * TICK;
        pr_delta  += 0.11 * socialist_influence * TICK;
    }
}

// ============================================================
// HISTORICAL PRECEDENT
// ============================================================

if (Q.spd_crisis_victories && Q.spd_crisis_victories > 0
        && econ_positive > 0.3 && socialist_in_power) {
    soc_delta += 0.06 * Q.spd_crisis_victories * socialist_influence * TICK;
}

if (Q.nationalist_crisis_failures && Q.nationalist_crisis_failures > 0
        && nationalist_in_power) {
    nat_delta -= 0.04 * Q.nationalist_crisis_failures * nationalist_influence * TICK;
}

// ============================================================
// APPLY DELTAS
// ============================================================

Q.pro_republic += pr_delta;
Q.nationalism  += nat_delta;
Q.socialism    += soc_delta;

// ============================================================
// CLAMP & ROUND
// ============================================================

if (!Q.math_broken) {
    // NORMAL: Clamp to [0, 100] and round to 1 decimal
    Q.pro_republic = Math.round(Math.max(0, Math.min(100, Q.pro_republic)) * 10) / 10;
    Q.nationalism  = Math.round(Math.max(0, Math.min(100, Q.nationalism))  * 10) / 10;
    Q.socialism    = Math.round(Math.max(0, Math.min(100, Q.socialism))    * 10) / 10;
} else {
    // MATH BROKEN: Values can exceed 100, go negative, or become nonsense
    Q.pro_republic = Q.impossible_percentage(Q.pro_republic);
    Q.nationalism  = Q.impossible_percentage(Q.nationalism);
    Q.socialism    = Q.impossible_percentage(Q.socialism);
    console.log("OPINION CHAOS: PR=" + Q.pro_republic + " Nat=" + Q.nationalism + " Soc=" + Q.socialism + " Total=" + (Q.pro_republic + Q.nationalism + Q.socialism));
}















// ============================================================
// QOL GRIEVANCE SYSTEM
// ============================================================

// ============================================================
// SECTION 2A — TARGET COMPUTATION PER DIMENSION PER CLASS
// Each target is 0–100. 50 = neutral (1928 baseline).
// Above 50 = satisfied, below 50 = aggrieved.
// ============================================================

// ---- SHARED SIGNALS ----
// Pre-compute signals used across multiple classes to avoid repetition.

// Economic signals
const _qol_unemp_stress  = Math.max(0, Q.unemployed - 8);       // 0 at baseline
const _qol_infl_stress   = Math.abs(Q.inflation - 2);            // 0 at stable 2%
const _qol_defl_stress   = Math.max(0, -Q.inflation);            // deflation hits debtors
const _qol_growth_bonus  = Math.max(0, Q.economic_growth - 1);   // positive growth signal
const _qol_growth_stress = Math.max(0, -Q.economic_growth);      // contraction signal

// Security signals
const _qol_sa_threat  = (Q.sa_strength  * Q.sa_militancy)  / 500;
const _qol_rfb_threat = (Q.rfb_strength * Q.rfb_militancy) / 400;
const _qol_sh_threat  = (Q.sh_strength  * Q.sh_militancy)  / 600;
const _qol_rb_shield  = Math.min(1.5, (Q.rb_strength * Q.rb_militancy) / 3000);
const _qol_pol_loyal  = ((Q.prussian_police_loyalty || 0.5) + (Q.interior_police_loyalty || 0.45)) / 2;

// Political signals
const _qol_spd_in_govt  = Q.spd_in_government  ? 1 : 0;
const _qol_left_in_govt = (Q.spd_in_government || Q.kpd_in_government || Q.sapd_in_government) ? 1 : 0;
const _qol_right_in_govt= (Q.dnvp_in_government || Q.nsdap_in_government) ? 1 : 0;
const _qol_con_reform   = Q.constitutional_reform || 0;
const _qol_pres_rel     = (Q.presidential_patience  || 50) / 100;

// Cultural signals
const _qol_edu          = Q.education_science || 0;
const _qol_sci          = Q.science           || 0;
const _qol_womens       = Q.womens_rights      || 0;
const _qol_secular      = Q.secularized        || 0;
const _qol_curriculum_d = (Q.major_curriculum === 'democratic'  || Q.minor_curriculum === 'democratic')  ? 1 : 0;
const _qol_curriculum_t = (Q.major_curriculum === 'traditional' || Q.minor_curriculum === 'traditional') ? 1 : 0;
const _qol_concordat    = (Q.prussian_concordate || Q.reichskonkordat) ? 1 : 0;
const _qol_youth_orgs   = Q.youth_organizations || 0;


// ============================================================
// WORKERS
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    _t += (Q.welfare          || 0) * 7;
    _t += (Q.working_hours    || 0) * 5;
    _t += (Q.workers_safety   || 0) * 4;
    _t += (Q.works_councils   || 0) * 4;
    _t += (Q.works_program    || 0) * 6;
    _t += (Q.wtb_implemented  || 0) * 5;
    _t += (Q.cooperatives     || 0) * 3;
    _t += _qol_growth_bonus        * 1.5;
    _t -= _qol_unemp_stress        * 2.5;
    _t -= _qol_growth_stress       * 2.0;
    _t -= (Q.dues_workers     || 0) * 4;     // dues are a burden on workers
    _t -= _qol_infl_stress         * 0.8;   // workers hurt by inflation but less than middle
    if (Q.unions_independent === 1) _t -= 10; // alienated from SPD
    _t = Math.max(0, Math.min(100, _t));
    Q.workers_grievance_economic += ((_t - Q.workers_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    _t = 50;
    _t -= _qol_sa_threat  * 18;   // SA is the primary threat to workers
    _t -= _qol_rfb_threat * 6;    // RFB crossfire also hurts workers
    _t += _qol_rb_shield  * 12;   // Reichsbanner protects
    _t += _qol_pol_loyal  * 10;   // loyal police helps
    _t -= (Q.blutmai ? 8 : 0);    // Blutmai permanently scars worker trust in state
    _t -= (Q.rb_banned  ? 12 : 0);
    _t -= (Q.rfb_banned ? 3  : 0); // RFB ban removes crossfire but also solidarity org
    _t = Math.max(0, Math.min(100, _t));
    Q.workers_grievance_security += ((_t - Q.workers_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    _t += _qol_spd_in_govt      * 15;
    _t += (Q.labor_rights    || 0) * 8;
    _t += (Q.works_councils  || 0) * 5;
    _t += (Q.economic_democracy || 0) * 6;
    _t += _qol_con_reform       * 4;
    _t -= _qol_right_in_govt    * 12;
    _t -= (Q.presidential_cabinet ? 8 : 0);
    _t -= (Q.emergency_rule   ? 10 : 0);
    _t -= (Q.rfb_banned && !Q.kpd_banned ? 6 : 0); // banning their orgs feels political
    _t = Math.max(0, Math.min(100, _t));
    Q.workers_grievance_political += ((_t - Q.workers_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    _t = 50;
    _t += _qol_edu              * 4;
    _t += _qol_womens           * 3;
    _t += (Q.commonwealth_cooperation || 0) * 5;
    _t += _qol_curriculum_d     * 5;
    _t -= _qol_curriculum_t     * 4;
    _t += _qol_youth_orgs       * 3;
    _t = Math.max(0, Math.min(100, _t));
    Q.workers_grievance_cultural += ((_t - Q.workers_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// UNEMPLOYED
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    _t += (Q.welfare        || 0) * 8;
    _t += (Q.works_program  || 0) * 10;   // works programs are their direct lifeline
    _t += (Q.wtb_implemented|| 0) * 8;
    _t += (Q.state_buyer    || 0) * 5;
    _t -= _qol_unemp_stress       * 3.5;  // they feel this most acutely
    _t -= _qol_growth_stress      * 2.5;
    _t -= _qol_defl_stress        * 1.5;  // deflation = no jobs being created
    _t -= (Q.dues_unemployedc > 0 ? (Q.dues_unemployedc * 6) : -8); // waived dues = relief
    _t = Math.max(0, Math.min(100, _t));
    Q.unemployedc_grievance_economic += ((_t - Q.unemployedc_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    _t = 50;
    _t -= _qol_sa_threat  * 20;   // SA recruits and terrorizes the unemployed simultaneously
    _t -= _qol_rfb_threat * 8;
    _t += _qol_rb_shield  * 10;
    _t += _qol_pol_loyal  * 8;
    _t -= (Q.blutmai ? 10 : 0);
    _t -= (Q.rb_banned  ? 14 : 0);
    _t = Math.max(0, Math.min(100, _t));
    Q.unemployedc_grievance_security += ((_t - Q.unemployedc_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    _t += _qol_left_in_govt     * 12;
    _t += (Q.labor_rights    || 0) * 5;
    _t += _qol_con_reform       * 3;
    _t -= _qol_right_in_govt    * 15;   // right govt = austerity = their destruction
    _t -= (Q.presidential_cabinet ? 12 : 0);
    _t -= (Q.emergency_rule   ? 12 : 0);
    _t -= (Q.austerity_cuts   ? 15 : 0); // emergency cuts devastate them
    _t = Math.max(0, Math.min(100, _t));
    Q.unemployedc_grievance_political += ((_t - Q.unemployedc_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    _t = 50;
    _t += _qol_edu              * 3;
    _t += _qol_youth_orgs       * 4;   // youth orgs matter more — they skew young
    _t += _qol_curriculum_d     * 4;
    _t -= _qol_curriculum_t     * 3;
    _t = Math.max(0, Math.min(100, _t));
    Q.unemployedc_grievance_cultural += ((_t - Q.unemployedc_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// OLD MIDDLE (Mittelstand — artisans, small shopkeepers, rentiers)
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    // Old middle was destroyed by 1923 — inflation is their deepest fear
    _t -= _qol_infl_stress        * 4.0;   // strongest inflation sensitivity of any class
    _t -= _qol_defl_stress        * 2.0;   // deflation kills their businesses too
    _t -= _qol_unemp_stress       * 1.5;   // less direct than workers
    _t += _qol_growth_bonus       * 2.0;
    _t -= _qol_growth_stress      * 2.5;
    _t += (Q.pro_consumer      || 0) * 5;  // pro-consumer policy helps shopkeepers
    _t -= (Q.dues_old_middle   || 0) * 5;
    _t += (Q.nationalization_progress > 0 ? -8 : 0); // nationalization threatens them
    _t = Math.max(0, Math.min(100, _t));
    Q.old_middle_grievance_economic += ((_t - Q.old_middle_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    _t = 50;
    _t -= _qol_sa_threat  * 8;    // SA is disruptive to their businesses
    _t -= _qol_rfb_threat * 10;   // RFB street fighting scares shopkeepers more
    _t += _qol_pol_loyal  * 12;
    _t -= (Q.general_strike_progress > 3 ? 10 : 0); // general strike = closed shops
    _t -= (Q.rb_banned  ? 5  : 0);
    _t -= (Q.emergency_rule ? -5 : 0); // emergency rule = order, they may prefer it
    _t = Math.max(0, Math.min(100, _t));
    Q.old_middle_grievance_security += ((_t - Q.old_middle_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    _t -= _qol_spd_in_govt      * 8;    // SPD = socialism = threat to property
    _t -= _qol_left_in_govt     * 10;
    _t += _qol_right_in_govt    * 6;
    _t += _qol_con_reform       * 3;
    _t += (Q.judicial_reform   || 0) * 5; // rule of law protects their contracts
    _t -= (Q.presidential_cabinet ? 3 : 0); // ambiguous — order but uncertainty
    _t -= (Q.emergency_rule   ? -4 : 0);   // they often prefer strong order
    _t = Math.max(0, Math.min(100, _t));
    Q.old_middle_grievance_political += ((_t - Q.old_middle_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    // Old middle is the most culturally conservative class
    _t = 50;
    _t += _qol_concordat        * 8;    // church-state relations matter deeply
    _t += _qol_curriculum_t     * 8;    // traditional curriculum = their values
    _t -= _qol_curriculum_d     * 6;
    _t -= _qol_secular          * 5;
    _t -= _qol_womens           * 3;    // women's rights challenge their worldview
    _t += (Q.judicial_reform   || 0) * 3;
    _t = Math.max(0, Math.min(100, _t));
    Q.old_middle_grievance_cultural += ((_t - Q.old_middle_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// NEW MIDDLE (White-collar workers, civil servants, professionals)
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    _t += _qol_growth_bonus       * 3.0;   // growth = promotions, security
    _t -= _qol_growth_stress      * 3.0;
    _t -= _qol_infl_stress        * 2.5;   // salaries don't keep up with inflation
    _t -= _qol_defl_stress        * 1.5;
    _t -= _qol_unemp_stress       * 1.5;
    _t += (Q.education_science || 0) * 5;  // education = their career prospects
    _t += (Q.science           || 0) * 4;
    _t -= (Q.dues_new_middle   || 0) * 4;
    _t += (Q.wtb_implemented   || 0) * 3;  // WTB stabilizes the economy they depend on
    _t = Math.max(0, Math.min(100, _t));
    Q.new_middle_grievance_economic += ((_t - Q.new_middle_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    _t = 50;
    _t -= _qol_sa_threat  * 10;
    _t -= _qol_rfb_threat * 10;   // equally threatened by both extremes
    _t += _qol_pol_loyal  * 14;   // care most about state order
    _t -= (Q.general_strike_progress > 3 ? 8 : 0);
    _t += (Q.emergency_rule ? 5 : 0); // new middle often prefers order over freedom
    _t -= (Q.rb_banned  ? 6  : 0);
    _t = Math.max(0, Math.min(100, _t));
    Q.new_middle_grievance_security += ((_t - Q.new_middle_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    // New middle wants competent, stable government more than ideology
    _t += _qol_con_reform       * 6;
    _t += (Q.bureaucratic_reform || 0) * 8;  // direct interest in civil service reform
    _t += (Q.judicial_reform    || 0) * 5;
    _t -= (Q.presidential_cabinet ? 4 : 0);
    _t -= _qol_left_in_govt     * 6;    // SPD threatens their civil service positions
    _t -= _qol_right_in_govt    * 4;    // DNVP purges them too
    _t += _qol_pres_rel         * 5;    // presidential legitimacy matters
    _t = Math.max(0, Math.min(100, _t));
    Q.new_middle_grievance_political += ((_t - Q.new_middle_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    // New middle is split — educated but often nationalist
    _t = 50;
    _t += _qol_edu              * 6;
    _t += _qol_sci              * 5;
    _t += _qol_womens           * 4;   // more open to women's rights than old middle
    _t += _qol_curriculum_d     * 4;
    _t -= _qol_curriculum_t     * 3;
    _t += _qol_youth_orgs       * 3;
    _t = Math.max(0, Math.min(100, _t));
    Q.new_middle_grievance_cultural += ((_t - Q.new_middle_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// RURAL
// ============================================================

{
    // --- Economic ---
    let _t = 50;
    _t += (Q.agricultural_policy  || 0) * 8;
    _t += (Q.agricultural_finance || 0) * 7;
    _t += (Q.land_reform          || 0) * 6;   // land reform helps poor farmers
    _t += (Q.state_buyer          || 0) * 6;   // state grain purchases = price floor
    _t -= _qol_defl_stress              * 3.5; // deflation crushes farm prices hardest
    _t -= _qol_infl_stress              * 1.5; // input cost inflation hurts
    _t -= _qol_unemp_stress             * 1.0;
    _t += _qol_growth_bonus             * 1.5;
    _t -= (Q.tariffs < 0 ? Math.abs(Q.tariffs) * 5 : 0); // low tariffs = foreign competition
    _t -= (Q.dues_rural           || 0) * 4;
    _t = Math.max(0, Math.min(100, _t));
    Q.rural_grievance_economic += ((_t - Q.rural_grievance_economic) * Q.grievance_decay.economic);

    // --- Security ---
    // Rural areas experience less direct street violence but fear disorder
    _t = 50;
    _t -= _qol_sa_threat  * 6;
    _t -= _qol_rfb_threat * 6;
    _t += _qol_pol_loyal  * 8;
    _t -= (Q.emergency_rule ? -6 : 0); // rural often welcomes strong order
    _t -= (Q.general_strike_progress > 5 ? 8 : 0); // strikes cut off supply chains
    _t = Math.max(0, Math.min(100, _t));
    Q.rural_grievance_security += ((_t - Q.rural_grievance_security) * Q.grievance_decay.security);

    // --- Political ---
    _t = 50;
    _t += (Q.agricultural_policy  || 0) * 6;  // direct representation of rural interests
    _t += (Q.land_reform          || 0) * 5;
    _t -= _qol_spd_in_govt              * 5;   // SPD is an urban party
    _t -= _qol_left_in_govt             * 8;
    _t += _qol_right_in_govt            * 4;   // DNVP claims to represent agrarian interests
    _t += (Q.cnbl_in_government ? 8 : 0);      // explicit rural party in govt
    _t += (Q.bb_in_government   ? 6 : 0);
    _t -= (Q.presidential_cabinet ? 2 : 0);
    _t = Math.max(0, Math.min(100, _t));
    Q.rural_grievance_political += ((_t - Q.rural_grievance_political) * Q.grievance_decay.political);

    // --- Cultural ---
    // Rural is the most church-dependent and tradition-bound class
    _t = 50;
    _t += _qol_concordat        * 6;
    _t += _qol_curriculum_t     * 10;
    _t -= _qol_curriculum_d     * 8;
    _t -= _qol_secular          * 8;
    _t -= _qol_womens           * 4;
    _t += (Q.catholics > 35 ? 4 : 0);
    _t += _qol_youth_orgs       * 2;
    _t = Math.max(0, Math.min(100, _t));
    Q.rural_grievance_cultural += ((_t - Q.rural_grievance_cultural) * Q.grievance_decay.cultural);
}


// ============================================================
// SECTION 2B — COMPOSITE QOL CALCULATION
// Weighted sum of 4 dimensions per class → Q.[class]_qol (0–150)
// ============================================================

const _CLASSES_QOL_TICK    = ['workers', 'unemployedc', 'old_middle', 'new_middle', 'rural'];
const _DIMENSIONS_QOL_TICK = ['economic', 'security', 'political', 'cultural'];

for (const _c of _CLASSES_QOL_TICK) {
    const _w  = Q.grievance_weights[_c];
    let _composite = 0;

    for (const _d of _DIMENSIONS_QOL_TICK) {
        // grievance dimension is 0-100, 50=neutral
        // remap to -50/+50 relative to neutral, then weight
        _composite += (_w[_d] * Q[_c + '_grievance_' + _d]);
    }
    // _composite is now 0-100 (50 = perfectly neutral across all dimensions)
    // Remap to 0-150 scale where 100 = 1928 baseline
    // Formula: 100 + (_composite - 50) * 1.0
    // So 50 composite → QOL 100, 100 composite → QOL 150, 0 composite → QOL 50

    Q[_c + '_qol_last'] = Q[_c + '_qol'];
    Q[_c + '_qol']      = Math.max(50, Math.min(150,
        100 + (_composite - 50)
    ));
    Q[_c + '_qol_vel']  = Q[_c + '_qol'] - Q[_c + '_qol_last'];
}

// Convenience aliases for display
Q.workers_qol_display    = Q.workers_qol.toFixed(1);
Q.unemployed_qol_display = Q.unemployedc_qol.toFixed(1);
Q.old_middle_qol_display = Q.old_middle_qol.toFixed(1);
Q.new_middle_qol_display = Q.new_middle_qol.toFixed(1);
Q.rural_qol_display      = Q.rural_qol.toFixed(1);

// Overall population QOL (class-size weighted)
Q.population_qol = (
    (Q.workers    / 100) * Q.workers_qol    +
    (Q.unemployedc/ 100) * Q.unemployedc_qol+
    (Q.old_middle / 100) * Q.old_middle_qol +
    (Q.new_middle / 100) * Q.new_middle_qol +
    (Q.rural      / 100) * Q.rural_qol
);
Q.population_qol = Math.round(Q.population_qol * 10) / 10;


// ============================================================
// SECTION 3D — MATH BROKEN COMPATIBILITY
// If Q.math_broken is active, QOL becomes chaotic.
// ============================================================

if (Q.math_broken) {
    for (const _c of ['workers', 'unemployedc', 'old_middle', 'new_middle', 'rural']) {
        Q[_c + '_qol'] = Q.impossible_percentage(Q[_c + '_qol']);
        for (const _d of ['economic', 'security', 'political', 'cultural']) {
            Q[_c + '_grievance_' + _d] = Q.impossible_add(Q[_c + '_grievance_' + _d], 0);
        }
    }
    Q.population_qol = Q.impossible_percentage(Q.population_qol);
    console.log('QOL CHAOS: population_qol=' + Q.population_qol);
}


// ============================================================
// SECTION 3C — QOL DISPLAY STRING
// ============================================================

{
    const _QOL_CLASSES = [
        ['workers',    'Workers'],
        ['unemployedc','Unemployed'],
        ['old_middle', 'Old Middle'],
        ['new_middle', 'New Middle'],
        ['rural',      'Rural'],
    ];
    const _QOL_DIMS = ['economic', 'security', 'political', 'cultural'];

    function _qol_bar(val) {
        // val is 0-100 grievance dimension. 50=neutral.
        // Returns a simple text indicator.
        if (val >= 75) return '+++';
        if (val >= 60) return '++ ';
        if (val >= 50) return '+  ';
        if (val >= 40) return '-  ';
        if (val >= 25) return '-- ';
        return                     '---';
    }

    let _report = '';
    for (const [_ck, _label] of _QOL_CLASSES) {
        const _qol = Q[_ck + '_qol'] || 100;
        const _vel = Q[_ck + '_qol_vel'] || 0;
        const _trend = _vel > 0.3 ? '↑' : _vel < -0.3 ? '↓' : '→';
        _report += `**${_label}** QOL: ${_qol.toFixed(0)} ${_trend}\n`;
        for (const _d of _QOL_DIMS) {
            const _dval = Q[_ck + '_grievance_' + _d] || 50;
            _report += `  ${_d}: ${_qol_bar(_dval)} (${_dval.toFixed(0)})\n`;
        }
        _report += '\n';
    }
    _report += `**Population QOL:** ${(Q.population_qol || 100).toFixed(1)}\n`;
    Q.qol_report = _report;
}


// ============================================================
// IDENTITY POPULATION DRIFT
// These are overlapping shares, not a normalized pool.
// ============================================================

// --- SECULARS ---
// Grows slowly with education and science policy
// Shrinks if traditional curriculum dominates
Q.secular_growth = 0;
if (Q.education_science >= 2)   Q.secular_growth += 0.08;
if (Q.education_science >= 4)   Q.secular_growth += 0.06;
if (Q.secularized >= 1)         Q.secular_growth += 0.10;
if (Q.major_curriculum === 'traditional') Q.secular_growth -= 0.10;
if (Q.minor_curriculum === 'traditional') Q.secular_growth -= 0.05;
// Baseline slow drift upward — modernization is a tide
Q.secular_growth += 0.02;
Q.seculars = Math.max(3, Math.min(40, Q.seculars + Q.secular_growth));

// --- CATHOLICS ---
// Mostly stable — shifts only from major events
// Slow natural decline as seculars grow, mostly from Protestant pool
Q.catholics = Math.max(20, Math.min(40, Q.catholics - Q.secular_growth * 0.3));

// --- PROTESTANTS ---
// Derived residual — takes the bulk of secular drift loss
Q.protestants = Math.max(30, Math.min(75, 100 - Q.catholics - Q.seculars));

// --- YOUTH ---
// 18-30 cohort radicalization level, not raw population share
// Rises with economic crisis, street violence, unemployment
// Falls with stability, successful youth policy
Q.youth_crisis_pressure = 0;
Q.youth_crisis_pressure += Math.max(0, Q.unemployed - 8) * 0.15;
Q.youth_crisis_pressure += Math.max(0, -Q.economic_growth) * 0.10;
Q.youth_crisis_pressure += ((Q.sa_strength * Q.sa_militancy) + 
                            (Q.rfb_strength * Q.rfb_militancy)) / 8000;
// Normalization pressure — always pulls back toward baseline over time
Q.youth_normalization = (Q.youth - 18) * 0.05;
// Policy counters
Q.youth_policy_effect = 0;
if (Q.youth_organizations >= 1) Q.youth_policy_effect -= 0.15 * Q.youth_organizations;
if (Q.education_science >= 2)   Q.youth_policy_effect -= 0.08;
if (Q.womens_rights >= 2)       Q.youth_policy_effect -= 0.04;

Q.youth = Math.max(10, Math.min(55, 
    Q.youth + Q.youth_crisis_pressure - Q.youth_normalization + Q.youth_policy_effect
));


// ============================================================
// IDENTITY MODIFIERS
// Applied to ideology_caps.base as multipliers.
// Each variable is a population share 0-100.
// Normalized to 0-1 for multiplication.
// ============================================================

var cath_share  = Q.catholics  / 100;
var prot_share  = Q.protestants / 100;
var sec_share   = Q.seculars   / 100;
var youth_share = Q.youth      / 100;


// === PARTY DRIFT OVERHAUL: IDENTITY MODIFIERS ===
// Wrapped in a function so it can be re-invoked with isolated
// share inputs later (for the per-identity display breakdown),
// without duplicating any of the formulas by hand.
function buildIdentityModifier(cs, ps, ss, ys) {
    return {
        spd:   1 + (ss * 0.30) - (cs * 0.20 * (Q.prussian_concordat >= 1 ? 1.04 : 1)),
        srpd:  1 + (ss * 0.25) - (cs * 0.15),
        kpd:   1 + (ys * 0.55) - (cs * 0.30),
        sapd:  1 + (ys * 0.45) - (cs * 0.25),
        wp:    1 + (ps * 0.20),
        csrp:  1 + (ss * 0.20) - (cs * 0.10),
        rdp:   1 + (ss * 0.30),
        lb:    1 + (ys * 0.35) - (cs * 0.15),
        faud:  1 + (ys * 0.65) - (cs * 0.35),
        kapd:  1 + (ys * 0.65) - (cs * 0.35),
        uspd:  1 + (ss * 0.35) - (cs * 0.20),
        hl:    1 + (ys * 0.30),
        sl:    1 + (ys * 0.35),
        kpo:   1 + (ys * 0.40) - (cs * 0.20),

        nsdap: 1 + (ys * 0.65) - (cs * 0.40),
        dvfp:  1 + (ys * 0.50) - (cs * 0.10),
        dnf:   1 + (ps * 0.55),
        gsrn:  1 + (ys * 0.75),
        aspd:  1 + (ys * 0.60),

        dnvp:  1 + (ps * 0.65) - (cs * 0.15),
        dbp:   1 + (ps * 0.65) - (cs * 0.15),
        rlb:   1 + (ps * 0.65) - (cs * 0.15),
        vnr:   1 + (ps * 0.60) - (cs * 0.15),
        cnbl:  1 + (ps * 0.25),
        csvd:  1 + (ps * 0.30) - (cs * 0.10),
        bb:    1 + (ps * 0.20),
        dhp:   1 + (ps * 0.20),
        kvp:   1 + (ps * 0.20),
        dtsp:  1 + (ps * 0.50) - (cs * 0.45),

        z:     (Q.z_ideology === "Christian Conservatism")
                   ? 1 + (cs * 1.60 * (Q.prussian_concordat >= 1 ? 1.15 : 1) * (Q.z_transition_cvp === 1 ? (1/3) : 0.5))
                       + (ys * (Q.z_transition_cvp === 2 ? 0.25 : 0))
               : (Q.z_ideology === "Catholic Laborism")
                   ? 1 + (cs * 1.60 * (Q.prussian_concordat >= 1 ? 1.15 : 1) * 1.10) - (ss * 0.30)
               : 1 + (cs * 1.60 * (Q.prussian_concordat >= 1 ? 1.15 : 1)) - (ss * 0.30),
        bvp:   1 + (cs * 1.45) - (ss * 0.30),
        cvp:   1 + (cs * 0.70) - (ss * 0.35),
        pp:    1 + (cs * 0.75) - (ps * 0.50),

        dvp:   1 + (ss * 0.20),
        ddp:   1 + (ss * 0.35),
        dsbp:  1 + (ss * 0.55) - (cs * 0.25),
        vrp:   1 + (ss * 0.15),
        sls:   1 + (ss * 0.15),

        other: 1,
    };
}

Q.identity_modifier = buildIdentityModifier(cath_share, prot_share, sec_share, youth_share);

// === EVENT-DRIVEN IDENTITY MODIFIERS ===
// NOTE: one-off event modifiers (e.g. Prussian Concordat -> z/spd) now live
// inline as ternary terms directly on the affected lines in
// buildIdentityModifier above, matching the Q.peoples_party inline pattern
// used throughout computeTarget's class_mods. This stub is kept only so
// the existing `* (eim.party || 1.0)` reads scattered through computeTarget
// keep working (they resolve to a harmless 1.0 no-op) without having to
// touch every call site.
Q.event_identity_modifier = {};
for (const party of Q.parties) {
    Q.event_identity_modifier[party] = 1.0;
}

// === CLASS×IDENTITY CROSS-TAB SUPPORT ===
// Per-identity affinity table, isolated at full strength (share=1.0) for
// each identity in turn. This becomes the identity_mods[party][idn] lookup
// used by the class×identity cell drift loop below. Built from
// buildIdentityModifier so it can never drift out of sync with the
// existing per-party identity coefficients — one source of truth.
Q.identity_mods = {};
{
    const _iso = {
        catholics:   buildIdentityModifier(1, 0, 0, 0),
        protestants: buildIdentityModifier(0, 1, 0, 0),
        seculars:    buildIdentityModifier(0, 0, 1, 0),
        youth:       buildIdentityModifier(0, 0, 0, 1),
    };
    for (var _party of Q.parties) {
        Q.identity_mods[_party] = {
            catholics:   (_iso.catholics[_party]   !== undefined) ? _iso.catholics[_party]   : 1.0,
            protestants: (_iso.protestants[_party] !== undefined) ? _iso.protestants[_party] : 1.0,
            seculars:    (_iso.seculars[_party]    !== undefined) ? _iso.seculars[_party]    : 1.0,
            youth:       (_iso.youth[_party]       !== undefined) ? _iso.youth[_party]       : 1.0,
        };
    }
}


// === PARTY DRIFT OVERHAUL ===
// Architecture: thermostat model
// Each tick: target = f(conditions), support moves toward target at speed s
// No caps, no soft cap function, no delta accumulation
// Target IS the ceiling/floor — self-correcting by design

// ─────────────────────────────────────────
// SHARED FACTORS (unchanged from original)
// ─────────────────────────────────────────

Q.unemployment_threshold = 7.5;
Q.inflation_threshold    = 3.0;

Q.unemployment_excess = Math.max(0, Q.unemployed - Q.unemployment_threshold);

if (Q.inflation >= 0) {
    Q.inflation_excess = Math.max(0, Q.inflation - Q.inflation_threshold);
} else {
    Q.inflation_excess = Math.abs(Q.inflation) * 1.5;
}

Q.unrest_factor = Q.random_factor(
    0.3 +
    Math.pow(Q.unemployment_excess / 8,  2.2) +
    Math.pow(Q.inflation_excess   / 6,  1.8),
    0.35
);
Q.unrest_factor = Math.min(Q.unrest_factor, 12.0);

if (Q.inflation >= 0) {
    Q.inflation_component = Q.inflation / 5;
} else {
    Q.inflation_component = Math.abs(Q.inflation) / 3;
}

Q.pro_republic_factor = Q.random_factor(
    Math.min(Math.max(Q.pro_republic / 33, 0.5), 1.5), 0.15
);
Q.nationalism_factor = Q.random_factor(
    Math.min(Math.max(Q.nationalism / 33, 0.5), 1.5), 0.20
);
Q.socialism_factor = Q.random_factor(
    Math.min(Math.max(Q.socialism / 33, 0.5), 1.5), 0.20
);
Q.street_pressure_factor = Q.random_factor(
    Math.min(Math.max(
        (Q.sa_strength * Q.sa_militancy + Q.rfb_strength * Q.rfb_militancy + Q.sh_strength * Q.sh_militancy) / 3500,
        0.7), 1.8),
    0.25
);

Q.sa_influence  = Q.nsdap_banned ? 0 : Q.random_factor((Q.sa_strength/100  + Q.sa_militancy)  * 0.25, 0.3);
Q.sh_influence  = (Q.dnvp_banned || Q.sh_banned) ? 0 : Q.random_factor((Q.sh_strength/100  + Q.sh_militancy)  * 0.2,  0.25);
Q.rfb_influence = Q.kpd_banned  ? 0 : Q.random_factor((Q.rfb_strength/100 + Q.rfb_militancy) * 0.2,  0.25);
Q.rb_influence  = Q.random_factor((Q.rb_strength/100 + Q.rb_militancy) * 0.15, 0.25);

// Class amplifiers — survive unchanged
Q.class_influences = {
    workers:     1.3 + Q.rfb_influence,
    old_middle:  1.0 + Q.sh_influence,
    new_middle:  1.0 + Q.sh_influence,
    rural:       1.0 + Q.sh_influence,
    unemployedc: 1.3 + Q.sa_influence,
};

// ─────────────────────────────────────────
// CENTRALIZED CAMPAIGNING SYSTEM
// Per-party campaign meters: Q.campaign_intensity_<party> (0..1-ish,
// decays each tick) and Q.campaign_focus_<party> (which class/demo
// that party is currently campaigning toward). Any party can run a
// campaign independently — this replaces the old single global
// Q.campaign_intensity / Q.campaign_focus pair that only SPD read.
//
// Magnitude scales off that party's own base_speeds entry (see
// computeSpeed) — fast/crisis-reactive parties campaign harder,
// slow/structural parties get a smaller campaign swing — rather than
// every party getting SPD's flat baseline.
// ─────────────────────────────────────────

const _CAMPAIGN_BASE_SPEEDS = {
    kapd: 0.25, nsdap: 0.18, dnf: 0.175, kpd: 0.17, sapd: 0.14, dvfp: 0.13,
    spd: 0.11, dnvp: 0.12, srpd: 0.10, csvd: 0.09, dvp: 0.09, ddp: 0.09, dsbp: 0.10,
    z: 0.06, bvp: 0.06, cnbl: 0.07, wp: 0.07, kvp: 0.08, rlb: 0.075,
    dbp: 0.08, bb: 0.05, dhp: 0.05, sls: 0.04, csrp: 0.05, vrp: 0.06, dtsp: 0.10,
    rdp: 0.06, cvp: 0.06, lb: 0.07, aspd: 0.06, hl: 0.06, sl: 0.08, kpo: 0.08,
    vnr: 0.07, other: 0.08, faud: 0.02, gsrn: 0.02, uspd: 0.07, pp: 0.04
};
const _CAMPAIGN_DEFAULT_SPEED = 0.07;
// SPD is the reference/baseline party for campaign scaling — its own
// scale factor is defined to be exactly 1.0.
const _CAMPAIGN_SPD_BASE = _CAMPAIGN_BASE_SPEEDS.spd;

function _campaignScale(party) {
    const s = _CAMPAIGN_BASE_SPEEDS[party] || _CAMPAIGN_DEFAULT_SPEED;
    return s / _CAMPAIGN_SPD_BASE;
}

// Decay every party's campaign intensity once per tick.
for (const _cp of Q.parties) {
    const key = 'campaign_intensity_' + _cp;
    if (Q[key] > 0) Q[key] -= 0.08;
    Q[key] = Math.max(0, Q[key] || 0);
}

// Map a campaign_focus value to the class key it targets, plus which
// classes get the smaller "spread" bonus (women/middle-style focuses
// that aren't a single class).
const _CAMPAIGN_FOCUS_CLASS_MAP = {
    workers:    'workers',
    unemployed: 'unemployedc',
    new_middle: 'new_middle',
    old_middle: 'old_middle',
    rural:      'rural',
};
const _CAMPAIGN_SPREAD_FOCI = ['women', 'middle'];

// _campaignMult(party, c) — multiplier applied to computeTarget's base
// for this party/class, driven by that party's own focus + intensity.
function _campaignMult(party, c) {
    const ci_p    = Q['campaign_intensity_' + party] || 0;
    const focus_p = Q['campaign_focus_' + party];
    if (ci_p <= 0 || !focus_p) return 1.0;

    const scale = _campaignScale(party);
    let boost = 1.0;

    if (_CAMPAIGN_FOCUS_CLASS_MAP[focus_p] === c) {
        boost += ci_p * 0.30 * scale;
    } else if (_CAMPAIGN_SPREAD_FOCI.includes(focus_p)) {
        boost += ci_p * 0.10 * scale; // smaller, spread across all classes
    }
    return boost;
}

// _campaignSpeedBonus(party, c) — additive bonus to computeSpeed's
// speed for this party/class.
function _campaignSpeedBonus(party, c) {
    const ci_p    = Q['campaign_intensity_' + party] || 0;
    const focus_p = Q['campaign_focus_' + party];
    if (ci_p <= 0 || !focus_p) return 0;

    const scale = _campaignScale(party);

    if (_CAMPAIGN_FOCUS_CLASS_MAP[focus_p] === c) {
        return ci_p * 0.04 * scale;
    }
    if (_CAMPAIGN_SPREAD_FOCI.includes(focus_p)) {
        return ci_p * 0.02 * scale;
    }
    return 0;
}


// ─────────────────────────────────────────
// BANNED REDISTRIBUTION MAP (unchanged)
// ─────────────────────────────────────────

const BANNED_REDISTRIBUTION = {
    nsdap: [
        ['dnvp',  0.50, () => !Q.dnvp_banned],
        ['dvp',   0.25, () => Q.dvp_right_shift && !Q.dvp_banned],
        ['other', 0.25, () => true]
    ],
    dnvp: [
        ['nsdap', 0.60, () => !Q.nsdap_banned && Q.dnvp_line === 3],
        ['nsdap', 0.30, () => !Q.nsdap_banned && Q.dnvp_line !== 3],
        ['dvp',   0.20, () => !Q.dvp_banned],
        ['other', 0.20, () => true]
    ],
    dvp: [
        ['dnvp',  0.35, () => !Q.dnvp_banned],
        ['nsdap', 0.25, () => !Q.nsdap_banned && Q.dvp_right_shift],
        ['wp',    0.20, () => !Q.wp_banned && !Q.dvp_right_shift],
        ['other', 0.20, () => true]
    ],
    wp: [
        ['spd',   0.30, () => !Q.spd_banned],
        ['ddp',   0.25, () => !Q.ddp_banned],
        ['srpd',  0.20, () => !Q.srpd_banned],
        ['other', 0.25, () => true]
    ],
    cnbl: [
        ['z',     0.35, () => !Q.z_banned],
        ['bvp',   0.20, () => !Q.bvp_banned],
        ['dnvp',  0.20, () => !Q.dnvp_banned],
        ['other', 0.25, () => true]
    ],
    kpd: [
        ['sapd',  0.40, () => Q.sapd_formed && !Q.sapd_banned],
        ['spd',   0.35, () => !Q.spd_banned && (Q.ideology === 'left' || Q.ideology === 'neorev')],
        ['spd',   0.20, () => !Q.spd_banned && Q.ideology !== 'left' && Q.ideology !== 'neorev'],
        ['other', 0.25, () => true]
    ],
    sapd: [
        ['kpd',   0.40, () => !Q.kpd_banned],
        ['spd',   0.30, () => !Q.spd_banned],
        ['srpd',  0.15, () => !Q.srpd_banned],
        ['other', 0.15, () => true]
    ],
    csvd: [
        ['dnvp',  0.30, () => !Q.dnvp_banned],
        ['nsdap', 0.25, () => !Q.nsdap_banned],
        ['other', 0.45, () => true]
    ],
    srpd: [
        ['spd',   0.45, () => !Q.spd_banned],
        ['sapd',  0.25, () => Q.sapd_formed && !Q.sapd_banned],
        ['kpd',   0.15, () => !Q.kpd_banned],
        ['other', 0.15, () => true]
    ],
    spd: [
        ['srpd',  0.35, () => !Q.srpd_banned],
        ['sapd',  0.25, () => Q.sapd_formed && !Q.sapd_banned],
        ['ddp',   0.20, () => !Q.ddp_banned],
        ['other', 0.20, () => true]
    ],
    ddp: [
        ['spd',   0.30, () => !Q.spd_banned],
        ['wp',    0.25, () => !Q.wp_banned],
        ['z',     0.20, () => !Q.z_banned],
        ['other', 0.25, () => true]
    ],
    z: [
        ['bvp',   0.40, () => !Q.bvp_banned],
        ['cnbl',  0.25, () => !Q.cnbl_banned],
        ['ddp',   0.15, () => !Q.ddp_banned],
        ['other', 0.20, () => true]
    ],
    bvp: [
        ['z',     0.45, () => !Q.z_banned],
        ['cnbl',  0.25, () => !Q.cnbl_banned],
        ['other', 0.30, () => true]
    ],
    other: [
        ['dnvp',  0.20, () => !Q.dnvp_banned],
        ['spd',   0.20, () => !Q.spd_banned],
        ['z',     0.20, () => !Q.z_banned],
        ['other', 0.40, () => true]
    ],
    kvp: [
        ['dnvp',  0.45, () => !Q.dnvp_banned],
        ['csvd',  0.30, () => !Q.csvd_banned],
        ['other', 0.25, () => true]
    ],
    dhp: [
        ['cnbl',  0.40, () => !Q.cnbl_banned],
        ['dnvp',  0.30, () => !Q.dnvp_banned],
        ['other', 0.30, () => true]
    ],
    bb: [
        ['cnbl',  0.35, () => !Q.cnbl_banned],
        ['bvp',   0.30, () => !Q.bvp_banned],
        ['nsdap', 0.20, () => !Q.nsdap_banned],
        ['other', 0.15, () => true]
    ]
};

// ─────────────────────────────────────────
// SECTION 3A — QOL HELPER
// ─────────────────────────────────────────

// _applyQOL — applies the asymmetric QOL multiplier to a computed base.
//
// For crisis parties: bad QOL amplifies appeal (2.0 - qol_ratio)
//   qol=50  (ratio 0.50) → ×1.50  strong amplification
//   qol=100 (ratio 1.00) → ×1.00  neutral
//   qol=150 (ratio 1.50) → ×0.50  suppressed even at baseline
//
// For moderate parties: good QOL gives gentle boost (0.85 + ratio*0.15)
//   qol=50  (ratio 0.50) → ×0.925  mild suppression
//   qol=100 (ratio 1.00) → ×1.000  neutral
//   qol=150 (ratio 1.50) → ×1.075  mild bonus
//
// The asymmetry is intentional:
//   crisis party penalty from high QOL (×0.50) >> moderate party bonus from high QOL (×1.075)
//   This means QOL erosion is always more dangerous than QOL improvement is helpful.
//
// NOTE: this still relies on a per-class "which parties count as
// crisis parties" table, but that table is scoped locally to this
// function only (see _QOL_CRISIS_PARTIES below) — it is a QOL-system
// concept, distinct from the computeSpeed crisis/stable speed-tier
// system that was removed.

const _QOL_CRISIS_PARTIES = {
    workers:     ['kpd', 'sapd', 'nsdap'],
    unemployedc: ['kpd', 'sapd', 'nsdap'],
    old_middle:  ['nsdap', 'dvfp', 'dnvp'],
    new_middle:  ['nsdap', 'dvfp', 'dnvp'],
    rural:       ['nsdap', 'cnbl', 'dnvp'],
};

function _applyQOL(base, party, c) {
    const _qol    = Q[c + '_qol'] || 100;
    const _ratio  = _qol / 100;                     // 0.5 to 1.5
    const _crisis = (_QOL_CRISIS_PARTIES[c] || []).includes(party);

    if (_crisis) {
        // Amplify crisis party appeal when QOL is bad
        return base * (2.0 - _ratio);
    } else {
        // Gently modulate moderate party appeal with QOL
        return base * (0.85 + _ratio * 0.15);
    }
}


// ─────────────────────────────────────────
// TARGET COMPUTATION
// Returns: the support level conditions currently warrant for this party/class
// This replaces ideology_caps.base × class_multiplier
// ─────────────────────────────────────────

// ─────────────────────────────────────────
// SANDBOX ADJUSTMENT HELPERS
// Q.<party>_adjustment                -> multiplies party base (all classes)
// Q.<class>_<party>_adjustment        -> multiplies that class's mod for the party
// Both default to 1.0 (no-op) if unset. Safe against NaN/undefined/non-numeric.
// ─────────────────────────────────────────

function _partyAdj(party) {
    const v = Q[`${party}_adjustment`];
    return (typeof v === 'number' && !isNaN(v)) ? v : 1.0;
}

function _classAdj(party, c) {
    const v = Q[`${c}_${party}_adjustment`];
    return (typeof v === 'number' && !isNaN(v)) ? v : 1.0;
}


Q.PARTY_BEHAVIORS = {
    revleft: {
        label:      'Revolutionary Left',
        unrestMode: 'climb',
        govGood: 0.65, govBad: 1.70,
        oppGood: 1.00, oppBad: 1.15,
    },


    revright: {
        label:      'Revolutionary Right',
        unrestMode: 'climb',
        govGood: 0.65, govBad: 1.70,
        oppGood: 1.00, oppBad: 1.15,
    },

    refleft: {
        label:      'Reformist Left',
        unrestMode: 'linear',
        govGood: 1.25, govBad: 0.65,
        oppGood: 1.00, oppBad: 1.08,
    },

    refright: {
        label:      'Reformist Right',
        unrestMode: 'linear',
        govGood: 1.25, govBad: 0.65,
        oppGood: 1.00, oppBad: 1.08,
    },

    center: {
        label:      'Establishment Center',
        unrestMode: 'linear',
        govGood: 1.35, govBad: 0.55,
        oppGood: 1.00, oppBad: 1.00,
    },
};

// Q.party_behavior — the actual party -> behavior-key assignment.
// Centralized here; edit this map (or set Q.party_behavior[x] mid-game
// via an event) to reassign any party's behavior. Parties not listed
// fall back to 'center' (see _behaviorFor below), so new/splinter
// parties added later degrade gracefully instead of erroring.
Q.party_behavior = Object.assign(Q.party_behavior || {}, {
    // Revolutionary Left
    kpd: 'revleft',
    kpo: 'revleft',
    kapd: 'revleft',
    faud: 'revleft',
    uspd: 'revleft',
    sapd: 'revleft',
    sl: 'revleft',
    gsrn: 'revleft',
    lb: 'revleft',

    // Reformist Left
    spd: 'refleft',
    srpd: 'refleft',
    csrp: 'refleft',
    rdp: 'refleft',

    // Center
    z: 'center',
    ddp: 'center',
    dsbp: 'center',
    bb: 'center',
    dbp: 'center',
    cvp: 'center',
    sls: 'center',
    pp: 'center',

    // Reformist Right
    dvp: 'refright',
    wp: 'refright',
    cnbl: 'refright',
    bvp: 'refright',
    csvd: 'refright',
    kvp: 'refright',
    dhp: 'refright',
    aspd: 'refright',
    vnr: 'refright',
    hl: 'refright',
    vrp: 'refright',

    // Revolutionary Right
    nsdap: 'revright',
    dnvp: 'revright',
    dnf: 'revright',
    dvfp: 'revright',
    dtsp: 'revright',
    rlb: 'revright'
});


// Human-readable label per party, stored on Q so it's inspectable/
// displayable without reaching into Q.PARTY_BEHAVIORS at call sites.
// Recomputed every tick so it always tracks the current assignment —
// including live reassignment mid-game.
for (const _bp of Object.keys(Q.party_behavior)) {
    const _bKey = Q.party_behavior[_bp];
    const _bDef = Q.PARTY_BEHAVIORS[_bKey];
    Q[_bp + '_behavior_name'] = _bDef ? _bDef.label : 'Establishment Center';
}

function _behaviorFor(party) {
    const key = Q.party_behavior[party] || 'center';
    return Q.PARTY_BEHAVIORS[key] || Q.PARTY_BEHAVIORS.center;
}

// ─────────────────────────────────────────────────────────────────────
// GOV / OPPOSITION ECONOMY MULTIPLIER
// Separate channel — reads Q.econ_signal directly, does not touch or
// compound with the bloc-level influence/honeymoon/fatigue system in
// OPINION DYNAMICS v2. Applied once per party inside computeTarget.
// ─────────────────────────────────────────────────────────────────────

function _govEconMult(party) {
    const beh = _behaviorFor(party);
    const s = (typeof Q.econ_signal === 'number') ? Q.econ_signal : 0; // -1..+1
    const inGov = Q[party + '_in_government'] === 1;

    if (inGov) {
        return s >= 0
            ? 1 + (beh.govGood - 1) * s
            : 1 + (beh.govBad  - 1) * -s;
    } else {
        return s >= 0
            ? 1 + (beh.oppGood - 1) * s
            : 1 + (beh.oppBad  - 1) * -s;
    }
}

// ─────────────────────────────────────────────────────────────────────
// REVOLUTIONARY UNREST POINTS ('climb' unrestMode)
// Replaces the fast/reactive unrest_soc_hybrid / unrest_nat_hybrid term
// for parties tagged revleft/revright. A persistent stock, not a spot
// reading: it climbs while the economy is bad, with the increment
// itself growing the worse conditions get (a point is added on top,
// plus a bonus scaled by how bad things are), and bleeds off slowly
// when conditions improve. This makes revolutionary rise gradual and
// sticky rather than tracking the economy tick-to-tick.
// ─────────────────────────────────────────────────────────────────────

Q.revolutionary_unrest_points = Q.revolutionary_unrest_points || {};

// computeTarget is called once per (party, class) pair — up to 5x per
// party per tick in the MAIN DRIFT LOOP below. The stock must only
// advance ONCE per tick regardless, so each party's climb is gated on
// Q.tick via a per-party "last advanced" marker.
Q._revolutionary_unrest_last_tick = Q._revolutionary_unrest_last_tick || {};

function _tickRevolutionaryUnrest(party) {
    const cur = Q.revolutionary_unrest_points[party] || 0;

    // Already advanced this party's stock this tick (e.g. called again
    // for a different class) — just return the current value untouched.
    if (Q._revolutionary_unrest_last_tick[party] === Q.tick) {
        return cur;
    }
    Q._revolutionary_unrest_last_tick[party] = Q.tick;

    const neg = (typeof Q.econ_negative === 'number') ? Q.econ_negative : 0; // 0..1

    if (neg > 0) {
        // Base point for any bad-economy tick, PLUS a bonus that grows
        // superlinearly with how bad it is — the worse the economy, the
        // bigger the increment on top of the flat point.
        const basePoint = 0.15;
        const badnessBonus = Math.pow(neg, 1.6) * 0.9;
        Q.revolutionary_unrest_points[party] = Math.min(20, cur + basePoint + badnessBonus);
    } else {
        // Good economy: slow bleed-off, never a hard reset — reflects
        // that revolutionary sentiment built up over a crisis doesn't
        // vanish the moment growth turns positive.
        Q.revolutionary_unrest_points[party] = Math.max(0, cur - 0.05);
    }

    return Q.revolutionary_unrest_points[party];
}


//   unrest_nat_hybrid — for NATIONALIST-EXTREMIST parties (nsdap, dvfp, dnf).
//     Crisis alone gives only a mild lift; crisis is a real amplifier
//     only when nationalism is already elevated. This is the
//     "their unrest buff only works if nationalism/socialism is also
//     strong, otherwise it's cut" behavior — extremists don't spike
//     off a stable economy, they spike off unrest THAT IS ALREADY
//     being read as nationalist or socialist anger.
//
//   unrest_soc_hybrid — for SOCIALIST-EXTREMIST parties (kpd, sapd).
//     Same shape, gated by socialism instead of nationalism.
// ─────────────────────────────────────────

function computeTarget(party, c) {
    const nat  = Q.nationalism_factor;
    const rep  = Q.pro_republic_factor;
    const soc  = Q.socialism_factor;
    const unr  = Q.unrest_factor;
    const im   = Q.identity_modifier;
    const eim  = Q.event_identity_modifier;

    // nat/soc factors are centered near 1.0 (0.5–1.5 band). Above-baseline
    // share (elevated) is what should unlock the crisis amplifier; below
    // baseline should actively suppress it, not just fail to boost it.
    const nat_elevated = Math.max(0, nat - 1.0);   // 0 at/below baseline, up to ~0.5 when hot
    const soc_elevated = Math.max(0, soc - 1.0);

    // Gate: 0.35 floor so unrest still matters a little even absent a
    // strong ideological current (crisis parties aren't literally inert
    // in a stable-but-chaotic economy), but the bulk of the effect
    // requires the matching ideology to already be running hot.
    const nat_gate = Math.min(1.0, 0.35 + nat_elevated * 1.6);
    const soc_gate = Math.min(1.0, 0.35 + soc_elevated * 1.6);

    // Cross-radicalization: nationalist unrest also partially feeds off
    // socialist heat and vice versa (polarization spiral), at reduced
    // weight — matches the cross-pressure section's bidirectional-but-
    // asymmetric logic applied later to the bloc-level aggregates.
    const unrest_nat_hybrid = unr * Math.min(1.0, nat_gate + soc_elevated * 0.5);
    const unrest_soc_hybrid = unr * Math.min(1.0, soc_gate + nat_elevated * 0.35);

    let base = 0;

    switch (party) {

        case 'nsdap': {
            if (Q.nsdap_banned) return 0;

            let stable_baseline = nat_elevated * 1.2;

            const nsdap_unrest_points = _tickRevolutionaryUnrest('nsdap');
            let crisis_contribution = nsdap_unrest_points * 0.9;

            let soft = 8, hard = 24;
            let raw = (nat * 1.7118) + stable_baseline + crisis_contribution;

            let final_raw = raw <= soft ? raw
                : soft + (hard - soft) * (1 - Math.exp(-(raw - soft) / 45));

            let identity = im.nsdap;
            if (nsdap_unrest_points > 3) identity = Math.max(identity, 1.0);

            base = final_raw * identity;
            base *= _partyAdj('nsdap');

            // Behavior: gov/opposition economy reward-punish — separate
            // channel from the bloc-level nationalism push/pull above.
            base *= _govEconMult('nsdap');
            // Centralized campaigning — party's own focus/intensity meter.
            base *= _campaignMult('nsdap', c);

            // Young NSDAP boost: only applies pre-1930
            const young_nsdap = (Q.hitler_young_funded == 1 && Q.year < 1930);
            const urban_flavor = (Q.urban_plan_flavor_1 == 1);
            const rural_flavor = (Q.geest_wildfire == 1);

            const young_boost = {
                workers:     young_nsdap ? (urban_flavor ? 1.20 : 1.05) : 1.0,
                old_middle:  young_nsdap ? 1.15 : 1.0,
                new_middle:  young_nsdap ? 1.10 : 1.0,
                rural:       young_nsdap ? (urban_flavor ? 1.05 : 1.20) : 1.0,
                unemployedc: young_nsdap ? 1.10 : 1.0,
            };

            const worker_urban_boost = urban_flavor ? 1.05 : 1.0;

            const isStrasserist = Q.nsdap_ideology === "National Socialism (Strasserism)";

            const class_mods = {
                workers:     (isStrasserist ? 2.60 : 0.90) * (Q.peoples_party === 1 ? 1.1 : 1) * young_boost.workers * worker_urban_boost * (rural_flavor ? 1 : 1.3),
                old_middle:  (isStrasserist ? 0.55 : 2.10) * (1 + (Q.nationalism/100) * (isStrasserist ? 0.15 : 0.5)) * young_boost.old_middle,
                new_middle:  (isStrasserist ? 0.45 : 1.80) * (1 + (Q.nationalism/100) * (isStrasserist ? 0.10 : 0.4)) * young_boost.new_middle,
                rural:       (isStrasserist ? 0.60 : 2.20) * (1 + (Q.nationalism/100) * (isStrasserist ? 0.15 : 0.6)) * young_boost.rural * (rural_flavor ? 1.4 : 1),
                unemployedc: (isStrasserist ? 2.30 : 2.10) * (1 + Math.min(unr / 8, 1.0)) * young_boost.unemployedc,
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('nsdap', c), party, c);
        }

        case 'dvfp': {
            if (Q.dvfp_banned || !Q.dvfp_formed) return 0;
            let nat_floor   = nat * 5;
            let u           = Math.max(0, unrest_nat_hybrid - 0.6);
            let crisis_ramp = 18 / (1 + Math.exp(-1.4 * (u - 1.8)));
            let buff = Q.april_challenge === 1 ? 1.28 : 0.85;
            base = (nat_floor + crisis_ramp) * buff * im.dvfp;
            base *= _partyAdj('dvfp');
            base *= _campaignMult('dvfp', c);

            const class_mods = {
                workers:     0.20 * (Q.peoples_party === 1 ? 1.02 : 1),
                old_middle:  1.74 * (1 + Math.min(Q.nationalism/100,1)*0.25) * (Q.peoples_party === 1 ? 0.95 : 1),
                new_middle:  0.77 * (Q.peoples_party === 1 ? 0.95 : 1),
                rural:       1.79 * (1 + Math.min(Q.nationalism/100,1)*0.22) * (Q.peoples_party === 1 ? 0.95 : 1),
                unemployedc: 0.77 * (Q.peoples_party === 1 ? 1.03 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dvfp', c), party, c);
        }

        case 'dnvp': {
           if (Q.dnvp_banned) return 0;

           const isNatCon      = Q.dnvp_ideology === "National Conservatism";
           const isSocCorp     = Q.dnvp_ideology === "Social Corporatism";

           const nsdapAbsent = Q.nsdap_banned || !Q.parties.includes('nsdap');

           let competitive_m = 1.0;
           if (!nsdapAbsent) {
               const nsdap_edge = Math.max(0, unrest_nat_hybrid - 0.7);
               competitive_m = Math.max(0.35, 1 - nsdap_edge * 1.0);
           }

           base = ((nat * 14) + (isSocCorp ? rep * 7 : 4)) * im.dnvp * competitive_m;

           const isLambach    = Q.dnvp_party_leader === "Walther Lambach";
           const lambachEarly = Q.year < 1929;
           const dnvpgovernment = Q.dnvp_in_government == 1;

           // Government bonus: starts at +20% (1.20), decays by 33% (relative) per crisis trigger
           let govBonus_m = 1.0;
           if (dnvpgovernment) {
               const crisisTriggers = [Q.cnbl_crisis, Q.vnr_momentum, Q.geest_wildfire]
                   .filter(Boolean).length;
               // Each trigger cuts the *bonus portion* (the 0.20 above baseline) by 33%
               const bonusPortion = 0.20 * Math.pow(0.67, crisisTriggers);
               govBonus_m = 1.0 + bonusPortion;
           }
           base *= govBonus_m;
           base *= _partyAdj('dnvp');
           base *= _campaignMult('dnvp', c);

           let workers_m     = 0.20
               * (Q.peoples_party                      === 1 ? 1.10 : 1)
               * (Q.lambach_reinstated && lambachEarly        ? 1.20 : 1)
               * (Q.lambach_momentum   && lambachEarly        ? 1.40 : 1)
               * (isLambach                                   ? 1.35 : 1.00)
               * (isSocCorp                                   ? 1.40 : 1.00)
               * (isNatCon                                    ? 0.80 : 1.00);
           let old_middle_m  = 1.20 * (1 + Math.min(Q.nationalism/100,1)*0.28)
               * (Q.peoples_party                      === 1 ? 0.95 : 1)
               * (isLambach                                   ? 0.87 : 1.00)
               * (isNatCon                                    ? 1.20 : 1.00)
               * (isSocCorp                                   ? 0.80 : 1.00);
           let new_middle_m  = 0.60 * (1 + Math.min(Q.nationalism/100,1)*0.18)
               * (Q.peoples_party                      === 1 ? 0.95 : 1)
               * (Q.lambach_reinstated && lambachEarly        ? 1.35 : 1)
               * (Q.lambach_momentum   && lambachEarly        ? 1.65 : 1)
               * (isLambach                                   ? 1.50 : 1.00)
               * (isSocCorp                                   ? 1.35 : 1.00)
               * (isNatCon                                    ? 0.80 : 1.00);
           let rural_m       = 1.20 * (1 + Math.min(Q.nationalism/100,1)*0.30)
               * (Q.peoples_party                      === 1 ? 0.95 : 1)
               * (Q.parties.includes('dbp')                  ? 0.9111 : 1)
               * (Q.parties.includes('cnbl')                  ? 0.7953 : 1)
               * (isLambach                                   ? 0.87 : 1.00)
               * (isNatCon                                    ? 1.20 : 1.00)
               * (isSocCorp                                   ? 0.80 : 1.00);
           let unemployedc_m = 0.33
               * (Q.peoples_party                      === 1 ? 1.05 : 1)
               * (isSocCorp                                   ? 1.40 : 1.00)
               * (isNatCon                                    ? 0.70 : 1.00);

           const class_mods = { workers: workers_m, old_middle: old_middle_m, new_middle: new_middle_m, rural: rural_m, unemployedc: unemployedc_m };
           if (Q.dem_challenge === 1) base *= 0.80;
           return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dnvp', c), party, c);
       }

        case 'dnf': {
            if (Q.dnf_banned) return 0;

            const dnf_nsdapAbsent = Q.nsdap_banned || !Q.parties.includes('nsdap');
            let dnf_competitive_m = 1.0;
            if (!dnf_nsdapAbsent) {
                const nsdap_edge = Math.max(0, unrest_nat_hybrid - 0.65);
                dnf_competitive_m = Math.max(0.30, 1 - nsdap_edge * 1.1);
            }
            base = (nat * 18) * dnf_competitive_m * (im.dnf || im.dnvp);
            base *= _partyAdj('dnf');
            base *= _campaignMult('dnf', c);

            const isHarzburg   = Q.harzburg_front_seen === true;
            const mediaBlitz   = Q.hugenberg_media_blitz === true;

            let workers_m     = 0.10
                * (mediaBlitz                                 ? 1.20 : 1)
                * (isHarzburg                                  ? 0.70 : 1);

            let old_middle_m  = 1.78 * (1 + Math.min(Q.nationalism/100,1)*0.40)
                * (Q.peoples_party                      === 1 ? 0.90 : 1)
                * (mediaBlitz                                  ? 1.15 : 1);

            let new_middle_m  = 0.30 * (1 + Math.min(Q.nationalism/100,1)*0.22)
                * (mediaBlitz                                  ? 1.35 : 1)
                * (isHarzburg                                  ? 1.10 : 1);

            let rural_m       = 2.15 * (1 + Math.min(Q.nationalism/100,1)*0.45)
                * (Q.peoples_party                      === 1 ? 0.90 : 1)
                * (Q.parties.includes('dbp')                  ? 0.85 : 1)
                * (Q.parties.includes('cnbl')                 ? 0.68 : 1)
                * (isHarzburg                                  ? 0.80 : 1);

            
            let unemployedc_m = 0.15
                * (Q.unemployment > 0.28                      ? 1.15 : 1);

            const class_mods = { workers: workers_m, old_middle: old_middle_m, new_middle: new_middle_m, rural: rural_m, unemployedc: unemployedc_m };
            
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dnf', c), party, c);
        }


        case 'dsbp': {
            if (Q.dsbp_banned) return 0;

            // ── Presence penalties ──────────────────────────────────────
            const ddp_present  = Q.parties.includes('ddp') && !Q.ddp_banned;
            const dvp_present  = Q.parties.includes('dvp') && !Q.dvp_banned;
            const vnr_present  = Q.parties.includes('vnr') && !Q.vnr_banned;

            let presence_pen = 1.0;
            if (ddp_present && dvp_present) presence_pen = 0.18;   // both parents: severe nerf
            else if (ddp_present)           presence_pen = 0.30;   // DDP alone: heavy nerf
            else if (dvp_present)           presence_pen = 0.30;   // DVP alone: heavy nerf
            if (vnr_present)                presence_pen *= 0.85;  // VNR siphons liberal-national voters

            let ddp_factor   = Q.dvp_right_shift ? nat * 0.95 : rep * 1.0;
            let dvp_scale    = Q.dvp_right_shift ? 2.2 : 1.8;
            let dvp_base_raw = ddp_factor * 9.8 * dvp_scale;

            let sec_bonus  = (100 - Q.catholics) / 100 * 0.10;
            let nat_pen_d  = (Q.nationalism / 100) * 0.15;
            let edu_bonus  = (Q.education_science || 0) * 0.03
                           + (Q.secularized       || 0) * 0.05
                           + (Q.science           || 0) * 0.10
                           + (Q.womens_rights     || 0) * 0.05;
            let ddp_base_raw = rep * 10.6 * (1.1 + sec_bonus - nat_pen_d + edu_bonus);

            // Rep factor boosted 30% vs raw DDP — merger skews liberal-republican
            let rep_boost = 1.30;
            base = (ddp_base_raw * rep_boost + dvp_base_raw) * 1.9 * presence_pen * (im.dsbp || 1);
            base *= _partyAdj('dsbp');
            base *= _campaignMult('dsbp', c);

            const combined = {
                workers:     (0.60 + 0.45)  / 2,   // 0.525
                old_middle:  (0.85 + 1.35)  / 2,   // 1.10
                new_middle:  (1.40 + 1.40)  / 2,   // 1.40
                rural:       (0.50 + 0.65)  / 2,   // 0.575
                unemployedc: (0.55 + 0.30)  / 2,   // 0.425
            };

            const class_mods = {
                workers:     combined.workers     * 0.80 * 0.30,  // ~0.126
                old_middle:  combined.old_middle  * 0.80 * 0.50,  // 50% extra penalty
                new_middle:  combined.new_middle  * 0.80,
                rural:       combined.rural       * 0.80 * 0.50,  // 50% extra penalty
                unemployedc: combined.unemployedc * 0.80 * 0.25,  // ~0.085
            };

            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dsbp', c), party, c);
        }

        case 'wp': {
            if (Q.wp_banned) return 0;
            let middle_norm  = (Q.old_middle + Q.new_middle) / 99;

            const old_mid_qol_low = Math.max(0, 100 - (Q.old_middle_qol || 100)) / 50; // 0 at baseline, 1 at QoL=50
            const new_mid_qol_low = Math.max(0, 100 - (Q.new_middle_qol || 100)) / 50;
            let qol_grievance_boost = 1 + Math.min(1.2, (old_mid_qol_low * 0.7 + new_mid_qol_low * 0.5));
            base = rep * 3.8 * nat * 3.4 * middle_norm * qol_grievance_boost * im.wp;
            base *= _partyAdj('wp');
            base *= _govEconMult('wp'); // Behavior: refright
            base *= _campaignMult('wp', c);

            let old_middle_m = 1.85 * (1 + old_mid_qol_low * 0.35) * (Q.peoples_party === 1 ? 0.96 : 1);
            let new_middle_m = 1.50 * (1 + new_mid_qol_low * 0.30) * (Q.peoples_party === 1 ? 0.96 : 1);

            const class_mods = { workers: 0.12, old_middle: old_middle_m, new_middle: new_middle_m, rural: 0.12, unemployedc: 0.12 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('wp', c), party, c);
        }

        case 'cnbl': {
            if (Q.cnbl_banned) return 0;
            base = (rep * 2.2 + nat * 3.8) * (1 + Q.rural * 0.009) * im.cnbl;
            base *= _partyAdj('cnbl');
            base *= _govEconMult('cnbl'); // Behavior: refright
            base *= _campaignMult('cnbl', c);
            let rural_m = 1.80 * (1 + Math.min(Q.rural / 100, 0.4)) * (Q.landvolk_fury > 0 ? (1 + Math.min(0.25 * (Math.pow(1.15, Q.landvolk_fury) - 1), 4) + Math.min(0.06 * (Math.pow(1.85, Q.landvolk_fury) - 1), 3)) : 1);

            const class_mods = { workers: 0.25, old_middle: 0.18, new_middle: 0.15, rural: rural_m, unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('cnbl', c), party, c);
        }

        case 'kpd': {
            if (Q.kpd_banned) return 0;
            let buff = Q.april_challenge === 1 ? 1.30 : 1;

            // Behavior: revleft ('climb') — replaces the reactive
            // unrest_soc_hybrid term with the slow-building revolutionary
            // unrest stock. Scaled down (/20 vs the old term's ~0-1.5
            // range) since the stock itself climbs to a cap of 20.
            const kpd_unrest_points = _tickRevolutionaryUnrest('kpd');
            base = soc * 6.8 * 1.9 * (1 + (kpd_unrest_points / 20) * 1.6) * buff * im.kpd;
            base *= _partyAdj('kpd');

            // Behavior: gov/opposition economy reward-punish — separate
            // channel from the bloc-level socialism push/pull above.
            base *= _govEconMult('kpd');
            base *= _campaignMult('kpd', c);

            let workers_m     = 1.55 * (Q.peoples_party === 1 ? 1.08 : 1);
            let old_middle_m  = 0.05 * (Q.peoples_party === 1 ? 0.92 : 1);
            let new_middle_m  = 0.10 * (Q.peoples_party === 1 ? 0.92 : 1);
            let rural_m       = 0.10 * (Q.peoples_party === 1 ? 0.92 : 1);
            let unemployedc_m = 1.40 * (Q.peoples_party === 1 ? 1.08 : 1);
            const class_mods  = { workers: workers_m, old_middle: old_middle_m, new_middle: new_middle_m, rural: rural_m, unemployedc: unemployedc_m };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('kpd', c), party, c);
        }

        case 'sapd': {
            if (Q.sapd_banned || !Q.sapd_formed) return 0;
            let buff = Q.april_challenge === 1 ? 1.15 : 0.90;
            base = soc * 3.8 * 2.0 * (1 + unrest_soc_hybrid * 0.12) * buff * im.sapd;
            base *= _partyAdj('sapd');
            base *= _campaignMult('sapd', c);

            const class_mods = {
                workers:     1.35 * (Q.peoples_party === 1 ? 1.07 : 1),
                old_middle:  0.10* (Q.peoples_party === 1 ? 0.93 : 1),
                new_middle:  0.10 * (Q.peoples_party === 1 ? 0.93 : 1),
                rural:       0.10 * (Q.peoples_party === 1 ? 0.93 : 1),
                unemployedc: 1.00 * (Q.peoples_party === 1 ? 1.07 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('sapd', c), party, c);
        }

        case 'srpd': {
            if (Q.srpd_banned || !Q.srpd_formed) return 0;
            let rb = Q.rb_strength * 0.0004;
            base = (soc * 2 * 1.95 + rep * 5 * 1.76 + rb) * im.srpd;
            base *= _partyAdj('srpd');
            base *= _campaignMult('srpd', c);


            const class_mods = {
                workers:     1.10 * (Q.peoples_party === 1 ? 1.06 : 1),
                old_middle:  0.25 * (Q.peoples_party === 1 ? 0.94 : 1),
                new_middle:  0.35 * (Q.peoples_party === 1 ? 0.94 : 1),
                rural:       0.59 * (Q.peoples_party === 1 ? 0.94 : 1),
                unemployedc: 0.25 * (Q.peoples_party === 1 ? 1.06 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('srpd', c), party, c);
        }

        case 'spd': {
    if (Q.spd_banned) return 0;
    let s = soc, r = rep;
    if (Q.peoples_party === 1)      { s *= 0.80; r *= 1.20; }
    if (Q.ideology === 'left')       { s *= 1.15; r *= 0.90; }
    else if (Q.ideology === 'reformist') { r *= 1.10; s *= 0.90; }
    else if (Q.ideology === 'neorev')    { s *= 1.05; r *= 1.05; }

    if (Q.social_fascism_adopted == 1) {r *= 1.47; s *= 0.60}

    // Centralized campaigning: SPD keeps its extra policy-conditional
    // fine-tuning per focus (below), layered on top of the same
    // generic _campaignMult() every other party uses.
    let campaign_policy_boost = 1.1;
    if (Q.campaign_focus_spd === 'workers'    && (Q.campaign_intensity_spd || 0) > 0) {
        campaign_policy_boost +=
              (Q.wtb_adopted === 1 ? 0.05 : 0)
            + (Q.nationalization_progress >= 1 ? 0.04 : 0)
            + (Q.welfare <= 0 ? -0.04 : 0)
            + (Q.workers_aid > 0 ? Q.workers_aid * 0.01 : 0)
            + (Q.pro_consumer > 0 ? 0.02 : 0)
            + (Q.trans_rights > 0 ? 0.01 : 0)
            + (Q.iron_front_progress > 2 ? 0.015 : 0)
            - (Q.peoples_party === 1 ? (Q.socialism / 200) : 0)
            - (Q.lower_tax_rates > 0 ? Q.lower_tax_rates * 0.03 : 0);
    }
    if (Q.campaign_focus_spd === 'new_middle' && (Q.campaign_intensity_spd || 0) > 0) {
        campaign_policy_boost +=
              (Q.peoples_party === 1 ? 0.04 : 0)
            + (Q.radio >= 1 ? 0.04 * Q.radio : 0)
            + (Q.commercialized_media >= 1 ? 0.02 * Q.commercialized_media : 0)
            - (Q.socialism <= 49 && Q.peoples_party === 0 ? 0.06 : 0)
            - (Q.upper_tax_rates > 0 ? Q.upper_tax_rates * 0.03 : 0);
    }
    if (Q.campaign_focus_spd === 'old_middle' && (Q.campaign_intensity_spd || 0) > 0) {
        campaign_policy_boost +=
              (Q.peoples_party === 1 ? 0.04 : 0)
            + (Q.radio >= 1 ? 0.02 * Q.radio : 0)
            - (Q.nationalism >= 51 && Q.peoples_party === 0 ? 0.06 : 0)
            - (Q.upper_tax_rates > 0 ? Q.upper_tax_rates * 0.03 : 0)
            - (Q.nationalism / 480);
    }
    if (Q.campaign_focus_spd === 'rural'      && (Q.campaign_intensity_spd || 0) > 0) {
        campaign_policy_boost +=
              (Q.agricultural_finance >= 2 ? 0.04 : 0)
            + (Q.state_buyer === 1 ? 0.03 : 0)
            - (Q.peoples_party === 0 ? 0.05 : 0);
    }
    if (Q.campaign_focus_spd === 'unemployed' && (Q.campaign_intensity_spd || 0) > 0) {
        campaign_policy_boost +=
              (Q.wtb_adopted === 1 ? 0.06 : 0)
            + (Q.welfare >= 2 ? 0.04 : 0)
            + (Q.iron_front_progress > 4 ? 0.02 : 0)
            - (Q.welfare < 0 ? 0.05 : 0);
    }
    if (Q.campaign_focus_spd === 'women'      && (Q.campaign_intensity_spd || 0) > 0) {
        campaign_policy_boost +=
              (Q.womens_rights >= 3 ? Q.womens_rights * 0.01 : 0)
            + (Q.abortion_rights > 0 ? 0.02 : 0)
            + (Q.womens_work > 0 ? Q.womens_work / 300 : 0)
            + (Q.family_law > 0 ? Q.family_law / 400 : 0);
    }
    if (Q.campaign_focus_spd === 'middle'     && (Q.campaign_intensity_spd || 0) > 0) {
        campaign_policy_boost +=
            - (Q.nationalism >= (Q.pro_republic / 2) && Q.peoples_party === 0 ? 0.05 : 0)
            - ((Q.socialism * 1.5) <= Q.nationalism && Q.peoples_party === 0 ? 0.04 : 0)
            - (Q.upper_tax_rates > 0 ? Q.upper_tax_rates * 0.027 : 0);
    }

    let left_extremism_bump = (Q.ideology === 'left')
        ? 1 + (unrest_soc_hybrid * 0.045)
        : 1.0;

    base = (r * 19.8 + s * 11.6) * im.spd * (eim.spd || 1.0) * campaign_policy_boost * left_extremism_bump;
    base *= _partyAdj('spd');

    // Behavior: refleft ('linear') — reactive unrest term above is
    // unchanged; only the gov/opposition economy multiplier is added,
    // as a separate channel from the bloc-level push/pull system.
    base *= _govEconMult('spd');
    // Centralized campaigning — same generic function every party uses.
    base *= _campaignMult('spd', c);

    let m;
    if (c === 'workers') {
        m = 1.10;
        if (Q.peoples_party === 1)  m *= 0.82;
        if (Q.ideology === 'left')      m *= 1.12;
        if (Q.ideology === 'reformist') m *= 0.92;
        
        let workersDuesDiff = Q.dues_workers - 1;
        m *= workersDuesDiff > 0 ? (1 - workersDuesDiff * 0.086) : (1 - workersDuesDiff * 0.05);
        if (Q.wtb_timer > 0)             m += (Q.workers / 100) * 0.75;
        if (Q.unions_independent === 1)  m *= 0.50;
        if (Q.pro_consumer > 0)          m += Q.pro_consumer     * 0.23;
        if (Q.state_buyer > 0)           m += Q.state_buyer     * 0.25;
        if (Q.welfare > 0)               m += Q.welfare         * 0.11;
        if (Q.working_hours > 0)         m += Q.working_hours   * 0.08;
        if (Q.workers_safety > 0)        m += Q.workers_safety  * 0.05;
        if (Q.commonwealth_cooperation > 0) m += Q.commonwealth_cooperation * 0.55;
        if (Q.works_councils > 0)        m += Q.works_councils  * 0.05;
        if (Q.economic_democracy > 0)    m += Q.economic_democracy * 0.02;
        if (Q.cooperatives > 0)          m += Q.cooperatives    * 0.10;
        if (Q.lower_tax_rates > 0)       m -= Q.lower_tax_rates * 0.25;
    } else if (c === 'old_middle') {

        m = 0.15;
        if (Q.peoples_party === 1)   m *= 1.15;
        if (Q.ideology === 'left')       m *= 0.88;
        if (Q.ideology === 'reformist')  m *= 1.10;
        if (Q.ideology === 'neorev')     m *= 1.05;
        
        let oldMiddleDuesDiff = Q.dues_old_middle - 1;
        m *= oldMiddleDuesDiff > 0 ? (1 - oldMiddleDuesDiff * 0.12) : (1 - oldMiddleDuesDiff * 0.07);
        if (Q.land_reform > 0)      m -= Q.land_reform     * 0.15;
    } else if (c === 'new_middle') {
        m = 0.65;
        if (Q.peoples_party === 1)   m *= 1.15;
        if (Q.ideology === 'left')       m *= 0.88;
        if (Q.ideology === 'reformist')  m *= 1.10;
        if (Q.ideology === 'neorev')     m *= 1.05;
        
        let newMiddleDuesDiff = Q.dues_new_middle - 2;
        m *= newMiddleDuesDiff > 0 ? (1 - newMiddleDuesDiff * 0.094) : (1 - newMiddleDuesDiff * 0.055);
        if (Q.wtb_timer > 0)        m += (Q.new_middle / 100) * 0.27;
        if (Q.reformists_resign === 1) m *= 0.50;
    } else if (c === 'rural') {
        m = 0.10;
        if (Q.peoples_party === 1)   m *= 1.30;
        
        let ruralDuesDiff = Q.dues_rural - 1;
        m *= ruralDuesDiff > 0 ? (1 - ruralDuesDiff * 0.11) : (1 - ruralDuesDiff * 0.065);
        if (Q.land_reform > 0)      m += Q.land_reform          * 0.48;
        if (Q.agricultural_finance > 0) m += Q.agricultural_finance * 0.25;
        if (Q.pro_consumer > 0)     m += Q.pro_consumer          * 0.03;
        if (Q.state_buyer > 0)      m += Q.state_buyer          * 1.22;
    } else if (c === 'unemployedc') {
        m = 0.91;
        if (Q.peoples_party === 1)   m *= 0.88;
        if (Q.ideology === 'left')   m *= 1.10;
        
        let unemployedDuesDiff = Q.dues_unemployedc - 0.5;
        m *= unemployedDuesDiff > 0 ? (1 - unemployedDuesDiff * 0.086) : (1 - unemployedDuesDiff * 0.05);
        if (Q.wtb_timer > 0)         m += (Q.unemployedc / 100) * 1.03;
        if (Q.left_split === 1)      m *= 0.50;
        if (Q.pro_consumer > 0)      m += Q.pro_consumer         * 0.13;
        if (Q.state_buyer > 0)       m += Q.state_buyer         * 0.15;
        if (Q.welfare > 0)           m += Q.welfare             * 0.06;
    } else {
        m = 1.0;
    }

    if (Q.dem_challenge === 1) base *= 0.80;
    if (Q.ls_challenge === 1) base *= 1.40;
    if (Q.new_partei_challenge) {
        const START_YEAR = 1928;
        const END_YEAR = 1935;
        const totalWeeks = (END_YEAR - START_YEAR) * 26;
        const elapsedWeeks = (Q.year - START_YEAR) * 26 + Q.month * 2 + (Q.weeks / 2);
        const debuffPercent = Math.max(0, 99 * (1 - elapsedWeeks / totalWeeks));
        base *= (1 - debuffPercent / 100);
    }

    const finalM = m * _classAdj('spd', c);
    return _applyQOL(base * finalM * 0.93, party, c);
}

        case 'ddp': {
           if (Q.ddp_banned) return 0;

           let edu_bonus = (Q.education_science || 0) * 0.03
                         + (Q.secularized       || 0) * 0.05
                         + (Q.science           || 0) * 0.10
                         + (Q.womens_rights     || 0) * 0.05;
           if (!Q.ddp_name || Q.ddp_name === 'DDP') {
               let sec_bonus = (100 - Q.catholics) / 100 * 0.10;
               let nat_pen   = (Q.nationalism / 100) * 0.15;
               base = (rep * 9.4 * (1.1 + sec_bonus - nat_pen + edu_bonus)) * im.ddp;
               base *= _partyAdj('ddp');
               base *= _govEconMult('ddp'); // Behavior: center
               base *= _campaignMult('ddp', c);

               const class_mods = {
                   workers:     (0.25) * (Q.peoples_party === 1 ? 0.93 : 1),
                   old_middle:  (0.95) * (Q.peoples_party === 1 ? 1.08 : 1),
                   new_middle:  (1.55 * ((Q.education_science >= 2 || Q.womens_rights >= 3) ? 1.05 : 1)) * (Q.peoples_party === 1 ? 1.08 : 1),
                   rural:       (0.20) * (Q.peoples_party === 1 ? 1.05 : 1),
                   unemployedc: (0.05) * (Q.peoples_party === 1 ? 0.93 : 1),
               };
               return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('ddp', c), party, c);
           } else if (Q.ddp_name === 'LMP') {
               let wp_strength = (Q.wp_votes || 0) * 0.004;
               let mittelstand_bonus = (Q.old_middle_ddp || 0) * 0.002;
               let edu_pen = (Q.education_science || 0) * 0.02
                           + (Q.secularized       || 0) * 0.03
                           + (Q.womens_rights     || 0) * 0.03;
               base = (rep * 0.30 + wp_strength + mittelstand_bonus - edu_pen) * 10.4 * im.ddp;
               base *= _partyAdj('ddp');
               base *= _govEconMult('ddp'); // Behavior: center
               base *= _campaignMult('ddp', c);

               const class_mods = {
                   workers:     0.20 * (Q.peoples_party === 1 ? 0.93 : 1),
                   old_middle:  1.35 * (Q.peoples_party === 1 ? 1.08 : 1),
                   new_middle:  0.85 * (Q.peoples_party === 1 ? 1.08 : 1),
                   rural:       0.10 * (Q.peoples_party === 1 ? 1.05 : 1),
                   unemployedc: 0.15 * (Q.peoples_party === 1 ? 0.93 : 1),
               };
               return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('ddp', c), party, c);
           } else {
               // DStP
               let jungdo  = (Q.jungdo_strength || 0) * 0.0003;
               let edu_pen = (Q.education_science || 0) * 0.01
                           + (Q.secularized       || 0) * 0.05
                           + (Q.science           || 0) * 0.10
                           + (Q.womens_rights     || 0) * 0.05;
               base = (rep * 0.30 + nat * 0.29 + jungdo - edu_pen) * 11.8 * im.ddp;
               base *= _partyAdj('ddp');
               base *= _govEconMult('ddp'); // Behavior: center
               base *= _campaignMult('ddp', c);

               const class_mods = {
                   workers:     0.50 * (Q.peoples_party === 1 ? 0.93 : 1),
                   old_middle:  1.05 * (Q.peoples_party === 1 ? 1.08 : 1),
                   new_middle:  1.10 * (Q.peoples_party === 1 ? 1.08 : 1),
                   rural:       0.5 * (Q.peoples_party === 1 ? 1.05 : 1),
                   unemployedc: 0.10 * (Q.peoples_party === 1 ? 0.93 : 1),
               };
               return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('ddp', c), party, c);
           }
       }

        case 'dvp': {
            if (Q.dvp_banned) return 0;

            let factor      = Q.dvp_right_shift ? nat * 0.95 : rep * 1.0;
            let scale       = Q.dvp_right_shift ? 2.2 : 1.8;
            base = factor * 8 * scale * (im.dvp || 1);
            base *= _partyAdj('dvp');
            base *= _govEconMult('dvp'); // Behavior: refright
            base *= _campaignMult('dvp', c);

            const class_mods = {
                workers:     0.15 * (Q.peoples_party === 1 ? 0.92 : 1),
                old_middle:  1.70 * (Q.dvp_right_shift ? (1 + Math.min(Q.nationalism/100,1)*0.22) : 1) * (Q.peoples_party === 1 ? 0.96 : 1),
                new_middle:  1.30 * (Q.dvp_right_shift ? (1 + Math.min(Q.nationalism/100,1)*0.18) : 1) * (Q.peoples_party === 1 ? 0.96 : 1),
                rural:       0.30 * (Q.peoples_party === 1 ? 0.96 : 1),
                unemployedc: 0.05 * (Q.peoples_party === 1 ? 0.92 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dvp', c), party, c);
        }

        case 'z': {
            if (Q.z_banned) return 0;
            let cath_bonus  = Q.catholics / 8;
            let leader_mod  = Q.z_party_leader === 'Kaas' ? 0.94 : Q.z_party_leader === 'Joos' ? 1.06 : 1.0;
            let gov_mod     = Q.z_in_government ? 1.12 : 0.93;
            base = (rep * 12 + cath_bonus * 0.8) * leader_mod * gov_mod * im.z * (eim.z || 1.0);

            let floor = cath_bonus * 1.5 * gov_mod;
            base = Math.max(base, floor);
            base *= _partyAdj('z');

            // Behavior: center — economy-aware gov/opposition multiplier,
            // separate channel layered on top of the existing static
            // gov_mod above (which stays as a flat in/out-of-government
            // flavor bonus; this adds the economic performance dimension).
            base *= _govEconMult('z');
            base *= _campaignMult('z', c);

            const isChristCon = Q.z_ideology === "Christian Conservatism";
            const isCathLabor = Q.z_ideology === "Catholic Laborism";

            const ccClassMult = isChristCon
                ? {
                    rural:      0.65,
                    old_middle: 0.65 * (Q.z_transition_cvp === 1 ? 1.20 : 1),
                    workers:    1.35 * (Q.z_transition_cvp === 2 ? 1.15 : 1),
                    new_middle: 1.25,
                  }
                : isCathLabor
                ? {
                    workers:     1.55,
                    unemployedc: 1.60,
                    old_middle:  0.75,
                    new_middle:  0.90,
                    rural:       0.85,
                  }
                : {};

            const class_mods = {
                workers:     0.35 * (Q.z_party_leader == 'Adam Stegerwald' ? 1.08 : 1) * (Q.peoples_party === 1 ? 1.09 : 1) * (ccClassMult.workers || 1),
                old_middle:  1.10 * (Q.peoples_party === 1 ? 0.91 : 1) * (ccClassMult.old_middle || 1),
                new_middle:  0.90 * (Q.peoples_party === 1 ? 0.87 : 1) * (ccClassMult.new_middle || 1),
                rural:       0.90 * (Q.peoples_party === 1 ? 0.87 : 1) * (ccClassMult.rural || 1),
                unemployedc: 0.20 * (Q.peoples_party === 1 ? 1.10 : 1) * (ccClassMult.unemployedc || 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('z', c), party, c);
        }

        case 'bvp': {
            if (Q.bvp_banned) return 0;
            let cath = Q.catholics * 0.10;
            let rur  = Q.rural    * 0.03;
            base = Math.min(9, rep * 3 * (nat * 4.4) * im.bvp + cath + rur);
            base *= _partyAdj('bvp');
            base *= _campaignMult('bvp', c);

            let rural_m = 1.20 * (1 + Math.min(Q.rural / 125, 0.25)) * (Q.peoples_party === 1 ? 0.96 : 1);
            const class_mods = {
                workers:     0.20 * (Q.peoples_party === 1 ? 0.94 : 1),
                old_middle:  1.30 * (Q.peoples_party === 1 ? 0.96 : 1),
                new_middle:  0.80 * (Q.peoples_party === 1 ? 0.96 : 1),
                rural:       rural_m,
                unemployedc: 0.05 * (Q.peoples_party === 1 ? 0.94 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('bvp', c), party, c);
        }

        case 'csvd': {
            if (Q.csvd_banned) return 0;
            let dnvp_split_bonus = 0;
            if (Q.dnvp_party_leader == "Alfred Hugenberg" || Q.lambach_defection >= 1)                              dnvp_split_bonus = 0.5 + (Q.dnvp_r * 0.03);


            let anti_nazi_appeal = 0;
            if (Q.nsdap_r >= 15 && Q.nsdap_r < 30)             anti_nazi_appeal = 0.3 + (Q.church_resist_nazis ? 0.15 : 0);
            else if (Q.nsdap_r >= 30)                           anti_nazi_appeal = -0.2;

            let coalition_stability = 0;

            let crisis_factor = Math.max(0.55, 1 - (unr / 12));

            base = (rep * 3 + (nat * 3) + dnvp_split_bonus + anti_nazi_appeal + coalition_stability) * crisis_factor * im.csvd;
            base *= _partyAdj('csvd');
            base *= _campaignMult('csvd', c);

            const class_mods = {
                workers:     0.30 * (Q.peoples_party === 1 ? 1.10 : 1) * (Q.lambach_defection >= 1 ? 2.50 : 1),
                old_middle:  0.75 * (1 + Math.min(Q.nationalism/100,1)*0.22) * (Q.peoples_party === 1 ? 0.96 : 1),
                new_middle:  1.80 * (1 + Math.min(Q.nationalism/100,1)*0.18) * (Q.peoples_party === 1 ? 0.96 : 1) * (Q.lambach_defection >= 1 ? 2.50 : 1),
                rural:       0.10 * (1 + Math.min(Q.nationalism/100,1)*0.25) * (Q.peoples_party === 1 ? 0.96 : 1),
                unemployedc: 0.25 * (Q.peoples_party === 1 ? 0.93 : 1),
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('csvd', c), party, c);
        }

        case 'csrp': {
            if (Q.csrp_banned) return 0;
            let april = Q.april_challenge && Q.year >= 1933 ? 27 : 1;
            base = rep * 3.2 * im.csrp * april;
            base *= _partyAdj('csrp');
            base *= _campaignMult('csrp', c);
            const class_mods = { workers: 0.20, old_middle: 0.05, new_middle: 0.15, rural: 0.10, unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('csrp', c), party, c);
        }

        case 'vrp': {
            if (Q.vrp_banned) return 0;

            const vrp_old_mid_low = Math.max(0, 100 - (Q.old_middle_qol || 100)) / 50;
            const vrp_new_mid_low = Math.max(0, 100 - (Q.new_middle_qol || 100)) / 50;
            base = (rep * 2.5) * (1 + Math.min(0.9, vrp_old_mid_low * 0.5 + vrp_new_mid_low * 0.4)) * im.vrp;
            base *= _partyAdj('vrp');
            base *= _campaignMult('vrp', c);
            const class_mods = { workers: 0.04, old_middle: 0.12 * (1 + vrp_old_mid_low * 0.3), new_middle: 0.08 * (1 + vrp_new_mid_low * 0.3), rural: 0.01, unemployedc: 0.67 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('vrp', c), party, c);
        }

        case 'other': {
            if (Q.other_banned) return 0;
            base = (nat + rep) * 1.4 * im.other;
            base *= _partyAdj('other');
            base *= _campaignMult('other', c);
            const class_mods = { 
        workers: 0.30, 
        old_middle: 0.85, 
        new_middle: 0.80, 
        rural: 1.15 * (Q.parties.includes('cnbl') ? 1.5953 : 1) * (Q.landvolk_fury > 0 ? (1 + Math.min(0.03 * (Math.pow(1.15, Q.landvolk_fury) - 1), 3) + Math.min(0.20 * (Math.pow(1.85, Q.landvolk_fury) - 1), 6)) : 1),
        unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('other', c), party, c);
        }

        case 'kvp': {
            if (Q.kvp_banned) return 0;
            let split_bonus = Q.dnvp_party_leader == "Alfred Hugenberg" || Q.lambach_stage >= 2 ? 2.5 : 0.8;
            base = (rep * 3.6 + nat * 2.8) * split_bonus * im.kvp;
            base *= _partyAdj('kvp');
            base *= _campaignMult('kvp', c);
            const class_mods = { workers: 0.10, old_middle: 1.65, new_middle: 1.25, rural: 1.25, unemployedc: 0.10 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('kvp', c), party, c);
        }

        case 'dhp': {
            if (Q.dhp_banned) return 0;
            base = Math.min(0.7, (rep * 6 + nat * 2) * 0.8 * im.dhp);
            base *= _partyAdj('dhp');
            base *= _campaignMult('dhp', c);
            const class_mods = { workers: 0.20, old_middle: 1.35, new_middle: 0.35, rural: 1.70, unemployedc: 0.10 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dhp', c), party, c);
        }

        case 'bb': {
            if (Q.bb_banned) return 0;
            let rural_weight    = Q.rural / 60;
            let deflation_bonus = Q.inflation < 0 ? (1 + Math.abs(Q.inflation) * 0.08) : 1.0;
            base = (rep * 2 + nat * 2.4) * rural_weight * deflation_bonus * im.bb;
            base *= _partyAdj('bb');
            base *= _campaignMult('bb', c);
            const class_mods = { workers: 0.10, old_middle: 0.40, new_middle: 0.20, rural: 2.10, unemployedc: 0.12 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('bb', c), party, c);
        }

        case 'aspd': {
            if (Q.aspd_banned) return 0;
            base = (rep * 0.6 + nat * 2 + soc * 0.2) * im.bb;
            base *= _partyAdj('aspd');
            base *= _campaignMult('aspd', c);
            const class_mods = { workers: 0.65, old_middle: 0.05, new_middle: 0.22, rural: 0.01, unemployedc: 0.35 };
            let result = base * (class_mods[c] || 1.0) * _classAdj('aspd', c);
            if (Q.reformists_resign >= 1) result *= 2.50;
            if (Q.unions_independent >= 1) result *= 2.50;
            if (Q.neorev_split >= 1) result *= 3.50;
            if (Q.ideology == "left") result *= 1.50;
            return _applyQOL(result, party, c);
        }

        case 'hl': {
            if (Q.hl_banned) return 0;
            base = (rep * 0.6 + nat * 1 + soc * 2) * im.bb;
            base *= _partyAdj('hl');
            base *= _campaignMult('hl', c);
            const class_mods = { workers: 0.20, old_middle: 0.50, new_middle: 0.20, rural: 0.55, unemployedc: 0.10 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('hl', c), party, c);
        }

        case 'sl': {
            if (Q.sl_banned) return 0;
            let sl_buff = Q.april_challenge === 1 ? 4.50 : 1;
            base = (rep * 0.6 + nat * 1 + soc * 2) * sl_buff * im.bb;
            base *= _partyAdj('sl');
            base *= _campaignMult('sl', c);
            const class_mods = { workers: 0.50, old_middle: 0.01, new_middle: 0.01, rural: 0.01, unemployedc: 0.25 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('sl', c), party, c);
        }

        case 'kpo': {
            if (Q.kpo_banned) return 0;
            base = (rep * 0.6 + nat * 1 + soc * 4) * im.bb;
            base *= _partyAdj('kpo');
            base *= _campaignMult('kpo', c);
            const class_mods = { workers: 0.50, old_middle: 0.50, new_middle: 0.20, rural: 0.55, unemployedc: 0.25 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('kpo', c), party, c);
        }

        case 'vnr': {
            if (Q.vnr_banned) return 0;
            base = (rep * 2.4 + nat * 1.6) * im.bb;
            base *= _partyAdj('vnr');
            base *= _campaignMult('vnr', c);
            const class_mods = { 
            workers: 0.10 * (Q.vnr_momentum >= 1 ? 1.08 : 1), 
            old_middle: 0.10 * (Q.vnr_momentum >= 1 ? 1.58 : 1), 
            new_middle: 0.40 * (Q.vnr_momentum >= 1 ? 3.65 : 1), 
            rural: 0.10, 
            unemployedc: 0.10 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('vnr', c), party, c);
        }

        case 'dtsp': {
            if (Q.dtsp_banned) return 0;
            base = nat * 1.6 * (1 + unrest_nat_hybrid * 0.10) * im.dtsp;
            base *= _partyAdj('dtsp');
            base *= _campaignMult('dtsp', c);
            const class_mods = { workers: 0.15, old_middle: 0.90, new_middle: 0.70, rural: 0.80, unemployedc: 0.20 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dtsp', c), party, c);
        }

        case 'sls': {
            if (Q.sls_banned) return 0;
            base = rep * 0.8 * im.sls;
            base *= _partyAdj('sls');
            base *= _campaignMult('sls', c);
            const class_mods = { workers: 0.30, old_middle: 0.40, new_middle: 0.25, rural: 0.60, unemployedc: 0.20 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('sls', c), party, c);
        }

        case 'rdp': {
            if (Q.rdp_banned) return 0;
            let nat_pen = (Q.nationalism / 100) * 0.20;
            base = rep * 1.2 * (1.0 - nat_pen) * im.rdp;
            base *= _partyAdj('rdp');
            base *= _campaignMult('rdp', c);
            const class_mods = { workers: 0.25, old_middle: 0.30, new_middle: 0.85, rural: 0.15, unemployedc: 0.20 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('rdp', c), party, c);
        }

        case 'cvp': {
            if (Q.cvp_banned) return 0;
            let cath_bonus = Q.catholics / 18;
            base = (rep * 1 + cath_bonus * 0.2) * im.cvp;
            base *= _partyAdj('cvp');
            base *= _campaignMult('cvp', c);
            const class_mods = { workers: 0.20, old_middle: 0.80, new_middle: 0.50, rural: 0.70, unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('cvp', c), party, c);
        }

        case 'lb': {
            if (Q.lb_banned) return 0;
            base = soc * 1.4 * (1 + unrest_soc_hybrid * 0.08) * im.lb;
            base *= _partyAdj('lb');
            base *= _campaignMult('lb', c);
            const class_mods = { workers: 0.55, old_middle: 0.10, new_middle: 0.20, rural: 0.10, unemployedc: 0.45 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('lb', c), party, c);
        }

       case 'dbp': {
    if (Q.dbp_banned) return 0;

    let rural_weight    = Q.rural / 70;  // slightly less rural-dependent than BB (Q.rural/60)
    let deflation_bonus = Q.inflation < 0 ? (1 + Math.abs(Q.inflation) * 0.06) : 1.0;
    let lib_bonus       = (rep * 0.45) + ((100 - Q.nationalism) / 100) * 0.15;

    base = (rep * 5.8 + nat * 1.6) * rural_weight * deflation_bonus * lib_bonus * (im.dbp || 1);
    base *= _partyAdj('dbp');
    base *= _campaignMult('dbp', c);

    const class_mods = {
        workers:     0.15,   
        old_middle:  0.35,   
        new_middle:  0.18,   
        rural:       2.20 * (Q.parties.includes('cnbl') && Q.year >= 1928 && Q.month >= 3 ? 1 : 1.35) * (Q.landvolk_fury > 0 ? (1 + Math.min(0.02 * (Math.pow(1.15, Q.landvolk_fury) - 1), 2) + Math.min(0.05 * (Math.pow(1.85, Q.landvolk_fury) - 1), 3)) : 1),
        unemployedc: 0.25,
    };
    return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('dbp', c), party, c);
}

    case 'faud': {
        if (Q.faud_banned) return 0;
        base = soc * 0.6 * (1 + unrest_soc_hybrid * 0.25) * im.kpd;
        base *= _partyAdj('faud');
        base *= _campaignMult('faud', c);

        const class_mods = {
            workers:     0.35 * (Q.unions_independent === 1 ? 1.5 : 1),
            old_middle:  0.01,
            new_middle:  0.02,
            rural:       0.02,
            unemployedc: 0.30,
        };
        return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('faud', c), party, c);
    }

    case 'kapd': {
        if (Q.kapd_banned) return 0;
        let buff = Q.april_challenge === 1 ? 1.10 : 0.85;
        base = soc * 1.6 * 1.4 * (1 + unrest_soc_hybrid * 0.18) * buff * im.kpd;
        base *= _partyAdj('kapd');
        base *= _campaignMult('kapd', c);

        const class_mods = {
            workers:     1.60 * (Q.peoples_party === 1 ? 1.05 : 1) * (Q.left_split === 1 ? 1.3 : 1),
            old_middle:  0.02,
            new_middle:  0.05,
            rural:       0.03,
            unemployedc: 1.35 * (Q.peoples_party === 1 ? 1.05 : 1),
        };
        return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('kapd', c), party, c);
    }

    case 'rlb': {
    if (Q.rlb_banned) return 0;
    let agrarian_crisis = Q.agri_price_collapse ? 1.5 : 1.0;
    base = (nat * 7 + rep * 4) * (Q.rural / 60) * agrarian_crisis * im.dnvp;
    base *= _partyAdj('rlb');
    base *= _campaignMult('rlb', c);

    const class_mods = {
        workers:     0.01,
        old_middle:  0.10,
        new_middle:  0.10,
        rural:       2.15 * (1 + Math.min(Q.nationalism/100,1)*0.35)
                     * (Q.parties.includes('dbp') ? 0.95 : 1)
                     * (Q.parties.includes('cnbl') ? 0.85 : 1),
        unemployedc: 0.10,
        };
    return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('rlb', c), party, c);
    }

    case 'uspd': {
            // Post-1922 rump USPD: most of the party either rejoined SPD or
            // merged into KPD in late 1920/1922. What remains is a marginal
            // left-socialist remnant — kept deliberately tiny.
            if (Q.uspd_banned) return 0;
            base = soc * 0.5 * (1 + unrest_soc_hybrid * 0.10) * im.bb;
            base *= _partyAdj('uspd');
            base *= _govEconMult('uspd'); // Behavior: refleft
            base *= _campaignMult('uspd', c);

            const class_mods = {
                workers:     0.45 * (Q.peoples_party === 1 ? 1.05 : 1),
                old_middle:  0.05,
                new_middle:  0.10,
                rural:       0.05,
                unemployedc: 0.35,
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('uspd', c), party, c);
        }

        case 'pp': {
            // Polish List (Polnische Liste) — ethnic-minority list, tightly
            // confined to Polish-speaking constituencies (Upper Silesia,
            // Posen border districts). Not meaningfully driven by the
            // national soc/rep/nat sliders; scaled by a flat regional base.
            if (Q.pp_banned) return 0;
            base = 1.2 * im.bb;
            base *= _partyAdj('pp');
            base *= _govEconMult('pp'); // Behavior: refleft
            base *= _campaignMult('pp', c);

            const class_mods = {
                workers:     0.60,
                old_middle:  0.35,
                new_middle:  0.20,
                rural:       1.10,
                unemployedc: 0.40,
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('pp', c), party, c);
        }

        case 'gsrn': {
            // National Bolshevist splinter (Paetel, 1930) — feeds off
            // NSDAP/Strasserist disillusionment (nsdap unrest) and off
            // socialist unrest generally, per the KPD "national liberation"
            // overtures of Aug 1930. Kept marginal (few hundred members
            // historically); mostly draws from young workers/new_middle.
            if (Q.gsrn_banned) return 0;

            const gsrn_unrest_points = _tickRevolutionaryUnrest('gsrn');
            const strasserist_bleed = (Q.nsdap_ideology === "National Socialism (Strasserism)") ? 0 : 1;

            base = (nat * 1.2 + soc * 1) * (1 + (gsrn_unrest_points / 20) * 1.2) * strasserist_bleed * im.bb;
            base *= _partyAdj('gsrn');
            base *= _govEconMult('gsrn'); // Behavior: revright
            base *= _campaignMult('gsrn', c);

            const class_mods = {
                workers:     0.55 * (Q.peoples_party === 1 ? 1.05 : 1),
                old_middle:  0.10,
                new_middle:  0.65,
                rural:       0.10,
                unemployedc: 0.30,
            };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('gsrn', c), party, c);
        }

        default: {
            if (Q.other_banned) return 0;
            base = (nat + rep) * 1.2 * im.other;
            base *= _partyAdj('other');
            base *= _campaignMult('other', c);
            const class_mods = { workers: 0.30, old_middle: 1.00, new_middle: 1.00, rural: 1.00, unemployedc: 0.30 };
            return _applyQOL(base * (class_mods[c] || 1.0) * _classAdj('other', c), party, c);
        }
    }
}




// ─────────────────────────────────────────
// SPEED COMPUTATION
// ─────────────────────────────────────────

function computeSpeed(party, c) {
    // Base speed per party archetype
    const base_speeds = {
        // Crisis-reactive — fast
        kapd:   0.25,
        nsdap:  0.18,
        dnf:    0.175,
        kpd:    0.17,
        sapd:   0.14,
        dvfp:   0.13,

        // Moderate reactive
        spd:    0.11,
        dnvp:   0.12,
        srpd:   0.10,
        csvd:   0.09,
        dvp:    0.09,
        ddp:    0.09,
        dsbp:   0.10,

        // Stable/structural
        z:      0.06,
        bvp:    0.06,
        cnbl:   0.07,
        wp:     0.07,
        kvp:    0.08,
        rlb:    0.075,

        // Very stable / niche
        dbp:    0.08,
        bb:     0.05,
        dhp:    0.05,
        sls:    0.04,
        csrp:   0.05,
        vrp:    0.06,
        dtsp:   0.10,
        rdp:    0.06,
        cvp:    0.06,
        lb:     0.07,
        aspd:   0.06,
        hl:     0.06,
        sl:     0.08,
        kpo:    0.08,
        vnr:    0.07,
        srpd:   0.09,
        other:  0.08,
        faud:   0.02,
        default: 0.07,
    };

    let speed = base_speeds[party] || base_speeds.default;

    // Centralized campaigning — additive speed bonus, driven by the
    // party's own campaign_focus/intensity meter (see _campaignSpeedBonus).
    speed += _campaignSpeedBonus(party, c);

    // Enemies modifier: suppressed parties move slower toward targeted classes
    const target_map = {
    'NSDAP': ['nsdap'],
    'KPD':   ['kpd'],
    'DNVP':  ['dnvp'],
    'DVP':   ['dvp'],
    'Z':     ['z'],
    'BVP':   ['bvp'],
    'WP':    ['wp'],
    'DDP':   ['ddp'],
    'SAPD':  ['sapd'],
    'CSVD':  ['csvd'],
    'CNBL':  ['cnbl'],
};

const enemy_vars = [Q.enemy_1, Q.enemy_2, Q.enemy_3].filter(Boolean);

if (enemy_vars.length > 0) {
    const worker_classes = ['workers', 'unemployedc'];

    // Collect all targeted parties, weighted by priority tier
    // Primary: full penalty | Secondary: reduced | Tertiary: minor
    const tier_multipliers = [0.78, 0.87, 0.93];

    let slowest_multiplier = 1.0;
    let spd_boost = 1.0;

    enemy_vars.forEach((enemy, tier) => {
        const targets = target_map[enemy] || [];
        if (targets.includes(party) && worker_classes.includes(c)) {
            // Take the strongest applicable penalty if a party appears somehow in multiple tiers
            slowest_multiplier = Math.min(slowest_multiplier, tier_multipliers[tier]);
        }
        if (party === 'spd' && targets.length > 0 && worker_classes.includes(c)) {
            // SPD boost also diminishes by tier: +8%, +5%, +3%
            spd_boost *= (tier === 0 ? 1.08 : tier === 1 ? 1.05 : 1.03);
        }
    });

    speed *= slowest_multiplier;
    if (party === 'spd') speed *= spd_boost;
}

return Math.min(speed, 0.40);

}


// ─────────────────────────────────────────
// EVENT NUDGE SYSTEM
// ─────────────────────────────────────────

Q.event_nudge = Q.event_nudge || {};

// Decay every existing nudge once per tick, before any new events add to it.
for (const _nk of Object.keys(Q.event_nudge)) {
    Q.event_nudge[_nk] *= 0.97;
    if (Math.abs(Q.event_nudge[_nk]) < 0.01) delete Q.event_nudge[_nk];
}

// Q.addEventNudge(c, party, amount) — call this from events instead of
// writing Q[c + '_' + party] directly. Stacks additively; persists and
// decays independently of computeTarget's output.
Q.addEventNudge = function(c, party, amount) {
    const k = c + '_' + party;
    Q.event_nudge[k] = (Q.event_nudge[k] || 0) + amount;
};

// Same idea for the class×identity cross-tab cells (workers_catholics_spd
// style keys), used later by the cell drift loop.
Q.event_nudge_cell = Q.event_nudge_cell || {};
for (const _nk of Object.keys(Q.event_nudge_cell)) {
    Q.event_nudge_cell[_nk] *= 0.97;
    if (Math.abs(Q.event_nudge_cell[_nk]) < 0.01) delete Q.event_nudge_cell[_nk];
}
Q.addEventNudgeCell = function(c, idn, party, amount) {
    const k = c + '_' + idn + '_' + party;
    Q.event_nudge_cell[k] = (Q.event_nudge_cell[k] || 0) + amount;
};



//// ─────────────────────────────────────────
// MAIN DRIFT LOOP
// ─────────────────────────────────────────

for (Q.c of Q.classes) {
    for (Q.party of Q.parties) {
        Q.base = Q[Q.c + '_' + Q.party] || 0;

        // === BANNED PARTY HANDLING ===
        const banned_flag = Q.party + '_banned';
        if (Q[banned_flag] && BANNED_REDISTRIBUTION[Q.party]) {
            if (Q.base > 0) {
                const routes = BANNED_REDISTRIBUTION[Q.party];
                for (let i = 0; i < routes.length; i++) {
                    const [target, share, condition] = routes[i];
                    if (condition()) {
                        Q[Q.c + '_' + target] += Q.base * share;
                    }
                }
            }
            Q[Q.c + '_' + Q.party] = 0;
            continue;
        }

        // === THERMOSTAT MOVE ===
        const event_bonus = Q.event_nudge[Q.c + '_' + Q.party] || 0;
        const target = computeTarget(Q.party, Q.c) + event_bonus;
        const speed  = computeSpeed(Q.party, Q.c);

        // Noise on the move itself, not the target
        // Slightly asymmetric: gains are noisier than losses (political momentum)
        const moving_up   = target > Q.base;
        const noise       = moving_up
            ? (0.80 + _r() * 0.45)   // 0.80–1.25 when gaining
            : (0.88 + _r() * 0.28);  // 0.88–1.16 when losing (stickier)

        Q[Q.c + '_' + Q.party] = Math.max(0,
            Q.base + (target - Q.base) * speed * noise
        );
    }
}


// ─────────────────────────────────────────
// NORMALIZATION
// ─────────────────────────────────────────

if (!Q.math_broken) {
    for (var c of Q.classes) {
        var class_votes = 0;
        for (var party of Q.parties) {
            class_votes += Q[c + '_' + party];
        }
        for (var party of Q.parties) {
            Q[c + '_' + party + '_normalized'] = class_votes > 0 ? Q[c + '_' + party] / class_votes : 0;
            Q[c + '_' + party + '_pct']        = Number((Q[c + '_' + party + '_normalized'] * 100).toFixed(1));
            Q[c + '_' + party + '_display']    = (Q[c + '_' + party + '_normalized'] * 100).toFixed(1);
        }
    }
} else {
    for (var c of Q.classes) {
        var class_votes = Q.impossible_add(0, 0);
        for (var party of Q.parties) {
            class_votes = Q.impossible_add(class_votes, Q[c + '_' + party]);
        }
        for (var party of Q.parties) {
            Q[c + '_' + party + '_normalized'] = Q.impossible_multiply(Q[c + '_' + party], 1 / class_votes);
            var _classPctStr = Q.impossible_percentage(Q[c + '_' + party + '_normalized'] * 100).toFixed(1);
            Q[c + '_' + party + '_pct']        = Number(_classPctStr);
            Q[c + '_' + party + '_display']    = _classPctStr;
        }
    }
}


// ============================================================
// CLASS×IDENTITY CROSS-TAB
// Identities form ON TOP OF classes: workers_catholics_spd, etc.
// Each (class, identity) pair gets its own raw vote pool per party,
// driven by the same computeTarget()/computeSpeed() thermostat as
// the class-only loop above, but with each party's target additionally
// crossed by Q.identity_mods[party][idn] (the identity's own affinity,
// isolated from buildIdentityModifier — see where Q.identity_mods is
// built, above the drift functions).
// ============================================================

Q.identities = Q.identities || ['catholics', 'protestants', 'seculars', 'youth'];

// --- Class lean coefficients ---
// The naive Q[c] * Q[idn] formula is scale-invariant in Q[c] (it cancels
// out of the ratio), so every class ended up with an identical identity
// composition — rural, workers, and new_middle all showing the exact same
// 20.7 / 63.4 / 3.9 / 12.0 split. That's not a real cross-tab, just the
// population-wide split copy-pasted per class.
//
// This table gives each class its own lean, multiplied against the
// population-wide Q[idn] share before normalizing. A lean of 1.0 means
// "matches the population average"; >1 skews the identity toward that
// class, <1 skews it away. Q[idn]'s own drift (secularization, youth
// radicalization, etc.) still moves every class's composition over time —
// this only sets the *relative* skew between classes, consistent with
// the setting (rural more religious/Protestant, workers/new_middle more
// secular and younger, old_middle the most religiously conventional).
Q.class_identity_lean = Q.class_identity_lean || {
    workers:     { catholics: 0.90, protestants: 0.95, seculars: 1.45, youth: 1.20 },
    old_middle:  { catholics: 1.05, protestants: 1.10, seculars: 0.55, youth: 0.75 },
    new_middle:  { catholics: 0.95, protestants: 1.00, seculars: 1.30, youth: 1.05 },
    rural:       { catholics: 1.10, protestants: 1.20, seculars: 0.25, youth: 0.85 },
    unemployedc: { catholics: 0.95, protestants: 0.95, seculars: 1.15, youth: 1.55 },
};

// --- Cell population shares: Q[idn] weighted by that class's lean,
//     renormalized so the 4 identity shares within each class sum to 100%.
Q.class_identity_share = Q.class_identity_share || {};

for (var c of Q.classes) {
    var _lean = Q.class_identity_lean[c] || {};
    var _raw = {};
    var _raw_total = 0;
    for (var idn of Q.identities) {
        var v = (Q[idn] || 0) * (_lean[idn] !== undefined ? _lean[idn] : 1.0);
        _raw[idn] = v;
        _raw_total += v;
    }
    Q.class_identity_share[c] = {};
    for (var idn of Q.identities) {
        Q.class_identity_share[c][idn] = _raw_total > 0 ? (_raw[idn] / _raw_total) * 100 : (100 / Q.identities.length);
    }
}

// --- Cell drift loop: same thermostat as the class-only loop, one level deeper.
if (!Q.math_broken) {
    for (var c of Q.classes) {
        for (var idn of Q.identities) {
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                var cbase = Q[ckey] || 0;

                // Banned party handling mirrors the class-only loop: zero out,
                // no redistribution logic duplicated here (class-level loop
                // already handles redistribution for the class as a whole).
                var banned_flag = party + '_banned';
                if (Q[banned_flag]) {
                    Q[ckey] = 0;
                    continue;
                }

                var class_target    = computeTarget(party, c);
            
                var identity_affinity = (Q.identity_mods[party] && Q.identity_mods[party][idn] !== undefined)
                ? Q.identity_mods[party][idn] : 1.0;
    
                var cell_event_bonus =
                      (Q.event_nudge[c + '_' + party] || 0)
                    + (Q.event_nudge_cell[c + '_' + idn + '_' + party] || 0);
                var cell_target = Math.max(0, class_target * identity_affinity + cell_event_bonus);
                var cell_speed       = computeSpeed(party, c);

                var moving_up = cell_target > cbase;
                var noise = moving_up
                    ? (0.80 + _r() * 0.45)
                    : (0.88 + _r() * 0.28);

                Q[ckey] = Math.max(0, cbase + (cell_target - cbase) * cell_speed * noise);
            }
        }
    }
} else {
    for (var c of Q.classes) {
        for (var idn of Q.identities) {
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                var cbase = Q.impossible_add(Q[ckey] || 0, 0);
                var class_target = computeTarget(party, c);
                // Same change as the normal-mode branch: identity no longer
                // biases the target, cell derives purely from the class calc.
                var cell_target = class_target;
                Q[ckey] = Q.impossible_add(cbase, Q.impossible_subtract(cell_target, cbase));
            }
        }
    }
}

// --- Cell normalization: within each (class, identity) pair, parties sum to 100%.
if (!Q.math_broken) {
    for (var c of Q.classes) {
        for (var idn of Q.identities) {
            var cell_votes = 0;
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                Q[ckey] = Math.max(0, Q[ckey] || 0);
                cell_votes += Q[ckey];
            }
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                Q[ckey + '_normalized'] = cell_votes > 0 ? Q[ckey] / cell_votes : 0;
                Q[ckey + '_pct']        = Number((Q[ckey + '_normalized'] * 100).toFixed(1));
                Q[ckey + '_display']    = (Q[ckey + '_normalized'] * 100).toFixed(1);
            }
        }
    }
} else {
    for (var c of Q.classes) {
        for (var idn of Q.identities) {
            var cell_votes = Q.impossible_add(0, 0);
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                cell_votes = Q.impossible_add(cell_votes, Q[ckey] || 0);
            }
            for (var party of Q.parties) {
                var ckey = c + '_' + idn + '_' + party;
                Q[ckey + '_normalized'] = Q.impossible_multiply(Q[ckey] || 0, 1 / cell_votes);
                var _cellPctStr = Q.impossible_percentage(Q[ckey + '_normalized'] * 100).toFixed(1);
                Q[ckey + '_pct']        = Number(_cellPctStr);
                Q[ckey + '_display']    = _cellPctStr;
            }
        }
    }
}



























































// === PARAMILITARY STRENGTH UPDATES ===

if (Q.nsdap_banned) {
    Q.sa_strength *= 0.99;
    Q.sa_militancy = Math.max(0, Q.sa_militancy - 0.0002);
} else {
    Q.sa_strength += Q.random_factor(Q.unrest_factor / 3, 0.3);
}

if (Q.dnvp_banned || Q.sh_banned) {
    Q.sh_strength *= 0.99;
    Q.sh_militancy = Math.max(0, Q.sh_militancy - 0.002);
} else {
    Q.sh_strength += Q.random_factor(Q.unrest_factor / 6, 0.3);
}

if (Q.rfb_banned && !Q.april_challenge) {
    Q.rfb_strength *= 0.99;
    Q.rfb_militancy = Math.max(0, Q.rfb_militancy - 0.005);
} else if (Q.rfb_true_ban && Q.april_challenge) {
    Q.rfb_strength *= 0.98;
    Q.rfb_militancy = Math.max(0, Q.rfb_militancy - 0.01);
} else {
    Q.rfb_strength += Q.random_factor(Q.unrest_factor / 5, 0.3);
}

if (Q.rb_banned) {
    Q.rb_strength *= 0.99;
    Q.rb_militancy = Math.max(0, Q.rfb_militancy - 0.0001);
} else {
    Q.rb_strength += Q.random_factor(Q.unrest_factor / 20, 0.3);
}

if (Q.jungdo_banned) {
    Q.jungdo_strength *= 0.99;
    Q.jungdo_militancy = Math.max(0, Q.rfb_militancy - 0.0001);
} else {
    Q.jungdo_strength += Q.random_factor(Q.new_middle/50 + Q.old_middle/100 + Q.nationalism/100, 0.3);
}

if (Q.ruhr_labor_strike == 1) {
    if (Q.ruhr_faud_banned) {
        Q.ruhr_faud_strength *= 0.99;
        Q.ruhr_faud_militancy = Math.max(0, Q.ruhr_faud_militancy - 0.00000005);
    } else {
        Q.ruhr_faud_strength += Q.random_factor(Q.unrest_factor / 5, 0.3);
    }

    if (Q.ruhr_kapd_banned) {
        Q.ruhr_kapd_strength *= 0.99;
        Q.ruhr_kapd_militancy = Math.max(0, Q.ruhr_kapd_militancy - 0.00000005);
    } else {
        Q.ruhr_kapd_strength += Q.random_factor(Q.unrest_factor / 8, 0.3);
    }
}


// Decay factors — FIXED
// stability_decay: only applies when things are genuinely calm (low unrest)
// Multiplier reduced from 10 → 2 so it doesn't obliterate growth
Q.stability_decay = Math.max(0, (0.4 - Q.unrest_factor)) * 2;

// prosperity_factor: INVERTED so economic collapse REDUCES decay instead of adding to it
// Previously this was always ~3-4 even in crisis — now crisis = near zero decay from this term
// Formula: high unemployment and inflation push this toward 0, stable economy pushes toward 1
Q.prosperity_factor = Math.max(0, Q.inflation / 100 + Q.unemployed / 50) * 1.5;
// This now reads: the worse the economy, the MORE this subtracts from decay pressure

// Combined decay = calm conditions + good economy both reduce paramilitaries
// Crisis conditions = both terms shrink toward 0, so decay is minimal
Q.combined_decay = Math.max(0, Q.stability_decay - Q.prosperity_factor);

// Apply natural decay
Q.sa_strength     -= Q.random_factor(Q.combined_decay, 0.25);
Q.sh_strength     -= Q.random_factor(Q.combined_decay, 0.25);
Q.rfb_strength    -= Q.random_factor(Q.combined_decay, 0.25);
Q.rb_strength     -= Q.random_factor(Q.combined_decay, 0.25);
Q.jungdo_strength -= Q.random_factor(Q.combined_decay, 0.25);

if (Q.ruhr_labor_strike == 1) {
    Q.ruhr_faud_strength -= Q.random_factor(Q.combined_decay, 0.25);
    Q.ruhr_kapd_strength -= Q.random_factor(Q.combined_decay, 0.25);
}

// Caps for RB.

if (Q.prussian_police_training < 1) {
    Q.rb_militancy = Math.min(Q.rb_militancy, 0.20); 
}


        // === PARAMILITARY CONSTRAINTS (SKIP IN CHAOS MODE) ===
    if (!Q.math_broken) {
        // NORMAL: Constrain paramilitary strength
        Q.sa_strength  = Math.min(Math.max(Q.sa_strength, 0), 10000);
        Q.sh_strength  = Math.min(Math.max(Q.sh_strength, 0), 10000);
        Q.rfb_strength = Math.min(Math.max(Q.rfb_strength, 0), 10000);
        Q.rb_strength  = Math.min(Math.max(Q.rb_strength, 0), 10000);
        Q.jungdo_strength  = Math.min(Math.max(Q.jungdo_strength, 0), 10000);
        if (Q.ruhr_labor_strike == 1) {
            Q.ruhr_faud_strength = Math.min(Math.max(Q.ruhr_faud_strength, 0), 10000);
            Q.ruhr_kapd_strength = Math.min(Math.max(Q.ruhr_kapd_strength, 0), 10000);
        }

        // Constrain militancy to 0.01 - 0.99999 (Reichswehr excluded)
        Q.sa_militancy     = Math.min(Math.max(Q.sa_militancy, 0.01), 0.99999);
        Q.sh_militancy     = Math.min(Math.max(Q.sh_militancy, 0.01), 0.99999);
        Q.rfb_militancy    = Math.min(Math.max(Q.rfb_militancy, 0.01), 0.99999);
        Q.rb_militancy     = Math.min(Math.max(Q.rb_militancy, 0.01), 0.99999);
        Q.jungdo_militancy = Math.min(Math.max(Q.jungdo_militancy, 0.01), 0.99999);
        if (Q.rpb_formed) {
            Q.rpb_militancy = Math.min(Math.max(Q.rpb_militancy, 0.01), 0.99999);
        }
        if (Q.ruhr_labor_strike == 1) {
            Q.ruhr_faud_militancy = Math.min(Math.max(Q.ruhr_faud_militancy, 0.01), 0.99999);
            Q.ruhr_kapd_militancy = Math.min(Math.max(Q.ruhr_kapd_militancy, 0.01), 0.99999);
        }
    } else {
        // MATH BROKEN: Paramilitary numbers can be anything
        Q.sa_strength = Q.impossible_add(Q.sa_strength, 0);
        Q.sh_strength = Q.impossible_multiply(Q.sh_strength, 1);
        Q.rfb_strength = Q.impossible_subtract(Q.rfb_strength, 0);
        Q.rb_strength = Q.impossible_percentage(Q.rb_strength / 100) * 100;
        Q.jungdo_strength = Q.impossible_add(Q.jungdo_strength, 0);
        if (Q.ruhr_labor_strike == 1) {
            Q.ruhr_faud_strength = Q.impossible_add(Q.ruhr_faud_strength, 0);
            Q.ruhr_kapd_strength = Q.impossible_multiply(Q.ruhr_kapd_strength, 1);
        }
    }










}












// === PARAMILITARY BALANCE OF POWER ===

// Gather all force strengths
const forces = {
    prussian_police:       Q.prussian_police_strength || 0,
    interior_police:       Q.interior_police_strength || 0,
    reichswehr:            Q.reichswehr_strength || 0,
    reichsbanner:          Q.rb_strength || 0,
    rpb:                   (Q.rpb_formed ? Q.rpb_strength || 0 : 0),
    jungdo:                Q.jungdo_strength || 0,
    rfb:                   Q.rfb_strength || 0,
    stahlhelm:             Q.sh_strength || 0,
    sa:                    Q.sa_strength || 0,
};

if (Q.ruhr_labor_strike == 1) {
    forces.ruhr_faud = Q.ruhr_faud_strength || 0;
    forces.ruhr_kapd = Q.ruhr_kapd_strength || 0;
}

// Militancy weights — raw strength alone isn't threat; multiply by militancy
const militancy_weights = {
    prussian_police:  (Q.prussian_police_loyalty || 50) / 100,
    interior_police:  (Q.interior_police_loyalty || 50) / 100,
    reichswehr:       (Q.reichswehr_militancy || 1) / 5,
    reichsbanner:     (Q.rb_militancy || 1) / 5,
    rpb:              (Q.rpb_militancy || 1) / 5,
    jungdo:           (Q.jungdo_militancy || 1) / 5,
    rfb:              (Q.rfb_militancy || 1) / 5,
    stahlhelm:        (Q.sh_militancy || 1) / 5,
    sa:               (Q.sa_militancy || 1) / 5,
};

if (Q.ruhr_labor_strike == 1) {
    militancy_weights.ruhr_faud = (Q.ruhr_faud_militancy || 1) / 5;
    militancy_weights.ruhr_kapd = (Q.ruhr_kapd_militancy || 1) / 5;
}

// Effective strength = raw * militancy weight
let total_effective = 0;
const effective = {};
for (const [key, raw] of Object.entries(forces)) {
    effective[key] = raw * (militancy_weights[key] || 1);
    total_effective += effective[key];
}

// Normalize to percentages
const para_share = {};
if (!Q.math_broken) {
    for (const [key, eff] of Object.entries(effective)) {
        para_share[key] = total_effective > 0
            ? Math.round((eff / total_effective) * 1000) / 10
            : 0;
    }
} else {
    for (const [key, eff] of Object.entries(effective)) {
        para_share[key] = total_effective > 0
            ? Q.impossible_percentage(Math.round((eff / total_effective) * 1000) / 10)
            : Q.impossible_add(0, 0);
    }
    console.log("PARA CHAOS: SA=" + para_share.sa + "% RFB=" + para_share.rfb + "% Total=" +
        Object.values(para_share).reduce((a, b) => a + b, 0) + "%");
}

// Write back to Q
Q.para_share_prussian_police  = para_share.prussian_police;
Q.para_share_interior_police  = para_share.interior_police;
Q.para_share_reichswehr       = para_share.reichswehr;
Q.para_share_reichsbanner     = para_share.reichsbanner;
Q.para_share_rpb              = para_share.rpb;
Q.para_share_jungdo           = para_share.jungdo;
Q.para_share_rfb              = para_share.rfb;
Q.para_share_stahlhelm        = para_share.stahlhelm;
Q.para_share_sa               = para_share.sa;

if (Q.ruhr_labor_strike == 1) {
    Q.para_share_ruhr_faud = para_share.ruhr_faud;
    Q.para_share_ruhr_kapd = para_share.ruhr_kapd;
}

//// Faction blocs
if (Q.april_challenge === 1 && Q.year >= 1933 && Q.month >= 10) {
    Q.para_bloc_pro_republic =
        para_share.prussian_police +
        para_share.interior_police +
        para_share.rpb +
        para_share.jungdo +
        para_share.stahlhelm;

    Q.para_bloc_left =
        para_share.rfb +
        para_share.reichsbanner +
        (Q.ruhr_labor_strike == 1 ? (para_share.ruhr_faud + para_share.ruhr_kapd) : 0);

    Q.para_bloc_right    = para_share.sa;
    Q.para_bloc_military = para_share.reichswehr;
} else {
    Q.para_bloc_pro_republic =
        para_share.prussian_police +
        para_share.interior_police +
        para_share.reichsbanner +
        para_share.rpb +
        para_share.jungdo;

    Q.para_bloc_left     = para_share.rfb +
        (Q.ruhr_labor_strike == 1 ? (para_share.ruhr_faud + para_share.ruhr_kapd) : 0);
    Q.para_bloc_right    = para_share.stahlhelm + para_share.sa;
    Q.para_bloc_military = para_share.reichswehr;
}
















Q.has_event = 0;
// check if there are any cards in #event, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
} else {
    Q.has_event = 0;
}
// pre-load all of the event images
if (this.ui && this.ui.show_portraits) {
    for (var choice of choices) {
        var cc = this.game.scenes[choice.id];
        if (cc.faceImage) {
            var im = new Image();
            im.onload = function(){};
            im.src = cc.faceImage;
        }
    }
}








 
// === EARLY BOUNDS CHECKING (SKIP IN CHAOS MODE) ===
if (!Q.math_broken) {
    Q.pro_republic = Math.round(Q.pro_republic * 10) / 10;
    Q.nationalism  = Math.round(Q.nationalism  * 10) / 10;
    Q.socialism    = Math.round(Q.socialism    * 10) / 10;

    Q.pro_republic = Math.max(0.1, Math.min(99.9, Q.pro_republic));
    Q.nationalism  = Math.max(0.1, Math.min(99.9, Q.nationalism));
    Q.socialism    = Math.max(0.1, Math.min(99.9, Q.socialism));
} else {
    // MATH BROKEN: Political values can be anything
    Q.pro_republic = Q.impossible_add(Q.pro_republic, 0);
    Q.nationalism  = Q.impossible_multiply(Q.nationalism, 1);
    Q.socialism    = Q.impossible_subtract(Q.socialism, 0);
}

// === IDEOLOGICAL NORMALIZATION (SKIP IN CHAOS MODE) ===
let ideologies = ['pro_republic', 'socialism', 'nationalism'];

if (!Q.math_broken) {
    // NORMAL: Ideologies sum to 200
    let total = 0;
    for (let ideology of ideologies) {
        total += Q[ideology];
    }
    let factor = 100 / total;
    for (let ideology of ideologies) {
        Q[ideology] = Math.round(Q[ideology] * factor * 10) / 10;
    }
} else {
    // MATH BROKEN: Ideologies don't normalize
    for (let ideology of ideologies) {
        Q[ideology] = Q.impossible_percentage(Q[ideology]);
    }
    console.log("IDEOLOGY CHAOS: Total = " + (Q.pro_republic + Q.socialism + Q.nationalism));
}

// === FACTION BOUNDS (SKIP IN CHAOS MODE) ===
if (!Q.math_broken) {
    for (var c of Q.factions) {
        if (Q[c+'_dissent'] < 0) {
            Q[c+'_dissent'] = 0;
        } else if (Q[c+'_dissent'] >= 100) {
            Q[c+'_dissent'] = 99;
        }
        if (Q[c+'_strength'] < 0) {
            Q[c+'_strength'] = 0;
        }
    }
} else {
    // MATH BROKEN: Factions can have impossible values
    for (var c of Q.factions) {
        Q[c+'_dissent'] = Q.impossible_percentage(Q[c+'_dissent']);
        Q[c+'_strength'] = Q.impossible_add(Q[c+'_strength'], 0);
    }
}

// === UNEMPLOYMENT FLOOR (SKIP IN CHAOS MODE) ===
if (!Q.math_broken) {
    if (Q.unemployed <= 1) {
        Q.unemployed = 1;
    }
    Q.unemployedc = Math.max(2, 10 + (Q.unemployed - 8) * 0.55);
} else {
    Q.unemployed = Q.impossible_add(Q.unemployed, 0);
}

// === CLASS NORMALIZATION (SKIP IN CHAOS MODE) ===
let classes = ['workers', 'old_middle', 'new_middle', 'rural', 'unemployedc'];

if (!Q.math_broken) {
    // NORMAL: Classes sum to 100%
    let total = 0;
    for (let c of classes) {
        total += Q[c];
    }
    let factor = 100 / total;
    for (let c of classes) {
        Q[c] = +(Q[c] * factor).toFixed(2);
    }
} else {
    // MATH BROKEN: Classes don't normalize
    // Apply impossible math to each class
    for (let c of classes) {
        Q[c] = Q.impossible_percentage(Q[c]);
    }
    // Total will NOT equal 100
    console.log("CLASS CHAOS: Total = " + (Q.workers + Q.old_middle + Q.new_middle + Q.rural + Q.unemployedc) + "%");
}

// After this, sum of Q.workers + Q.old_middle + ... + Q.catholics === 100




// === IDENTITY CLASS NORMALIZATION (SKIP IN CHAOS MODE) ===
let classesI = ['protestants', 'catholics', 'seculars', 'youth'];

if (!Q.math_broken) {
    // NORMAL: ClassesI sum to 100%
    let totalI = 0;
    for (let c of classesI) {
        totalI += Q[c];
    }
    let factor = 100 / totalI;
    for (let c of classesI) {
        Q[c] = +(Q[c] * factor).toFixed(2);
    }
} else {
    // MATH BROKEN: Classes don't normalize
    // Apply impossible math to each class
    for (let c of classesI) {
        Q[c] = Q.impossible_percentage(Q[c]);
    }
    }




// === CLASS VOTE NORMALIZATION (SKIP IN CHAOS MODE) ===
if (!Q.math_broken) {
    // NORMAL: Class votes normalize to 100%
    for (var c of Q.classes) {
        let class_votes = 0;

        for (var party of Q.parties) {
            Q[c + '_' + party] = Math.max(0, Q[c + '_' + party]);
            class_votes += Q[c + '_' + party];
        }

        for (var party of Q.parties) {
            Q[c + '_' + party + '_normalized'] = class_votes > 0 ? Q[c + '_' + party] / class_votes : 0;
            Q[c + '_' + party + '_display'] = (Q[c + '_' + party + '_normalized'] * 100).toFixed(1);
        }
    }
} else {
    // MATH BROKEN: Class votes don't normalize
    for (var c of Q.classes) {
        let class_votes = Q.impossible_add(0, 0); // "Zero" that isn't zero

        for (var party of Q.parties) {
            Q[c + '_' + party] = Q.impossible_add(Q[c + '_' + party], 0); // Can go negative
            class_votes = Q.impossible_add(class_votes, Q[c + '_' + party]);
        }

        for (var party of Q.parties) {
            // Division that doesn't work properly
            if (Math.random() < 0.5) {
                Q[c + '_' + party + '_normalized'] = Q.impossible_multiply(Q[c + '_' + party], 1/class_votes);
            } else {
                Q[c + '_' + party + '_normalized'] = Q.impossible_subtract(Q[c + '_' + party], -class_votes);
            }
            Q[c + '_' + party + '_display'] = Q.impossible_percentage(Q[c + '_' + party + '_normalized'] * 100).toFixed(1);
        }
    }
}





// ============================================================
// IDENTITY (SOCIAL GROUP) DISPLAY EXTRACTION — post-computation
// Re-runs buildIdentityModifier() with each identity isolated
// (the other three shares zeroed) to read off that identity's
// own contribution to im.<party>, with no separate coefficient
// table to fall out of sync. Any future edit to
// buildIdentityModifier automatically propagates here.
// ============================================================

Q.identities = Q.identities || ['catholics', 'protestants', 'seculars', 'youth'];

var isolated_im = {
    catholics:   buildIdentityModifier(cath_share, 0, 0, 0),
    protestants: buildIdentityModifier(0, prot_share, 0, 0),
    seculars:    buildIdentityModifier(0, 0, sec_share, 0),
    youth:       buildIdentityModifier(0, 0, 0, youth_share),
};

if (!Q.math_broken) {
    for (var idn of Q.identities) {
        var id_votes = 0;
        var im_iso   = isolated_im[idn];

        for (var party of Q.parties) {
            var ikey       = idn + '_' + party;
            var aff_mult   = (im_iso[party] !== undefined) ? im_iso[party] : 1.0;
            var base_share = Q[party + '_normalized'] || 0;
            var id_target  = Math.max(0, base_share * aff_mult);

            Q[ikey] = (Q[ikey] !== undefined) ? Q[ikey] : id_target;
            Q[ikey] = Q[ikey] + (id_target - Q[ikey]) * 0.20;
            Q[ikey] = Math.max(0, Q[ikey]);

            id_votes += Q[ikey];
        }

        for (var party of Q.parties) {
            var ikey = idn + '_' + party;
            Q[ikey + '_normalized'] = id_votes > 0 ? Q[ikey] / id_votes : 0;
            Q[ikey + '_display']    = (Q[ikey + '_normalized'] * 100).toFixed(1);
        }
    }
} else {
    for (var idn of Q.identities) {
        var id_votes = Q.impossible_add(0, 0);
        for (var party of Q.parties) {
            var ikey = idn + '_' + party;
            Q[ikey] = Q.impossible_add(Q[ikey] || 0, 0);
            id_votes = Q.impossible_add(id_votes, Q[ikey]);
        }
        for (var party of Q.parties) {
            var ikey = idn + '_' + party;
            Q[ikey + '_normalized'] = Q.impossible_multiply(Q[ikey], 1 / id_votes);
            Q[ikey + '_display']    = Q.impossible_percentage(Q[ikey + '_normalized'] * 100).toFixed(1);
        }
    }
}





// === PARTY SUPPORT CALCULATION (SKIP IN CHAOS MODE) ===
// Identities form ON TOP OF classes: party_support is now the sum over
// every (class, identity) cell of
//   class_share[c] × (class_identity_share[c][idn] / 100) × cell_normalized
// i.e. "what fraction of the population is in this class AND this identity,
// times how that cell votes for this party." No separate class-only or
// identity-only blend remains — cells are the sole mechanism.
if (!Q.math_broken) {
    var total_support = 0;
    for (var party of Q.parties) {
        let party_support = 0;
        for (var c of Q.classes) {
            var c_share = Q[c] || 0;
            for (var idn of Q.identities) {
                var idn_share_within_c = (Q.class_identity_share[c] && Q.class_identity_share[c][idn] !== undefined)
                    ? Q.class_identity_share[c][idn] / 100 : 0;
                var ckey = c + '_' + idn + '_' + party;
                var cell_pct = Q[ckey + '_normalized'] || 0;
                party_support += c_share * idn_share_within_c * cell_pct;
            }
        }
        Q[party + '_support'] = party_support;
        total_support += party_support;
    }
} else {
    // MATH BROKEN: Party support calculation is nonsense
    var total_support = Q.impossible_add(0, 0);
    for (var party of Q.parties) {
        let party_support = Q.impossible_multiply(0, 1);
        for (var c of Q.classes) {
            var c_share = Q[c] || 0;
            for (var idn of Q.identities) {
                var idn_share_within_c = (Q.class_identity_share[c] && Q.class_identity_share[c][idn] !== undefined)
                    ? Q.class_identity_share[c][idn] / 100 : 0;
                var ckey = c + '_' + idn + '_' + party;
                var cell_pct = Q[ckey + '_normalized'] || 0;
                party_support = Q.impossible_add(party_support,
                    Q.impossible_multiply(Q.impossible_multiply(c_share, idn_share_within_c), cell_pct));
            }
        }
        Q[party + '_support'] = party_support;
        total_support = Q.impossible_add(total_support, party_support);
    }
    console.log("PARTY CHAOS: Total support = " + total_support);
}




// === PARTY VOTE NORMALIZATION (SKIP IN CHAOS MODE) ===
if (!Q.math_broken) {
    // NORMAL: Parties normalize to 100%
    for (var party of Q.parties) {
        Q[party + '_normalized'] = total_support > 0 ? Q[party + '_support'] / total_support : 0;
        Q[party + '_votes'] = Math.round(Q[party + '_normalized'] * 1000) / 10;
        Q[party + '_pct'] = Q[party + '_votes'];
    }
} else {
    // MATH BROKEN: Parties don't normalize
    for (var party of Q.parties) {
        Q[party + '_normalized'] = Q.impossible_multiply(Q[party + '_support'], 1/total_support);
        Q[party + '_votes'] = Q.impossible_percentage(Q[party + '_normalized'] * 100);
        Q[party + '_pct'] = Q[party + '_votes'];
    }
    console.log("VOTE CHAOS: SPD = " + Q.spd_votes + "%, NSDAP = " + Q.nsdap_votes + "%");
}

