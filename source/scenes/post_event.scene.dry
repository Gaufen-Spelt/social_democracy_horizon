Q.presidential_patience = Math.max(0, Math.min(100, Q.presidential_patience));

Q.sa_strength     = Math.max(0, Math.min(10000, Q.sa_strength));
Q.sh_strength     = Math.max(0, Math.min(10000, Q.sh_strength));
Q.rfb_strength    = Math.max(0, Math.min(10000, Q.rfb_strength));
Q.rb_strength     = Math.max(0, Math.min(10000, Q.rb_strength));
Q.jungdo_strength = Math.max(0, Math.min(10000, Q.jungdo_strength));
if (Q.ruhr_labor_strike == 1) {
    Q.ruhr_faud_strength = Math.max(0, Math.min(10000, Q.ruhr_faud_strength));
    Q.ruhr_kapd_strength = Math.max(0, Math.min(10000, Q.ruhr_kapd_strength));
}

Q.sa_militancy     = Math.max(0.01, Math.min(0.99999, Q.sa_militancy));
Q.sh_militancy     = Math.max(0.01, Math.min(0.99999, Q.sh_militancy));
Q.rfb_militancy    = Math.max(0.01, Math.min(0.99999, Q.rfb_militancy));
Q.rb_militancy     = Math.max(0.01, Math.min(0.99999, Q.rb_militancy));
Q.jungdo_militancy = Math.max(0.01, Math.min(0.99999, Q.jungdo_militancy));
if (Q.rpb_formed) {
    Q.rpb_militancy = Math.max(0.01, Math.min(0.99999, Q.rpb_militancy));
}
if (Q.ruhr_labor_strike == 1) {
    Q.ruhr_faud_militancy = Math.max(0.01, Math.min(0.99999, Q.ruhr_faud_militancy));
    Q.ruhr_kapd_militancy = Math.max(0.01, Math.min(0.99999, Q.ruhr_kapd_militancy));
}

// Party relations: clamp every tracked party's relation value
for (var i = 0; i < Q.parties.length; i++) {
    var _relParty = Q.parties[i];
    if (Q[_relParty + '_relation'] !== undefined) {
        Q[_relParty + '_relation'] = Math.max(-100, Math.min(100, Q[_relParty + '_relation']));
    }
}

// Faction dissent/strength: clamp every tracked faction
if (Q.factions) {
    for (var i = 0; i < Q.factions.length; i++) {
        var _facKey = Q.factions[i];
        if (Q[_facKey + '_dissent'] < 0) {
            Q[_facKey + '_dissent'] = 0;
        } else if (Q[_facKey + '_dissent'] >= 100) {
            Q[_facKey + '_dissent'] = 99;
        }
        if (Q[_facKey + '_strength'] < 0) {
            Q[_facKey + '_strength'] = 0;
        }
    }
}

if (Q.revolutionary_unrest_points) {
    for (var _rup in Q.revolutionary_unrest_points) {
        Q.revolutionary_unrest_points[_rup] = Math.max(0, Math.min(20, Q.revolutionary_unrest_points[_rup]));
    }
}

//               HOME TO ALL CONSTRAINTS OF THE VALUES HERE, OKAY.

// ============================================================
// VARIABLE RANGE CAPPING
// ============================================================

Q.capped_var_ranges = {
    // 0 to 10
    pro_consumer:              [0, 10],
    agricultural_finance:      [0, 10],
    land_reform:               [0, 10],
    socialization:             [0, 10],
    commonwealth_cooperation:  [0, 10],
    cooperatives:              [0, 10],
    economic_democracy:        [0, 20],
    workers_safety:            [0, 10],
    working_hours:             [0, 10],
    womens_rights:             [0, 10],

    // -10 to 10
    welfare:                   [-10, 10],
    judicial_reform:           [-10, 10],
    pacifism:                  [-10, 10],
    radicalization:            [-10, 10],
    democratization:           [-10, 10],

    // -1 to 2
    confronting_antisemitism:  [-1, 2],

    // 0 to 15
    workers_aid:               [-5, 15],
    campaign_media:            [-5, 15],
    commercialized_media:      [-5, 15],
    cultural_organizations:    [-5, 15],
    wtb_support:               [-5, 15],
    local_rally:               [-5, 15],
    peoples_party_support:     [0, 15]
};

Q.apply_var_caps = function() {
    for (var varName in Q.capped_var_ranges) {
        if (!Q.capped_var_ranges.hasOwnProperty(varName)) continue;
        if (Q[varName] === undefined) continue; // skip vars not in use

        var range = Q.capped_var_ranges[varName];
        var min = range[0];
        var max = range[1];

        if (Q[varName] < min) {
            Q[varName] = min;
        } else if (Q[varName] > max) {
            Q[varName] = max;
        }
    }
};

Q.apply_var_caps();


{
    const _dnvp_total_cap = 1000;
    const _dnvp_tracked = [
        'hugenberg_momentum',
        'delegate_power_moderates',
        'delegate_power_nat_cons',
        'delegate_power_agrarians',
        'delegate_power_yocon',
        'delegate_power_christsoc'
    ];

    const _dnvp_sum = _dnvp_tracked.reduce((sum, key) => sum + (Q[key] || 0), 0);

    if (_dnvp_sum > _dnvp_total_cap) {
        const _dnvp_scale = _dnvp_total_cap / _dnvp_sum;
        _dnvp_tracked.forEach(key => {
            Q[key] *= _dnvp_scale;
        });
        Q.delegate_power_traditionalists =
            Q.delegate_power_moderates + Q.delegate_power_nat_cons + Q.delegate_power_agrarians;
    }
}


