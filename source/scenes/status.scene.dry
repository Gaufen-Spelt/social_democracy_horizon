title: Status
new-page: true
is-special: true
on-arrival: {!
const inGov = Object.keys(Q)
  .filter(key => key.endsWith("_in_government") && Q[key] == 1)
  .map(key => key.replace("_in_government", "").toUpperCase());

Q.parties_in_government_display = inGov.length > 0
  ? inGov.join(", ")
  : "None";

var tolDisplay = (Q.tolerating_parties && Q.tolerating_parties.length > 0)
  ? Q.tolerating_parties.map(function(p){ return p.toUpperCase(); }).join(", ")
  : "None";
Q.tolerating_parties_display = tolDisplay;

if (Q.peoples_party >= 1) {
    Q.spd_status = "Broad People's Party";
} else {
    Q.spd_status = "Worker's Party";
}
!}

<hr>
= Status
<hr>

[+ weeks: monther +], [+ month : month +] [+ year +]

[? if ruhr_labor_strike: <span style="color: #dc143c;">  Ruhr is under the labor strike! </span> ?]

Next election: [+ next_election_month : month +] [+ next_election_year +]

Next presidential election: [+ next_presidential_election_month : month +] [+ next_presidential_election_year +]

<hr>
= Government
<hr>

President: [+ president +] ([+ president_party +])

[+ president +]' patience: [+ presidential_patience +]

Chancellor: [+ chancellor +] ([+ chancellor_party +])

Prussian Minister-President: [+ ministerpresident +] ([+ mp_party_prussia +]) ([+ coalition_name_prussia +])

Coalition in government: [+ coalition_name +] ([+ parties_in_government_display +])

[? if tolerating_parties_display != "None" : Tolerated by: [+ tolerating_parties_display +] ?]

Government coalition votes: [+ government_total_votes +][? if tolerating_parties_display != "None" :  ([+ government_effective_pct +] effective with toleration) ?]

Budget: [+ budget +]

= Other Positions

Reichsbank President: [+ reichsbank_president +]

Reichstag President: [+ reichstag_president +]

<hr>
= SPD
<hr>

SPD Leadership: [+ spd_party_leader +]

SPD position: [? if spd_toleration : toleration ?][? if spd_in_government : in government - ?][? if spd_toleration == 0 and spd_in_government == 0 and spd_caretaker == 0 : opposition ?][? if spd_caretaker : caretaker government ?]
[? if in_weimar_coalition and spd_in_government: Weimar Coalition ?][? if in_grand_coalition and spd_in_government: Grand Coalition ?][? if in_popular_front and spd_in_government: Popular Front ?][? if in_left_front and spd_in_government: Left Front ?][? if in_spd_majority and spd_in_government: SPD majority ?][? if in_minority_government and spd_in_government: minority government ?][? if in_emergency_government and spd_in_government: emergency government ?]

SPD's stance: [+ spd_status +]
<br> SPD's ideology: [+ spd_ideology +]

Resources available: [+ resources +]

@politics
on-arrival: {!
Q.pro_republic_disp = Q.pro_republic;
Q.nationalism_disp = Q.nationalism;
Q.socialism_disp = Q.socialism;
Q.pacifism_disp = Q.pacifism;
Q.democratization_disp = Q.democratization;
Q.radicalization_disp = Q.radicalization;

var partyNameOverrideIdeology = {
    ddp: 'Q.ddp_name'
};

var partyNameOverrideRelations = {
    ddp: Q.ddp_name || 'DDP',
    dsbp: Q.dsbp_name
};

function partyLabelIdeology(p) {
    if (partyNameOverrideIdeology.hasOwnProperty(p)) return partyNameOverrideIdeology[p];
    return p.toUpperCase();
}

function partyLabelRelations(p) {
    if (partyNameOverrideRelations.hasOwnProperty(p)) return partyNameOverrideRelations[p];
    return p.toUpperCase();
}

function formatRelationship(val) {
    if (val < 5) return "hostile";
    if (val < 14.9) return "frigid";
    if (val < 29.9) return "cold";
    if (val < 39.9) return "cool";
    if (val < 54.9) return "neutral";
    if (val < 64.9) return "warm";
    if (val < 74.9) return "friendly";
    return "very friendly";
}

var ideologyHtml = "";
for (var i = 0; i < Q.parties.length; i++) {
    var p = Q.parties[i];
    if (p === 'other' || p === 'spd') continue;
    var votes = Q[p + '_votes'];
    if (votes !== undefined && votes > 1) {
        var ideology = Q[p + '_ideology'];
        var leader = Q[p + '_party_leader'];
        var label = partyLabelIdeology(p);

        ideologyHtml += label + " Ideology: " + ideology + "<br>" +
                         label + " Leadership: " + leader + "<br>";

        var behaviorName = Q[p + '_behavior_name'];
        if (behaviorName) {
            ideologyHtml += label + " Behavior: " + behaviorName + "<br>";
        }

        if (votes > 0) {
            var relLabel = partyLabelRelations(p);
            var rawVal = Q[p + '_relation'];
            var formatted = formatRelationship(rawVal);
            ideologyHtml += relLabel + " Relation: " + formatted +
                             (Q.deterministic_mode == 1 ? " " + rawVal : "") + "<br>";
        }

        ideologyHtml += "<br>";
    }
}
Q.party_ideology_leadership_html = ideologyHtml;
!}

<hr>
= Parties
<hr>

[+ party_ideology_leadership_html +]

<hr>
= Internal Factions of the SPD
<hr>

Internal dissent: [+ dissent_percent : dissent +] [? if deterministic_mode == 1: [+ dissent_percent +] ?]

{!<span class="tooltip-text" title="The Left is interested in radical, transformative policies and cooperation with the KPD.">Klassenkampf Linke</span>!} strength: [+ left_strength : strength +] [? if deterministic_mode == 1: [+ left_strength +] ?], dissent: [+ left_dissent : dissent +] [? if deterministic_mode == 1: [+ left_dissent +] ?] [? if left_split: Leftists have defected from our party! ?]

{!<span class="tooltip-text" title="The Center is a faction of Center Marxists, between reform and revolution.">Materialist / Center Marxists</span>!} strength: [+ center_strength : strength +] [? if deterministic_mode == 1: [+ center_strength +] ?], dissent: [+ center_dissent : dissent +] [? if deterministic_mode == 1: [+ center_dissent +] ?] [? if centrists_resign: "Center Marxists have defected from our party! ?]

{!<span class="tooltip-text" title="Labor's goal is economic reform and benefits for organized workers."> Arbeitergewerkschaft </span>!} strength: [+ labor_strength : strength +] [? if deterministic_mode == 1: [+ labor_strength +] ?], dissent: [+ labor_dissent : dissent +] [? if deterministic_mode == 1: [+ labor_dissent +] ?] [? if unions_independent: Unions have defected from our party! ?]

{!<span class="tooltip-text" title="Reformists are pragmatic participants in government, and seek to expand the welfare state and defend democracy."> Reformist / Evolutionary Socialists </span>!} strength: [+ reformist_strength : strength +] [? if deterministic_mode == 1: [+ reformist_strength +] ?], dissent: [+ reformist_dissent : dissent +] [? if deterministic_mode == 1: [+ reformist_dissent +] ?] [? if reformists_resign: Reformists have defected from our party! ?]

[? if neorevisionism > 0 : Neorevisionist / Militant Democrats strength: [+ neorevisionist_strength : strength +] [? if deterministic_mode == 1: [+ neorevisionist_strength +] ?], dissent: [+ neorevisionist_dissent : dissent +] [? if deterministic_mode == 1: [+ neorevisionist_dissent +] ?] ?] [? if neorevisionism > 0 and neorev_split: Neorevisionists have defected from our party! ?]

<hr>
= National Sentiment
<hr>

Support for the Republic: [+ pro_republic_disp +]%

Support for the Nationalism: [+ nationalism_disp +]%

Support for the Socialism: [+ socialism_disp +]%

Support of the Pacifism: [+ pacifism_disp +]%

Support of the Democratization: [+ democratization_disp +]%   -   Support of the radicalization: [+ radicalization_disp +]


@paramilitaries
on-arrival: {!

// ---------- helpers ----------

function militancyLabel(v) {
    if (v === undefined || v === null) return "Nonexistent";
    if (v < 0.05) return "Nonexistent";
    if (v < 0.14) return "Very low";
    if (v < 0.24) return "Low";
    if (v < 0.44) return "Medium-low";
    if (v < 0.69) return "Medium";
    if (v < 1.0)  return "High";
    return "Very high";
}

function fmtStrength(v) {
    return (v || 0).toFixed(1);
}

function fmtPct(v) {
    return (v || 0).toFixed(1);
}

// ---------- 1. define active forces ----------

var forces = [];

forces.push({
    key: "reichsbanner",
    name: "Reichsbanner",
    strength: Q.rb_strength || 0,
    militancy: Q.rb_militancy || 0,
    bloc: function() {
        if (Q.april_challenge == 1 && Q.year >= 1933 && Q.month >= 10) return "left";
        return "republic";
    }
});

forces.push({
    key: "jungdo",
    name: "Young German Order",
    strength: Q.jungdo_strength || 0,
    militancy: Q.jungdo_militancy || 0,
    bloc: function() { return "republic"; }
});

if (Q.rpb_formed) {
    forces.push({
        key: "rpb",
        name: "RPB",
        strength: Q.rpb_strength || 0,
        militancy: Q.rpb_militancy || 0,
        bloc: function() { return "republic"; }
    });
}

forces.push({
    key: "rfb",
    name: "RFB",
    strength: Q.rfb_strength || 0,
    militancy: Q.rfb_militancy || 0,
    bloc: function() { return "left"; }
});

forces.push({
    key: "stahlhelm",
    name: "Stahlhelm",
    strength: Q.sh_strength || 0,
    militancy: Q.sh_militancy || 0,
    bloc: function() {
        if (Q.april_challenge == 1 && Q.year >= 1933 && Q.month >= 10) return "republic";
        if (Q.rb_sh_front) return "republic";
        return "right";
    }
});

forces.push({
    key: "sa",
    name: "SA",
    strength: Q.sa_strength || 0,
    militancy: Q.sa_militancy || 0,
    bloc: function() { return "right"; }
});

if (Q.ruhr_labor_strike == 1) {
    forces.push({
        key: "ruhr_faud",
        name: "FAUD",
        strength: Q.ruhr_faud_strength || 0,
        militancy: Q.ruhr_faud_militancy || 0,
        bloc: function() { return "left"; }
    });
    forces.push({
        key: "ruhr_kapd",
        name: "KAPD",
        strength: Q.ruhr_kapd_strength || 0,
        militancy: Q.ruhr_kapd_militancy || 0,
        bloc: function() { return "left"; }
    });
}

forces.push({
    key: "prussian_police",
    name: "Prussian Police",
    strength: Q.prussian_police_strength || 0,
    militancy: (Q.prussian_police_loyalty || 0) / 100,
    isPolice: true,
    bloc: function() { return "republic"; }
});

if (Q.spd_in_government) {
    forces.push({
        key: "interior_police",
        name: "Interior Police",
        strength: Q.interior_police_strength || 0,
        militancy: (Q.interior_police_loyalty || 0) / 100,
        isPolice: true,
        bloc: function() { return "republic"; }
    });
}

var reichswehr = {
    key: "reichswehr",
    name: "Reichswehr",
    strength: Q.reichswehr_strength || 0,
    militancy: (Q.reichswehr_militancy || 0),
    loyalty: Q.reichswehr_loyalty || 0
};

// ---------- 2. compute effective (militancy-weighted) shares ----------

var total_effective = reichswehr.strength * (reichswehr.militancy / 5 || 0.2);
for (var i = 0; i < forces.length; i++) {
    var f = forces[i];
    var weight = f.isPolice ? f.militancy : (f.militancy / 5);
    f.effective = f.strength * weight;
    total_effective += f.effective;
}

function shareOf(effective) {
    return total_effective > 0 ? (effective / total_effective) * 100 : 0;
}

reichswehr.share = shareOf(reichswehr.strength * (reichswehr.militancy / 5 || 0.2));

var blocTotals = { republic: 0, left: 0, right: 0 };
for (var i = 0; i < forces.length; i++) {
    var f = forces[i];
    f.share = shareOf(f.effective);
    f.blocKey = f.bloc();
    blocTotals[f.blocKey] += f.share;
}

Q.para_bloc_pro_republic = Math.round(blocTotals.republic * 10) / 10;
Q.para_bloc_left         = Math.round(blocTotals.left * 10) / 10;
Q.para_bloc_right        = Math.round(blocTotals.right * 10) / 10;
Q.para_bloc_military     = Math.round(reichswehr.share * 10) / 10;

// ---------- 3. render everything into one HTML block ----------

var blocMeta = {
    republic: { label: "Pro-Republic Bloc", color: "#FFD700" },
    left:     { label: "Left Bloc",         color: "#dc143c" },
    right:    { label: "Right Bloc",        color: "#4b4b4b" }
};

function renderForceRow(f) {
    var militancyText = f.isPolice
        ? "Loyalty: " + militancyLabel(f.militancy) + (Q.deterministic_mode == 1 ? " (" + f.militancy.toFixed(2) + ")" : "")
        : "Militarization: " + militancyLabel(f.militancy) + (Q.deterministic_mode == 1 ? " (" + f.militancy.toFixed(2) + ")" : "");

    return '<div class="para-force">' +
             '<b>' + f.name + '</b> &mdash; Strength: ' + fmtStrength(f.strength) + ' thousand ' +
             '(' + fmtPct(f.share) + '% of total)<br>' +
             militancyText +
           '</div>';
}

var html = "";

html += '<div class="para-bloc-summary">';
html += '<b>Pro-Republic bloc:</b> ' + fmtPct(Q.para_bloc_pro_republic) + '%<br>';
html += '<b>Left bloc:</b> ' + fmtPct(Q.para_bloc_left) + '%<br>';
html += '<b>Right bloc:</b> ' + fmtPct(Q.para_bloc_right) + '%<br>';
html += '<b>Military (Reichswehr):</b> ' + fmtPct(Q.para_bloc_military) + '%';
html += '</div><hr>';

if (Q.rb_sh_front) {
    html += '<p><i>Reichsbanner and Stahlhelm have signed a mutual non-aggression treaty. What is to come of this is unknown.</i></p>';
}

var order = ["republic", "left", "right"];
for (var b = 0; b < order.length; b++) {
    var bk = order[b];
    var members = forces.filter(function(f) { return f.blocKey === bk; });
    if (members.length === 0) continue;

    html += '<h3 style="color:' + blocMeta[bk].color + '">' + blocMeta[bk].label +
            ' (' + fmtPct(blocTotals[bk]) + '%)</h3>';
    for (var m = 0; m < members.length; m++) {
        html += renderForceRow(members[m]);
    }
}

html += '<h3 style="color:#1e90ff">Military</h3>';
html += '<div class="para-force"><b>Reichswehr</b> &mdash; Strength: ' + fmtStrength(reichswehr.strength) +
        ' thousand (' + fmtPct(reichswehr.share) + '% of total)<br>' +
        'Militancy: ' + militancyLabel(reichswehr.militancy) +
        (Q.deterministic_mode == 1 ? " (" + reichswehr.militancy.toFixed(2) + ")" : "") + '<br>' +
        'Loyalty: ' + militancyLabel((reichswehr.loyalty || 0) / 100) +
        (Q.deterministic_mode == 1 ? " (" + reichswehr.loyalty + ")" : "") +
        '</div>';

Q.paramilitaries_display = html;

!}

