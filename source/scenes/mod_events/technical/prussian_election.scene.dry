title: Prussian Landtag Elections
new-page: true
tags: event
priority: -2
view-if: (year = next_election_year_prussia and month >= next_election_month_prussia) or (year > next_election_year_prussia)
on-arrival: last_ministerpresident = ministerpresident; old_ministerpresident = ministerpresident; last_election_month_prussia = month; last_election_year_prussia = year; last_election_time_prussia = time
on-departure: month_actions += 1; in_election_prussia = 0; next_election_year_prussia = next_election_year_prussia + 4; n_elections_prussia += 1; next_election_time_prussia = time + 48; papen_ministerpresident_timer = 4; tag_1 = 1;
set-jump: post_election_prussia_1928
face-image: img/Rothe_Wahlen_1903.jpg

= Prussian Landtag Elections, [+ month : month +] [+ year +]

The elections to the Prussian Landtag, the parliament of the largest and most populous state in the Reich, are to be held now.

- @post_election_prussia_1928: May we do our best...
- @cancel_elections_prussia

@cancel_elections_prussia
title: We cannot hold the Landtag elections now. Cancel the elections.
subtitle: This is an anti-democratic move that may backfire.
view-if: in_emergency_government_prussia == 1 and ministerpresident == "Braun" and not presidential_powers

Since the Prussian state government is currently ruling under emergency conditions, we may use quasi-constitutional trickery to significantly delay these Landtag elections.

- @cancel_elections_prussia_2: Yes, do it.
- @election_algorithm_prussia: No, let's hold the elections.

@cancel_elections_prussia_2
on-arrival: next_election_year_prussia = next_election_year_prussia + 1; next_election_time_prussia = time + 12; pro_republic -= 8; dvp_relation -= 6; z_relation -= 6; ddp_relation -= 8; kpd_relation -= 6; coup_progress += 1; workers_spd -= 3; new_middle_spd -= 4; old_middle_spd -= 4; rural_spd -= 4; catholics_spd -= 4; unemployed_spd -= 4; coup_progress += 1 if nsdap_normalized >= 0.3; coup_progress += 1 if nsdap_normalized + dnvp_normalized >= 0.5
achievement: preussen_ausnahmezustand

Fine. Minister-President [+ ministerpresident +] has taken the unprecedented step of canceling the Prussian Landtag elections. New elections are scheduled for [+ next_election_month_prussia : month +] [+ next_election_year_prussia +].

@post_election_prussia_1928
on-arrival: {!

Q.PRUSSIA_MODIFIER = {
    kapd: 1.05,
    faud: 1.05,
    kpd:  1.10,
    sapd: 1.05,
    lb:   1.00,
    sl:   1.00,
    kpo:  1.05,
    spd:  1.05,
    srpd: 1.05,
    rdp:  1.00,
    ddp:  1.00,
    dbp:  0.85,
    cvp:  1.00,
    z:    1.05,
    bb:   1.00,
    bvp:  0.20,
    csrp: 1.00,
    sls:  1.00,
    aspd: 1.00,
    dhp:  0.60,
    dsbp: 1.00,
    dvp:  0.95,
    vrp:  0.90,
    wp:   0.95,
    hl:   1.00,
    vnr:  1.00,
    cnbl: 1.10,
    csvd: 0.90,
    kvp:  0.90,
    rlb:  1.15,
    dnvp: 1.05,
    dnf:  1.00,
    other:1.00,
    nsdap:0.95,
    dtsp: 1.00,
    dvfp: 1.00
};

function prussia_adjust(party, base_support) {
    var mod = (Q.PRUSSIA_MODIFIER && Q.PRUSSIA_MODIFIER[party] !== undefined) ? Q.PRUSSIA_MODIFIER[party] : 1.0;
    return base_support * mod;
}

// === CLEAR GOVERNMENT STATUS ===
for (var party of Q.parties) {
    Q[party + '_in_government_prussia'] = 0;
}

var new_party_sum_prussia = 0;
var adjusted_support_prussia = {};

// Calculate election results (Prussia-specific)
for (var party of Q.parties) {
    Q['old_' + party + '_r_prussia'] = Q[party + '_r_prussia'] ?? 0;
    Q['old_' + party + '_seat_pct_prussia'] = Q[party + '_seat_pct_prussia'] ?? 0;
    Q['old_' + party + '_seats_prussia'] = Q[party + '_seats_prussia'] ?? 0;

    var base_support = Q[party + '_support'];

    if (Q[party + '_banned']) {
        base_support = 0;
    }

    // Apply the Prussian regional adjustment BEFORE any threshold/ban math
    adjusted_support_prussia[party] = prussia_adjust(party, base_support);

    if (Q.constitutional_reform > 0) {
        if (Q[party + '_votes'] < Q.electoral_threshold ||
            (Q.electoral_threshold > 1 && party === 'other') ||
            Q[party + '_banned']) {
            adjusted_support_prussia[party] = 0;
        }
    }

    if (Q.math_broken) {
        adjusted_support_prussia[party] = Q.impossible_add(adjusted_support_prussia[party], 0);
    }

    new_party_sum_prussia += adjusted_support_prussia[party];
}

if (Q.math_broken) {
    new_party_sum_prussia = Q.impossible_multiply(new_party_sum_prussia, 1);
}

for (var party of Q.parties) {
    if (Q[party + '_banned'] && !Q.math_broken) {
        Q[party + '_r_prussia'] = 0;
        Q[party + '_votes_prussia'] = 0;
    } else if (!Q.math_broken) {
        if (new_party_sum_prussia > 0) {
            Q[party + '_r_prussia'] = (adjusted_support_prussia[party] / new_party_sum_prussia) * 100;
        } else {
            Q[party + '_r_prussia'] = 0;
        }
        Q[party + '_votes_prussia'] = Math.round(Q[party + '_r_prussia'] * 10) / 10;
    } else {
        if (new_party_sum_prussia > 0) {
            var roll = Math.random();
            if (roll < 0.3) {
                Q[party + '_r_prussia'] = (adjusted_support_prussia[party] / new_party_sum_prussia) * 100;
            } else if (roll < 0.5) {
                Q[party + '_r_prussia'] = Q.impossible_multiply(adjusted_support_prussia[party], new_party_sum_prussia / 100);
            } else if (roll < 0.7) {
                Q[party + '_r_prussia'] = Q.impossible_percentage(adjusted_support_prussia[party]);
            } else {
                Q[party + '_r_prussia'] = Q.impossible_add(adjusted_support_prussia[party], new_party_sum_prussia);
            }
        } else {
            Q[party + '_r_prussia'] = Q.impossible_subtract(0, 0);
        }

        Q[party + '_votes_prussia'] = Q.impossible_multiply(Q[party + '_r_prussia'], 1);

        if (isNaN(Q[party + '_r_prussia'])) Q[party + '_r_prussia'] = Math.random() * 50;
        if (isNaN(Q[party + '_votes_prussia'])) Q[party + '_votes_prussia'] = Math.random() * 50;
    }
}

for (var party of Q.parties) {
    if (!Q.math_broken) {
        Q[party + '_r_disp_prussia'] = (Math.round(Q[party + '_r_prussia'] * 10) / 10).toFixed(1);

        Q['change_' + party + '_r_prussia'] = Q[party + '_r_prussia'] - Q['old_' + party + '_r_prussia'];
        Q['str_change_' + party + '_prussia'] = (Q['change_' + party + '_r_prussia'] >= 0 ? '+' : '') +
            (Math.ceil(Q['change_' + party + '_r_prussia'] * 10) / 10).toFixed(1);
    } else {
        if (Q.use_decimals) {
            Q[party + '_r_disp_prussia'] = Q.impossible_add(Q[party + '_r_prussia'], 0).toFixed(1);
        } else {
            Q[party + '_r_disp_prussia'] = Math.round(Q.impossible_multiply(Q[party + '_r_prussia'], 1)).toString();
        }

        Q['change_' + party + '_r_prussia'] = Q.impossible_subtract(Q[party + '_r_prussia'], Q['old_' + party + '_r_prussia']);

        if (isNaN(Q['change_' + party + '_r_prussia'])) Q['change_' + party + '_r_prussia'] = Math.random() * 20 - 10;

        var broken_sign = Math.random() < 0.3 ? '-' : '+';
        if (Math.random() < 0.5) {
            broken_sign = (Q['change_' + party + '_r_prussia'] >= 0 ? '+' : '');
        }

        Q['str_change_' + party + '_prussia'] = broken_sign +
            Q.impossible_add(Q['change_' + party + '_r_prussia'], 0).toFixed(1);
    }
}

// The historic 3rd-period Landtag (1928) had 450 seats.
Q.total_seats_prussia = 450;

Q.election_system_name_prussia = Q.fptp_variable === 1 ? 'First Past the Post' : 'Proportional Representation';

if (Q.fptp_variable === 1) {
    var fptp_votes_prussia = {};
    var fptp_sum_prussia = 0;
    for (var i = 0; i < Q.parties.length; i++) {
        var party = Q.parties[i];
        var v = Q[party + '_r_prussia'] || 0;
        if (v >= 3 && !Q[party + '_banned']) {
            fptp_votes_prussia[party] = v;
            fptp_sum_prussia += v;
        } else {
            fptp_votes_prussia[party] = 0;
        }
    }

    var fptp_normalised_prussia = {};
    for (var party in fptp_votes_prussia) {
        fptp_normalised_prussia[party] = fptp_sum_prussia > 0
            ? (fptp_votes_prussia[party] / fptp_sum_prussia) * 100 : 0;
    }

    var sq_sum_prussia = 0;
    var squares_prussia = {};
    for (var party in fptp_normalised_prussia) {
        var v = fptp_normalised_prussia[party] / 100;
        squares_prussia[party] = v * v;
        sq_sum_prussia += squares_prussia[party];
    }

    for (var k = 0; k < Q.parties.length; k++) {
        var party = Q.parties[k];
        Q[party + '_seats_prussia'] = (sq_sum_prussia > 0 && squares_prussia[party] > 0)
            ? Math.round((squares_prussia[party] / sq_sum_prussia) * Q.total_seats_prussia)
            : 0;
    }

    var fptp_seat_total_prussia = 0;
    var largest_fptp_party_prussia = null;
    var largest_fptp_seats_prussia = 0;
    for (var m = 0; m < Q.parties.length; m++) {
        var party = Q.parties[m];
        fptp_seat_total_prussia += Q[party + '_seats_prussia'];
        if (Q[party + '_seats_prussia'] > largest_fptp_seats_prussia) {
            largest_fptp_seats_prussia = Q[party + '_seats_prussia'];
            largest_fptp_party_prussia = party;
        }
    }
    if (largest_fptp_party_prussia) {
        Q[largest_fptp_party_prussia + '_seats_prussia'] += Q.total_seats_prussia - fptp_seat_total_prussia;
    }
} else {
    for (var party of Q.parties) {
        if (!Q.math_broken) {
            Q[party + '_seats_prussia'] = Math.round(Q[party + '_r_prussia'] * 4.5);
        } else {
            Q[party + '_seats_prussia'] = Math.round(Q.impossible_multiply(Q[party + '_r_prussia'], 4.5));
        }
    }
}

Q.total_seats_filled_prussia = 0;
for (var party of Q.parties) {
    Q.total_seats_filled_prussia += Q[party + '_seats_prussia'];
}

for (var party of Q.parties) {
    if (!Q.math_broken) {
    Q[party + '_seat_pct_prussia'] = Q.total_seats_filled_prussia > 0
        ? Math.round((Q[party + '_seats_prussia'] / Q.total_seats_filled_prussia) * 1000) / 10
        : 0;
    Q[party + '_seats_disp_prussia'] = Q[party + '_seats_prussia'].toString();
    Q[party + '_seat_pct_disp_prussia'] = Q[party + '_seat_pct_prussia'].toFixed(1);
    Q['change_' + party + '_seat_pct_prussia'] = Q[party + '_seat_pct_prussia'] - Q['old_' + party + '_seat_pct_prussia'];
    Q['str_change_' + party + '_seats_prussia'] = (Q['change_' + party + '_seat_pct_prussia'] >= 0 ? '+' : '') +
        (Math.round(Q['change_' + party + '_seat_pct_prussia'] * 10) / 10).toFixed(1);
    Q['change_' + party + '_seats_num_prussia'] = Q[party + '_seats_prussia'] - Q['old_' + party + '_seats_prussia'];
    Q['str_change_' + party + '_seats_num_prussia'] = (Q['change_' + party + '_seats_num_prussia'] >= 0 ? '+' : '') +
        Q['change_' + party + '_seats_num_prussia'].toString();
    }
}

for (var party of Q.parties) {
    if (Q[party + '_support'] === 0 || Q[party + '_r_prussia'] === 0) {
        Q[party + '_seats_prussia'] = 0;
        Q[party + '_seat_pct_prussia'] = 0;
        Q[party + '_r_prussia'] = 0;
        Q[party + '_votes_prussia'] = 0;
    }
}

Q.coalition_dissent_prussia = 0;
Q.kpd_coalition_dissent_prussia = 0;
Q.spd_in_government_prussia = 0;
Q.in_weimar_coalition_prussia = 0;
Q.in_grand_coalition_prussia = 0;
Q.in_left_front_prussia = 0;
Q.in_popular_front_prussia = 0;
Q.in_emergency_government_prussia = 0;
Q.in_minority_government_prussia = 0;
Q.in_unity_government_prussia = 0;
Q.spd_toleration_prussia = 0;
Q.in_bourgeois_coalition_prussia = 0;
Q.in_right_coalition_prussia = 0;
Q.in_social_christian_coalition_prussia = 0;
Q.in_social_liberal_coalition_prussia = 0;

Q.kpd_goals_seen_prussia = 0;
Q.welfare_goal_prussia = 0;
Q.agriculture_goal_prussia = 0;
Q.economy_goal_prussia = 0;
Q.finance_goal_prussia = 0;
Q.labor_goal_prussia = 0;
Q.interior_goal_prussia = 0;

Q.popular_front_possible_prussia = (Q.kpd_party_leader === "Conciliators" && Q.z_party_leader === "Joos") ? 1 : 0;
Q.left_front_possible_prussia = (Q.communist_coalition >= 3 && Q.kpd_relation >= 50) ? 1 : 0;
Q.unity_government_possible_prussia = (Q.nazi_urgency >= 6 || Q.pro_republic < 40) ? 1 : 0;
Q.bourgeois_only_possible_prussia = (Q.year >= 1929 || Q.spd_r_prussia < 25) ? 1 : 0;
Q.right_coalition_viable_prussia = (Q.dnvp_line !== 3 || Q.z_party_leader === "Kaas") ? 1 : 0;

var election_result_prussia = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties) {
    election_result_prussia[party] = Q[party + '_r_prussia'];
}
Q.election_records_prussia = Q.election_records_prussia || [];
Q.election_records_prussia.push(election_result_prussia);
!}
on-display: {!
Q.partyDataPrussia = [
{ id: "kapd", name: "KAPD",       color: "#5C0000", row: "far-left",  seats: Q.kapd_seats_prussia, show: !!(Q.kapd_r_prussia > 0) },
{ id: "faud", name: "FAUD",       color: "#1C1C1C", row: "far-left",  seats: Q.faud_seats_prussia, show: !!(Q.faud_r_prussia > 0) },
{ id: "kpd",  name: "KPD",        color: "#8B0000", row: "left",      seats: Q.kpd_seats_prussia,  show: !!(Q.kpd_r_prussia  && Q.kpd_r_prussia  > 0) },
{ id: "sapd", name: "SAPD",       color: "#C40000", row: "left",      seats: Q.sapd_seats_prussia, show: !!(Q.sapd_r_prussia && Q.sapd_r_prussia > 0) },
{ id: "lb",   name: "LB",         color: "#6B0000", row: "left",      seats: Q.lb_seats_prussia,   show: !!(Q.lb_r_prussia   && Q.lb_r_prussia   > 0) },
{ id: "sl",   name: "SL",         color: "#005B96", row: "left",      seats: Q.sl_seats_prussia,   show: !!(Q.sl_r_prussia   && Q.sl_r_prussia   > 0) },
{ id: "kpo",  name: "KPO",        color: "#990000", row: "left",      seats: Q.kpo_seats_prussia,  show: !!(Q.kpo_r_prussia  && Q.kpo_r_prussia  > 0) },
{ id: "spd",  name: "SPD",        color: "#E3000F", row: "left spd",  seats: Q.spd_seats_prussia,  show: !!(Q.spd_r_prussia  && Q.spd_r_prussia  > 0) },
{ id: "srpd", name: "SRPD",       color: "#FF6B6B", row: "left",      seats: Q.srpd_seats_prussia, show: !!(Q.srpd_r_prussia && Q.srpd_r_prussia > 0) },
{ id: "rdp",  name: "RDP",        color: "#B8B000", row: "center",    seats: Q.rdp_seats_prussia,  show: !!(Q.rdp_r_prussia  && Q.rdp_r_prussia  > 0) },
{ id: "ddp",  name: Q.ddp_name,   color: "#DCCA4A", row: "center",    seats: Q.ddp_seats_prussia,  show: !!(Q.ddp_r_prussia  && Q.ddp_r_prussia  > 0) },
{ id: "dbp",  name: "DBP",        color: "#03A331", row: "liberal",   seats: Q.dbp_seats_prussia,  show: !!(Q.dbp_r_prussia  && Q.dbp_r_prussia  > 0) },
{ id: "cvp",  name: "CVP",        color: "#1A1A1A", row: "center",    seats: Q.cvp_seats_prussia,  show: !!(Q.cvp_r_prussia  && Q.cvp_r_prussia  > 0) },
{ id: "z",    name: "Z (Zentrum)",color: "#000000", row: "liberal",   seats: Q.z_seats_prussia,    show: !!(Q.z_r_prussia    && Q.z_r_prussia    > 0) },
{ id: "bb",   name: "BB",         color: "#69A2BE", row: "liberal",   seats: Q.bb_seats_prussia,   show: !!(Q.bb_r_prussia   && Q.bb_r_prussia   > 0) },
{ id: "bvp",  name: "BVP",        color: "#69A2BE", row: "liberal",   seats: Q.bvp_seats_prussia,  show: !!(Q.bvp_r_prussia  && Q.bvp_r_prussia  > 0) },
{ id: "csrp", name: "CSRP",       color: "#FFCCFF", row: "center",    seats: Q.csrp_seats_prussia, show: !!(Q.csrp_r_prussia && Q.csrp_r_prussia > 0) },
{ id: "sls",  name: "SLS",        color: "#4A7C59", row: "liberal",   seats: Q.sls_seats_prussia,  show: !!(Q.sls_r_prussia  && Q.sls_r_prussia  > 0) },
{ id: "aspd", name: "ASPD",       color: "#B22222", row: "left",      seats: Q.aspd_seats_prussia, show: !!(Q.aspd_r_prussia && Q.aspd_r_prussia > 0) },
{ id: "dhp",  name: "DHP",        color: "#69A2BE", row: "liberal",   seats: Q.dhp_seats_prussia,  show: !!(Q.dhp_r_prussia  && Q.dhp_r_prussia  > 0) },
{ id: "dsbp", name: Q.dsbp_name,  color: Q.dsbp_name === "DLP" ? "#F7FF05" : "#7A9DB5", row: "center", seats: Q.dsbp_seats_prussia, show: !!(Q.dsbp_r_prussia && Q.dsbp_r_prussia > 0) },
{ id: "dvp",  name: "DVP",        color: "#D5AC27", row: "center",    seats: Q.dvp_seats_prussia,  show: !!(Q.dvp_r_prussia  && Q.dvp_r_prussia  > 0) },
{ id: "vrp",  name: "VRP",        color: "#8B7355", row: "neutral",   seats: Q.vrp_seats_prussia,  show: !!(Q.vrp_r_prussia  && Q.vrp_r_prussia  > 0) },
{ id: "wp",   name: "WP",         color: "#424242", row: "neutral",   seats: Q.wp_seats_prussia,   show: !!(Q.wp_r_prussia   && Q.wp_r_prussia   > 0) },
{ id: "hl",   name: "HL",         color: "#2E8B57", row: "liberal",   seats: Q.hl_seats_prussia,   show: !!(Q.hl_r_prussia   && Q.hl_r_prussia   > 0) },
{ id: "vnr",  name: "VNR",        color: "#4B5320", row: "right",     seats: Q.vnr_seats_prussia,  show: !!(Q.vnr_r_prussia  && Q.vnr_r_prussia  > 0) },
{ id: "cnbl", name: "CNBL",       color: "#5D4E37", row: "neutral",   seats: Q.cnbl_seats_prussia, show: !!(Q.cnbl_r_prussia && Q.cnbl_r_prussia > 0) },
{ id: "csvd", name: "CSVD",       color: "#3f7bc1", row: "right",     seats: Q.csvd_seats_prussia, show: !!(Q.csvd_r_prussia > 0) },
{ id: "kvp",  name: "KVP",        color: "#3f7bc1", row: "right",     seats: Q.kvp_seats_prussia,  show: !!(Q.kvp_r_prussia  > 0) },
{ id: "rlb",  name: "RLB",        color: "#4A5D23", row: "right",     seats: Q.rlb_seats_prussia,  show: !!(Q.rlb_r_prussia && Q.rlb_r_prussia > 0) },
{ id: "dnvp", name: "DNVP",       color: "#3f7bc1", row: "right",     seats: Q.dnvp_seats_prussia, show: !!(Q.dnvp_r_prussia && Q.dnvp_r_prussia > 0) },
{ id: "dnf",  name: "DNF",        color: "#434F99", row: "far-right", seats: Q.dnf_seats_prussia,  show: !!(Q.dnf_r_prussia && Q.dnf_r_prussia > 0) },
{ id: "other",name: "Other",      color: "#a0a0a0", row: "neutral",   seats: Q.other_seats_prussia,show: !!(Q.other_r_prussia && Q.other_r_prussia > 0) },
{ id: "nsdap",name: "NSDAP",      color: "#954B00", row: "far-right", seats: Q.nsdap_seats_prussia,show: !!(Q.nsdap_r_prussia && Q.nsdap_r_prussia > 0) },
{ id: "dtsp", name: "DtsP",       color: "#3B1A00", row: "far-right", seats: Q.dtsp_seats_prussia, show: !!(Q.dtsp_r_prussia  && Q.dtsp_r_prussia  > 0) },
{ id: "dvfp", name: "DVFP",       color: "#1A0F00", row: "far-right", seats: Q.dvfp_seats_prussia, show: !!(Q.dvfp_r_prussia && Q.dvfp_r_prussia > 0) },
];

var visiblePartiesPrussia = Q.partyDataPrussia.filter(function(p) { return p.show && p.seats > 0; });

var data = visiblePartiesPrussia.map(function(p) {
    return { id: p.id, legend: p.name, name: p.name, seats: p.seats };
});

if (window && d3) {
    var width = 600;
    var height = 300;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = Math.round(width / 2);
        document.getElementById("landtag").style.height = height + "px";
    }
    document.getElementById("landtag").style.width = width + "px";
    document.getElementById("landtag").style.height = height + "px";

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#landtag").datum(data).call(parliament);

    var totalSeatsPrussia = visiblePartiesPrussia.reduce(function(sum, p) { return sum + p.seats; }, 0);
    var bar = document.getElementById("party-color-bar-prussia");
    bar.innerHTML = "";
    bar.style.display = "flex";
    bar.style.width = "100%";
    bar.style.height = "28px";
    bar.style.marginTop = "8px";
    bar.style.overflow = "hidden";
    bar.style.borderRadius = "3px";

    visiblePartiesPrussia.forEach(function(p) {
        var pct = p.seats / totalSeatsPrussia;
        var seg = document.createElement("div");
        seg.style.width = (pct * 100) + "%";
        seg.style.height = "100%";
        seg.style.backgroundColor = p.color;
        seg.style.display = "flex";
        seg.style.alignItems = "center";
        seg.style.justifyContent = "center";
        seg.style.overflow = "hidden";
        seg.style.boxSizing = "border-box";
        seg.title = p.name + ": " + p.seats + " seats";

        if (pct > 0.035) {
            var label = document.createElement("span");
            label.style.fontSize = "10px";
            label.style.fontWeight = "bold";
            label.style.color = "#fff";
            label.style.textShadow = "0 0 2px #000, 0 0 2px #000";
            label.style.whiteSpace = "nowrap";
            label.style.pointerEvents = "none";
            label.textContent = p.name + " " + Math.round(pct * 100) + "%";
            seg.appendChild(label);
        }

        bar.appendChild(seg);
    });
}

function buildLandtagTableHTML(Q, partyData) {
    var rows = partyData.filter(function(p) {
        return Q[p.id + '_votes_prussia'] > 0;
    }).map(function(p) {
        var changeR = Q['change_' + p.id + '_r_prussia'];
        var changeSeats = Q['change_' + p.id + '_seats_num_prussia'];
        var rColor = changeR > 0 ? 'color: green;' : (changeR < 0 ? 'color: red;' : '');
        var sColor = changeSeats > 0 ? 'color: green;' : (changeSeats < 0 ? 'color: red;' : '');
        return '<tr class="row-' + p.row + '">' +
            '<td style="padding:8px;"><div class="box" style="background-color:' + p.color + '; display:inline-block; margin-right:8px;"> </div>' + p.name + '</td>' +
            '<td style="padding:8px; text-align:right; font-weight:bold;">' + Q[p.id + '_r_disp_prussia'] + '%</td>' +
            '<td style="padding:8px; text-align:right; ' + rColor + '">' + Q['str_change_' + p.id + '_prussia'] + '</td>' +
            '<td style="padding:8px; text-align:right;">' + Q[p.id + '_seats_prussia'] + '</td>' +
            '<td style="padding:8px; text-align:right; ' + sColor + '">' + Q['str_change_' + p.id + '_seats_num_prussia'] + '</td>' +
            '</tr>';
    }).join('');

    return '<table style="width:100%; border-collapse: collapse;">' +
        '<tr style="border-bottom: 2px solid #333;">' +
        '<td style="padding:8px; font-weight:bold;">Party</td>' +
        '<td style="padding:8px; font-weight:bold; text-align:right;">Votes</td>' +
        '<td style="padding:8px; font-weight:bold; text-align:right;">Δ Votes</td>' +
        '<td style="padding:8px; font-weight:bold; text-align:right;">Seats</td>' +
        '<td style="padding:8px; font-weight:bold; text-align:right;">Δ Seats</td>' +
        '</tr>' + rows + '</table>';
}

Q.election_table_html_prussia = buildLandtagTableHTML(Q, Q.partyDataPrussia);

document.getElementById('election-table-prussia').innerHTML = Q.election_table_html_prussia;
!}
go-to: coalition_formation_start_prussia

= Prussian Landtag election results

[? if fptp_variable = 1 : <p style="font-size:0.8em; color:#888; font-style:italic;">⚑ First Past the Post seat allocation — cube rule with 5% threshold</p> ?]

{!<svg id="landtag" style="width: 600px; height: 300px;"> </svg>
<div id="party-color-bar-prussia"></div>!}

{!<div id="election-table-prussia"></div>!}




@coalition_formation_start_prussia
on-arrival: {!
// ============================================
// BUILD LIST OF PARTIES BY VOTE SHARE (PRUSSIA)
// ============================================

var seat_total_prussia = 0;
for (var i = 0; i < Q.parties.length; i++) {
    seat_total_prussia += Q[Q.parties[i] + '_seats_prussia'] || 0;
}
if (seat_total_prussia === 0) seat_total_prussia = 1;

Q.party_votes_prussia = [];

function try_add_party_prussia(party_key, display_name) {
    if (Q.parties.indexOf(party_key) < 0) return;
    if (Q[party_key + '_banned']) return;
    var seats = Q[party_key + '_seats_prussia'] || 0;
    if (seats <= 0) return;
    Q.party_votes_prussia.push({
        party: display_name || party_key.toUpperCase(),
        votes: (seats / seat_total_prussia) * 100
    });
}

var special_display_names_prussia = {
    'z': 'Z',
    'other': 'other',
    'dtsp': 'DtsP'
};

for (var i = 0; i < Q.parties.length; i++) {
    var party_key = Q.parties[i];
    var display_name = special_display_names_prussia[party_key] || undefined;
    try_add_party_prussia(party_key, display_name);
}

Q.party_votes_prussia.sort(function(a, b) { return b.votes - a.votes; });

// ============================================================
// PRESIDENTIAL / MINISTER-PRESIDENT FORMATEUR SELECTION
// In Prussia there is no Reich President with formateur powers;
// the Landtag itself elects the Minister-President by absolute
// majority (Art. 45 Prussian Constitution). We keep the largest-
// party-first constitutional default and allow the Prussian
// State Ministry / camarilla-equivalent dynamics to interfere
// only under a presidential-powers/commissarial scenario
// (i.e. the "Preußenschlag" branch), mirroring the Reich logic
// but gated on Q.preussenschlag_active instead of a president.
// ============================================================

Q.formateur_interfered_prussia = 0;
Q.formateur_prussia = Q.party_votes_prussia[0].party; // constitutional default

function landtag_formateur_score(party) {
    var score = 0;
    var cam = Q.camarilla_chancellor_scores || {};

    var party_chancellor_proxy = {
        SPD:  'Braun',    SRPD: 'Horsing',   KPD:  'Thälmann',
        SAPD: 'Rosenfeld', Z:    'Brüning',    BVP:  'Held',
        DDP:  'Koch-Weser',DVP:  'Stresemann', WP:   'Drewitz',
        CNBL: 'Hepp',      CSVD: 'Lambach',    DNVP: Q.dnvp_line === 3 ? 'Hugenberg' : 'Westarp',
        NSDAP:'Hitler',    VRP:  'Drewitz',    CSRP: 'Vitus Heller',
        KVP:  'Westarp',   DHP:  'Hamkens',    BB:   'Hamkens',
        DVFP: 'Graefe', DNF: 'Alfred Hugenberg'
    };
    var proxy = party_chancellor_proxy[party] || '';
    if (cam[proxy] !== undefined) score += cam[proxy] * 0.3;

    if (Q.preussenschlag_active) {
        // Under commissarial rule, the Reich government (acting through
        // its Reich commissioner in Prussia) is hostile to the SPD/KPD
        // and favors the right.
        if (party === 'SPD' || party === 'KPD' || party === 'SAPD') score -= 60;
        if (party === 'DNVP' || party === 'NSDAP') score += 20;
    }

    return score;
}

var largest_prussia = Q.party_votes_prussia[0].party;
var largest_score_prussia = landtag_formateur_score(largest_prussia);
var DEFAULT_THRESHOLD_PRUSSIA = -20;

if (largest_score_prussia <= DEFAULT_THRESHOLD_PRUSSIA) {
    var best_alt_prussia = null;
    var best_alt_score_prussia = -9999;

    for (var i = 1; i < Q.party_votes_prussia.length; i++) {
        var candidate = Q.party_votes_prussia[i].party;
        var cscore = landtag_formateur_score(candidate);
        if (cscore > largest_score_prussia + 20 && cscore > DEFAULT_THRESHOLD_PRUSSIA) {
            if (cscore > best_alt_score_prussia) {
                best_alt_prussia = candidate;
                best_alt_score_prussia = cscore;
            }
        }
    }

    if (best_alt_prussia) {
        Q.formateur_prussia = best_alt_prussia;
        Q.formateur_interfered_prussia = 1;
    }
} else {
    Q.formateur_prussia = largest_prussia;
}

(function check_global_coalition_feasibility_prussia() {
    function get_relation(p1, p2) {
        if (p1 === p2) return 100;
        var pr = Q.party_relations;
        if (!pr) return 0;
        var v1 = (pr[p1] && pr[p1][p2] != null) ? pr[p1][p2] : -1;
        var v2 = (pr[p2] && pr[p2][p1] != null) ? pr[p2][p1] : -1;
        if (isNaN(v1) || v1 < 0) v1 = -1;
        if (isNaN(v2) || v2 < 0) v2 = -1;
        if (v1 >= 0 && v2 >= 0) return (v1 + v2) / 2;
        if (v1 >= 0) return v1;
        if (v2 >= 0) return v2;
        return 0;
    }
    function is_blocked(p1, p2) {
        var cb = Q.coalition_blocks || {};
        if (cb[p1 + '_' + p2] || cb[p2 + '_' + p1]) return true;
        if (cb[p1 + '_ALL'] || cb[p2 + '_ALL']) return true;
        return false;
    }
    function can_partner(p1, p2) {
        if (is_blocked(p1, p2)) return false;
        var pr = Q.party_relations;
        if (!pr) return false;
        var v1 = (pr[p1] && pr[p1][p2] !== undefined) ? pr[p1][p2] : -1;
        var v2 = (pr[p2] && pr[p2][p1] !== undefined) ? pr[p2][p1] : -1;
        if (isNaN(v1) || v1 < 0) v1 = 0;
        if (isNaN(v2) || v2 < 0) v2 = 0;
        return v1 >= 30 && v2 >= 30;
    }

    var seat_total = 0;
    for (var i = 0; i < Q.parties.length; i++) {
        seat_total += Q[Q.parties[i] + '_seats_prussia'] || 0;
    }
    if (seat_total === 0) { Q.no_coalition_possible_prussia = 0; return; }

    var active = [];
    for (var i = 0; i < Q.parties.length; i++) {
        var p = Q.parties[i];
        var seats = Q[p + '_seats_prussia'] || 0;
        if (seats <= 0) continue;
        if (Q[p + '_banned']) continue;
        active.push({ party: p.toUpperCase(), votes: (seats / seat_total) * 100 });
    }

    if (active.length === 0) { Q.no_coalition_possible_prussia = 1; return; }
    if (active.length === 1) {
        Q.no_coalition_possible_prussia = active[0].votes < 50 ? 1 : 0;
        return;
    }

    var threshold = 50;
    var n = active.length;
    var feasible = false;

    if (n <= 24) {
        for (var mask = 1; mask < (1 << n) && !feasible; mask++) {
            var subset = [];
            var votes = 0;
            for (var b = 0; b < n; b++) {
                if (mask & (1 << b)) {
                    subset.push(active[b].party);
                    votes += active[b].votes;
                }
            }
            if (votes < threshold) continue;
            var ok = true;
            for (var a = 0; a < subset.length && ok; a++) {
                for (var c = a + 1; c < subset.length; c++) {
                    if (!can_partner(subset[a], subset[c])) { ok = false; break; }
                }
            }
            if (ok) feasible = true;
        }
    } else {
        var sorted = active.slice().sort(function(a, b) { return b.votes - a.votes; });
        var acc = [];
        var accVotes = 0;
        for (var s = 0; s < sorted.length; s++) {
            var cand = sorted[s];
            var ok = true;
            for (var a = 0; a < acc.length; a++) {
                if (!can_partner(acc[a], cand.party)) { ok = false; break; }
            }
            if (ok) { acc.push(cand.party); accVotes += cand.votes; }
            if (accVotes >= threshold) { feasible = true; break; }
        }
    }

    Q.no_coalition_possible_prussia = feasible ? 0 : 1;
})();

Q.election_results_list_prussia = "";
for (var i = 0; i < Q.party_votes_prussia.length; i++) {
    Q.election_results_list_prussia += "- " + Q.party_votes_prussia[i].party + ":&nbsp;"
        + Q.party_votes_prussia[i].votes.toFixed(1) + "%\n";
}
Q.first_party_votes_prussia = Q.party_votes_prussia[0].votes.toFixed(1);
Q.formation_round_prussia   = 1;
Q.formation_attempts_prussia = [];

Q.first_party_0_prussia = Q.party_votes_prussia[0].party
!}
go-to: presidential_crisis_prussia if no_coalition_possible_prussia; begin_negotiations_prussia

= Landtag Coalition Formation - [+ year +]

**Prussian Landtag Election Results:**

[+ election_results_list_prussia +]

[? if formateur_interfered_prussia : The Reich commissioner's office has signalled it will not tolerate [+ first_party_0_prussia +] leading the Prussian government, and effectively hands the initiative to **[+ formateur_prussia +]** instead. ?]

[? if not formateur_interfered_prussia : By constitutional tradition, **[+ formateur_prussia +]** ([+ first_party_votes_prussia +]%) receives the first opportunity to seek election as Minister-President in the Landtag. ?]

- @begin_negotiations_prussia: Begin coalition negotiations














@begin_negotiations_prussia
on-arrival: {!
// ============================================================
// HELPERS (PRUSSIA)
// ============================================================

function get_relation(p1, p2) {
    if (p1 === p2) return 100;
    var pr = Q.party_relations;
    if (!pr) return 0;
    var v1 = (pr[p1] && pr[p1][p2] != null) ? pr[p1][p2] : -1;
    var v2 = (pr[p2] && pr[p2][p1] != null) ? pr[p2][p1] : -1;
    if (isNaN(v1) || v1 < 0) v1 = -1;
    if (isNaN(v2) || v2 < 0) v2 = -1;
    if (v1 >= 0 && v2 >= 0) return (v1 + v2) / 2;
    if (v1 >= 0) return v1;
    if (v2 >= 0) return v2;
    return 0;
}

function is_blocked(p1, p2) {
    var cb = Q.coalition_blocks;
    if (!cb) return false;
    if (cb[p1 + '_' + p2]) return true;
    if (cb[p2 + '_' + p1]) return true;
    if (cb[p1 + '_ALL'])   return true;
    if (cb[p2 + '_ALL'])   return true;
    return false;
}

function can_partner(p1, p2) {
    if (is_blocked(p1, p2)) return false;
    var pr = Q.party_relations;
    if (!pr) return false;
    var v1 = (pr[p1] && pr[p1][p2] !== undefined) ? pr[p1][p2] : -1;
    var v2 = (pr[p2] && pr[p2][p1] !== undefined) ? pr[p2][p1] : -1;
    if (isNaN(v1) || v1 < 0) v1 = 0;
    if (isNaN(v2) || v2 < 0) v2 = 0;
    return v1 >= 30 && v2 >= 30;
}

function coalition_compatibility(parties) {
    var total = 0, count = 0;
    for (var a = 0; a < parties.length; a++) {
        for (var b = a + 1; b < parties.length; b++) {
            var rel = get_relation(parties[a], parties[b]);
            if (rel < 20) return -1;
            total += rel;
            count++;
        }
    }
    return count > 0 ? total / count : 100;
}

function classify_coalition(parties) {
    if (parties.length === 1) return 'sole_majority';
    var has = {};
    for (var i = 0; i < parties.length; i++) has[parties[i]] = true;
    if (has.SPD && has.KPD && !has.Z)                                       return 'left_front';
    if (has.KPD && has.Z && has.SPD && has.DDP)                             return 'popular_front';
    if (has.SPD && has.SAPD && !has.KPD && !has.Z)                         return 'socialist_unity';
    if (has.SPD && has.Z && has.DDP && parties.length === 3)                return 'weimar';
    if (has.SPD && has.Z && has.DDP && has.DVP && has.BVP)                 return 'grand';
    if (has.SPD && has.Z && has.DDP && has.DVP && parties.length === 4)    return 'grand_small';
    if (has.SPD && has.Z && parties.length === 2)                           return 'social_christian';
    if (has.SPD && has.DDP && parties.length === 2)                         return 'social_liberal';
    if (!has.SPD && !has.KPD && !has.SAPD && has.Z && has.DDP && has.DVP) return 'bourgeois';
    if (!has.SPD && !has.KPD && !has.SAPD && has.Z && has.DVP && has.BVP) return 'bourgeois_catholic';
    if (has.Z && has.DVP && has.DNVP && !has.NSDAP)                        return 'right';
    if (has.DVP && has.DNVP && !has.Z && !has.NSDAP)                       return 'right_business';
    if (has.DNVP && has.NSDAP)                                              return 'far_right';
    if (has.NSDAP)                                                          return 'far_right';
    if (parties.length >= 5)                                                return 'unity';
    return 'other';
}

var _cb = Q.coalition_blocks || {};
var _cbkeys = Object.keys(_cb);
for (var _i = 0; _i < _cbkeys.length; _i++) {
    var _k = _cbkeys[_i];
    if (!_cb[_k]) continue;
    var _parts = _k.split('_');
    if (_parts.length !== 2) continue;
    var _reverse = _parts[1] + '_' + _parts[0];
    if (_cb[_reverse] === undefined) {
        _cb[_reverse] = true;
    }
}
Q.coalition_blocks = _cb;

// ============================================================
// SETUP
// ============================================================

Q.rejected_coalitions_prussia = Q.rejected_coalitions_prussia || [];
Q.spd_rejection_count_prussia = Q.spd_rejection_count_prussia || 0;
Q.possible_coalitions_prussia = [];

var formateur = Q.formateur_prussia;
var seat_total = 0;
for (var pi = 0; pi < Q.parties.length; pi++) {
    seat_total += Q[Q.parties[pi] + '_seats_prussia'] || 0;
}
if (seat_total === 0) seat_total = 1;

var formateur_votes = ((Q[formateur.toLowerCase() + '_seats_prussia'] || 0) / seat_total) * 100;
var threshold = 50;
Q.formation_attempts_prussia.push(formateur);

var goto_coalition_success = false;

// ============================================================
// SOLE MAJORITY
// ============================================================

if (formateur_votes >= threshold) {
    Q.sole_majority_possible_prussia = 1;
    Q.sole_majority_party_prussia    = formateur;

    var sole = {
        parties: [formateur], votes: formateur_votes,
        compatibility: 100, size: 1, type: 'sole_majority'
    };

    if (formateur === 'SPD') {
        Q.spd_can_govern_alone_prussia = 1;
        Q.possible_coalitions_prussia.push(sole);
    } else {
        Q.coalition_formed_prussia        = 1;
        Q.chosen_coalition_prussia        = sole;
        Q.spd_in_chosen_coalition_prussia = 0;
        Q.spd_must_decide_prussia         = 0;
        goto_coalition_success    = true;
    }
} else {
    Q.sole_majority_possible_prussia = 0;
    Q.spd_can_govern_alone_prussia   = 0;
}

// ============================================================
// PARTNER POOL
// ============================================================

if (!goto_coalition_success) {

var other_parties = [];
for (var oi = 0; oi < Q.party_votes_prussia.length; oi++) {
    var op = Q.party_votes_prussia[oi];
    if (op.party === formateur) continue;
    if (op.votes < 0.5)        continue;
    other_parties.push(op);
}
var trimmed_others = other_parties.slice(0, 12);

// ============================================================
// MAJORITY COALITION SEARCH
// ============================================================

function evaluate_size(size) {
    var n = trimmed_others.length;
    var r = size - 1;
    if (r > n) return;

    var indices = [];
    for (var ii = 0; ii < r; ii++) indices[ii] = ii;

    while (true) {
        var partners = [], partner_votes = 0;
        for (var ii = 0; ii < r; ii++) {
            partners.push(trimmed_others[indices[ii]].party);
            partner_votes += trimmed_others[indices[ii]].votes;
        }

        if (formateur_votes + partner_votes >= threshold) {
            var all = [formateur].concat(partners);
            var viable = true;
            outer_check:
            for (var aa = 0; aa < all.length; aa++) {
                for (var bb = aa + 1; bb < all.length; bb++) {
                    if (!can_partner(all[aa], all[bb])) {
                        viable = false;
                        break outer_check;
                    }
                }
            }
            if (viable) {
                var compat = coalition_compatibility(all);
                if (compat >= 0) {
                    Q.possible_coalitions_prussia.push({
                        parties: all, votes: formateur_votes + partner_votes,
                        compatibility: compat, size: size, type: classify_coalition(all)
                    });
                }
            }
        }

        var pos = r - 1;
        while (pos >= 0 && indices[pos] === n - r + pos) pos--;
        if (pos < 0) break;
        indices[pos]++;
        for (var ii = pos + 1; ii < r; ii++) indices[ii] = indices[ii-1] + 1;
    }
}

for (var sz = 2; sz <= 8; sz++) {
    evaluate_size(sz);
}

// ============================================================
// MINORITY + TOLERATION SEARCH
// ============================================================

var MIN_GOV = 30;

function get_tolerators(gov_parties) {
    var tols = [];
    for (var ti = 0; ti < Q.party_votes_prussia.length; ti++) {
        var cand = Q.party_votes_prussia[ti].party;
        if (gov_parties.indexOf(cand) >= 0) continue;
        if (Q.party_votes_prussia[ti].votes < 0.5)  continue;
        var ok = true;
        for (var gi = 0; gi < gov_parties.length; gi++) {
            if (!can_partner(cand, gov_parties[gi])) { ok = false; break; }
        }
        if (ok) tols.push({ party: cand, votes: Q.party_votes_prussia[ti].votes });
    }
    return tols;
}

function find_tol_combos(gov_votes, tols) {
    var combos = [];
    var maxT = Math.min(tols.length, 3);
    function recurse(start, cur) {
        if (cur.length > 0) {
            var tot = gov_votes;
            for (var ci = 0; ci < cur.length; ci++) tot += cur[ci].votes;
            if (tot >= threshold) combos.push({ parties: cur.slice(), total: tot });
        }
        if (cur.length >= maxT) return;
        for (var si = start; si < tols.length; si++) {
            cur.push(tols[si]);
            recurse(si + 1, cur);
            cur.pop();
        }
    }
    recurse(0, []);
    return combos;
}

var min_govs = [];

if (formateur_votes >= MIN_GOV && formateur_votes < threshold) {
    min_govs.push({ parties: [formateur], votes: formateur_votes, compat: 100, size: 1 });
}
for (var mi = 0; mi < other_parties.length; mi++) {
    var p1 = other_parties[mi].party;
    var tot2 = formateur_votes + other_parties[mi].votes;
    if (tot2 >= MIN_GOV && tot2 < threshold && can_partner(formateur, p1)) {
        var c2 = coalition_compatibility([formateur, p1]);
        if (c2 >= 0) min_govs.push({ parties: [formateur, p1], votes: tot2, compat: c2, size: 2 });
    }
}
for (var mi = 0; mi < other_parties.length; mi++) {
    for (var mj = mi + 1; mj < other_parties.length; mj++) {
        var p1 = other_parties[mi].party, p2 = other_parties[mj].party;
        var tot3 = formateur_votes + other_parties[mi].votes + other_parties[mj].votes;
        if (tot3 >= MIN_GOV && tot3 < threshold
            && can_partner(formateur, p1) && can_partner(formateur, p2) && can_partner(p1, p2)) {
            var c3 = coalition_compatibility([formateur, p1, p2]);
            if (c3 >= 0) min_govs.push({ parties: [formateur, p1, p2], votes: tot3, compat: c3, size: 3 });
        }
    }
}

for (var gi = 0; gi < min_govs.length; gi++) {
    var mg   = min_govs[gi];
    var tols = get_tolerators(mg.parties);
    if (tols.length === 0) continue;
    var combos = find_tol_combos(mg.votes, tols);
    for (var ci = 0; ci < combos.length; ci++) {
        var combo = combos[ci];
        Q.possible_coalitions_prussia.push({
            parties:            mg.parties,
            votes:              mg.votes,
            effective_votes:    combo.total,
            compatibility:      mg.compat,
            size:               mg.size,
            type:               classify_coalition(mg.parties),
            toleration:         true,
            tolerating_parties: combo.parties.map(function(p) { return p.party; }),
            tolerating_votes:   combo.total - mg.votes
        });
    }
}

// ============================================================
// SORT
// ============================================================

Q.possible_coalitions_prussia.sort(function(a, b) {
    if (a.type === 'sole_majority' && b.type !== 'sole_majority') return -1;
    if (b.type === 'sole_majority' && a.type !== 'sole_majority') return 1;
    if (!a.toleration && b.toleration)  return -1;
    if (a.toleration  && !b.toleration) return 1;
    if (a.size !== b.size) return a.size - b.size;
    if (Math.abs(a.compatibility - b.compatibility) > 5) return b.compatibility - a.compatibility;
    return a.votes - b.votes;
});

if (formateur === 'SPD') {
    var maj_opts = Q.possible_coalitions_prussia.filter(function(c) { return !c.toleration; });
    var tol_opts = Q.possible_coalitions_prussia.filter(function(c) { return  c.toleration; }).slice(0, 2);
    Q.possible_coalitions_prussia = maj_opts.concat(tol_opts);
}

// ============================================================
// DECIDE
// ============================================================

if (Q.possible_coalitions_prussia.length > 0) {
    Q.coalition_formed_prussia = 1;
    Q.chosen_coalition_prussia = Q.possible_coalitions_prussia[0];
    if (formateur === 'SPD') {
        Q.spd_must_decide_prussia         = 1;
        Q.spd_in_chosen_coalition_prussia = 1;
    } else {
        Q.spd_must_decide_prussia         = 0;
        Q.spd_in_chosen_coalition_prussia = Q.chosen_coalition_prussia.parties.indexOf('SPD') >= 0;
    }
} else {
    Q.coalition_formed_prussia        = 0;
    Q.spd_must_decide_prussia         = 0;
    Q.spd_in_chosen_coalition_prussia = 0;
}

Q.num_coalitions_prussia = Q.possible_coalitions_prussia.length;

}
!}
go-to: spd_formateur_choice_prussia if coalition_formed_prussia and formateur_prussia = "SPD"; player_coalition_review_prussia if coalition_formed_prussia and formateur_prussia != "SPD" and spd_in_chosen_coalition_prussia; coalition_success_prussia if coalition_formed_prussia and not spd_in_chosen_coalition_prussia; coalition_failure_prussia if not coalition_formed_prussia


















# # ============================================
# SPD AS FORMATEUR - PLAYER CHOOSES COALITION (PRUSSIA)
# ============================================

@spd_formateur_choice_prussia
on-arrival: {!
Q.num_coalitions_prussia = Q.possible_coalitions_prussia.length;

Q.coalition_options_display_prussia = "";

if (Q.possible_coalitions_prussia.length === 0) {
    Q.coalition_options_display_prussia = "**No viable coalitions found.**\n\nNo combination of parties willing to work together can achieve a majority in the Landtag.";
} else {
    Q.coalition_options_display_prussia = "**Available Coalition Options:**\n\n";

    for (var i = 0; i < Q.possible_coalitions_prussia.length && i < 80; i++) {
        var coal = Q.possible_coalitions_prussia[i];
        var partners_text = coal.parties.join(', ');
        var type_text = coal.type.replace(/_/g, ' ');

        Q.coalition_options_display_prussia += (i + 1) + ". **" + partners_text + "**<br>";

        if (coal.toleration) {
            var tol_text = coal.tolerating_parties.join(' + ');
            Q.coalition_options_display_prussia += "&nbsp;&nbsp;&nbsp;&nbsp;- Minority government, tolerated by: **" + tol_text + "**<br>";
            Q.coalition_options_display_prussia += "&nbsp;&nbsp;&nbsp;&nbsp;- Government seats: " + Math.round(coal.votes * 10) / 10 + "% | Effective majority: " + Math.round(coal.effective_votes * 10) / 10 + "%<br>";
        } else {
            Q.coalition_options_display_prussia += "&nbsp;&nbsp;&nbsp;&nbsp;- Support: " + Math.round(coal.votes * 10) / 10 + "%<br>";
        }

        Q.coalition_options_display_prussia += "&nbsp;&nbsp;&nbsp;&nbsp;- Type: " + type_text + "<br>";
        Q.coalition_options_display_prussia += "&nbsp;&nbsp;&nbsp;&nbsp;- Compatibility: " + Math.round(coal.compatibility) + "/100<br><br>";

    }

    if (Q.possible_coalitions_prussia.length > 80) {
        Q.coalition_options_display_prussia += "*(+" + (Q.possible_coalitions_prussia.length - 80) + " more options available)*\n";
    }
}
!}

