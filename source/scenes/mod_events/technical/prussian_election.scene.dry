# ============================================
# MINISTER-PRESIDENT NEGOTIATION - AI DECIDES
# ============================================

@mp_negotiation_ai_prussia
on-arrival: {!
var total_coalition_votes_ai = 0;
for (var i = 0; i < coalition.length; i++) {
    total_coalition_votes_ai += Q[coalition[i].toLowerCase() + '_r_prussia'];
}
if (total_coalition_votes_ai === 0) total_coalition_votes_ai = 1;

var best_candidate = 0;
var best_score = -999;

for (var i = 0; i < Q.mp_candidates_prussia.length; i++) {
    var candidate = Q.mp_candidates_prussia[i];

    var party_votes = Q[candidate.party.toLowerCase() + '_r_prussia'];
    var coalition_share = (party_votes / total_coalition_votes_ai) * 100;

    var score = coalition_share * (candidate.weight / 100);

    if (candidate.party === Q.formateur_prussia) {
        score += 15;
    }

    if (candidate.name === "Braun") {
        score += 15;
    }
    if (candidate.name === "Hirtsiefer") {
        score += 10;
    }
    if (candidate.name === "Höpker-Aschoff") {
        score += 8;
    }

    if (score > best_score) {
        best_score = score;
        best_candidate = i;
    }
}

Q.chosen_mp_index_prussia = best_candidate;
Q.mp_party_prussia = Q.mp_candidates_prussia[best_candidate].party;
Q.ministerpresident = Q.mp_candidates_prussia[best_candidate].name;
!}
go-to: mp_confirmed_prussia

