    var new_party = 'Z';
    if (Q.government_parties_prussia) {
        for (var i = 0; i < Q.government_parties_prussia.length; i++) {
            if (Q.government_parties_prussia[i] !== 'SPD') {
                new_party = Q.government_parties_prussia[i];
                break;
            }
        }
    }
    Q.agriculture_minister_party_prussia = new_party;
    Q.agriculture_minister_prussia = 'Steger';
!}
