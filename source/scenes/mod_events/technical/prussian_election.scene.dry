// Finance Ministry
if (Q.finance_minister_party_prussia === 'KPD') Q.finance_minister_prussia = 'Neumann';
else if (Q.finance_minister_party_prussia === 'SAPD') Q.finance_minister_prussia = 'Rosenfeld';
