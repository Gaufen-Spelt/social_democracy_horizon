@coalition_failure_prussia
on-arrival: {!
Q.formation_round_prussia++;
Q.no_majority_elections_prussia = Q.no_majority_elections_prussia || 0;

Q.failed_formateur_prussia = Q.formateur_prussia;

var _ft = 0;
for (var fi = 0; fi < Q.parties.length; fi++) {
    _ft += Q[Q.parties[fi] + '_seats_prussia'] || 0;
}
if (_ft === 0) _ft = 1;
Q.formateur_votes_prussia = Math.round(
    ((Q[Q.formateur_prussia.toLowerCase() + '_seats_prussia'] || 0) / _ft) * 1000
) / 10;

Q.next_formateur_found_prussia = 0;

for (var fi = Q.formation_round_prussia - 1; fi < Q.party_votes_prussia.length; fi++) {
    var candidate = Q.party_votes_prussia[fi].party;
    if (Q.party_votes_prussia[fi].votes < 1)                 continue;
    if (candidate === 'NSDAP' && Q.nsdap_r_prussia < 40)     continue;
    if (candidate === 'KPD'   && Q.communist_coalition < 3)  continue;
    if (Q.formation_attempts_prussia.indexOf(candidate) >= 0) continue;

    Q.formateur_prussia = candidate;

    var _ft2 = 0;
    for (var fj = 0; fj < Q.parties.length; fj++) {
        _ft2 += Q[Q.parties[fj] + '_seats_prussia'] || 0;
    }
    if (_ft2 === 0) _ft2 = 1;
    Q.formateur_votes_prussia = Math.round(
        ((Q[Q.formateur_prussia.toLowerCase() + '_seats_prussia'] || 0) / _ft2) * 1000
    ) / 10;

    Q.next_formateur_found_prussia = 1;
    break;
}

Q.all_attempts_failed_prussia = !Q.next_formateur_found_prussia || Q.formation_round_prussia > Q.party_votes_prussia.length;

if (Q.all_attempts_failed_prussia) {
    Q.no_majority_elections_prussia++;
}
!}
go-to: call_new_elections_prussia if all_attempts_failed_prussia and no_majority_elections_prussia < 2; presidential_crisis_prussia if all_attempts_failed_prussia and no_majority_elections_prussia >= 2; next_formateur_attempt_prussia if not all_attempts_failed_prussia

