// ============================================
// FINALIZE (PRUSSIA)
// ============================================

@finalize_shuffle_prussia
on-arrival: {!
    function assign_minister_prussia(ministry, party) {
        var minister_var = ministry + '_minister_prussia';

        var ministers = {
            interior: {
                KPD: 'Ulbricht', SAPD: 'Seydewitz', SRPD: 'Hörsing', DDP: 'Höpker-Aschoff',
                Z: 'Hirtsiefer', BVP: 'Schmelzer', DVP: 'Boelitz', WP: 'Drewitz',
                CNBL: 'Kriege', DNVP: 'Winterfeld'
            },
            justice: {
                KPD: 'Heckert', SAPD: 'Frankenthal', SRPD: 'Hörsing', DDP: 'Höpker-Aschoff',
                Z: 'Wirth', BVP: 'Held', DVP: 'Boelitz', WP: 'Borchert',
                CNBL: 'Hepp', DNVP: 'Kries'
            },
            finance: {
                KPD: 'Neumann', SAPD: 'Rosenfeld', SRPD: 'Hörsing', DDP: 'Höpker-Aschoff',
                Z: 'Hermes', BVP: 'Held', DVP: 'Kanitz', WP: 'Drewitz',
                CNBL: 'Hepp', DNVP: 'Bundt'
            },
            trade: {
                KPD: 'Remmele', SAPD: 'Rosenfeld', SRPD: 'Hörsing', DDP: 'Dietrich',
                Z: 'Bredt', BVP: 'Held', DVP: 'Kriege', WP: 'Perschke',
                CNBL: 'Ladendorff', DNVP: 'Conradt'
            },
            agriculture: {
                KPD: 'Hoernle', SAPD: 'Baade', SRPD: 'Baade', DDP: 'Dietrich',
                Z: 'Steger', BVP: 'Wutzlhofer', DVP: 'von Campe', WP: 'Bischoff',
                CNBL: 'Hepp', DNVP: 'Schaefer'
            },
            publicworks: {
                KPD: 'Hoernle', SAPD: 'Baade', SRPD: 'Baade', DDP: 'Dietrich',
                Z: 'Grass', BVP: 'Wutzlhofer', DVP: 'Eichhoff', WP: 'Bredt',
                CNBL: 'Hamkens', DNVP: 'Kickhöffel'
            },
            kultus: {
                KPD: 'Golke', SAPD: 'Frankenthal', SRPD: 'Hörsing', DDP: 'Nuschke',
                Z: 'Hirtsiefer', BVP: 'Schmelzer', DVP: 'Boelitz', WP: 'Hestermann',
                CNBL: 'Kliesch', DNVP: 'Tiling'
            }
        };

        if (ministers[ministry] && ministers[ministry][party]) {
            Q[minister_var] = ministers[ministry][party];
        } else {
            Q[minister_var] = 'Unbesetzt';
        }
    }

    var changes = 0;
    for (var ministry in Q.original_allocation_prussia) {
        if (!Q.original_allocation_prussia.hasOwnProperty(ministry)) continue;
        var current_party_var = ministry + '_minister_party_prussia';
        if (Q.original_allocation_prussia[ministry] !== Q[current_party_var]) {
            changes++;
        }
    }

    Q.shuffle_changes_made_prussia = changes;

    var ministry_delta = {};
    for (var i = 0; i < Q.government_parties_prussia.length; i++) {
        ministry_delta[Q.government_parties_prussia[i]] = 0;
    }

    for (var ministry in Q.original_allocation_prussia) {
        if (!Q.original_allocation_prussia.hasOwnProperty(ministry)) continue;
        var orig_party = Q.original_allocation_prussia[ministry];
        if (ministry_delta[orig_party] !== undefined) {
            ministry_delta[orig_party]++;
        }
        var curr_party = Q[ministry + '_minister_party_prussia'];
        if (ministry_delta[curr_party] !== undefined) {
            ministry_delta[curr_party]--;
        }
    }

    var compensation_needed = [];
    for (var party in ministry_delta) {
        if (!ministry_delta.hasOwnProperty(party)) continue;
        if (party !== 'SPD' && ministry_delta[party] > 0) {
            compensation_needed.push({
                party: party,
                losses: ministry_delta[party],
                leverage: Q.shuffle_leverage_prussia[party] || 0
            });
        }
    }

    compensation_needed.sort(function(a, b) { return b.leverage - a.leverage; });

    Q.coalition_demands_prussia = [];

    var ministries = ['interior', 'justice', 'finance', 'trade', 'agriculture', 'publicworks', 'kultus'];
    var available_to_take = [];
    for (var i = 0; i < ministries.length; i++) {
        if (Q[ministries[i] + '_minister_party_prussia'] === 'SPD') {
            available_to_take.push(ministries[i]);
        }
    }

    for (var i = 0; i < compensation_needed.length; i++) {
        var demand = compensation_needed[i];
        var rel_var = demand.party.toLowerCase() + '_relation';
        var relation = Q[rel_var] || 50;
        var spd_leverage = Q.shuffle_leverage_prussia.SPD || 0;

        var takeover_chance = demand.leverage > spd_leverage
            ? 0.3 + (demand.losses * 0.15)
            : 0.1 + (demand.losses * 0.1);

        if (relation < 40) takeover_chance += 0.2;
        if (relation < 30) takeover_chance += 0.2;

        for (var j = 0; j < demand.losses; j++) {
            if (Math.random() < takeover_chance && available_to_take.length > 0) {
                var ministry_idx = Math.floor(Math.random() * available_to_take.length);
                var taken_ministry = available_to_take.splice(ministry_idx, 1)[0];

                Q[taken_ministry + '_minister_party_prussia'] = demand.party;
                assign_minister_prussia(taken_ministry, demand.party);

                Q.coalition_demands_prussia.push({
                    party: demand.party,
                    ministry: taken_ministry,
                    reason: 'compensation'
                });

                changes++;
            }
        }
    }

    if ((Q.shuffle_leverage_prussia.SPD || 0) < 40 || Q.coalition_tension > 3) {
        for (var i = 0; i < Q.government_parties_prussia.length; i++) {
            var party = Q.government_parties_prussia[i];
            if (party === 'SPD') continue;
            if (ministry_delta[party] < 0) continue;

            var rel_var = party.toLowerCase() + '_relation';
            var relation = Q[rel_var] || 50;
            var party_leverage = Q.shuffle_leverage_prussia[party] || 0;
            var spd_leverage = Q.shuffle_leverage_prussia.SPD || 0;

            var grab_chance = 0;
            if (party_leverage > spd_leverage * 1.3) grab_chance = 0.25;
            if (relation < 35) grab_chance += 0.15;
            if (Q.coalition_tension > 4) grab_chance += 0.15;

            if (Math.random() < grab_chance && available_to_take.length > 0) {
                var ministry_idx = Math.floor(Math.random() * available_to_take.length);
                var taken_ministry = available_to_take.splice(ministry_idx, 1)[0];

                Q[taken_ministry + '_minister_party_prussia'] = party;
                assign_minister_prussia(taken_ministry, party);

                Q.coalition_demands_prussia.push({
                    party: party,
                    ministry: taken_ministry,
                    reason: 'opportunistic'
                });

                changes++;
            }
        }
    }

    Q.shuffle_changes_made_prussia = changes;

    Q.coalition_response_text_prussia = "";
    if (Q.coalition_demands_prussia && Q.coalition_demands_prussia.length > 0) {
        for (var i = 0; i < Q.coalition_demands_prussia.length; i++) {
            var demand = Q.coalition_demands_prussia[i];
            var ministry_name = demand.ministry.charAt(0).toUpperCase() + demand.ministry.slice(1);
            if (demand.reason === 'compensation') {
                Q.coalition_response_text_prussia += "- The **" + demand.party + "** has seized the **" + ministry_name + " Ministry** as compensation for their losses.\n\n";
            } else {
                Q.coalition_response_text_prussia += "- The **" + demand.party + "** has opportunistically claimed the **" + ministry_name + " Ministry**.\n\n";
            }
        }
    }

    Q.cal_prussia = Q.coalition_demands_prussia.length;
!}

[? if shuffle_changes_made_prussia > 0 : The Prussian cabinet has been reshuffled. ?]
[? if shuffle_changes_made_prussia = 0 : No changes were made to the Prussian cabinet. ?]

[? if cal_prussia > 0 : **Coalition partners have responded:** ?]

[+ coalition_response_text_prussia +]

- @ministry_shuffle_complete_prussia: Continue

@ministry_shuffle_complete_prussia

The Prussian ministry reshuffle is complete.

@cancel_shuffle_prussia

The current Prussian arrangement will remain unchanged.
