# ============================================

@mp_confirmed_prussia
on-arrival: {!
if (Q.in_left_front_prussia) {
    Q.coup_progress += 2;
    Q.capital_strike_progress += 1;
    Q.kpd_relation += 8;
}

if (Q.in_popular_front_prussia) {
    Q.coup_progress += 1;
    Q.pro_republic += 4;
    Q.kpd_relation += 8;
    Q.z_relation += 4;
}

if (Q.coalition_type_prussia === 'far_right') {
    Q.coup_progress += 3;
    Q.pro_republic -= 10;
}

if (Q.in_bourgeois_coalition_prussia && !Q.spd_in_government_prussia) {
    Q.workers_spd -= 3;
}
!}

= [+ coalition_name_prussia +] Formed in Prussia

**Minister-President:** [+ ministerpresident +] ([+ mp_party_prussia +])

**Coalition Partners:**

[+ coalition_partners_list_prussia +]

**Total Landtag Support:** [+ coalition_votes_display_prussia +]%

[? if coalition_type_prussia = 'left_front' : The formation of a Left Front government including the Communists in Prussia has sent shockwaves through the establishment. The right-wing may attempt a coup. ?]

[? if coalition_type_prussia = 'popular_front' : The unprecedented Prussian Popular Front brings together Socialists, Communists, and Catholics in defense of the state's democratic order. ?]

[? if coalition_type_prussia = 'unity' : A broad Unity Government of democratic parties has been formed to face the crisis in Prussia. ?]

[? if coalition_type_prussia = 'bourgeois' : The bourgeois parties have formed a Prussian state government without the SPD. ?]

[? if coalition_type_prussia = 'far_right' : The Nazis have entered the Prussian state government. This may be the end of democracy in Germany's largest state. ?]

[? if ministerpresident = "Rich Uncle Pennybags": Rich Uncle Pennybags — philanthropist, business executive and supposed **time traveler**, with his rise to the Minister-Presidency, ordered the creation of the organization "Chance and Community Chest" in the Staatsministerium, drawing on his business friends and fellow supposed time travelers: Hjalmar Schacht, Thyssen, and others. Minister-President, what is the crisis looming ahead of Prussia? Another capitalist crisis, or just an imperialist war? Or are you only bluffing? ?]

- @ministry_allocation_prussia: Proceed to ministry distribution





@ministry_allocation_prussia
on-arrival: {!
// ============================================================
// PRUSSIAN CABINET
// Prussia's Staatsministerium had no Foreign or Reichswehr
// portfolio (these were Reich-level competences). We allocate
// the historically accurate seven Prussian ministries:
// Interior, Justice, Finance, Trade & Commerce (economic),
// Agriculture (Domänen und Forsten), Public Works
// (Eisenbahnen und Wasserstraßen / transport), and
// Volkswohlfahrt & Kultus (welfare, education, and church
// affairs, combined here as the "Kultus" portfolio).
// ============================================================

var coalition = Q.government_parties_prussia;
var total_coalition_votes = 0;

for (var i = 0; i < coalition.length; i++) {
    var party = coalition[i];
    var party_lower = party.toLowerCase();
    total_coalition_votes += Q[party_lower + '_r_prussia'];
}

var leverage = {};

for (var i = 0; i < coalition.length; i++) {
    var party = coalition[i];
    var party_lower = party.toLowerCase();

    var base = (Q[party_lower + '_r_prussia'] / total_coalition_votes) * 100;

    var relation_var = party_lower + '_relation';
    var relation = Q[relation_var] || 50;
    base += (relation - 50) / 5;

    if (Q.mp_party_prussia === party) {
        base -= 10;
    }

    if (party === "Z" && Q.z_party_leader === "Brüning") {
        base += 5;
    }
    if (party === "DVP") {
        base += 3;
    }
    if (party === "KPD" && Q.kpd_party_leader === "Conciliators") {
        base += 5;
    }

    if (Q.in_grand_coalition_prussia && party === "DVP" && Q.capital_strike_progress >= 3) {
        base += 5;
    }

    if (Q.in_left_front_prussia && party === "KPD") {
        base -= 5;
    }

    leverage[party] = Math.max(base, 10);
}

var MIN_RELATIVE_SHARE = 0.05;

var raw_total_leverage = 0;
for (var i = 0; i < coalition.length; i++) {
    raw_total_leverage += leverage[coalition[i]];
}

var excluded_parties = [];
var eligible_coalition = [];

for (var i = 0; i < coalition.length; i++) {
    var party = coalition[i];
    var relative_share = leverage[party] / raw_total_leverage;

    if (relative_share < MIN_RELATIVE_SHARE && party !== Q.mp_party_prussia) {
        excluded_parties.push(party);
    } else {
        eligible_coalition.push(party);
    }
}

if (excluded_parties.length > 0) {
    var reclaimed = 0;
    for (var i = 0; i < excluded_parties.length; i++) {
        reclaimed += leverage[excluded_parties[i]];
    }
    var remaining_total = 0;
    for (var i = 0; i < eligible_coalition.length; i++) {
        remaining_total += leverage[eligible_coalition[i]];
    }
    for (var i = 0; i < eligible_coalition.length; i++) {
        var party = eligible_coalition[i];
        leverage[party] += reclaimed * (leverage[party] / remaining_total);
    }
}

Q.excluded_from_cabinet_prussia = excluded_parties;
Q.has_excluded_parties_prussia = excluded_parties.length > 0 ? 1 : 0;

// ============================================================
// ALLOCATE 7 MINISTRIES (PRUSSIAN PORTFOLIOS ONLY)
// ============================================================

var ministries = ['interior', 'justice', 'finance', 'trade', 'agriculture', 'publicworks', 'kultus'];
var allocation = {};
var ministry_count = {};

var total_leverage = 0;
for (var i = 0; i < eligible_coalition.length; i++) {
    total_leverage += leverage[eligible_coalition[i]];
}

for (var i = 0; i < eligible_coalition.length; i++) {
    var party = eligible_coalition[i];
    var count = Math.round((leverage[party] / total_leverage) * ministries.length);
    allocation[party] = count;
    ministry_count[party] = 0;
}

for (var i = 0; i < excluded_parties.length; i++) {
    allocation[excluded_parties[i]] = 0;
}

var total_assigned = 0;
for (var i = 0; i < eligible_coalition.length; i++) {
    total_assigned += allocation[eligible_coalition[i]];
}

while (total_assigned > ministries.length) {
    var max_party = null;
    var max_count = 0;
    for (var i = 0; i < eligible_coalition.length; i++) {
        var party = eligible_coalition[i];
        if (allocation[party] > max_count && party !== Q.mp_party_prussia) {
            max_party = party;
            max_count = allocation[party];
        }
    }
    if (max_party) {
        allocation[max_party]--;
        total_assigned--;
    } else {
        break;
    }
}

while (total_assigned < ministries.length) {
    var max_party = null;
    var max_leverage = 0;
    for (var i = 0; i < eligible_coalition.length; i++) {
        var party = eligible_coalition[i];
        if (leverage[party] > max_leverage) {
            max_party = party;
            max_leverage = leverage[party];
        }
    }
    if (max_party) {
        allocation[max_party]++;
        total_assigned++;
        leverage[max_party] -= 10;
    } else {
        break;
    }
}

Q.ministry_display_list_prussia = "";
for (var i = 0; i < coalition.length; i++) {
    var party = coalition[i];
    var party_votes = Q[party.toLowerCase() + '_r_prussia'];
    var rounded_leverage = Math.round(leverage[party] * 10) / 10;
    var count = allocation[party] || 0;
    var shut_out_note = excluded_parties.indexOf(party) >= 0 ? " *(shut out of cabinet)*" : "";
    Q.ministry_display_list_prussia += "- **" + party + "**: " + count + " ministries (" + Math.round(party_votes * 10) / 10 + "% votes, leverage: " + rounded_leverage + ")" + shut_out_note + "\n";
}

// ============================================================
// MINISTRY PRIORITIES BY PARTY (PRUSSIAN PORTFOLIOS)
// ============================================================

var priorities = {
    KPD: ['interior', 'kultus', 'trade', 'finance', 'justice', 'agriculture', 'publicworks'],
    SAPD: ['kultus', 'interior', 'justice', 'trade', 'finance', 'agriculture', 'publicworks'],
    SPD: ['interior', 'kultus', 'justice', 'finance', 'trade', 'agriculture', 'publicworks'],
    SRPD: ['justice', 'kultus', 'interior', 'finance', 'trade', 'agriculture', 'publicworks'],
    DDP: ['justice', 'trade', 'finance', 'interior', 'kultus', 'agriculture', 'publicworks'],
    Z: ['interior', 'kultus', 'finance', 'agriculture', 'justice', 'trade', 'publicworks'],
    BVP: ['agriculture', 'justice', 'interior', 'finance', 'trade', 'kultus', 'publicworks'],
    DVP: ['trade', 'finance', 'justice', 'interior', 'kultus', 'agriculture', 'publicworks'],
    WP: ['trade', 'finance', 'justice', 'agriculture', 'interior', 'kultus', 'publicworks'],
    CNBL: ['agriculture', 'finance', 'trade', 'justice', 'interior', 'kultus', 'publicworks'],
    DNVP: ['interior', 'finance', 'agriculture', 'trade', 'justice', 'kultus', 'publicworks'],
    CSRP: ['interior', 'finance', 'agriculture', 'trade', 'justice', 'kultus', 'publicworks'],
};

var assignments = {};
for (var i = 0; i < ministries.length; i++) {
    assignments[ministries[i]] = null;
}

var sorted_coalition = eligible_coalition.slice().sort(function(a, b) {
    return leverage[b] - leverage[a];
});

for (var round = 0; round < ministries.length; round++) {
    for (var i = 0; i < sorted_coalition.length; i++) {
        var party = sorted_coalition[i];

        if (allocation[party] > ministry_count[party]) {
            var party_priorities = priorities[party] || ministries;

            for (var j = 0; j < party_priorities.length; j++) {
                var ministry = party_priorities[j];

                if (assignments[ministry] === null) {
                    assignments[ministry] = party;
                    ministry_count[party]++;
                    break;
                }
            }
        }
    }
}

Q.interior_minister_party_prussia = assignments.interior || 'I';
Q.justice_minister_party_prussia = assignments.justice || 'I';
Q.finance_minister_party_prussia = assignments.finance || 'I';
Q.trade_minister_party_prussia = assignments.trade || 'I';
Q.agriculture_minister_party_prussia = assignments.agriculture || 'I';
Q.publicworks_minister_party_prussia = assignments.publicworks || 'I';
Q.kultus_minister_party_prussia = assignments.kultus || 'I';

Q.ministry_allocation_prussia = allocation;
Q.ministry_leverage_prussia = leverage;

// ============================================================
// ASSIGN MINISTER NAMES (based on real Prussian Landtag figures
// where available, per the 3rd Wahlperiode member list)
// ============================================================

// Interior Ministry
if (Q.interior_minister_party_prussia === 'KPD') Q.interior_minister_prussia = 'Ulbricht';
else if (Q.interior_minister_party_prussia === 'SAPD') Q.interior_minister_prussia = 'Seydewitz';
else if (Q.interior_minister_party_prussia === 'SPD') Q.interior_minister_prussia = 'Severing';
else if (Q.interior_minister_party_prussia === 'SRPD') Q.interior_minister_prussia = 'Hörsing';
else if (Q.interior_minister_party_prussia === 'DDP') Q.interior_minister_prussia = 'Höpker-Aschoff';
else if (Q.interior_minister_party_prussia === 'Z') Q.interior_minister_prussia = 'Hirtsiefer';
else if (Q.interior_minister_party_prussia === 'BVP') Q.interior_minister_prussia = 'Schmelzer';
else if (Q.interior_minister_party_prussia === 'DVP') Q.interior_minister_prussia = 'Boelitz';
else if (Q.interior_minister_party_prussia === 'WP') Q.interior_minister_prussia = 'Drewitz';
else if (Q.interior_minister_party_prussia === 'CNBL') Q.interior_minister_prussia = 'Kriege';
else if (Q.interior_minister_party_prussia === 'DNVP') Q.interior_minister_prussia = 'Winterfeld';
else Q.interior_minister_prussia = 'Unbesetzt';

// Justice Ministry
if (Q.justice_minister_party_prussia === 'KPD') Q.justice_minister_prussia = 'Heckert';
else if (Q.justice_minister_party_prussia === 'SAPD') Q.justice_minister_prussia = 'Frankenthal';
