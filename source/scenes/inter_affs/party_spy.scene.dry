@ddp
view-if: ddp_unlocked_spy >= 1
subtitle: The internal situation of DDP is a fight between the business wing and the social-republicans.
on-display: {!

var isDark = document.body.classList.contains('dark-mode');

Q.business_wing_ddp = Q.business_wing_ddp || 370;
Q.social_republican_ddp = Q.social_republican_ddp || 130;

var factionData = [
    { id: "business", name: "Business Wing", subtitle: "Property-Owning / Free-Trade Liberals",
      raw: Math.max(Q.business_wing_ddp, 0), color: isDark ? "#e0824a" : "#8a3b12" },
    { id: "social", name: "Social-Republican Wing", subtitle: "Social Republican Line / Left-Liberals",
      raw: Math.max(Q.social_republican_ddp, 0), color: isDark ? "#9a9bff" : "#595BFF" }
];

var total = 0;
for (var i = 0; i < factionData.length; i++) { total += factionData[i].raw; }

var displaySeats = 300;
var visibleFactions = [];
for (var j = 0; j < factionData.length; j++) {
    var f = factionData[j];
    f.pct = total > 0 ? (f.raw / total * 100) : 0;
    f.seats = total > 0 ? Math.round(f.raw / total * displaySeats) : 0;
    if (f.raw > 0) { visibleFactions.push(f); }
}

Q.ddp_business_disp = Math.round(Q.business_wing_ddp);
Q.ddp_social_disp = Math.round(Q.social_republican_ddp);

var byId = {};
visibleFactions.forEach(function(f) { byId[f.id] = f; });
Q.ddp_business_pct = byId.business ? byId.business.pct.toFixed(1) : "0.0";
Q.ddp_social_pct = byId.social ? byId.social.pct.toFixed(1) : "0.0";

if (window && d3 && document.getElementById("ddp-parliament")) {
    var width = 600;
    var height = 300;
    var contentEl = document.getElementById('content');
    var screenWidth = contentEl ? contentEl.offsetWidth : 600;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = Math.round(width / 2);
    }

    var svg = document.getElementById("ddp-parliament");
    svg.style.width = width + "px";
    svg.style.height = height + "px";

    var data = visibleFactions.map(function(f) {
        return { id: f.id, legend: f.name, name: f.name,
                 seats: f.seats, color: f.color };
    });

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#ddp-parliament").datum(data).call(parliament);

    visibleFactions.forEach(function(f) {
        d3.selectAll("#ddp-parliament circle")
            .filter(function(d) { return d && d.data && d.data.id === f.id; })
            .style("stroke", "#333")
            .style("stroke-width", "1px")
            .style("fill", f.color);
    });
}
!}
