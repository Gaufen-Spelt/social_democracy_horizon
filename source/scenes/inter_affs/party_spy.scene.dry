@unlock_dnvp
view-if: dnvp_unlocked_spy <= 0
subtitle: -2 resources
choose-if: resources >= 2
unavailable-subtitle: Not enough resources.
on-arrival: {! Q.dnvp_unlocked_spy = 1; Q.resources -= 2; !}
go-to: party_spy

